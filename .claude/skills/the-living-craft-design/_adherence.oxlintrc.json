{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "applied/**",
              "components/agent/**",
              "components/core/**",
              "components/state/**",
              "components/structure/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Figtree|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Figtree, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:agent|state|stamp|actions|children|style|key|ref|className|style|children)$/]",
        "message": "<AgentBlock> doesn't accept that prop. Declared props: agent, state, stamp, actions, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentBlock'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:machine|human|uncertain|refused|cited)$/]",
        "message": "<AgentBlock> state must be one of 'machine' | 'human' | 'uncertain' | 'refused' | 'cited'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|full|type|href|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, full, type, href, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|checked|onChange|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, hint, checked, onChange, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Citation'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|source|href|children|style|key|ref|className|style|children)$/]",
        "message": "<Citation> doesn't accept that prop. Declared props: n, source, href, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Confidence'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|ticks|label|style|key|ref|className|style|children)$/]",
        "message": "<Confidence> doesn't accept that prop. Declared props: value, ticks, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|width|mono|quiet|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, label, align, width, mono, quiet."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|note|action|index|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: label, note, action, index, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|required|htmlFor|children|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, error, required, htmlFor, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|invalid|mono|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: as, invalid, mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|textarea)$/]",
        "message": "<Input> as must be one of 'input' | 'textarea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|mono|key|ref|className|style|children)$/]",
        "message": "<MetaListItem> doesn't accept that prop. Declared props: label, value, mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|tone|heavy|footer|children|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, meta, tone, heavy, footer, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:plain|sunken|invert)$/]",
        "message": "<Panel> tone must be one of 'plain' | 'sunken' | 'invert'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Provenance'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|label|filled|style|key|ref|className|style|children)$/]",
        "message": "<Provenance> doesn't accept that prop. Declared props: state, label, filled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Provenance'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:machine|human|uncertain|refused|cited)$/]",
        "message": "<Provenance> state must be one of 'machine' | 'human' | 'uncertain' | 'refused' | 'cited'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Refusal'] > JSXAttribute > JSXIdentifier[name!=/^(?:agent|reason|next|stamp|style|key|ref|className|style|children)$/]",
        "message": "<Refusal> doesn't accept that prop. Declared props: agent, reason, next, stamp, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|note|level|rule|style|key|ref|className|style|children)$/]",
        "message": "<SectionHead> doesn't accept that prop. Declared props: index, title, note, level, rule, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: options."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onChange|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: label, checked, onChange, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Unwritten'] > JSXAttribute > JSXIdentifier[name!=/^(?:lines|label|owner|style|key|ref|className|style|children)$/]",
        "message": "<Unwritten> doesn't accept that prop. Declared props: lines, label, owner, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
