# Copy to .env.local for dev; set the same keys in the Vercel project for prod.

# ---------------------------------------------------------------------------
# Public cohort scheduling
# ---------------------------------------------------------------------------

# Paste only the appointment schedule URL from Google Calendar's "Button with
# popup" website embed. This is deliberately public and is also the direct-link
# fallback if Google's popup script is unavailable. Leave it blank until the
# schedule is configured and ready to accept a test booking; while blank, the
# site continues to show the existing application and enquiry routes only.
PUBLIC_GOOGLE_CALENDAR_APPOINTMENT_URL=

# ---------------------------------------------------------------------------
# Agents
# ---------------------------------------------------------------------------

# Powers the visitor Q&A agent (/api/ask) and both retriever agents
# (npm run gather, npm run radar). Without it, /api/ask returns 503 and the
# widget tells visitors to use the form instead — the site degrades, it does
# not break.
#
# Set a monthly spend limit on this key in the Anthropic Console. It is the
# real ceiling on agent cost; the in-process rate limiter only bounds the
# cheap abuse case.
ANTHROPIC_API_KEY=

# Soft spend ceiling, in USD per calendar month, and the admin key used to read
# month-to-date spend from the Anthropic cost report. Together they let the
# agents stand down *before* the balance runs out: the retrievers refuse to
# sweep above 80%, /api/ask declines politely at 100%, and /craft/admin shows the
# number. Both unset (the default) means spend is simply not tracked here.
#
# The Admin API needs an ORGANIZATION account — on an individual account these
# calls are rejected and the guard reports "not tracked" rather than failing.
# Either way, set the spend limit in the Anthropic Console: that is the hard
# ceiling, and this is only the polite warning in front of it.
ANTHROPIC_ADMIN_KEY=
AGENT_MONTHLY_BUDGET_USD=

# ---------------------------------------------------------------------------
# Admin console (/craft/admin) — every var below is admin-only
# ---------------------------------------------------------------------------
# The public site does not read any of these. Leave them unset and /, /caio,
# /assessment and /api/ask behave exactly as they did before the console
# existed; /craft/admin says what is missing instead of erroring.

# The password you type at /craft/admin/login. Long and random — this is the only
# thing between the open internet and your leads.
#   openssl rand -base64 24
ADMIN_PASSWORD=

# Signs the admin session cookie (HMAC-SHA256). Changing it logs you out
# everywhere, which is also how you revoke a session.
#
# It signs two more things: learner sessions for /craft, and the HMAC of every
# learner access code. Changing it therefore ALSO invalidates every issued seat
# code — each one has to be re-issued from /craft/admin/learners. Rotate it knowing
# that, not by surprise.
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Salt for the daily-rotating visitor hash in first-party analytics. Raw IPs are
# never stored; they are hashed with this and the date, so the identifier dies
# at midnight and cannot be reversed without the salt.
#   openssl rand -base64 32
ANALYTICS_SALT=

# Supabase — leads, visitor questions, traffic events, and the cohort's seats.
# The learners table gates /craft: without these vars the course area returns
# 503 rather than opening, because "cannot verify a seat" must not resolve to
# "let them in".
# Project URL is on the dashboard; the SERVICE ROLE key is under
# Settings -> API. It bypasses row-level security, so it is server-only and
# must never appear in client code or a PUBLIC_/VITE_ prefixed var.
# Run supabase/schema.sql once before first use.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub — lets the console open PRs against this repo (editing retriever
# findings, hiding an item, adding an operator note) and trigger the retriever
# workflows on demand. Fine-grained PAT scoped to this repo only, with
# Contents: read/write, Pull requests: read/write, Actions: read/write.
#
# Omit it and the console still reads everything; the write-back buttons are
# disabled with a note rather than failing on click.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# What the SHARED console password grants, while there are no named staff
# accounts yet. Comma-separated role names from src/lib/pipeline/roles.ts:
# operator, instructor, finance, programme, maintainer.
#
# Defaults to `operator` alone, deliberately. An operator can work the pipeline
# and cannot approve an offer or confirm a payment, so a console running on the
# shared password cannot complete an enrolment on its own — which is the whole
# separation the brief asks for. The way past it is to create named accounts,
# not to widen this. If you do widen it, write down when you will undo it.
# ADMIN_BOOTSTRAP_ROLES=operator

# Mail delivery remains OFF until a provider adapter is implemented and the
# domain/mailbox are verified. These values are explicit assertions consumed
# by the communication launch gate; setting them does not by itself send mail.
# COMMS_PROVIDER=
# COMMS_SENDING_DOMAIN=
# COMMS_REPLY_MAILBOX=apply@thelivingcraft.ai

# Signs the one-click unsubscribe link. Required before COMMS_DISPATCH can be
# turned on; without it no token can be minted and nurture stays disabled.
#
# IT MUST NOT EQUAL ADMIN_SESSION_SECRET. The two token families had an
# identical wire format, so sharing the key made an emailed unsubscribe link a
# valid admin session cookie — a public, 400-day link that opened the console
# shell. The signing input is now domain-separated so that cannot happen
# whatever you set, but keep them different anyway: defence that depends on one
# person reading one comment is not defence.
#
# Generate: openssl rand -base64 32
# COMMS_LINK_SECRET=

# Set to exactly "on" to allow mail to leave. Every other value, and its
# absence, means dispatch is off. It is ALSO gated on the other preconditions
# being met — a provider, a verified sending domain, a monitored reply mailbox —
# so setting this alone does not start sending. See /craft/admin/comms.
# COMMS_DISPATCH=
# --- Google Calendar (booking invites) --------------------------------------
# Availability is NOT read from Google. Slots come from this site's own rules,
# edited at /craft/admin/bookings. Google is used for one thing: creating the
# event so both people get an invite, an update when a call moves, and a
# cancellation when it is called off.
#
# Without these three, booking still works and is still recorded. Nobody gets an
# invite, and the console shows every affected call in red.
#
# How to get them, once:
#   1. console.cloud.google.com -> new project -> enable the Google Calendar API.
#   2. OAuth consent screen: External. ADD YOURSELF AS THE ONLY USER, then
#      PUBLISH THE APP. An app left in "Testing" expires its refresh token after
#      seven days, and the symptom is invites silently stopping a week later.
#   3. Credentials -> OAuth client ID -> Web application. Add
#      https://developers.google.com/oauthplayground as a redirect URI.
#   4. developers.google.com/oauthplayground -> settings -> use your own
#      credentials -> authorise https://www.googleapis.com/auth/calendar.events
#      -> exchange for tokens -> copy the refresh token.
# A service account will not do: it cannot invite attendees without Google
# Workspace domain-wide delegation, and the invite goes to nobody.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Which calendar to write to. 'primary' is the account's own and is usually right.
GOOGLE_CALENDAR_ID=primary
