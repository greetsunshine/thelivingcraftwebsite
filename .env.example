# Copy to .env.local for dev; set the same keys in the Vercel project for prod.

# ---------------------------------------------------------------------------
# Agents
# ---------------------------------------------------------------------------

# Powers the visitor Q&A agent (/api/ask) and both retriever agents
# (npm run gather, npm run radar). Without it, /api/ask returns 503 and the
# widget tells visitors to use the form instead — the site degrades, it does
# not break.
#
# Set a monthly spend limit on this key in the Anthropic Console. It is the
# real ceiling on agent cost; the in-process rate limiter only bounds the
# cheap abuse case.
ANTHROPIC_API_KEY=

# Soft spend ceiling, in USD per calendar month, and the admin key used to read
# month-to-date spend from the Anthropic cost report. Together they let the
# agents stand down *before* the balance runs out: the retrievers refuse to
# sweep above 80%, /api/ask declines politely at 100%, and /admin shows the
# number. Both unset (the default) means spend is simply not tracked here.
#
# The Admin API needs an ORGANIZATION account — on an individual account these
# calls are rejected and the guard reports "not tracked" rather than failing.
# Either way, set the spend limit in the Anthropic Console: that is the hard
# ceiling, and this is only the polite warning in front of it.
ANTHROPIC_ADMIN_KEY=
AGENT_MONTHLY_BUDGET_USD=

# ---------------------------------------------------------------------------
# Admin console (/admin) — every var below is admin-only
# ---------------------------------------------------------------------------
# The public site does not read any of these. Leave them unset and /, /caio,
# /assessment and /api/ask behave exactly as they did before the console
# existed; /admin says what is missing instead of erroring.

# The password you type at /admin/login. Long and random — this is the only
# thing between the open internet and your leads.
#   openssl rand -base64 24
ADMIN_PASSWORD=

# Signs the admin session cookie (HMAC-SHA256). Changing it logs you out
# everywhere, which is also how you revoke a session.
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Salt for the daily-rotating visitor hash in first-party analytics. Raw IPs are
# never stored; they are hashed with this and the date, so the identifier dies
# at midnight and cannot be reversed without the salt.
#   openssl rand -base64 32
ANALYTICS_SALT=

# Supabase — leads, visitor questions, and traffic events.
# Project URL is on the dashboard; the SERVICE ROLE key is under
# Settings -> API. It bypasses row-level security, so it is server-only and
# must never appear in client code or a PUBLIC_/VITE_ prefixed var.
# Run supabase/schema.sql once before first use.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub — lets the console open PRs against this repo (editing retriever
# findings, hiding an item, adding an operator note) and trigger the retriever
# workflows on demand. Fine-grained PAT scoped to this repo only, with
# Contents: read/write, Pull requests: read/write, Actions: read/write.
#
# Omit it and the console still reads everything; the write-back buttons are
# disabled with a note rather than failing on click.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
