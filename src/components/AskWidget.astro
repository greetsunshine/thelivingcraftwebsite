---
// The visitor-facing surface of the Q&A agent.
//
// Deliberately not a bouncing purple bubble. It sits as a hairline-bordered
// panel in the corner, closed by default, in the same warm palette and type
// scale as the rest of the site — a site that sells restraint should not open
// with a chatbot lunging at you.
//
// No framework, no client storage: the transcript lives in a module-scoped
// array and dies with the tab, which is what CLAUDE.md's no-localStorage rule
// requires and what keeps the privacy story simple.
import { CONTACT_EMAIL } from '../data/site';

export interface Props {
  /** Which page the visitor is on — sent with each turn so answers can be local. */
  surface: string;
  /** Region the page resolved, so the agent quotes the same rate the page shows. */
  region?: string | null;
}

const { surface, region = null } = Astro.props;

// Render nothing unless the agent can actually answer. A chat button that
// opens and says "not configured" is worse than no button — it reads as a
// broken site to the exact senior audience this page is trying to impress.
// Adding the key to Vercel triggers a redeploy, which is when it appears.
const agentReady = Boolean(
  import.meta.env.ANTHROPIC_API_KEY ?? process.env.ANTHROPIC_API_KEY,
);

const OPENERS: Record<string, string[]> = {
  '/': ['What does the cohort cost?', 'Is it right for a staff engineer?', 'When does it start?'],
  '/caio': ['How do the tiers differ?', 'Do you work in regulated industries?', 'How do we start?'],
  '/assessment': ['What do I actually get?', 'How long does it take?', 'What does it cost?'],
};
const prompts = OPENERS[surface] ?? OPENERS['/'];
---

{agentReady && (
<div class="ask" id="ask" data-surface={surface} data-region={region ?? ""}>
  <button class="ask-toggle" id="askToggle" aria-expanded="false" aria-controls="askPanel">
    <span class="ask-dot"></span>
    <span class="ask-toggle-label">Ask about the practice</span>
  </button>

  <div class="ask-panel" id="askPanel" role="dialog" aria-label="Ask about the practice" hidden>
    <div class="ask-head">
      <div>
        <div class="ask-title">Ask</div>
        <div class="ask-sub">Answers drawn from this site. Not Sunil — he replies by email.</div>
      </div>
      <button class="ask-close" id="askClose" aria-label="Close">×</button>
    </div>

    <div class="ask-log" id="askLog" aria-live="polite">
      <div class="ask-msg bot">
        <p>Ask me anything about the cohort, the CAIO retainer, or the assessment. If I don't know, I'll say so and pass it to Sunil.</p>
      </div>
      <div class="ask-prompts" id="askPrompts">
        {prompts.map((p) => <button class="ask-chip" data-q={p}>{p}</button>)}
      </div>
    </div>

    <form class="ask-form" id="askForm">
      <input
        id="askInput"
        type="text"
        name="question"
        autocomplete="off"
        placeholder="Type a question…"
        aria-label="Your question"
        maxlength="1500"
      />
      <button type="submit" id="askSend" aria-label="Send">→</button>
    </form>
    <p class="ask-foot">Prefer email? <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
  </div>
</div>
)}

<style>
  .ask {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 90;
    font-family: 'Inter', sans-serif;
  }

  /* toggle */
  .ask-toggle {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--ink);
    color: #ede6d7;
    border: 0;
    border-radius: 3px;
    padding: 13px 20px;
    cursor: pointer;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    box-shadow: 0 8px 30px rgba(34, 28, 21, 0.22);
    transition: background 0.2s, transform 0.2s;
  }
  .ask-toggle:hover { background: #14100b; transform: translateY(-1px); }
  .ask-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--ochre);
    flex-shrink: 0;
  }
  .ask[data-open='true'] .ask-toggle { display: none; }

  /* panel */
  .ask-panel {
    width: min(400px, calc(100vw - 32px));
    height: min(560px, calc(100vh - 48px));
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    box-shadow: 0 18px 60px rgba(34, 28, 21, 0.2);
    overflow: hidden;
  }
  .ask-panel[hidden] { display: none; }

  .ask-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    padding: 18px 20px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }
  .ask-title {
    font-family: 'Fraunces', serif;
    font-size: 19px;
    font-weight: 440;
    color: var(--ink);
    line-height: 1.2;
  }
  .ask-sub {
    font-size: 12px;
    color: var(--ink-faint);
    margin-top: 3px;
    max-width: 30ch;
    line-height: 1.45;
  }
  .ask-close {
    background: none; border: 0; cursor: pointer;
    font-size: 24px; line-height: 1;
    color: var(--ink-faint); padding: 0 2px;
  }
  .ask-close:hover { color: var(--ink); }

  /* transcript */
  .ask-log {
    flex: 1;
    overflow-y: auto;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  /* Message bubbles are created at runtime by the script below, so they never
     get Astro's scoping attribute — these have to be :global or they silently
     don't apply and every turn renders as unstyled text. Scoped by .ask-log so
     the global escape hatch stays contained to this widget. */
  .ask-log :global(.ask-msg) { font-size: 14.5px; line-height: 1.6; }
  .ask-log :global(.ask-msg p) { margin: 0 0 9px; }
  .ask-log :global(.ask-msg p:last-child) { margin-bottom: 0; }
  .ask-log :global(.ask-msg.bot) { color: var(--ink-soft); }
  .ask-log :global(.ask-msg.user) {
    align-self: flex-end;
    max-width: 85%;
    background: var(--ink);
    color: #ede6d7;
    padding: 10px 14px;
    border-radius: 3px;
  }
  .ask-log :global(.ask-msg.err) { color: var(--clay-deep); }

  .ask-prompts { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 2px; }
  .ask-chip {
    background: none;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    padding: 7px 11px;
    font-family: 'Inter', sans-serif;
    font-size: 12.5px;
    color: var(--ink-soft);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .ask-chip:hover { border-color: var(--clay); color: var(--clay); }

  /* the agent thinking — also runtime-created, so also :global */
  .ask-log :global(.ask-thinking) { display: flex; gap: 5px; padding: 3px 0; }
  .ask-log :global(.ask-thinking span) {
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--ochre);
    animation: askPulse 1.3s ease-in-out infinite;
  }
  .ask-log :global(.ask-thinking span:nth-child(2)) { animation-delay: 0.18s; }
  .ask-log :global(.ask-thinking span:nth-child(3)) { animation-delay: 0.36s; }
  @keyframes askPulse {
    0%, 60%, 100% { opacity: 0.25; }
    30% { opacity: 1; }
  }

  /* input */
  .ask-form {
    display: flex;
    gap: 8px;
    padding: 14px 20px 10px;
    border-top: 1px solid var(--line);
  }
  .ask-form input {
    flex: 1;
    font-family: 'Inter', sans-serif;
    font-size: 14.5px;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    padding: 10px 12px;
  }
  .ask-form input::placeholder { color: var(--ink-faint); opacity: 0.75; }
  .ask-form input:focus {
    outline: none;
    border-color: var(--clay);
    box-shadow: 0 0 0 3px rgba(176, 81, 46, 0.12);
  }
  .ask-form button {
    background: var(--clay);
    color: #fff;
    border: 0;
    border-radius: 2px;
    width: 42px;
    font-size: 17px;
    cursor: pointer;
    transition: background 0.15s;
  }
  .ask-form button:hover:not(:disabled) { background: var(--clay-deep); }
  .ask-form button:disabled { opacity: 0.4; cursor: default; }

  .ask-foot {
    padding: 0 20px 14px;
    font-size: 11.5px;
    color: var(--ink-faint);
    text-align: center;
  }
  .ask-foot a { color: var(--clay); }

  @media (max-width: 520px) {
    .ask { right: 12px; bottom: 12px; left: 12px; }
    .ask-toggle { width: 100%; justify-content: center; }
    .ask-panel { width: 100%; height: min(70vh, 520px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ask-toggle, .ask-form button, .ask-chip { transition: none; }
    .ask-log :global(.ask-thinking span) { animation: none; opacity: 0.6; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('ask');
    if (!root) return;

    var toggle = document.getElementById('askToggle') as HTMLButtonElement;
    var closeBtn = document.getElementById('askClose') as HTMLButtonElement;
    var panel = document.getElementById('askPanel') as HTMLElement;
    var form = document.getElementById('askForm') as HTMLFormElement;
    var input = document.getElementById('askInput') as HTMLInputElement;
    var send = document.getElementById('askSend') as HTMLButtonElement;
    var log = document.getElementById('askLog') as HTMLElement;
    var prompts = document.getElementById('askPrompts');
    var surface = root.getAttribute('data-surface') || '/';
    // Server-resolved region (param or geo). Falls back to the URL param for
    // shareable ?region= links; the API re-validates and geo-fills either way.
    var region =
      root.getAttribute('data-region') ||
      new URLSearchParams(location.search).get('region') ||
      '';

    // In memory only. No localStorage, no cookie — closing the tab ends it.
    var history: { role: 'user' | 'assistant'; content: string }[] = [];
    var busy = false;

    function open() {
      root!.setAttribute('data-open', 'true');
      panel.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      input.focus();
    }

    function close() {
      root!.removeAttribute('data-open');
      panel.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.focus();
    }

    toggle.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !panel.hidden) close();
    });

    function bubble(text: string, cls: string) {
      var el = document.createElement('div');
      el.className = 'ask-msg ' + cls;
      // Split on blank lines into paragraphs; textContent throughout, so a
      // model response can never inject markup into the page.
      var paras = text.split(/\n{2,}/);
      for (var i = 0; i < paras.length; i++) {
        var p = document.createElement('p');
        p.textContent = paras[i].replace(/\n/g, ' ').trim();
        if (p.textContent) el.appendChild(p);
      }
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return el;
    }

    function thinking() {
      var el = document.createElement('div');
      el.className = 'ask-msg bot';
      el.innerHTML = '<div class="ask-thinking"><span></span><span></span><span></span></div>';
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return el;
    }

    // Web3Forms rejects server-side posts on the free plan, so the lead is
    // delivered from here — the same path the application forms already use.
    // The agent has already told the visitor their details are on the way, so
    // a failure has to be surfaced rather than swallowed.
    async function deliverCapture(payload: Record<string, string>) {
      try {
        var res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        var json = await res.json();
        if (!json.success) throw new Error(json.message || 'rejected');
      } catch (err) {
        bubble(
          'One correction: that handoff did not go through. Please email apply@thelivingcraft.ai directly so your question reaches Sunil.',
          'bot err',
        );
      }
    }

    async function ask(question: string) {
      if (busy || !question.trim()) return;
      busy = true;
      send.disabled = true;
      if (prompts) prompts.remove();

      bubble(question, 'user');
      input.value = '';
      var pending = thinking();

      try {
        var res = await fetch('/api/ask', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question: question, history: history, surface: surface, region: region }),
        });
        var data = await res.json();
        pending.remove();

        if (data.answer) {
          bubble(data.answer, 'bot');
          history.push({ role: 'user', content: question });
          history.push({ role: 'assistant', content: data.answer });
          if (history.length > 12) history = history.slice(-12);
          if (data.capture) await deliverCapture(data.capture);
        } else {
          bubble(data.error || 'Something went wrong. Email apply@thelivingcraft.ai.', 'bot err');
        }
      } catch (err) {
        pending.remove();
        bubble('Network trouble. Email apply@thelivingcraft.ai and Sunil will pick it up.', 'bot err');
      }

      busy = false;
      send.disabled = false;
      input.focus();
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      ask(input.value);
    });

    if (prompts) {
      prompts.addEventListener('click', function (e) {
        var t = e.target as HTMLElement;
        var q = t.getAttribute('data-q');
        if (q) ask(q);
      });
    }
  })();
</script>
