---
// Google Tag Manager, behind the visitor's consent.
//
// Until 29 September 2026 this was Google's own snippet, which requested the
// container as soon as the page opened. It now renders the consent banner, and
// the banner's script requests the container only after a yes to analytics.
// Read src/lib/consent/consent.ts for the rules.
//
// Layouts still render this in <head> and GoogleTagManagerNoscript in <body>,
// so no layout changed when consent arrived.
import { GTM_CONTAINER_ID } from '../data/site';
import ConsentBanner from './ConsentBanner.astro';
---

<ConsentBanner gtm={GTM_CONTAINER_ID} />
