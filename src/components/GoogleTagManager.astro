---
// Head snippet, placed as high in <head> as possible per Google's own
// instructions. Pairs with GoogleTagManagerNoscript.astro, which carries the
// matching <body> half — the two must always ship together.
import { GTM_CONTAINER_ID } from '../data/site';
---

<script is:inline define:vars={{ id: GTM_CONTAINER_ID }}>
  (function (w, d, s, l, i) {
    w[l] = w[l] || [];
    w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    var f = d.getElementsByTagName(s)[0],
      j = d.createElement(s),
      dl = l != 'dataLayer' ? '&l=' + l : '';
    j.async = true;
    j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
    f.parentNode.insertBefore(j, f);
  })(window, document, 'script', 'dataLayer', id);
</script>
