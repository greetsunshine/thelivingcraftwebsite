---
// The download gate's dialog. One per page, the same on every resource page.
//
// HOW A PAGE USES IT
//
//   1. Render <ResourceGate resource="poc-screen" lead="..." /> once, anywhere
//      in the page body.
//   2. Put data-gate="<kind>" on any button or link that hands over a file:
//      pdf, xlsx, zip, json, csv, md, txt, or print. Optional data-variant
//      (templates use blank | worked). The client wires them by delegation.
//   3. A page whose file is built from the reader's own answers (a scored
//      PDF, a CSV of their rows) passes `manual` here and calls mountGate()
//      from its own module script with a `payload` function. Every other page
//      needs no script of its own: this component mounts the gate itself.
//
// The dialog is a native <dialog>: focus is trapped, Escape closes it, and
// nothing else on the page needs a script to make that true. The name and the
// email come from RESOURCE_FIELDS, the same definition the server validates
// against, so a field cannot be required in the browser and optional on the
// server. The role is the shared RoleField, whose list is the one the server
// definition reads too (audience-roles.ts).
//
// What it says is fixed on purpose: the address is used to send this resource
// once and starts no other email. That sentence is the promise the marketing
// view depends on (`consented = false`), and no page may reword it.
//
// WHOSE FILE IT IS depends on the button, and the dialog says which. A control
// that hands over the reader's own answers (a scored PDF, a CSV of their rows,
// a print of a filled tool) carries `data-own`, and the dialog reads "Your
// copy" and "What you typed into the tool goes into the file and is not
// stored". Any other control hands over the same file for everyone (a blank
// workbook, a worksheet, a template), and the dialog says that instead. Until
// 29 September 2026 every file was called "your copy", which was false for the
// blank tools that became the main download on 28 September.
import { RESOURCE_FIELDS } from '../lib/pipeline/resources';
import RoleField from './RoleField.astro';
import { MARKETING_CONSENT } from '../lib/pipeline/consent';

interface Props {
  /** The resource id the request is recorded against. */
  resource: string;
  /** One sentence on what the file carries. Shown above the fields. */
  lead: string;
  /** The page mounts the gate itself, with a payload. */
  manual?: boolean;
}

const { resource, lead, manual = false } = Astro.props;
const nameField = RESOURCE_FIELDS.find((f) => f.name === 'name')!;
const emailField = RESOURCE_FIELDS.find((f) => f.name === 'email')!;
---

<dialog class="gate" id="gate-dialog" aria-labelledby="gate-title" data-resource={resource} data-manual={manual ? '' : undefined}>
  <form method="dialog" id="gate-form" novalidate>
    <span class="eyebrow"><span class="num" id="gate-kind">File</span> <span id="gate-whose">Download</span></span>
    <h2 id="gate-title">Get the file</h2>
    <p class="gate-lead">{lead} It is built against a name, a role and an email address.</p>
    <div class="gate-grid">
      <label>
        {nameField.label}
        <input type="text" name="name" autocomplete={nameField.autocomplete} maxlength={nameField.max} required />
      </label>
      <label>
        {emailField.label}
        <input type="email" name="email" autocomplete={emailField.autocomplete} maxlength={emailField.max} required />
      </label>
      {/* The role, since 29 September 2026 (Sunil: "ask for role there also"). */}
      <RoleField id="gate-role" required labelClass="gate-full" />
    </div>
    {/* Marketing permission (30 September 2026): unticked, separate, optional.
        The words and their version come from consent.ts, so the record can
        say what was shown. Ticking it opens the resource follow-ups; leaving
        it sends the resource and nothing else. Reusing the application form's
        wording on this surface awaits Sunil's confirmation. */}
    <label class="gate-tick" for="gate-consent">
      <input type="checkbox" id="gate-consent" name="marketing_consent" value="yes" />
      <span>{MARKETING_CONSENT.wording}</span>
    </label>
    <input class="hp" type="text" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <p class="gate-note">
      <span id="gate-note-own" hidden>What you typed into the tool goes into the file and is not stored.</span>
      <span id="gate-note-same">This file is the same for everyone. Nothing you typed goes into it.</span>
      Your address is used to send you this resource once. It does not start any other email.
    </p>
    <p class="gate-status" id="gate-status" role="status" aria-live="polite"></p>
    <ul class="gate-checks mono" id="gate-checks" hidden></ul>
    <div class="gate-actions">
      <button class="btn btn-primary" id="gate-submit" type="submit">Get the file</button>
      <button class="btn btn-ghost" id="gate-cancel" type="button">Cancel</button>
    </div>
  </form>
</dialog>

{/* Pages with a payload mount the gate themselves; every other page gets it here. */}
<script>
  import { mountGate } from '../lib/resources/gate-client';
  const dialog = document.getElementById('gate-dialog');
  if (dialog && !dialog.hasAttribute('data-manual')) mountGate();

  // Say whose file this is before the dialog opens: capture phase, so it runs
  // ahead of the gate's own click handler. See WHOSE FILE IT IS above.
  const whose = document.getElementById('gate-whose');
  const noteOwn = document.getElementById('gate-note-own');
  const noteSame = document.getElementById('gate-note-same');
  document.addEventListener(
    'click',
    (e) => {
      const control = (e.target as Element | null)?.closest?.('[data-gate]');
      if (!control || !whose || !noteOwn || !noteSame) return;
      const own = control.hasAttribute('data-own');
      whose.textContent = own ? 'Your copy' : 'Download';
      noteOwn.hidden = !own;
      noteSame.hidden = own;
    },
    true,
  );
</script>

<style>
  .gate {
    /* The reset zeroes margin on everything, which also removes the
       browser's own centring of a modal dialog. Put it back. */
    margin: auto;
    border: 0;
    padding: 0;
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    overflow: auto;
    background: var(--surface-panel);
    color: var(--text-body);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-overlay);
  }
  .gate::backdrop { background: rgba(22, 33, 46, 0.45); }
  .gate form { padding: var(--space-6); }
  .gate .eyebrow { display: block; margin-bottom: var(--space-3); }
  .gate h2 { font-size: var(--size-6); margin: 0 0 var(--space-3); }
  .gate-lead { margin: 0 0 var(--space-5); }
  .gate-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .gate :global(.gate-full) { grid-column: 1 / -1; }
  /* :global, because RoleField's two labels and its text box are another component's markup. */
  .gate :global(label) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-family: var(--font-marginal);
    font-size: var(--size-1);
    color: var(--text-quiet);
  }
  .gate :global(input),
  .gate :global(select) {
    font-family: var(--font-body);
    font-size: var(--size-3);
    color: var(--text-body);
    background: var(--surface-panel);
    border: var(--border-w-rule) solid var(--border-field);
    border-radius: var(--radius-field);
    padding: 0 var(--space-4);
    height: var(--control-h);
    width: 100%;
  }
  .gate :global(input:focus), .gate :global(select:focus) { outline: none; border-color: var(--text-body); }
  .gate :global(input:focus-visible), .gate :global(select:focus-visible) { outline: var(--focus-w) solid var(--focus-ring); outline-offset: var(--focus-offset); }
  .gate .gate-tick {
    flex-direction: row;
    align-items: flex-start;
    gap: var(--space-3);
    margin-top: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--size-2);
    color: var(--text-body);
    line-height: 1.5;
    cursor: pointer;
  }
  .gate .gate-tick input[type="checkbox"] {
    flex: none;
    width: 18px;
    height: 18px;
    margin: 2px 0 0;
    padding: 0;
    accent-color: var(--control-primary-bg, #183d32);
  }
  .gate .hp { position: absolute !important; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .gate-note { margin: var(--space-4) 0 0; font-size: var(--size-2); color: var(--text-quiet); }
  .gate-status { margin: var(--space-3) 0 0; font-size: var(--size-2); min-height: 1.4em; }
  .gate-status.err { color: var(--danger); }
  .gate-status.ok { color: var(--text-loud); }
  .gate-checks {
    list-style: none;
    padding: var(--space-3) var(--space-4);
    margin: var(--space-3) 0 0;
    background: var(--surface-sunken);
    border-radius: var(--radius-inner);
    font-size: var(--size-1);
    color: var(--text-quiet);
    display: flex;
    flex-direction: column;
    gap: 3px;
    max-height: 180px;
    overflow: auto;
  }
  .gate-checks :global(li) { display: flex; gap: var(--space-2); }
  .gate-checks :global(li b) { flex: 0 0 5ch; font-weight: var(--weight-strong); color: var(--text-body); }
  .gate-checks :global(li.fail b) { color: var(--danger); }
  .gate-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-4); }
  .gate button[disabled] { opacity: 0.42; pointer-events: none; }
  @media (max-width: 860px) {
    .gate-grid { grid-template-columns: 1fr; }
  }
  @media print {
    .gate { display: none !important; }
  }
</style>
