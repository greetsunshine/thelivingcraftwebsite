---
// Shared <head>: meta, canonical, Open Graph, Twitter, JSON-LD, analytics.
// Imported by all three layouts so the three surfaces can't drift apart.
import { SITE_ORIGIN, practitioner } from '../data/facts';
import { isProduction } from '../lib/env';

export interface Props {
  title: string;
  description?: string;
  /** Path or absolute URL. Defaults to the current request path. */
  canonical?: string;
  /** JSON-LD graph nodes for this page. Serialised into one @graph script. */
  schema?: unknown[];
  /** OG image path, relative to the origin. */
  image?: string;
  /**
   * Keep this page out of the index whatever the environment. For a page that
   * is deliberately not for search — an honest placeholder, a page the owner
   * has not signed off. Staging is handled separately, below.
   */
  noindex?: boolean;
}

// The social card is its own file, not the hero portrait. The hero photo is a 4:5
// portrait, and a summary_large_image card crops that to a wide band across the
// chest. /og-card.jpg is the same photograph, cropped to 1200x630.
const { title, description, canonical, schema = [], image = '/og-card.jpg', noindex = false } = Astro.props;

// Two separate reasons to stay out of the index, and they are not the same
// thing. `noindex` is the page saying so about itself, on every environment.
// isProduction() is the DEPLOYMENT saying so: a Vercel preview or a local build
// must not be indexed whatever the page thinks. Either one is enough.
//
// On a prerendered route this is decided at build time, not per request. See
// src/lib/env.ts for which routes those are and what it costs.
const indexable = isProduction() && !noindex;

const href = canonical
  ? new URL(canonical, SITE_ORIGIN).href
  : new URL(Astro.url.pathname, SITE_ORIGIN).href;
const imageUrl = new URL(image, SITE_ORIGIN).href;

// One @graph beats several loose scripts — nodes can @id-reference each other,
// which is how a crawler learns the Person and the Course are the same practice.
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE_ORIGIN}/#person`,
      name: practitioner.name,
      jobTitle: practitioner.role,
      email: `mailto:${practitioner.email}`,
      url: SITE_ORIGIN,
      sameAs: practitioner.sameAs,
      address: { '@type': 'PostalAddress', addressLocality: 'Bengaluru', addressCountry: 'IN' },
      alumniOf: practitioner.companies.map((n) => ({ '@type': 'Organization', name: n })),
      knowsAbout: [
        'Agentic AI architecture',
        'Multi-agent orchestration',
        'LLM evaluation and reliability',
        'AI red-teaming and prompt injection defence',
        'Distributed systems architecture',
        'AI governance and regulatory compliance',
      ],
    },
    ...schema,
  ],
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="icon" href="/favicon.ico" />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={href} />
<meta name="author" content={practitioner.name} />
<meta
  name="robots"
  content={indexable ? 'index, follow, max-image-preview:large, max-snippet:-1' : 'noindex, nofollow'}
/>

<meta property="og:site_name" content="Sunil Mathew — The Living Craft" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={href} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content="en_IN" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<!-- Machine-readable companions, advertised so agents and crawlers find them. -->
<link rel="alternate" type="text/plain" href="/llms.txt" title="Site facts for LLMs" />
<link rel="alternate" type="application/json" href="/api/facts" title="Structured practice facts" />

{/* Design system v1 (18 September 2026): Figtree for reading and controls,
    Source Serif 4 for h1, h2 and the pull quote. Weights 400 to 700 are
    loaded so a page-scoped rule that bolds a serif heading gets a real bold,
    not a synthesised one. JetBrains Mono is no longer loaded here: the public
    pages stopped using it, and /craft loads its own fonts. The package ships
    the font files, but with no licence file, so they are not self-hosted. */}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400&display=swap"
  rel="stylesheet"
/>

<script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
