---
// Edit / hide controls for one agent finding, on both the radar and the content
// review. Shared because the two pages must present the same affordances, even
// though what happens on submit now differs: the visitor retriever's findings
// are edited by pull request (they are read aloud to prospects, so every change
// should be a reviewable diff), while the radar writes straight to its table.
// That difference is one `endpoint` prop rather than two copies of the form.
//
// The edit form is collapsed by default. These findings are meant to be read
// first and corrected second — an always-open textarea invites rewriting the
// agent's wording out of habit, and the wording is usually not the problem.

export interface Props {
  id: string;
  /** Which store this item lives in. */
  file: 'radar' | 'latest';
  title: string;
  body: string;
  /** Radar findings only. */
  implication?: string;
  /**
   * False when the store's write path is unconfigured — GITHUB_TOKEN for
   * 'latest', Supabase for 'radar'. The buttons explain rather than fail.
   */
  canWrite: boolean;
  /** Wording for the hide button; the consequence differs between the two stores. */
  hideLabel: string;
  /** Where the buttons POST. Defaults to the pull-request flow. */
  endpoint?: string;
  /** 'hide' or 'restore' — the radar can put a dismissed finding back. */
  hideAction?: 'hide' | 'restore';
}

const {
  id,
  file,
  title,
  body,
  implication,
  canWrite,
  hideLabel,
  endpoint = '/api/craft/admin/propose',
  hideAction = 'hide',
} = Astro.props;
---

<div class="actions" data-id={id} data-file={file} data-endpoint={endpoint} data-hide-action={hideAction}>
  <details class="raw" style="width:100%">
    <summary>Edit the wording</summary>

    <div style="margin-top:12px;display:flex;flex-direction:column;gap:12px;max-width:78ch">
      <label>
        <span class="label">Title</span>
        <input type="text" class="edit-title" value={title} maxlength="300" />
      </label>

      <label>
        <span class="label">Body</span>
        <textarea class="edit-body" rows="4" maxlength="2000">{body}</textarea>
      </label>

      {
        file === 'radar' && (
          <label>
            <span class="label">Implication</span>
            <textarea class="edit-implication" rows="2" maxlength="2000">{implication ?? ''}</textarea>
          </label>
        )
      }

      <p class="faint" style="font-size:12.5px">
        The source URL, the date it was found, and the source grading are not editable here.
        Fixing the prose is editing; changing the citation would be fabrication — rerun the
        agent instead.
      </p>

      <div>
        <button class="btn small primary save-finding" disabled={!canWrite}>
          {endpoint === '/api/craft/admin/propose' ? 'Propose this edit' : 'Save this edit'}
        </button>
      </div>
    </div>
  </details>

  <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;width:100%">
    <button class="btn small hide-finding" disabled={!canWrite}>{hideLabel}</button>
    <p class="status-line" style="margin:0;font-size:12.5px"></p>
  </div>
</div>
