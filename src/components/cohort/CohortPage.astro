{/* Switches which of the two forms above is visible, and runs the arrival
    cue.

    A button pair rather than a <select> or radios, because there are only two
    and each needs room for a description — the same reasoning RouteForm's own
    field choices follow.

    THE CUE. Arriving from any Apply CTA closes both forms, lights BOTH
    buttons, and waits for a choice. It does not open a form by itself: an
    earlier version did that after 900ms, which read as the form simply
    opening on arrival, and picked the individual route on the reader's
    behalf into the bargain. The point is that the team route is seen at all
    — with a form already open, the chooser was something a reader scrolled
    past on the way to the fields. Anyone who scrolls here themselves, with
    no Apply click behind them, gets the individual form open as before; the
    cue is only for people who were sent here by a CTA.

    Three links elsewhere on the site point straight at a branch and must
    skip the cue entirely: #team and #enterprise-form (the contact page, and
    the footer's "Learning for a team") open the team form directly, and
    #apply-form opens the individual one. Somebody who asked for one form
    does not need to be shown that a choice exists. */}
<script>
  (function () {
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-route-choice]'),
    );
    const panels: Record<string, HTMLElement | null> = {
      application: document.getElementById('apply-panel'),
      enterprise: document.getElementById('team'),
    };
    if (buttons.length === 0 || !panels.application || !panels.enterprise) return;

    const select = (branch: string, focus: boolean) => {
      if (!panels[branch]) return;
      buttons.forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.routeChoice === branch)),
      );
      Object.entries(panels).forEach(([key, panel]) => {
        if (panel) panel.hidden = key !== branch;
      });
      if (focus) panels[branch]!.focus();
    };

    const endCue = () => {
      buttons.forEach((b) => b.classList.remove('is-cueing'));
    };

    /**
     * Highlight both choices and WAIT.
     *
     * There is no timer here on purpose. A previous version opened the
     * individual form by itself after 900ms, which read as the form simply
     * opening on arrival — the highlight was over before anybody registered
     * it, and the choice had been made on the reader's behalf anyway. The
     * highlight now holds until somebody picks, which is the whole point of
     * showing them two things.
     */
    const cue = () => {
      // Both panels closed, so the two buttons are the only thing to look at.
      Object.values(panels).forEach((panel) => {
        if (panel) panel.hidden = true;
      });
      // Nothing is selected while the question is open. Leaving the
      // individual button pressed would answer it for them.
      buttons.forEach((b) => {
        b.setAttribute('aria-pressed', 'false');
        // Restart the animation on a second click, which it will not do on
        // its own while the class is already there.
        b.classList.remove('is-cueing');
        void b.offsetWidth;
        b.classList.add('is-cueing');
      });
    };

    buttons.forEach((b) => {
      b.addEventListener('click', () => {
        // The choice answers the cue, so the cue stops being asked.
        endCue();
        select(b.dataset.routeChoice ?? 'application', true);
      });
    });

    const fromHash = () => {
      if (location.hash === '#team' || location.hash === '#enterprise-form') {
        endCue();
        select('enterprise', false);
      } else if (location.hash === '#apply-form') {
        endCue();
        select('application', false);
      } else if (location.hash === '#apply') {
        cue();
      }
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);

    /* A second click on an Apply CTA fires no hashchange, because the hash is
       already #apply — so the cue would run once and never again. This
       catches the click itself, on this page only; the browser still does the
       scrolling. */
    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const link = target?.closest?.('a[href]') as HTMLAnchorElement | null;
      if (!link) return;
      const url = new URL(link.href, location.href);
      const samePage = url.pathname.replace(/\/+$/, '') === location.pathname.replace(/\/+$/, '');
      if (!samePage) return;
      if (url.hash === '#apply') cue();
      // The panel has to be visible BEFORE the browser scrolls to it: a
      // hidden target cannot be scrolled to, and a repeat click fires no
      // hashchange. The hero and the enterprise section both link #team.
      else if (url.hash === '#team' || url.hash === '#enterprise-form') {
        endCue();
        select('enterprise', false);
      } else if (url.hash === '#apply-form') {
        endCue();
        select('application', false);
      }
    });
  })();
</script>

<style>
  /* The page's own pieces. The shared components (hero, cards, lists, modules,
     the stat band, the FAQ, the price card) and the section rhythm are styled
     for this page in src/styles/landing.css, which is where the 19 September
     refinement lives. Section padding used to be set here; it is there now, so
     one file owns the rhythm. */

  /* ── prose ───────────────────────────────────────────────────────────── */
  .two-up {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6) 80px;
    align-items: start;
  }
  /* The shorter paragraph sits level with the END of the lead, as the
     package sets it. On a phone they stack and it starts under the lead. */
  .two-up > .body-copy { align-self: end; }
  .body-copy {
    font-size: 1.125rem;
    line-height: 1.62;
    color: var(--text-body);
    max-width: 64ch;
  }
  .body-copy + .body-copy { margin-top: 20px; }
  .body-copy.quiet { color: var(--text-quiet); }
  .sunil-copy { max-width: var(--measure-prose); }

  /* The pull quote's attribution, directly under the quote. */
  .quote-attrib {
    margin: 0 0 var(--space-5);
    font-family: var(--font-body);
    font-size: var(--size-2);
    color: var(--accent-ink);
  }
  .after-quote { margin-top: var(--space-5); }

  /* ── the boundary diagram: a timeline, not a boxed card ──────────────── */
  .example { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
  .example-body { display: flex; flex-direction: column; }
  .example-body p { font-size: 1.125rem; }

  /* THE TIMELINE. One continuous rail through four knots. Each step draws
     the rail from its own knot down to the next one (::after), so the line
     is unbroken whatever each step's height, and stops at the last knot.
     QA on 19 September: as borders, the rail broke at the boundary step and
     never reached "Acts". */
  /* V4 sets the timeline on an unbleached cloth panel, under the drawing. */
  .boundary {
    list-style: none;
    display: grid;
    gap: 0;
    padding: 28px 28px 30px;
    margin: 16px 0 0;
    border-radius: 4px;
    background: var(--surface-cloth);
  }
  .boundary li { position: relative; padding: 0 0 28px 40px; }
  .boundary li:last-child { padding-bottom: 0; }
  .boundary li::before {
    content: '';
    position: absolute;
    z-index: 1;
    left: 1px;
    top: 7px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--ember);
  }
  .boundary li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 6px;
    top: 12px;
    bottom: -12px;
    width: 1px;
    background: var(--border-field);
  }
  .boundary .b-k {
    font-family: var(--font-body);
    font-size: var(--size-2);
    font-weight: var(--weight-strong);
    letter-spacing: 0.04em;
    color: var(--accent-ink);
  }
  .boundary b {
    display: block;
    margin: 6px 0;
    font-size: 1.375rem;
    line-height: 1.35;
    font-weight: var(--weight-strong);
    color: var(--text-loud);
  }
  .boundary .b-n {
    display: block;
    max-width: 36ch;
    font-size: var(--size-3);
    line-height: 1.6;
    color: var(--text-body);
  }
  /* The one step that is a question, not an action: the moment the
     responsibility changes. Its knot is an open gold ring, and its words sit
     on a soft gold panel beside the rail, so the rail itself stays whole.
     Deep gold on that panel is 5.62:1; ink is 11.4:1. */
  .boundary .b-line { padding-bottom: 28px; }
  .boundary .b-line::before {
    top: 23px;
    background: var(--surface-panel);
    box-shadow: inset 0 0 0 2px var(--ember);
  }
  .boundary .b-line .b-body {
    margin-left: -16px;
    padding: 16px 20px 18px 16px;
    border-radius: var(--radius-control);
    background: var(--accent-quiet);
  }

  /* ── explores list ───────────────────────────────────────────────────── */
  .explores { max-width: 880px; }

  /* ── commitment ──────────────────────────────────────────────────────── */
  .commit { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; margin-bottom: 40px; }
  .commit-copy { display: flex; flex-direction: column; }

  /* ── forms ───────────────────────────────────────────────────────────── */
  /* The chooser and the form share the text's left edge and one 940px width
     (landing.css). They were centred until QA on 19 September, at two
     different widths, under a left-aligned heading. */

  /* The branch chooser. Two buttons, not a <select> — each needs room for a
     one-line description, and a visible pair is one fewer click than a
     dropdown for a decision this page exists to help someone make quickly.
     Outlined, not raised, as the refinement draws them. */
  .route-choice {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    max-width: 940px;
    margin: 0 0 var(--space-6);
  }
  .route-choice-btn {
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--surface-panel);
    border: var(--border-w-hair) solid var(--border-field);
    border-radius: 4px;
    padding: 22px 24px;
    cursor: pointer;
    font: inherit;
    color: inherit;
  }
  .route-choice-btn:hover { border-color: var(--text-loud); }
  .route-choice-btn:focus-visible {
    outline: var(--focus-w) solid var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  /* The selected branch: a heavier forest edge on the soft green. Forest as a
     line, not a fill — a fill is for an action, and this button is not "go",
     it is "chosen". Ink on soft green is 11.89:1. */
  .route-choice-btn[aria-pressed='true'] {
    border: 2px solid var(--sun);
    padding: 21px 23px;
    background: var(--surface-hover);
  }
  .rc-title {
    font-size: 1.125rem;
    font-weight: var(--weight-strong);
    line-height: 1.4;
    color: var(--text-loud);
  }
  .rc-body { font-size: 1rem; color: var(--text-body); line-height: 1.6; }

  .route-panel:focus { outline: none; }

  /* THE ARRIVAL CUE. Landing on #apply from an Apply CTA closes both forms
     and lights both choices, and the highlight HOLDS until somebody picks —
     the class stays on, so these declarations outlast the pulse. The form
     used to be open on arrival, which meant the chooser was the thing a
     reader scrolled past on their way to the fields, and the team route was
     invisible to anyone who did not look up. Border and ink only: --sun is a
     fill for an action, and a button being pointed at has not been chosen —
     which is also why this has to look different from the pressed state
     above, and does, by the shadow. */
  .route-choice-btn.is-cueing {
    border-color: var(--text-loud);
    box-shadow: var(--shadow-lift);
    animation: rc-cue 500ms var(--ease-out) 3;
  }
  @keyframes rc-cue {
    0%,
    100% {
      border-color: var(--text-loud);
    }
    50% {
      border-color: var(--accent-ink);
    }
  }
  /* The cue still happens for somebody who has asked for less motion — it
     just holds the highlight instead of pulsing it. */
  @media (prefers-reduced-motion: reduce) {
    .route-choice-btn.is-cueing { animation: none; }
  }

  .contact-line {
    margin-top: 32px;
    max-width: 75ch;
    font-size: 1rem;
    color: var(--text-body);
  }
  .contact-line a { overflow-wrap: anywhere; }
  .contact-line a { color: var(--accent-ink); text-decoration: underline; text-underline-offset: 0.2em; }

  /* ── narrow ──────────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .two-up,
    .example,
    .commit { gap: 40px; }
  }

  @media (max-width: 760px) {
    .boundary { padding: 24px 20px; }
    .boundary b { font-size: 1.25rem; }
    .two-up,
    .example,
    .commit {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
    .two-up > .body-copy { align-self: start; }
    .commit { margin-bottom: var(--space-5); }
    .route-choice { grid-template-columns: 1fr; gap: var(--space-3); }
    .route-choice-btn { padding: 20px; }
    .route-choice-btn[aria-pressed='true'] { padding: 19px; }
  }
</style>
