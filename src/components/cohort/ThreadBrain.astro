---
/**
 * The thread brain from the October campaign poster (assets/LC-Brain.jpeg),
 * beside "01 Who this is for" on the cohort page. Decoration only.
 *
 * The source is a photograph, not a vector, so it is built in three layers:
 * - a DIM copy of the brain, visible from the start: the thread before it
 *   carries anything;
 * - a LIT copy on top, revealed left to right, the way the thread runs in the
 *   poster. Both are one crop with no poster text and a soft edge baked into
 *   the alpha channel (public/brand/lc-brain-*.webp), so the browser fetches
 *   it once;
 * - an inline SVG of the knots the photo already has. Each one lights as the
 *   front passes it: a short flash of gold light that fades out, and a solid
 *   gold knot that stays while the brain is lit. No script inside the SVG,
 *   no external request.
 *
 * It LOOPS, on Sunil's request (18 September: "like a GIF lighting up", then
 * "make sure it continuously loops"). One cycle is --cycle (5s): the light
 * crosses in 1s and each knot flashes as it is reached, the brain holds lit,
 * then the light goes out left to right and it starts again. Nothing plays
 * until it first scrolls into view, and it pauses while off screen, so it
 * costs nothing while somebody reads the rest of the page. The glow is a
 * deliberate step past the "no glowing brains" line in CLAUDE.md.
 *
 * The default is the FINAL frame. The script arms the start state only when
 * motion is allowed, so a blocked script or prefers-reduced-motion both show
 * the finished picture. Nothing is stored in the browser.
 *
 * Shown from 1100px up only. Below that it is display:none, and the
 * <picture> hands a phone a one-pixel source, so the photo is not downloaded.
 */

// Knot centres in the crop's own pixels (610 × 730), found by colour, not by
// eye. Only the knots inside the solid part of the soft edge are kept: a gold
// dot on a thread that has faded out reads as a stray mark. Ordered left to
// right, which is the way the light travels.
const KNOTS: Array<[number, number]> = [
  [114, 208], [188, 269], [198, 407], [272, 472], [296, 512], [393, 213],
  [412, 394], [443, 142], [498, 336],
];
const WIDTH = 610;

const PIXEL = 'data:image/gif;base64,R0lGODlhAQABAAAAACw=';
const SRC = '/brand/lc-brain-240.webp';
const SRCSET = '/brand/lc-brain-240.webp 240w, /brand/lc-brain-480.webp 480w';
---

<figure class="thread-brain" aria-hidden="true" data-thread-brain>
  {['dim', 'lit'].map((layer) => (
    <picture class={layer}>
      {/* Below 1100px the figure is hidden, and a hidden lazy image is still
          fetched. This one-pixel source means a phone downloads nothing. */}
      <source media="(max-width: 1099px)" srcset={PIXEL} />
      <img src={SRC} srcset={SRCSET} sizes="240px" width="240" height="287" alt="" loading="lazy" decoding="async" />
    </picture>
  ))}
  <svg viewBox="0 0 610 730" focusable="false">
    <defs>
      <radialGradient id="thread-brain-light">
        <stop offset="0" style="stop-color: var(--lc-gold); stop-opacity: 0.9" />
        <stop offset="1" style="stop-color: var(--lc-gold); stop-opacity: 0" />
      </radialGradient>
    </defs>
    {KNOTS.map(([cx, cy]) => (
      // The delay follows the light front: a knot lights when the reveal
      // reaches its x position.
      <g style={`--at:${(cx / WIDTH).toFixed(3)}`}>
        <circle class="flash" cx={cx} cy={cy} r="34" fill="url(#thread-brain-light)" />
        <circle class="knot" cx={cx} cy={cy} r="9" />
      </g>
    ))}
  </svg>
</figure>

<script>
  // Arm, start on first sight, then pause whenever it is off screen.
  // Armed = the start frame; without this script the figure simply shows
  // its final frame.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  for (const fig of document.querySelectorAll<HTMLElement>('[data-thread-brain]')) {
    if (reduce.matches || !('IntersectionObserver' in window)) continue;
    fig.dataset.armed = '';
    const io = new IntersectionObserver((entries) => {
      const seen = entries.some((e) => e.isIntersecting);
      if (seen) fig.dataset.play = '';
      fig.toggleAttribute('data-paused', !seen);
    }, { threshold: 0.4 });
    io.observe(fig);
  }
</script>

<style>
  .thread-brain {
    /* One loop. The light crosses in the first fifth (1s at 5s). */
    --cycle: 5s;
    display: none;
    position: absolute;
    top: var(--space-6);
    right: var(--space-7);
    width: 240px;
    margin: 0;
    pointer-events: none;
  }
  @media (min-width: 1100px) {
    .thread-brain { display: block; }
  }
  .thread-brain picture { display: block; }
  .thread-brain .lit { position: absolute; inset: 0; }
  .thread-brain img {
    display: block;
    width: 100%;
    height: auto;
    /* Drops the poster's cream paper into the page's ivory. */
    mix-blend-mode: multiply;
  }
  /* Unlit thread: pale and nearly colourless. Hidden in the final frame,
     because the lit copy covers it exactly. */
  .thread-brain .dim img { filter: grayscale(0.85) opacity(0.45); }
  /* Lit thread: a little warmer and deeper than the photo. */
  .thread-brain .lit img { filter: saturate(1.3) contrast(1.08); }

  .thread-brain svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .thread-brain .knot {
    fill: var(--lc-gold);
    stroke: var(--lc-forest);
    stroke-width: 1.5;
    stroke-opacity: 0.35;
    transform-box: fill-box;
    transform-origin: center;
  }
  .thread-brain .flash {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Start frame: dim thread, no light, no knots. */
  .thread-brain[data-armed] .lit {
    -webkit-mask-image: linear-gradient(90deg, #000 40%, transparent 60%);
    mask-image: linear-gradient(90deg, #000 40%, transparent 60%);
    -webkit-mask-size: 250% 100%;
    mask-size: 250% 100%;
    -webkit-mask-position: 100% 0;
    mask-position: 100% 0;
  }
  .thread-brain[data-armed] .knot { opacity: 0; transform: scale(0.3); }

  /* Play, forever. A knot at x = --at of the width is offset by
     --at × 1s, so it lights when the front reaches it and goes out in the
     same left-to-right order. An infinite animation keeps that offset on
     every cycle. */
  .thread-brain[data-play] .lit { animation: thread-brain-sweep var(--cycle) linear infinite both; }
  .thread-brain[data-play] .knot {
    animation: thread-brain-knot var(--cycle) var(--ease-out) infinite both;
    animation-delay: calc(var(--at) * 1s);
  }
  .thread-brain[data-play] .flash {
    animation: thread-brain-flash var(--cycle) ease-out infinite both;
    animation-delay: calc(var(--at) * 1s);
  }
  .thread-brain[data-paused] :is(.lit, .knot, .flash) { animation-play-state: paused; }

  /* 0-20% the light crosses, 20-72% it holds, 72-88% it fades out. The
     jump back to the masked start happens while it is invisible. */
  @keyframes thread-brain-sweep {
    0%   { -webkit-mask-position: 100% 0; mask-position: 100% 0; opacity: 1; }
    20%  { -webkit-mask-position: 0 0;    mask-position: 0 0;    opacity: 1; }
    72%  { -webkit-mask-position: 0 0;    mask-position: 0 0;    opacity: 1; }
    88%  { -webkit-mask-position: 0 0;    mask-position: 0 0;    opacity: 0; }
    100% { -webkit-mask-position: 0 0;    mask-position: 0 0;    opacity: 0; }
  }
  @keyframes thread-brain-knot {
    0%   { opacity: 0; transform: scale(0.3); }
    4%   { opacity: 1; transform: scale(1.5); }
    10%  { opacity: 1; transform: scale(1); }
    74%  { opacity: 1; transform: scale(1); }
    88%  { opacity: 0; transform: scale(0.6); }
    100% { opacity: 0; transform: scale(0.3); }
  }
  @keyframes thread-brain-flash {
    0%   { opacity: 0; transform: scale(0.4); }
    4%   { opacity: 1; transform: scale(1); }
    12%  { opacity: 0; transform: scale(1.3); }
    100% { opacity: 0; transform: scale(1.3); }
  }

  @media (prefers-reduced-motion: reduce) {
    .thread-brain .lit { -webkit-mask-image: none; mask-image: none; }
    .thread-brain .knot { opacity: 1; transform: none; animation: none; }
    .thread-brain .flash { opacity: 0; animation: none; }
  }
</style>
