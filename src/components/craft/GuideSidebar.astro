---
// Guide Sidebar Component
---

<div class="guide-container">
  <div class="gs-header">
    <div class="gs-agent-icon">
      <span class="l-icon">L</span>
    </div>
    <div class="gs-title">
      <h3>Guide</h3>
      <span class="mono subtitle">Ein - cohort 1 - week 1 of 6</span>
    </div>
  </div>
  
  <div class="gs-chat">
    <!-- Chat messages will appear here -->
  </div>
  
  <div class="gs-footer">
    <div class="chips-container" id="demo-chips">
      <!-- Chips will be inserted here by JS -->
    </div>
    
    <div class="gs-input">
      <input type="text" placeholder="Or type your own question" id="demo-input" />
      <button class="clear-btn" id="demo-clear" title="Clear chat">Clear</button>
      <button class="send-btn" id="demo-send">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
      </button>
    </div>
  </div>
</div>

<script>
  // Simple fake chat interaction for the PoC Demo
  document.addEventListener('astro:page-load', () => {
    const input = document.getElementById('demo-input') as HTMLInputElement;
    const btn = document.getElementById('demo-send');
    const clearBtn = document.getElementById('demo-clear');
    const chat = document.querySelector('.gs-chat');
    const chipsContainer = document.getElementById('demo-chips');
    
    if (!input || !btn || !chat || !chipsContainer) return;

    // Initial chips
    const initialChips = [
      "What's due this week?",
      "Explain the worker-loop",
      "I disagree with the D5 finding",
      "Ask Sunil"
    ];

    function renderChips(chipTexts: string[]) {
      chipsContainer.innerHTML = '';
      chipTexts.forEach(text => {
        const btn = document.createElement('button');
        btn.className = 'action-chip';
        btn.textContent = text;
        btn.addEventListener('click', () => {
          input.value = text;
          sendMessage();
        });
        chipsContainer.appendChild(btn);
      });
    }

    renderChips(initialChips);

    function sendMessage() {
      if (!input.value.trim()) return;
      
      const prompt = input.value;
      
      // Add User Message
      const userMsg = document.createElement('div');
      userMsg.className = 'chat-msg user';
      userMsg.innerHTML = `<div class="msg-bubble">${prompt}</div>`;
      chat.appendChild(userMsg);
      
      input.value = '';
      chat.scrollTop = chat.scrollHeight;

      // Fake Assistant Response
      setTimeout(() => {
        const astMsg = document.createElement('div');
        astMsg.className = 'chat-msg assistant';
        
        let reply = "That's an interesting approach. However, have you considered how this handles edge cases when the payload is malformed?";
        
        if (prompt.toLowerCase().includes('due')) {
          reply = "You need to respond to the new DLQ finding on PR #14 and complete the Week 4 material before Saturday.";
          // Dynamically update chips!
          renderChips([
            "Ask Sunil about PR #14",
            "Show me the Week 4 material",
            "Explain the worker-loop"
          ]);
        }
        else if (prompt.toLowerCase().includes('sunil') || prompt.toLowerCase().includes('pr #14')) {
          reply = "I've drafted a message to Sunil with the context of your PR #14 and the DLQ finding. Should I send it?";
          renderChips(["Yes, send it", "No, let me edit it", "Cancel"]);
        }
        else if (prompt.toLowerCase().includes('d5') || prompt.toLowerCase().includes('disagree')) {
          reply = "This is a judgement call about production operations. The best way to resolve this is to discuss it with Sunil. I've drafted a message with your context. Should I send it?";
          renderChips(["Yes, send it", "No, cancel"]);
        }
        else if (prompt.toLowerCase().includes('worker-loop')) {
          reply = "The worker-loop is a durable execution primitive. It pulls from a queue, processes the message, and then explicitly acknowledges it, preventing messages from being lost if the worker dies.";
        }

        astMsg.innerHTML = `
          <div class="assistant-avatar"><span class="l-icon">L</span></div>
          <div class="msg-bubble">${reply}</div>
        `;
        chat.appendChild(astMsg);
        chat.scrollTop = chat.scrollHeight;
      }, 800);
    }

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') sendMessage();
    });
    btn.addEventListener('click', sendMessage);
    
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        chat.innerHTML = '';
        renderChips(initialChips); // Reset chips on clear
      });
    }
  });
</script>

<style is:global>
  .guide-container {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
    background: var(--surface);
  }
  
  .gs-header {
    padding: 24px;
    border-bottom: 1px solid var(--line-hair);
    display: flex;
    align-items: center;
    gap: 16px;
  }
  
  .gs-agent-icon {
    width: 32px;
    height: 32px;
    background: var(--noir);
    color: var(--paper-1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  
  .l-icon {
    font-family: var(--font-display);
    font-weight: var(--weight-heavy);
    font-size: 14px;
  }
  
  .gs-title {
    display: flex;
    flex-direction: column;
  }
  
  .gs-title h3 {
    font-size: 16px;
    font-weight: var(--weight-strong);
    color: var(--ink);
    line-height: 1.2;
  }
  
  .subtitle {
    font-size: 10px;
    color: var(--ink-faint);
    letter-spacing: var(--tracking-label);
    text-transform: none;
    margin-top: 2px;
  }
  
  .gs-chat {
    flex: 1;
    padding: 24px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  
  .chat-msg {
    display: flex;
    width: 100%;
    gap: 12px;
  }
  .chat-msg.assistant {
    justify-content: flex-start;
  }
  .chat-msg.user {
    justify-content: flex-end;
  }
  
  .assistant-avatar {
    width: 24px;
    height: 24px;
    background: var(--sun);
    color: var(--ink);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 4px;
  }
  .assistant-avatar .l-icon {
    font-size: 11px;
  }
  
  .msg-bubble {
    max-width: 85%;
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink);
  }
  .chat-msg.user .msg-bubble {
    background: var(--surface-invert);
    color: var(--text-on-invert);
    padding: 12px 16px;
    border-radius: var(--radius-inner);
    border-bottom-right-radius: 4px;
  }
  
  .gs-footer {
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  
  .chips-container {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  
  .action-chip {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 6px 14px;
    font-size: 11px;
    color: var(--ink-soft);
    cursor: pointer;
    font-family: inherit;
  }
  .action-chip:hover {
    border-color: var(--ink-faint);
    color: var(--ink);
  }
  
  .gs-input {
    display: flex;
    gap: 12px;
    position: relative;
  }
  
  .gs-input input {
    flex: 1;
    padding: 0 16px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-size: 13px;
    font-family: inherit;
    background: #fff;
    padding-right: 96px; /* space for text button and send button */
  }
  
  .clear-btn {
    position: absolute;
    right: 44px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    color: var(--ink-soft);
    border: none;
    border-radius: var(--radius-pill);
    font-size: 11px;
    font-weight: var(--weight-medium);
    padding: 6px 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }
  .clear-btn:hover {
    color: var(--ink);
    background: var(--surface-hover);
  }
  
  .send-btn {
    position: absolute;
    right: 4px;
    top: 4px;
    width: 36px;
    height: 36px;
    background: var(--sun);
    color: var(--ink);
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: not-allowed;
    opacity: 0.7;
  }
</style>
