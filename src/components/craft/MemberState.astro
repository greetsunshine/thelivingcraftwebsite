---
import { mockMemberState } from '../../data/mock-dashboard';
---

<div class="state-container">
  <div class="state-header">
    <h2 class="section-title">Your Current Standing</h2>
    <details class="legend">
      <summary class="legend-toggle mono">How to read this ↓</summary>
      <div class="legend-body">
        <div class="legend-section">
          <span class="legend-label">Levels (0–4)</span>
          <span class="legend-desc">Mastery tier, set by code from aggregated PR evidence. Level 4 requires ≥2 distinct evidence sources across ≥2 weeks.</span>
        </div>
        <div class="legend-section">
          <span class="legend-label">Raw Score</span>
          <span class="legend-desc">Accumulated signal from PR findings. Each PR contributes at most ±2 per dimension. Positive = evidence of strength; negative = evidence of gaps.</span>
        </div>
        <div class="legend-section">
          <span class="legend-label">Trends</span>
          <div class="legend-trends">
            <span><span class="trend up">↗</span> Improving — recent PRs adding positive signal</span>
            <span><span class="trend flat">→</span> Flat — no significant recent evidence</span>
            <span><span class="trend down">↘</span> Declining — recent PRs adding negative signal</span>
          </div>
        </div>
        <div class="legend-section">
          <span class="legend-label">Dimensions</span>
          <div class="legend-dims">
            <span class="mono">D1</span><span>Architecture &amp; Design</span>
            <span class="mono">D2</span><span>Context Management</span>
            <span class="mono">D3</span><span>Evaluation &amp; Metrics</span>
            <span class="mono">D4</span><span>Security &amp; Containment</span>
            <span class="mono">D5</span><span>Production Operations</span>
          </div>
        </div>
      </div>
    </details>
  </div>
  <div class="dimensions-grid">
    {mockMemberState.map(dim => (
      <div class="dimension-card">
        <div class="dim-header">
          <span class="dim-id mono">{dim.dimension}</span>
          <span class="dim-level">Level {dim.level}</span>
        </div>
        <div class="dim-title">{dim.title}</div>
        
        <div class="dim-track">
          {[1, 2, 3, 4].map(level => (
            <div class={`level-indicator ${level <= dim.level ? 'achieved' : ''}`}></div>
          ))}
        </div>
        
        <div class="dim-footer">
          <span class="score-val">Raw Score: {dim.score.toFixed(1)}</span>
          {dim.trend === 'up' && <span class="trend up">↗</span>}
          {dim.trend === 'down' && <span class="trend down">↘</span>}
          {dim.trend === 'flat' && <span class="trend flat">→</span>}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .state-container {
    margin-bottom: 48px;
  }
  .state-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 20px;
    position: relative;
  }
  .section-title {
    font-size: 24px;
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-strong);
  }
  
  /* Legend Styles */
  .legend {
    position: relative;
  }
  .legend-toggle {
    font-size: 11px;
    color: var(--ink-faint);
    cursor: pointer;
    letter-spacing: var(--tracking-label);
    list-style: none;
    user-select: none;
  }
  .legend-toggle::-webkit-details-marker {
    display: none;
  }
  .legend-toggle:hover {
    color: var(--clay);
  }
  .legend-body {
    position: absolute;
    top: 100%;
    right: 0;
    width: 320px;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-inner);
    padding: 20px;
    margin-top: 8px;
    box-shadow: var(--shadow-raise);
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .legend-section {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .legend-label {
    font-family: var(--font-display);
    font-weight: var(--weight-strong);
    font-size: 13px;
  }
  .legend-desc {
    font-size: 13px;
    color: var(--ink-soft);
    line-height: 1.4;
  }
  .legend-trends {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
    color: var(--ink-soft);
  }
  .legend-trends .trend {
    display: inline-block;
    width: 16px;
  }
  .legend-dims {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 4px 8px;
    font-size: 12px;
    color: var(--ink-soft);
  }
  .legend-dims .mono {
    color: var(--clay);
  }

  .dimensions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }
  .dimension-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-inner);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .dim-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .dim-id {
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: var(--tracking-label);
  }
  .dim-level {
    font-size: 12px;
    font-weight: var(--weight-strong);
    color: var(--ink);
  }
  .dim-title {
    font-size: 14px;
    font-weight: var(--weight-medium);
    line-height: 1.3;
    height: 2.6em; /* fixed height for 2 lines */
  }
  .dim-track {
    display: flex;
    gap: 4px;
    margin-top: auto;
  }
  .level-indicator {
    flex: 1;
    height: 4px;
    background: var(--line-hair);
    border-radius: 2px;
  }
  .level-indicator.achieved {
    background: var(--sun);
  }
  .dim-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    color: var(--ink-soft);
    margin-top: 4px;
  }
  .trend {
    font-weight: bold;
  }
  .trend.up { color: var(--sun); }
  .trend.down { color: var(--danger); }
  .trend.flat { color: var(--ink-faint); }
</style>
