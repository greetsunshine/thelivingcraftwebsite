---
import { mockPrReviews } from '../../data/mock-dashboard';

// Renders PR reviews with a simplified provenance drawer via a native <details> element
---

<div class="reviews-container">
  <h2 class="section-title">Recent Code Reviews</h2>
  
  <div class="reviews-list">
    {mockPrReviews.map(pr => (
      <div class="pr-card">
        <div class="pr-header">
          <div class="pr-meta">
            <span class="mono date">{pr.date}</span>
            <a href={pr.url} target="_blank" rel="noopener noreferrer" class="pr-link">
              {pr.id} ↗
            </a>
          </div>
          <div class="pr-status">
            <span class="mono badge">{pr.status}</span>
          </div>
        </div>
        
        <div class="findings-list">
          {pr.findings.map(finding => (
            <details class="finding-drawer">
              <summary class="finding-summary">
                <div class="finding-badges">
                  <span class={`mono badge dim`}>{finding.dimension}</span>
                  <span class={`mono badge sev ${finding.severity}`}>{finding.severity}</span>
                </div>
                <div class="finding-text">{finding.question}</div>
              </summary>
              <div class="finding-details">
                <p class="rationale">{finding.rationale}</p>
                <div class="evidence-box">
                  <div class="evidence-header mono">
                    {finding.evidence.path} (L{finding.evidence.line_start}-{finding.evidence.line_end})
                  </div>
                  <pre><code>{finding.evidence.quote}</code></pre>
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .reviews-container {
    margin-bottom: 48px;
  }
  .section-title {
    font-size: 24px;
    margin-bottom: 20px;
    font-family: var(--font-display);
    font-weight: var(--weight-strong);
  }
  .reviews-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .pr-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-inner);
    padding: 24px;
  }
  .pr-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line-hair);
  }
  .pr-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .date {
    font-size: 12px;
    color: var(--ink-faint);
  }
  .pr-link {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink);
    text-decoration: none;
  }
  .pr-link:hover {
    color: var(--clay);
  }
  .badge {
    font-size: 11px;
    padding: 4px 8px;
    border-radius: var(--radius-pill);
    letter-spacing: var(--tracking-label);
  }
  .pr-status .badge {
    background: var(--paper-2);
    color: var(--ink-soft);
  }
  .findings-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  
  .finding-drawer {
    border: 1px solid var(--line-hair);
    border-radius: 8px;
    background: #fff;
  }
  .finding-summary {
    padding: 16px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 8px;
    list-style: none; /* remove default arrow */
  }
  .finding-summary::-webkit-details-marker {
    display: none;
  }
  .finding-badges {
    display: flex;
    gap: 8px;
  }
  .finding-badges .dim {
    background: var(--agent-human-bg);
    color: var(--ink-soft);
  }
  .finding-badges .sev {
    background: var(--paper-2);
    color: var(--ink-soft);
  }
  .finding-badges .sev.concern {
    background: var(--agent-refused-bg);
    color: var(--danger);
  }
  .finding-text {
    font-size: 15px;
    font-weight: var(--weight-medium);
  }
  
  .finding-details {
    padding: 0 16px 16px 16px;
    border-top: 1px dashed var(--line-hair);
    margin-top: 8px;
    padding-top: 16px;
  }
  .rationale {
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.5;
    margin-bottom: 16px;
  }
  .evidence-box {
    background: var(--surface-invert);
    border-radius: 6px;
    overflow: hidden;
  }
  .evidence-header {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-on-invert);
    font-size: 11px;
    padding: 8px 12px;
  }
  .evidence-box pre {
    margin: 0;
    padding: 12px;
    font-size: 12px;
    color: var(--text-on-invert);
    font-family: var(--font-mono);
    overflow-x: auto;
  }
</style>
