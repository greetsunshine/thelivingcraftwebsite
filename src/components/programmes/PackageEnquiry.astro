---
/**
 * One enquiry section from the 15 October 2026 package: its heading and intro
 * on the left, the form on the right. The fields, their words, their order,
 * the tick and the button's words are the package's, passed straight through
 * to RouteForm.
 *
 * It does both things (the user's choice, 15 October): the enquiry is saved in
 * the pipeline first, so it reaches the console even if no email is sent, and
 * then the package's email draft opens to apply@ with the same answers, with
 * its copy box as the fallback (RouteForm's `draft`). That keeps the package's
 * "This opens an email draft…" sentence true.
 *
 * "Current role" and the list are required, as in the package. The
 * enquiry route has them optional (the cohort page uses it too), so that is
 * checked in the browser only (RouteForm's `require`).
 *
 * The tick, "I agree to be contacted about this enquiry", is required, as in
 * the package. It only gates the browser's submit and is not stored: it is
 * not the marketing permission, which these pages do not ask for.
 */
import RouteForm from '../cohort/RouteForm.astro';
import type { Route } from '../../lib/pipeline/forms';
import { CONTACT_EMAIL } from '../../data/site';

export interface Props {
  id: string;
  heading: string;
  intro: string;
  route?: Route;
  /** The button's words, without the arrow. */
  action: string;
  labels: Record<string, string>;
  order: string[];
  choices?: Record<string, string[]>;
  preset?: Record<string, string>;
  fixed?: Record<string, string>;
  include?: string[];
  omit?: string[];
  /** One box sent under two names: see RouteForm's `mirror`. */
  mirror?: Record<string, string>;
}

const { id, heading, intro, route = 'enquiry', action, labels, order, choices, preset, fixed, include, omit, mirror } =
  Astro.props;
---

<section class="section enquiry" id={id}>
  <div class="enquiry-intro">
    <h2>{heading}</h2>
    <p>{intro}</p>
    <p class="email-notice">This opens an email draft. Review and send it in your email app to complete your enquiry.</p>
  </div>
  <RouteForm
    route={route}
    id={`${id}-form`}
    head={false}
    consent={false}
    hints={false}
    flat
    action={action}
    labels={labels}
    order={order}
    choices={choices}
    preset={preset}
    fixed={fixed}
    include={include}
    omit={omit}
    mirror={mirror}
    asText={['role']}
    prompt="Choose an option"
    rows={3}
    require={['role', 'interest']}
    agree="I agree to be contacted about this enquiry."
    privacy={{
      summary: 'Your enquiry and contact details',
      text: 'Your details are saved so the team can reply, and used to prepare this enquiry in your email app. Sending an enquiry does not subscribe you to marketing.',
    }}
    draft={{ to: CONTACT_EMAIL, prefix: 'The Living Craft programme enquiry' }}
  />
</section>
