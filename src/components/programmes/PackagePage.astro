---
/**
 * The shell for the nine /programmes/ pages built from the 15 October 2026
 * landing-page package (staging branch feat/programme-pathways; must not
 * merge).
 *
 * The header and the footer are the package's own (PackageHeader.astro,
 * PackageFooter.astro), at the user's request on 15 October; that departs from
 * CLAUDE.md's one-lockup rule and is staging only. Inside <main>, the page is the
 * package's markup under #pkg, styled by the package's own stylesheet
 * (templates/programme-package.css), which is imported nowhere else.
 *
 * The structured data is the package's: one WebPage node with its breadcrumb,
 * in Indian English, about The Living Craft.
 */
import '../../styles/templates/programme-package.css';
import PracticeLayout from '../../layouts/PracticeLayout.astro';
import PackageHeader from './PackageHeader.astro';
import PackageFooter from './PackageFooter.astro';
import { SITE_ORIGIN } from '../../data/facts';

export interface Props {
  title: string;
  description: string;
  /** The page's path, with its trailing slash. */
  path: string;
  /** The package's breadcrumb names, in order. */
  breadcrumb: string[];
  /** The id of the page's enquiry section, for the header's button. */
  enquire: string;
  /**
   * The header button's words. The package uses Enquire on the hub and the
   * two pathway pages, and the page's own call to action on an offer page.
   */
  cta?: string;
}

const { title, description, path, breadcrumb, enquire, cta = 'Enquire' } = Astro.props;

/** The header link marked current: the hub, or the pathway the page sits in. */
const current = path.startsWith('/programmes/agentic-systems/')
  ? 'agentic-systems'
  : path.startsWith('/programmes/career-preparation/')
    ? 'career-preparation'
    : 'hub';

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE_ORIGIN}${path}#webpage`,
    url: `${SITE_ORIGIN}${path}`,
    name: title,
    description,
    inLanguage: 'en-IN',
    about: { '@type': 'EducationalOrganization', name: 'The Living Craft' },
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumb.map((name, i) => ({ '@type': 'ListItem', position: i + 1, name })),
    },
  },
];
---

<PracticeLayout
  title={title}
  description={description}
  canonical={path}
  schema={schema}
  stickyApply={false}
  reading={false}
>
  <PackageHeader slot="header" current={current} cta={cta} ctaHref={`#${enquire}`} />
  <div id="pkg" class="pkg">
    <slot />
  </div>
  <PackageFooter slot="footer" current={current} />
</PracticeLayout>
