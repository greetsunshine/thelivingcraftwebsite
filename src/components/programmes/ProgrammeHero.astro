---
/**
 * The opening of a /programmes/ hub, pathway or offer page: breadcrumbs, the
 * V5 ivory hero, and the package's illustration or Sunil's portrait beside the
 * words on a wide screen (under them on a phone).
 *
 * Breadcrumbs render only when the page passes them, and a page that passes
 * them also emits the matching BreadcrumbList. Structured data may describe a
 * trail only when the visible content shows one (see enterprise.astro).
 */
import type { Img } from '../../data/programme-offers';

export interface Props {
  crumbs?: { label: string; href?: string }[];
  eyebrow: string;
  /** Each entry is one line of the heading. */
  title: string[];
  lede: string;
  cta: { label: string; href: string };
  image?: Img;
  portrait?: Img;
}

const { crumbs, eyebrow, title, lede, cta, image, portrait } = Astro.props;
const art = image ?? portrait;
---

{
  crumbs && (
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        {crumbs.map((c, i) => (
          <>
            {i > 0 && (
              <span class="sep" aria-hidden="true">
                /
              </span>
            )}
            {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
          </>
        ))}
      </nav>
    </div>
  )
}

<section class="hero">
  <div class:list={['wrap', 'pg-hero', art && 'has-art', portrait && !image && 'is-portrait']}>
    <div class="pg-hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title.map((line) => <span class="pg-line">{line}</span>)}</h1>
      <p class="credential">{lede}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={cta.href}>
          {cta.label}&nbsp;<span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    {
      art && (
        <figure class="pg-hero-art">
          <img
            src={art.src}
            alt={art.alt}
            width={art.width}
            height={art.height}
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )
    }
  </div>
</section>
