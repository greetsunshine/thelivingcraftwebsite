---
/**
 * The "Book now" secondary CTA.
 *
 * WHAT IT OPENS
 *
 * The cohort page's own booking section (`#book`), which renders the site's
 * BookingWidget against the `cohort-call` meeting type — the same three-step
 * day / time / details widget `/caio` and `/assessment` already use, reading
 * real availability from `booking_rules` in our own database. Sunil asked for
 * that on 16 September, with a screenshot of the discovery-call widget: "the
 * book now should look this image".
 *
 * IT IS A LINK, NOT A POPUP, AND IT HAS NO CONFIGURATION GATE.
 *
 * The Google Calendar control this replaced could not render until somebody
 * supplied an appointment URL, so "Book now" was invisible everywhere while
 * that stayed blank. This points at a section of our own site, so it always
 * works and can never be a dead control. GoogleCalendarBooking.astro and
 * lib/booking.ts are left in the repo, unimported — the scheduling scaffold
 * RESUME.md lists as owed is a separate promise from this button.
 *
 * WHAT IT IS NOT. Booking a call is not applying and must never be presented
 * as it: Apply stays the primary CTA everywhere this appears, and the meeting
 * type's own blurb says the call is not an application.
 */
export interface Props {
  /**
   * Named only so the traffic beacon can tell the placements apart.
   * Track.astro reports any `a[href]` it does not recognise as a plain link,
   * and `data-book-now-placement` is what a later report would group by.
   */
  placement: 'hero' | 'closing' | 'nav' | 'sticky' | 'contact';
  /** Same-document on the cohort page; cross-document everywhere else. */
  onCohortPage?: boolean;
  /** `textlink` is for a link inside running prose, not a button row. */
  variant?: 'button' | 'textlink';
}

const { placement, onCohortPage = false, variant = 'button' } = Astro.props;

const href = `${onCohortPage ? '' : '/'}#book`;
---

<a
  class={variant === 'button' ? 'btn btn-ghost' : 'textlink'}
  href={href}
  data-book-now
  data-book-now-placement={placement}
>
  Book now
</a>
