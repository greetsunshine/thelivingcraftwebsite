---
/**
 * The one footer, on every public page.
 *
 * SOURCE. The footer review of 29 September 2026: "one shared footer on every
 * page. Same labels, order and destinations." Before this, seven layouts drew
 * seven footers. The home page listed Resources twice and two team-learning
 * routes under two labels, and the resource pages listed the page's own
 * sections. A reader met a different footer on every page.
 *
 * THREE QUESTIONS, THREE COLUMNS. The review names what a reader asks at the
 * foot of a page: how can I learn with Sunil, can I explore his approach
 * first, and how do I ask a question. Learning, Explore, About & contact.
 * "Cohort" opens the programme overview; "Apply" goes straight to the form.
 * Those are two different needs, so they are two links.
 *
 * NOT HERE, ON PURPOSE. The CAIO and assessment pages are reached from the
 * advisory journey and do not sit beside the cohort. No sales banner, booking
 * widget or newsletter form: the page above already carries its own action.
 * The programme summary and the two route links of the 29 September outreach
 * handoff (FooterSummary.astro) are gone; the review replaced the paragraph
 * with one sentence, and the two routes live in the Learning column.
 *
 * THE MARK WITHOUT THE TILE. The review asks for "no white rectangle around
 * the logo". The lockup's lettering is dark ink and vanishes on forest, and
 * recolouring the artwork is forbidden. So the footer shows the mark alone,
 * on the small cream paper the artwork already carries, with the name set in
 * ivory type beside it. The header of every page still draws the full lockup.
 *
 * SOLID GREEN. The band is flat dark forest since the plain-green change of
 * 25 September (theme.css restates --footer-bg on <body>). Nothing here
 * reintroduces a texture.
 *
 * Layout and colour come from ds/site-v5.css (`footer.site`). The slot
 * `controls` takes `/`'s "Pause motion" button and nothing else.
 */
import Logo from './Logo.astro';

const year = new Date().getFullYear();

interface Item {
  href: string;
  label: string;
  /** Opens in a new tab: only the one link that leaves the site. */
  external?: boolean;
  /** The first-party CTA attributes, for the one link that is an application. */
  cta?: boolean;
}

interface Column {
  heading: string;
  items: Item[];
}

const COLUMNS: Column[] = [
  {
    heading: 'Learning',
    items: [
      { href: '/programmes/', label: 'Agentic systems cohort' },
      { href: '/#apply', label: 'Apply for the cohort', cta: true },
      { href: '/programmes/enterprise/', label: 'Learning for teams' },
    ],
  },
  {
    heading: 'Explore',
    items: [
      { href: '/resources/', label: 'Resources' },
      { href: '/tools/', label: 'Try the tools' },
      { href: '/latest', label: 'Field notes' },
    ],
  },
  {
    heading: 'About & contact',
    items: [
      { href: '/about/', label: 'About Sunil' },
      { href: '/advisory/', label: 'Advisory' },
      { href: 'mailto:apply@thelivingcraft.ai', label: 'apply@thelivingcraft.ai' },
      { href: 'https://linkedin.com/in/sunil-mathew-466615a', label: 'Sunil on LinkedIn', external: true },
    ],
  },
];
---

<footer class="site">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="foot-mark" href="/" aria-label="The Living Craft, home">
          <Logo />
          <span class="foot-name" aria-hidden="true">The Living Craft</span>
        </a>
        <p class="foot-line">Practical learning in agentic systems and architecture.</p>
      </div>

      {
        COLUMNS.map((c) => (
          <div class="foot-col">
            <h2>{c.heading}</h2>
            {c.items.map((i) => (
              <a
                href={i.href}
                target={i.external ? '_blank' : undefined}
                rel={i.external ? 'noopener' : undefined}
                data-cta={i.cta ? 'form' : undefined}
                data-cta-placement={i.cta ? 'footer' : undefined}
              >
                {i.label}
              </a>
            ))}
          </div>
        ))
      }
    </div>

    <div class="foot-bottom">
      <span class="foot-legal">
        <span>© {year} The Living Craft</span>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/communication-preferences">Email preferences</a>
      </span>
      <slot name="controls" />
    </div>
  </div>
</footer>
