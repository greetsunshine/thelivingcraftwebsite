---
// Shell for every admin page.
//
// Deliberately NOT built on SeoHead or BaseLayout. Those two exist to make the
// public surfaces discoverable — canonical URLs, an OG card, a JSON-LD @graph
// naming the practice. Every one of those is wrong here, and the JSON-LD in
// particular would be actively bad: a structured-data block describing the
// cohort, emitted from a page listing leads.
//
// So this head is the opposite: noindex, no canonical, no schema, no analytics
// beacon. Access control lives in src/middleware.ts; this file only has to
// avoid undoing it.

import '../styles/admin.css';
import { capabilities } from '../lib/admin/env';
import { dbHealth, looksUnmigrated } from '../lib/admin/health';

export interface Props {
  title: string;
  /**
   * Which nav item is current. Derived from NAV, so adding a console page means
   * one edit (the nav entry) rather than two that can drift apart.
   */
  active?: (typeof NAV)[number]['key'];
}

const { title, active } = Astro.props;
const caps = capabilities();

// Checked on every admin page, cached for a minute, because a broken table has
// to be visible from wherever you happen to be standing. Reading /admin/radar
// and seeing "never run" is exactly the moment you need to be told that the
// table behind it does not exist.
const health = caps.data ? await dbHealth() : null;
const unmigrated = health ? looksUnmigrated(health) : false;

const NAV = [
  { key: 'overview', href: '/admin', label: 'Overview' },
  { key: 'traffic', href: '/admin/traffic', label: 'Traffic' },
  { key: 'leads', href: '/admin/leads', label: 'Leads' },
  { key: 'questions', href: '/admin/questions', label: 'Questions' },
  { key: 'radar', href: '/admin/radar', label: 'Radar' },
  { key: 'content', href: '/admin/content', label: 'Content' },
  { key: 'learners', href: '/admin/learners', label: 'Learners' },
  { key: 'intake', href: '/admin/intake', label: 'Intake' },
  { key: 'doubts', href: '/admin/doubts', label: 'Doubts' },
  { key: 'adrs', href: '/admin/adrs', label: 'ADRs' },
  { key: 'quiz', href: '/admin/quiz', label: 'Quiz' },
  { key: 'quiz-adr', href: '/admin/quiz-adr-comparison', label: 'Quiz vs ADR' },
  { key: 'feedback', href: '/admin/feedback', label: 'Feedback' },
  { key: 'familiarity', href: '/admin/familiarity', label: 'Familiarity' },
] as const;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Console</title>
    <!-- Belt and braces: middleware sets X-Robots-Tag on the response, this
         covers a crawler that somehow renders the page without seeing it. -->
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="admin-nav">
      <div class="wrap admin-nav-inner">
        <a class="admin-mark" href="/admin"><span class="dot"></span> Console</a>
        <button
          type="button"
          class="admin-burger"
          id="adminNavToggle"
          aria-expanded="false"
          aria-controls="adminLinks"
          aria-label="Menu"
        >
          <span class="burger" aria-hidden="true"></span>
        </button>
        <nav class="admin-links" id="adminLinks">
          {
            NAV.map((item) => (
              <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <a class="faint" style="font-size:13px" href="/" target="_blank" rel="noopener">View site ↗</a>
        <form method="POST" action="/api/admin/logout">
          <button class="btn small" type="submit">Sign out</button>
        </form>
      </div>
    </header>

    <main>
      <div class="wrap">
        {
          /* One setup notice, shown once, rather than each panel apologising
             separately. A half-configured console should say exactly what is
             missing — the alternative is a page of zeroes that reads like "no
             traffic" when it means "no database". */
          !caps.data && (
            <div class="notice">
              <h3>Supabase is not connected</h3>
              <p class="muted">
                Traffic, leads, and questions are all empty until it is. Nothing on the public
                site is affected — this is the console's storage only.
              </p>
              <ol>
                <li>Create a Supabase project, then run <code>supabase/schema.sql</code> in its SQL editor.</li>
                <li>
                  Set <code>SUPABASE_URL</code> and <code>SUPABASE_SERVICE_ROLE_KEY</code> in the
                  Vercel project (and <code>.env.local</code> for dev).
                </li>
                <li>Redeploy.</li>
              </ol>
            </div>
          )
        }

        {
          /* Configured but not answering. Every number on the page below is
             about to read as zero, and without this banner that is
             indistinguishable from a quiet week. */
          health && !health.ok && (
            <div class="notice danger">
              <h3>
                {health.broken.length} of {health.probes.length} storage objects are not responding
              </h3>
              {unmigrated ? (
                <p class="muted">
                  Postgres reports these as missing, which almost always means{' '}
                  <code>supabase/schema.sql</code> has not been run since the schema last grew. It
                  is idempotent — re-run the whole file in the Supabase SQL editor.
                </p>
              ) : (
                <p class="muted">
                  Anything below that depends on these will render as empty rather than as an
                  error. Treat the figures on this page as unreliable until it is fixed.
                </p>
              )}
              <ul>
                {health.broken.map((b) => (
                  <li>
                    <code>{b.name}</code> <span class="faint">({b.kind})</span> — {b.error}
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <slot />
      </div>
    </main>
  </body>
</html>

<script>
  // Phone nav sheet for the console. Fourteen destinations do not fit a phone
  // row; the burger opens them as full-width rows instead.
  function initAdminNav() {
    const toggle = document.getElementById('adminNavToggle');
    const links = document.getElementById('adminLinks');
    if (!toggle || !links) return;

    const setOpen = (open: boolean) => {
      links.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () =>
      setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

    links.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    var wide = window.matchMedia('(min-width: 721px)');
    wide.addEventListener('change', function (e) { if (e.matches) setOpen(false); });

    setOpen(false);
  }
  initAdminNav();
</script>
