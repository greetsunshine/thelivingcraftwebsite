---
import '../styles/global.css';
// The V5 layer shared with `/` (25 September): header, ground, width, reading
// type, footer. A page template loads after it and refines it.
import '../styles/ds/site-v5.css';
// The consulting page template (design system v1).
import '../styles/templates/consulting.css';
import SeoHead from '../components/SeoHead.astro';
import AskWidget from '../components/AskWidget.astro';
import Track from '../components/Track.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import GoogleTagManagerNoscript from '../components/GoogleTagManagerNoscript.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import BrandLockup from '../components/site/BrandLockup.astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: unknown[];
}

const { title, description, canonical, schema } = Astro.props;
const year = new Date().getFullYear();
// <body> takes `lc-v5` (V5's chrome) and `lc-v5-read` (V5's reading type):
// see ds/site-v5.css. Comments stay up here: a JSX comment between </head>
// and <body> makes Astro open an implicit <body> and loses these classes.
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <GoogleTagManager />
    <SeoHead title={title} description={description} canonical={canonical} schema={schema} />
  </head>
  <body class="consult-page lc-v5 lc-v5-read">
    <GoogleTagManagerNoscript />
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader
      brandHref="#top"
      sub="AI Readiness"
      action={{ label: 'Request a scope call', href: '#contact' }}
      pageLinks={[
        ['What it is', '#what'],
        ['What you get', '#deliverables'],
        ['How it runs', '#run'],
        ['Investment', '#investment'],
      ]}
      related={[['Fractional CAIO', '/caio']]}
    />

    <main id="main">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <BrandLockup tile />
            <p class="muted">A fixed-scope AI diagnostic for leaders who want a straight answer. It runs on your systems, and gives you a board-ready roadmap you own.</p>
          </div>
          <div class="foot-col">
            <h2>The assessment</h2>
            <a href="#what">What it is</a>
            <a href="#deliverables">What you get</a>
            <a href="#run">How it runs</a>
            <a href="#investment">Investment</a>
          </div>
          <div class="foot-col">
            <h2>Connect</h2>
            <a href="mailto:apply@thelivingcraft.ai">apply@thelivingcraft.ai</a>
            <a href="https://linkedin.com/in/sunil-mathew-466615a" target="_blank" rel="noopener">LinkedIn</a>
            <a href="/caio">Fractional CAIO retainer <span aria-hidden="true">→</span></a>
            <a href="/">The Living Craft · cohort <span aria-hidden="true">→</span></a>
            <a href="/latest">Field notes · agentic AI <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© {year} Sunil Mathew · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></span>
          <span class="mono">AI Readiness Assessment · India</span>
        </div>
      </div>
    </footer>

    <Track />
    <AskWidget surface="/assessment" />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
