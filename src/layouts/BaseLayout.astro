---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import AskWidget from '../components/AskWidget.astro';
import Track from '../components/Track.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: unknown[];
  /** Resolved region, forwarded to the Ask widget so it quotes the same rate. */
  region?: string | null;
}

const { title, description, canonical, schema, region = null } = Astro.props;
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} canonical={canonical} schema={schema} />
  </head>
  <body>
    <!-- Nav -->
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="wordmark" href="/"><span class="dot"></span> the living craft</a>
        <nav class="navlinks">
          <a href="/#fit">Who it is for</a>
          <a href="/#curriculum">The work</a>
          <a href="/#sunil">Sunil</a>
          <a href="/#commitment">Commitment</a>
          <a href="/#questions">Questions</a>
          <a class="btn btn-primary" style="padding:10px 20px" href="/#apply">Apply&nbsp;<span class="arrow">→</span></a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <div class="wordmark" style="margin-bottom:14px"><span class="dot"></span> the living craft</div>
            <p class="muted">Build a working agentic system, and develop the ability to explain its design, examine its behaviour and guide the decisions behind it.</p>
          </div>
          <div class="foot-col">
            <h5>Programme</h5>
            <a href="/#fit">Who it is for</a>
            <a href="/#curriculum">What the work explores</a>
            <a href="/#commitment">The commitment</a>
            <a href="/#apply">Apply for the open cohort</a>
            <a href="/#team">Learning for a team</a>
          </div>
          <div class="foot-col">
            <h5>Also by Sunil</h5>
            <a href="/caio">Fractional CAIO retainer →</a>
            <a href="/assessment">AI Readiness Assessment →</a>
            <a href="/latest">Field notes — agentic AI →</a>
          </div>
          <div class="foot-col">
            <h5>Connect</h5>
            <a href="mailto:apply@thelivingcraft.ai">apply@thelivingcraft.ai</a>
            <a href="https://linkedin.com/in/sunil-mathew-466615a" target="_blank" rel="noopener">LinkedIn</a>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© {year} The Living Craft · Sunil Mathew</span>
          <span class="foot-legal">
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
            <a href="/communication-preferences">Email preferences</a>
          </span>
        </div>
      </div>
    </footer>

    <Track region={region} />
    <AskWidget surface="/" region={region} />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
