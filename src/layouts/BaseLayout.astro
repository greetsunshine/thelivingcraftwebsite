---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import AskWidget from '../components/AskWidget.astro';
import Track from '../components/Track.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import GoogleTagManagerNoscript from '../components/GoogleTagManagerNoscript.astro';
import StickyApplyBar from '../components/site/StickyApplyBar.astro';
import MobileMenu from '../components/site/MobileMenu.astro';
import TalkToSunilLink from '../components/site/TalkToSunilLink.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Logo from '../components/site/Logo.astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: unknown[];
  /** Resolved region, forwarded to the Ask widget so it quotes the same rate. */
  region?: string | null;
}

const { title, description, canonical, schema, region = null } = Astro.props;
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <GoogleTagManager />
    <SeoHead title={title} description={description} canonical={canonical} schema={schema} />
  </head>
  <body>
    <GoogleTagManagerNoscript />
    {/* Keyboard-only bypass for the header, the same one PracticeLayout carries.
        This page is 7000px of anchor navigation and the header repeats on every
        surface that uses this shell. */}
    <a class="skip" href="#main">Skip to content</a>

    <!-- Nav -->
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="wordmark" href="/"><Logo /> the living craft</a>
        <nav class="navlinks">
          <a href="/#fit">Who it is for</a>
          <a href="/#curriculum">The work</a>
          <a href="/#sunil">Sunil</a>
          <a href="/#commitment">Commitment</a>
          <a href="/#questions">Questions</a>
          {/* Apply is the LAST thing in the bar, and the bar is
              `justify-content: space-between`, so it sits hard against the
              right edge of the header. Sunil, 16 September: "remove … top
              right book now" and "apply on the right side". A secondary
              "Talk with Sunil" link used to sit to the right of it; the top
              of every page now carries one action only. The conversation is
              still one scroll away, in the hero and in section 14. */}
          <a class="btn btn-primary" style="padding:10px 20px" href="/#apply">Apply&nbsp;<span class="arrow" aria-hidden="true">→</span></a>
          {/* Phones only: the links above are hidden below 900px, and this
              is how a phone reaches them. It also carries Talk with Sunil,
              which left the header on 16 September. */}
          <MobileMenu>
            <a href="/#fit">Who it is for</a>
            <a href="/#curriculum">The work</a>
            <a href="/#sunil">Sunil</a>
            <a href="/#commitment">Commitment</a>
            <a href="/#questions">Questions</a>
            <TalkToSunilLink placement="menu" variant="textlink" onCohortPage />
          </MobileMenu>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <div class="wordmark" style="margin-bottom:14px"><Logo tile /> the living craft</div>
            <p class="muted">Build a working agentic system, and develop the ability to explain its design, examine its behaviour and guide the decisions behind it.</p>
          </div>
          <div class="foot-col">
            <h2>Programme</h2>
            <a href="/#fit">Who it is for</a>
            <a href="/#curriculum">What the work explores</a>
            <a href="/#commitment">The commitment</a>
            <a href="/#apply">Apply for the open cohort</a>
            <a href="/#team">Learning for a team</a>
          </div>
          <div class="foot-col">
            <h2>Also by Sunil</h2>
            <a href="/caio">Fractional CAIO retainer <span aria-hidden="true">→</span></a>
            <a href="/assessment">AI Readiness Assessment <span aria-hidden="true">→</span></a>
            <a href="/resources">Resources · free tools <span aria-hidden="true">→</span></a>
            <a href="/latest">Field notes · agentic AI <span aria-hidden="true">→</span></a>
          </div>
          <div class="foot-col">
            <h2>Connect</h2>
            <a href="mailto:apply@thelivingcraft.ai">apply@thelivingcraft.ai</a>
            <a href="https://linkedin.com/in/sunil-mathew-466615a" target="_blank" rel="noopener">LinkedIn</a>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© {year} The Living Craft · Sunil Mathew</span>
          <span class="foot-legal">
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
            <a href="/communication-preferences">Email preferences</a>
          </span>
        </div>
      </div>
    </footer>

    <Track region={region} />
    <AskWidget surface="/" region={region} />
    <StickyApplyBar applyHref="#apply" />

    {/* Publishes the sticky header's real height as --anchor-offset, which
        global.css spends as scroll-margin-top on :target. Every CTA on this
        page is an in-page anchor and header.nav is sticky, so without this
        each one lands with its heading hidden behind the nav. Measured
        rather than hard-coded because .nav-inner wraps, so its height is not
        one number across viewports. */}
    <script>
      (function () {
        const nav = document.querySelector<HTMLElement>('header.nav');
        if (!nav) return;
        const publish = () => {
          document.documentElement.style.setProperty(
            '--anchor-offset',
            `${nav.offsetHeight + 12}px`,
          );
        };
        publish();
        window.addEventListener('resize', publish, { passive: true });
      })();
    </script>
    <Analytics />
    <SpeedInsights />
  </body>
</html>

<style>
  /* Visible only on keyboard focus, and above the sticky header (--z-sticky is
     10). Same geometry as PracticeLayout's, deliberately — one bypass link that
     behaves the same way wherever it appears. */
  .skip {
    position: absolute;
    left: var(--space-4);
    top: var(--space-4);
    z-index: var(--z-dialog);
    transform: translateY(-200%);
    background: var(--surface-panel);
    color: var(--text-loud);
    border-radius: var(--radius-control);
    padding: var(--space-3) var(--space-5);
    box-shadow: var(--shadow-lift);
    font-size: var(--size-3);
    font-weight: var(--weight-medium);
  }
  .skip:focus-visible {
    transform: none;
  }
</style>
