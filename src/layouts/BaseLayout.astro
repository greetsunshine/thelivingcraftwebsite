---
import '../styles/global.css';
// The cohort page's refinement (19 September). This layout serves `/` alone,
// and every rule in it is scoped under body.landing.
import '../styles/landing.css';
// The V4 and V5 layers of 19 September, after the base, as the package loads them.
import '../styles/landing-v5.css';
import SeoHead from '../components/SeoHead.astro';
import AskWidget from '../components/AskWidget.astro';
import Track from '../components/Track.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import GoogleTagManagerNoscript from '../components/GoogleTagManagerNoscript.astro';
import StickyApplyBar from '../components/site/StickyApplyBar.astro';
import BrandLockup from '../components/site/BrandLockup.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import MobileMenu from '../components/site/MobileMenu.astro';
import TalkToSunilLink from '../components/site/TalkToSunilLink.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: unknown[];
  /** Resolved region, forwarded to the Ask widget so it quotes the same rate. */
  region?: string | null;
}

const { title, description, canonical, schema, region = null } = Astro.props;

/* The site's own sections, in the header and the phone menu (V4/V5). The
   page's own sections moved to the "On this page" bar under it. */
const GLOBAL_NAV = [
  ['Programmes', '/programmes'],
  ['Advisory', '/advisory'],
  ['Resources', '/resources'],
  ['Tools', '/tools'],
  ['About', '/about'],
];
const PAGE_NAV = [
  ['Overview', '#top'],
  ['Examples', '#example'],
  ['Curriculum', '#curriculum'],
  ['Sunil', '#sunil'],
  ['Fees', '#commitment'],
  ['Questions', '#questions'],
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <GoogleTagManager />
    <SeoHead title={title} description={description} canonical={canonical} schema={schema} />
  </head>
  <body class="landing">
    <GoogleTagManagerNoscript />
    {/* Keyboard-only bypass for the header, the same one PracticeLayout carries.
        This page is 7000px of anchor navigation and the header repeats on every
        surface that uses this shell. */}
    <a class="skip" href="#main">Skip to content</a>

    <!-- Nav -->
    <header class="nav">
      <div class="wrap nav-inner">
        {/* The lockup, from BrandLockup.astro — the same one every other page
            carries since 20 September. Its cohort sizes are in landing.css. */}
        <BrandLockup href="/" />
        <nav class="navlinks" aria-label="Main navigation">
          {GLOBAL_NAV.map(([label, href]) => <a href={href}>{label}</a>)}
          {/* "Apply", not the package's "Enquire" (Sunil, 19 September: the
              cohort's call to action is Apply everywhere). It goes to #apply,
              which lights both routes and waits for a choice. */}
          <a class="btn btn-primary" href="#apply">Apply<span class="arrow" aria-hidden="true">→</span></a>
          {/* ONE MENU ON PHONES (Sunil, 19 September). Below 1080px the site's
              five links fold into this menu. Below 760px the "On this page"
              row folds in too, as the menu's first group, so a phone has one
              menu control instead of two. */}
          <MobileMenu breakpoint={1080}>
            <div class="mm-group mm-group-page">
              <p class="mm-group-label">On this page</p>
              {PAGE_NAV.map(([label, href]) => <a href={href}>{label}</a>)}
            </div>
            <div class="mm-group">
              <p class="mm-group-label">The Living Craft</p>
              {GLOBAL_NAV.map(([label, href]) => <a href={href}>{label}</a>)}
              <a href="#apply">Apply</a>
              <TalkToSunilLink placement="menu" variant="textlink" onCohortPage />
            </div>
          </MobileMenu>
        </nav>
      </div>
      {/* ON THIS PAGE. A quiet second row with the page's own sections, on
          screens wider than 760px. On a phone it is hidden and the same
          links are the first group of the menu above. */}
      <div class="page-navigation">
        <div class="wrap">
          <nav class="page-links" aria-label="On this page">
            {PAGE_NAV.map(([label, href]) => <a href={href}>{label}</a>)}
          </nav>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <!-- Footer -->
    <SiteFooter />

    <Track region={region} />
    <AskWidget surface="/" region={region} />
    <StickyApplyBar applyHref="#apply" copy="Find the right programme for you." />

    {/* Publishes the sticky header's real height as --anchor-offset, which
        global.css spends as scroll-margin-top on :target. Every CTA on this
        page is an in-page anchor and header.nav is sticky, so without this
        each one lands with its heading hidden behind the nav. Measured
        rather than hard-coded because .nav-inner wraps, so its height is not
        one number across viewports. */}
    <script>
      (function () {
        const nav = document.querySelector<HTMLElement>('header.nav');
        if (!nav) return;
        const publish = () => {
          document.documentElement.style.setProperty(
            '--anchor-offset',
            `${nav.offsetHeight + 12}px`,
          );
        };
        publish();
        window.addEventListener('resize', publish, { passive: true });
      })();
    </script>

    {/* MOTION, from the V5 package (its preview adapter's motion state and
        illustrated.js), rewritten here because the adapter itself is not
        shipped.

        One switch, `data-motion` on <html>: "paused" under the OS
        reduced-motion setting, and only then. The footer's "Pause motion"
        button was removed on 29 September at Sunil's request ("let the
        motion always be there"). The cost is WCAG 2.2.2: a loop longer
        than five seconds has no on-page pause now; the OS setting is the
        one way to stop it. Then:
          * the hero brain loops (is-looping) and runs only while it is on
            screen, the tab is visible and motion is on (is-visible);
          * each concept drawing traces ONCE, the first time it is on screen
            with motion on, and then rests (art-play, art-in-view).
        Nothing is stored. */}
    <script>
      (function () {
        const root = document.documentElement;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
        const brain = document.querySelector<HTMLElement>('[data-woven-brain]');
        const figures = Array.from(document.querySelectorAll<HTMLElement>('[data-concept]'));
        let brainSeen = true;
        const visible = new Set<Element>();
        const done = new Set<Element>();
        const off = () => reduced.matches;

        const update = () => {
          const motionOff = off();
          root.dataset.motion = motionOff ? 'paused' : 'on';
          brain?.classList.toggle('is-visible', brainSeen && !motionOff && !document.hidden);
          figures.forEach((fig) => {
            const active = visible.has(fig) && !document.hidden && !motionOff;
            if (active && !done.has(fig)) fig.classList.add('art-play');
            fig.classList.toggle('art-in-view', active && !done.has(fig));
          });
        };

        brain?.classList.add('is-looping');
        reduced.addEventListener('change', update);
        document.addEventListener('visibilitychange', update);

        if ('IntersectionObserver' in window) {
          if (brain) {
            new IntersectionObserver(
              (entries) => {
                brainSeen = entries[0].isIntersecting;
                update();
              },
              { threshold: 0.05 },
            ).observe(brain);
          }
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target)));
              update();
            },
            { threshold: 0.25 },
          );
          figures.forEach((fig) => io.observe(fig));
        }
        figures.forEach((fig) =>
          fig.addEventListener('animationend', (event) => {
            if (!['thread-trace', 'junction-settle'].includes((event as AnimationEvent).animationName)) return;
            done.add(fig);
            fig.classList.remove('art-in-view');
          }),
        );
        update();
      })();
    </script>
    <Analytics />
    <SpeedInsights />
  </body>
</html>

<style>
  /* Visible only on keyboard focus, and above the sticky header (--z-sticky is
     10). Same geometry as PracticeLayout's, deliberately — one bypass link that
     behaves the same way wherever it appears. */
  .skip {
    position: absolute;
    left: var(--space-4);
    top: var(--space-4);
    z-index: var(--z-dialog);
    transform: translateY(-200%);
    background: var(--surface-panel);
    color: var(--text-loud);
    border-radius: var(--radius-control);
    padding: var(--space-3) var(--space-5);
    box-shadow: var(--shadow-lift);
    font-size: var(--size-3);
    font-weight: var(--weight-medium);
  }
  .skip:focus-visible {
    transform: none;
  }
</style>
