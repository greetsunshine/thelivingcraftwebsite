---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import AskWidget from '../components/AskWidget.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: unknown[];
}

const { title, description, canonical, schema } = Astro.props;
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} canonical={canonical} schema={schema} />
  </head>
  <body>
    <!-- Nav -->
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="wordmark" href="#top"><span class="dot"></span> the living craft</a>
        <nav class="navlinks">
          <a href="#experience">The Maker</a>
          <a href="#curriculum">The Program</a>
          <a href="#cohort">Format</a>
          <a href="#pricing">Investment</a>
          <a class="btn btn-primary" style="padding:10px 20px" href="#apply">Apply&nbsp;<span class="arrow">→</span></a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <div class="wordmark" style="margin-bottom:14px"><span class="dot"></span> the living craft</div>
            <p class="muted">A small, application-only program in agentic &amp; systems architecture — taught from 26 years at the bench.</p>
          </div>
          <div class="foot-col">
            <h5>Program</h5>
            <a href="#experience">The maker</a>
            <a href="#curriculum">Curriculum</a>
            <a href="#cohort">Format</a>
            <a href="#pricing">Investment</a>
          </div>
          <div class="foot-col">
            <h5>Also by Sunil</h5>
            <a href="/caio">Fractional CAIO retainer →</a>
            <a href="/assessment">AI Readiness Assessment →</a>
          </div>
          <div class="foot-col">
            <h5>Connect</h5>
            <a href="mailto:apply@thelivingcraft.ai">apply@thelivingcraft.ai</a>
            <a href="https://linkedin.com/in/sunil-mathew-466615a" target="_blank" rel="noopener">LinkedIn</a>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© {year} The Living Craft · Sunil Mathew</span>
          <span class="mono">Built as a demonstration of the craft.</span>
        </div>
      </div>
    </footer>

    <AskWidget surface="/" />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
