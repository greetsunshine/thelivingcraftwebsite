---
import '../styles/global.css';
// The cohort page's refinement (19 September). This layout serves `/` alone,
// and every rule in it is scoped under body.landing.
import '../styles/landing.css';
// The V4 and V5 layers of 19 September, after the base, as the package loads them.
import '../styles/landing-v5.css';
import SeoHead from '../components/SeoHead.astro';
import AskWidget from '../components/AskWidget.astro';
import Track from '../components/Track.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import GoogleTagManagerNoscript from '../components/GoogleTagManagerNoscript.astro';
import StickyApplyBar from '../components/site/StickyApplyBar.astro';
import MobileMenu from '../components/site/MobileMenu.astro';
import TalkToSunilLink from '../components/site/TalkToSunilLink.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: unknown[];
  /** Resolved region, forwarded to the Ask widget so it quotes the same rate. */
  region?: string | null;
}

const { title, description, canonical, schema, region = null } = Astro.props;
const year = new Date().getFullYear();

/* The site's own sections, in the header and the phone menu (V4/V5). The
   page's own sections moved to the "On this page" bar under it. */
const GLOBAL_NAV = [
  ['Programmes', '/programmes'],
  ['Advisory', '/advisory'],
  ['Resources', '/resources'],
  ['Tools', '/tools'],
  ['About', '/about'],
];
const PAGE_NAV = [
  ['Overview', '#top'],
  ['Examples', '#example'],
  ['Curriculum', '#curriculum'],
  ['Sunil', '#sunil'],
  ['Fees', '#commitment'],
  ['Questions', '#questions'],
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <GoogleTagManager />
    <SeoHead title={title} description={description} canonical={canonical} schema={schema} />
  </head>
  <body class="landing">
    <GoogleTagManagerNoscript />
    {/* Keyboard-only bypass for the header, the same one PracticeLayout carries.
        This page is 7000px of anchor navigation and the header repeats on every
        surface that uses this shell. */}
    <a class="skip" href="#main">Skip to content</a>

    <!-- Nav -->
    <header class="nav">
      <div class="wrap nav-inner">
        {/* The lockup from the 19 September refinement: the LC mark and the
            "The Living Craft" lettering, both cropped from the supplied artwork
            with the paper keyed out (public/brand/lc-mark-keyed.webp,
            lc-name.webp). Images of text, so the link carries the name. */}
        <a class="wordmark brand-lockup" href="/" aria-label="The Living Craft, home">
          <img class="brand-symbol" src="/brand/lc-mark-keyed.webp" width="163" height="104" alt="" decoding="async" />
          <img class="brand-name" src="/brand/lc-name.webp" width="364" height="57" alt="" decoding="async" />
        </a>
        <nav class="navlinks" aria-label="Main navigation">
          {GLOBAL_NAV.map(([label, href]) => <a href={href}>{label}</a>)}
          {/* "Enquire", as the V4/V5 package names it. It lands on the
              application section's heading (#enquire), ABOVE the choice
              between the open cohort and a team programme, so the header
              does not pick a route for anybody. Apply is still the action
              inside that section and on the price card. */}
          <a class="btn btn-primary" href="#enquire">Enquire<span class="arrow" aria-hidden="true">→</span></a>
          {/* Below 1080px the five links fold into this menu. */}
          <MobileMenu breakpoint={1080}>
            {GLOBAL_NAV.map(([label, href]) => <a href={href}>{label}</a>)}
            <a href="#enquire">Enquire</a>
            <TalkToSunilLink placement="menu" variant="textlink" onCohortPage />
          </MobileMenu>
        </nav>
      </div>
      {/* ON THIS PAGE. A quiet second row with the page's own sections. On a
          phone it folds into a native <details>, which needs no script to
          open; the script below only closes it after a jump. */}
      <div class="page-navigation">
        <div class="wrap">
          <nav class="page-links" aria-label="On this page">
            {PAGE_NAV.map(([label, href]) => <a href={href}>{label}</a>)}
          </nav>
          <details class="page-menu" data-page-menu>
            <summary>On this page<span aria-hidden="true">⌄</span></summary>
            <nav aria-label="On this page, menu">
              {PAGE_NAV.map(([label, href]) => <a href={href}>{label}</a>)}
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <span class="brand-tile" role="img" aria-label="The Living Craft">
              <img class="brand-symbol" src="/brand/lc-mark-keyed.webp" width="163" height="104" alt="" decoding="async" loading="lazy" />
              <img class="brand-name" src="/brand/lc-name.webp" width="364" height="57" alt="" decoding="async" loading="lazy" />
            </span>
            <p class="muted">Build a working agentic system, and develop the ability to explain its design, examine its behaviour and guide the decisions behind it.</p>
          </div>
          <div class="foot-col">
            <h2>Programme</h2>
            <a href="/#fit">Who it is for</a>
            <a href="/#curriculum">What the work explores</a>
            <a href="/#commitment">The commitment</a>
            <a href="/#apply">Apply for the open cohort</a>
            <a href="/#team">Learning for a team</a>
          </div>
          <div class="foot-col">
            <h2>Also by Sunil</h2>
            <a href="/caio">Fractional CAIO retainer <span aria-hidden="true">→</span></a>
            <a href="/assessment">AI Readiness Assessment <span aria-hidden="true">→</span></a>
            <a href="/resources">Resources · free tools <span aria-hidden="true">→</span></a>
            <a href="/latest">Field notes · agentic AI <span aria-hidden="true">→</span></a>
          </div>
          <div class="foot-col">
            <h2>Connect</h2>
            <a href="mailto:apply@thelivingcraft.ai">apply@thelivingcraft.ai</a>
            <a href="https://linkedin.com/in/sunil-mathew-466615a" target="_blank" rel="noopener">LinkedIn</a>
          </div>
          <div class="foot-col">
            <h2>Explore</h2>
            <a href="/resources">Resources</a>
            <a href="/tools">Tools</a>
            <a href="/programmes/enterprise">Enterprise learning</a>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© {year} The Living Craft · Sunil Mathew</span>
          <span class="foot-legal">
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
            <a href="/communication-preferences">Email preferences</a>
          </span>
          {/* The one pause for all motion on this page: the hero brain's loop
              and the drawings' single trace. It is what satisfies WCAG 2.2.2
              for a loop longer than five seconds. The choice lasts for this
              page view only; nothing is stored. */}
          <button type="button" class="motion-setting" data-pause-motion aria-pressed="false">Pause motion</button>
        </div>
      </div>
    </footer>

    <Track region={region} />
    <AskWidget surface="/" region={region} />
    <StickyApplyBar applyHref="#enquire" copy="Find the right programme for you." label="Enquire" />

    {/* Publishes the sticky header's real height as --anchor-offset, which
        global.css spends as scroll-margin-top on :target. Every CTA on this
        page is an in-page anchor and header.nav is sticky, so without this
        each one lands with its heading hidden behind the nav. Measured
        rather than hard-coded because .nav-inner wraps, so its height is not
        one number across viewports. */}
    <script>
      (function () {
        const nav = document.querySelector<HTMLElement>('header.nav');
        if (!nav) return;
        const publish = () => {
          document.documentElement.style.setProperty(
            '--anchor-offset',
            `${nav.offsetHeight + 12}px`,
          );
        };
        publish();
        window.addEventListener('resize', publish, { passive: true });
      })();
    </script>

    {/* THE PAGE MENU (phones). Close it after a jump, and on Escape. */}
    <script>
      (function () {
        const menu = document.querySelector<HTMLDetailsElement>('[data-page-menu]');
        if (!menu) return;
        menu.querySelectorAll('a').forEach((a) =>
          a.addEventListener('click', () => {
            menu.open = false;
          }),
        );
        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape' || !menu.open) return;
          menu.open = false;
          menu.querySelector('summary')?.focus();
        });
      })();
    </script>

    {/* MOTION, from the V5 package (its preview adapter's motion state and
        illustrated.js), rewritten here because the adapter itself is not
        shipped.

        One switch, `data-motion` on <html>: "paused" under the OS
        reduced-motion setting or after Pause motion is pressed. Then:
          * the hero brain loops (is-looping) and runs only while it is on
            screen, the tab is visible and motion is on (is-visible);
          * each concept drawing traces ONCE, the first time it is on screen
            with motion on, and then rests (art-play, art-in-view).
        Nothing is stored: the pause lasts for this page view. */}
    <script>
      (function () {
        const root = document.documentElement;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
        const button = document.querySelector<HTMLButtonElement>('[data-pause-motion]');
        const brain = document.querySelector<HTMLElement>('[data-woven-brain]');
        const figures = Array.from(document.querySelectorAll<HTMLElement>('[data-concept]'));
        let manualPaused = false;
        let brainSeen = true;
        const visible = new Set<Element>();
        const done = new Set<Element>();
        const off = () => reduced.matches || manualPaused;

        const update = () => {
          const motionOff = off();
          root.dataset.motion = motionOff ? 'paused' : 'on';
          if (button) {
            button.disabled = reduced.matches;
            button.setAttribute('aria-pressed', String(motionOff));
            button.textContent = reduced.matches
              ? 'Motion paused'
              : manualPaused
                ? 'Resume motion'
                : 'Pause motion';
          }
          brain?.classList.toggle('is-visible', brainSeen && !motionOff && !document.hidden);
          figures.forEach((fig) => {
            const active = visible.has(fig) && !document.hidden && !motionOff;
            if (active && !done.has(fig)) fig.classList.add('art-play');
            fig.classList.toggle('art-in-view', active && !done.has(fig));
          });
        };

        brain?.classList.add('is-looping');
        button?.addEventListener('click', () => {
          manualPaused = !manualPaused;
          update();
        });
        reduced.addEventListener('change', update);
        document.addEventListener('visibilitychange', update);

        if ('IntersectionObserver' in window) {
          if (brain) {
            new IntersectionObserver(
              (entries) => {
                brainSeen = entries[0].isIntersecting;
                update();
              },
              { threshold: 0.05 },
            ).observe(brain);
          }
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target)));
              update();
            },
            { threshold: 0.25 },
          );
          figures.forEach((fig) => io.observe(fig));
        }
        figures.forEach((fig) =>
          fig.addEventListener('animationend', (event) => {
            if (!['thread-trace', 'junction-settle'].includes((event as AnimationEvent).animationName)) return;
            done.add(fig);
            fig.classList.remove('art-in-view');
          }),
        );
        update();
      })();
    </script>
    <Analytics />
    <SpeedInsights />
  </body>
</html>

<style>
  /* Visible only on keyboard focus, and above the sticky header (--z-sticky is
     10). Same geometry as PracticeLayout's, deliberately — one bypass link that
     behaves the same way wherever it appears. */
  .skip {
    position: absolute;
    left: var(--space-4);
    top: var(--space-4);
    z-index: var(--z-dialog);
    transform: translateY(-200%);
    background: var(--surface-panel);
    color: var(--text-loud);
    border-radius: var(--radius-control);
    padding: var(--space-3) var(--space-5);
    box-shadow: var(--shadow-lift);
    font-size: var(--size-3);
    font-weight: var(--weight-medium);
  }
  .skip:focus-visible {
    transform: none;
  }
</style>
