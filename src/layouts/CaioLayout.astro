---
import '../styles/global.css';
// The consulting page template (design system v1).
import '../styles/templates/consulting.css';
import SeoHead from '../components/SeoHead.astro';
import AskWidget from '../components/AskWidget.astro';
import Track from '../components/Track.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import GoogleTagManagerNoscript from '../components/GoogleTagManagerNoscript.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import MobileMenu from '../components/site/MobileMenu.astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: unknown[];
}

const { title, description, canonical, schema } = Astro.props;
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <GoogleTagManager />
    <SeoHead title={title} description={description} canonical={canonical} schema={schema} />
  </head>
  <body class="consult-page">
    <GoogleTagManagerNoscript />
    <a class="skip" href="#main">Skip to content</a>
    <!-- Nav — personal practice, brand-neutral, cross-linked to The Living Craft -->
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="wordmark" href="#top">
          <span class="dot"></span> Sunil Mathew
          <span class="wordmark-sub">Fractional&nbsp;CAIO</span>
        </a>
        <nav class="navlinks">
          <a href="#problem">The gap</a>
          <a href="#own">What I own</a>
          <a href="#maker">Why me</a>
          <a href="#engagement">Engagement</a>
          <a href="#tiers">Ways to work</a>
          <a href="/assessment">AI Readiness</a>
          <a class="btn btn-primary" style="padding:10px 20px" href="#contact">Book a call&nbsp;<span class="arrow" aria-hidden="true">→</span></a>
          {/* Phones: the links above are hidden below 900px (global.css), and this
              is how a phone reaches them. Same links, same order. */}
          <MobileMenu>
            <a href="#problem">The gap</a>
            <a href="#own">What I own</a>
            <a href="#maker">Why me</a>
            <a href="#engagement">Engagement</a>
            <a href="#tiers">Ways to work</a>
            <a href="/assessment">AI Readiness</a>
          </MobileMenu>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <div class="wordmark" style="margin-bottom:14px"><span class="dot"></span> Sunil Mathew</div>
            <p class="muted">An embedded AI executive, part-time and accountable for outcomes. Strategy, governance, and first use cases into production, for India's regulated and mid-market enterprises.</p>
          </div>
          <div class="foot-col">
            <h2>Engage</h2>
            <a href="#problem">The leadership gap</a>
            <a href="#own">What I own</a>
            <a href="#engagement">The engagement</a>
            <a href="#tiers">Ways to work together</a>
          </div>
          <div class="foot-col">
            <h2>Connect</h2>
            <a href="mailto:apply@thelivingcraft.ai">apply@thelivingcraft.ai</a>
            <a href="https://linkedin.com/in/sunil-mathew-466615a" target="_blank" rel="noopener">LinkedIn</a>
            <a href="/assessment">AI Readiness Assessment <span aria-hidden="true">→</span></a>
            <a href="/">The Living Craft · cohort and team enablement <span aria-hidden="true">→</span></a>
            <a href="/latest">Field notes · agentic AI <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© {year} Sunil Mathew · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></span>
          <span class="mono">Fractional Chief AI Officer · India</span>
        </div>
      </div>
    </footer>

    <Track />
    <AskWidget surface="/caio" />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
