---
import '../styles/global.css';
// The V5 layer shared with `/` (25 September): header, ground, width, reading
// type, footer. A page template loads after it and refines it.
import '../styles/ds/site-v5.css';
// The consulting page template (design system v1).
import '../styles/templates/consulting.css';
import SeoHead from '../components/SeoHead.astro';
import AskWidget from '../components/AskWidget.astro';
import Track from '../components/Track.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import GoogleTagManagerNoscript from '../components/GoogleTagManagerNoscript.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import BrandLockup from '../components/site/BrandLockup.astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: unknown[];
}

const { title, description, canonical, schema } = Astro.props;
const year = new Date().getFullYear();
// <body> takes `lc-v5` (V5's chrome) and `lc-v5-read` (V5's reading type):
// see ds/site-v5.css. Comments stay up here: a JSX comment between </head>
// and <body> makes Astro open an implicit <body> and loses these classes.
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <GoogleTagManager />
    <SeoHead title={title} description={description} canonical={canonical} schema={schema} />
  </head>
  <body class="consult-page lc-v5 lc-v5-read">
    <GoogleTagManagerNoscript />
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader
      brandHref="#top"
      sub="Fractional CAIO"
      action={{ label: 'Book a call', href: '#contact' }}
      pageLinks={[
        ['The gap', '#problem'],
        ['What I own', '#own'],
        ['Why me', '#maker'],
        ['Engagement', '#engagement'],
        ['Ways to work', '#tiers'],
      ]}
      related={[['AI Readiness', '/assessment']]}
    />

    <main id="main">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <BrandLockup tile />
            <p class="muted">An embedded AI executive, part-time and accountable for outcomes. Strategy, governance, and first use cases into production, for India's regulated and mid-market enterprises.</p>
          </div>
          <div class="foot-col">
            <h2>Engage</h2>
            <a href="#problem">The leadership gap</a>
            <a href="#own">What I own</a>
            <a href="#engagement">The engagement</a>
            <a href="#tiers">Ways to work together</a>
          </div>
          <div class="foot-col">
            <h2>Connect</h2>
            <a href="mailto:apply@thelivingcraft.ai">apply@thelivingcraft.ai</a>
            <a href="https://linkedin.com/in/sunil-mathew-466615a" target="_blank" rel="noopener">LinkedIn</a>
            <a href="/assessment">AI Readiness Assessment <span aria-hidden="true">→</span></a>
            <a href="/">The Living Craft · cohort and team enablement <span aria-hidden="true">→</span></a>
            <a href="/latest">Field notes · agentic AI <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© {year} Sunil Mathew · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></span>
          <span class="mono">Fractional Chief AI Officer · India</span>
        </div>
      </div>
    </footer>

    <Track />
    <AskWidget surface="/caio" />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
