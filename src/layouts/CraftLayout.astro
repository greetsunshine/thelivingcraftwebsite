---
// Chrome for the course area — every page under /craft, including sign-in.
//
// The same design system as the public site, deliberately: a learner who
// applied on the strength of that page should not land somewhere that looks
// like a different product. What changes is what the chrome is FOR — no CTAs,
// no pricing, no application form. They already bought. The course area's own
// components live in craft.css, which is additive to global.css and never a
// replacement for it.
//
// `learner` is optional, and that is what folds /craft/login in here. Sign-in
// is reached without a session, so it cannot show a nav that says "sign out" or
// a footer that names who you are — but it is the same site, and duplicating
// the whole <head> to say so meant the fonts, the favicon and the noindex tag
// were maintained in two places and had already drifted. No learner renders the
// bare shell: wordmark, no links, no footer identity.
//
// No SeoHead here. This area is noindex by middleware header and by robots.txt,
// and a canonical tag or OG image on a page no crawler may fetch is noise.
import '../styles/global.css';
import '../styles/craft.css';
import type { Learner } from '../lib/craft/learners';

export interface Props {
  title: string;
  /** Absent only on sign-in, which has no session yet. */
  learner?: Learner;
  /** Shown as a back-link when the page is not the index. */
  back?: { href: string; label: string };
}

const { title, learner, back } = Astro.props;
const year = new Date().getFullYear();
const firstName = learner ? (learner.name ?? learner.email).split(/[\s@]/)[0] : null;

// The nav is the whole map of the area — three destinations, no submenus. Kept
// here rather than per page so adding a fourth is one edit and cannot go
// missing on one page and not another.
const NAV = [
  { href: '/craft', label: 'Sessions' },
  { href: '/craft/notes', label: 'Field notes' },
  { href: '/craft/intake', label: 'Intake' },
];
const here = Astro.url.pathname.replace(/\/+$/, '') || '/craft';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{title} · The Living Craft</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        {/* Signed out there is nowhere for the wordmark to go: linking it back to
            /craft/login would drop the ?next= the middleware set, so a learner
            who clicked it would lose the deep link they arrived with. */}
        {
          learner ? (
            <a class="wordmark" href="/craft">
              <span class="dot" /> the living craft
              <span class="wordmark-sub">Cohort</span>
            </a>
          ) : (
            <div class="wordmark">
              <span class="dot" /> the living craft
              <span class="wordmark-sub">Cohort</span>
            </div>
          )
        }
        {
          learner && (
            <nav class="navlinks">
              {NAV.map((item) => (
                <a href={item.href} class={here === item.href ? 'on' : ''} aria-current={here === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              ))}
              <span class="who klabel">{firstName}</span>
              <form method="POST" action="/api/craft/logout" style="display:inline">
                <button class="signout klabel" type="submit">Sign out</button>
              </form>
            </nav>
          )
        }
      </div>
    </header>

    <main>
      {
        back && (
          <div class="wrap backbar">
            <a class="klabel" href={back.href}>
              ← {back.label}
            </a>
          </div>
        )
      }
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <div class="wordmark" style="margin-bottom:14px"><span class="dot"></span> the living craft</div>
            <p class="muted">
              Your cohort area. Sessions, pre-work, and what to bring to the room.
            </p>
          </div>
          {
            learner && (
              <div class="foot-col">
                <h5>The area</h5>
                {NAV.map((item) => (
                  <a href={item.href}>{item.label}</a>
                ))}
              </div>
            )
          }
          <div class="foot-col">
            <h5>Stuck?</h5>
            <a href="mailto:apply@thelivingcraft.ai">apply@thelivingcraft.ai</a>
            <p class="muted" style="margin-top:8px;max-width:26ch">
              Email Sunil directly — there is no support queue, and there does not need to be
              one for eight people.
            </p>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© {year} The Living Craft · Sunil Mathew</span>
          {learner && <span class="klabel">Signed in as {learner.email}</span>}
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* .wordmark-sub is the global pill, shared with /latest, /caio, /assessment. */
  .navlinks .on {
    color: var(--text-loud);
    font-weight: var(--weight-medium);
  }
  /* --text-faint is 2.29:1 on white and ruled out as a text colour; the name
     is quiet, not invisible. */
  .navlinks .who {
    color: var(--text-quiet);
  }
  .signout {
    background: none;
    border: 0;
    border-bottom: var(--border-w-hair) solid var(--border-field);
    padding: 2px 0;
    color: var(--text-quiet);
    cursor: pointer;
  }
  .signout:hover {
    color: var(--clay);
    border-color: var(--clay);
  }
  .backbar {
    padding-top: var(--space-5);
  }
  .backbar a {
    color: var(--text-quiet);
  }
  .backbar a:hover {
    color: var(--clay);
  }
</style>
