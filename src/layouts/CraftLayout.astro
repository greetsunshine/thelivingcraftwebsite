---
// Chrome for the course area.
//
// The same design system as the public site, deliberately: a learner who
// applied on the strength of that page should not land somewhere that looks
// like a different product. What changes is what the chrome is FOR — no CTAs,
// no pricing, no application form. They already bought.
//
// No SeoHead here. This area is noindex by middleware header and by robots.txt,
// and a canonical tag or OG image on a page no crawler may fetch is noise.
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import type { Learner } from '../lib/craft/learners';
import GuideSidebar from '../components/craft/GuideSidebar.astro';

export interface Props {
  title: string;
  learner: Learner;
  /** Shown as a back-link when the page is a session rather than the index. */
  back?: { href: string; label: string };
}

const { title, learner, back } = Astro.props;
const year = new Date().getFullYear();
const firstName = (learner.name ?? learner.email).split(/[\s@]/)[0];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (p: string) => path === p ? 'active' : '';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{title} · The Living Craft</title>
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="app-layout">
      <nav class="app-sidebar">
        <div class="sidebar-top">
          <a href="/craft" class={`sidebar-icon ${isActive('/craft')}`} title="Dashboard">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </a>
          <a href="/craft/modules" class={`sidebar-icon ${isActive('/craft/modules')}`} title="Modules">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
          </a>
          <a href="/craft/notes" class={`sidebar-icon ${isActive('/craft/notes')}`} title="Field Notes">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          </a>
          <a href="/craft/doubts" class={`sidebar-icon ${isActive('/craft/doubts')}`} title="Doubts">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
          </a>
          <a href="/craft/quiz" class={`sidebar-icon ${isActive('/craft/quiz')}`} title="Quiz">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
          </a>
          <a href="/craft/adr" class={`sidebar-icon ${isActive('/craft/adr')}`} title="ADR" style="font-weight: 700; font-size: 13px;">
            ADR
          </a>
          <a href="/craft/feedback" class={`sidebar-icon ${isActive('/craft/feedback')}`} title="Session feedback">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </a>
          <a href="/craft/familiarity" class={`sidebar-icon ${isActive('/craft/familiarity')}`} title="Familiarity check">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="20" y2="10"/><line x1="18" x2="18" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="16"/></svg>
          </a>
        </div>
        <div class="sidebar-bottom">
          <form method="POST" action="/api/craft/logout">
            <button class="sidebar-icon logout" type="submit" title="Sign out">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
            </button>
          </form>
        </div>
      </nav>

      <main class="app-main">
        <div class="main-scroller">
          {
            back && (
              <div class="wrap backbar">
                <a class="mono" href={back.href}>← {back.label}</a>
              </div>
            )
          }
          <slot />
        </div>
      </main>

      <aside class="app-guide">
        <GuideSidebar />
      </aside>
    </div>
  </body>
</html>

<style>
  body {
    margin: 0;
    padding: 0;
    overflow: hidden; /* layout handles scrolling */
    background: var(--noir); /* edges of screen behind the layout */
  }

  .app-layout {
    display: flex;
    width: 100vw;
    height: 100vh;
    background: var(--mist); /* main background is mist */
  }

  .app-sidebar {
    width: 64px;
    background: var(--mist);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: 24px 0;
    border-right: 1px solid var(--line);
  }

  .sidebar-top, .sidebar-bottom {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
  }

  .sidebar-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-inner);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-faint);
    cursor: pointer;
    transition: all 0.2s;
    background: transparent;
    border: none;
    position: relative;
  }
  
  .sidebar-icon:hover {
    color: var(--ink);
    background: var(--paper-2);
  }

  .sidebar-icon.active {
    color: var(--ink);
  }
  
  .sidebar-icon.active::before {
    content: '';
    position: absolute;
    left: -12px;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sun);
  }

  .app-main {
    flex: 1;
    height: 100vh;
    overflow-y: auto;
    overflow-x: hidden;
    position: relative;
  }

  .main-scroller {
    min-height: 100%;
    padding: 32px 48px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .app-guide {
    width: 380px;
    background: var(--surface);
    border-left: 1px solid var(--line);
    height: 100vh;
    flex-shrink: 0;
  }

  .backbar {
    padding-bottom: 24px;
  }
  .backbar a {
    font-size: 13px;
    color: var(--ink-faint);
  }
  .backbar a:hover {
    color: var(--clay);
  }
</style>
