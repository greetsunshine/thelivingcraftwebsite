---
// Chrome for the course area.
//
// The same design system as the public site, deliberately: a learner who
// applied on the strength of that page should not land somewhere that looks
// like a different product. What changes is what the chrome is FOR — no CTAs,
// no pricing, no application form. They already bought.
//
// No SeoHead here. This area is noindex by middleware header and by robots.txt,
// and a canonical tag or OG image on a page no crawler may fetch is noise.
import '../styles/global.css';
import type { Learner } from '../lib/craft/learners';

export interface Props {
  title: string;
  learner: Learner;
  /** Shown as a back-link when the page is a session rather than the index. */
  back?: { href: string; label: string };
}

const { title, learner, back } = Astro.props;
const year = new Date().getFullYear();
const firstName = (learner.name ?? learner.email).split(/[\s@]/)[0];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{title} · The Living Craft</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="wordmark" href="/craft">
          <span class="dot"></span> the living craft
          <span class="wordmark-sub">Cohort</span>
        </a>
        <nav class="navlinks">
          <a href="/craft">Sessions</a>
          <a href="/latest">Field notes</a>
          <span class="who mono">{firstName}</span>
          <form method="POST" action="/api/craft/logout" style="display:inline">
            <button class="signout mono" type="submit">Sign out</button>
          </form>
        </nav>
      </div>
    </header>

    <main>
      {
        back && (
          <div class="wrap backbar">
            <a class="mono" href={back.href}>← {back.label}</a>
          </div>
        )
      }
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <div class="wordmark" style="margin-bottom:14px"><span class="dot"></span> the living craft</div>
            <p class="muted">
              Your cohort area. Sessions, pre-work, and what to bring to the room.
            </p>
          </div>
          <div class="foot-col">
            <h5>Stuck?</h5>
            <a href="mailto:apply@thelivingcraft.ai">apply@thelivingcraft.ai</a>
            <p class="muted" style="margin-top:8px;max-width:26ch">
              Email Sunil directly — there is no support queue, and there does not need to be
              one for eight people.
            </p>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© {year} The Living Craft · Sunil Mathew</span>
          <span class="mono">Signed in as {learner.email}</span>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .wordmark-sub {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 3px 7px;
    margin-left: 4px;
  }
  .navlinks .who {
    font-size: 12px;
    color: var(--ink-faint);
    letter-spacing: 0.04em;
  }
  .signout {
    background: none;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    padding: 2px 0;
    font-size: 12px;
    color: var(--ink-soft);
    cursor: pointer;
    letter-spacing: 0.04em;
  }
  .signout:hover {
    color: var(--clay);
    border-color: var(--clay);
  }
  .backbar {
    padding-top: 26px;
  }
  .backbar a {
    font-size: 13px;
    color: var(--ink-faint);
  }
  .backbar a:hover {
    color: var(--clay);
  }
</style>
