---
// Layout for /latest — the published output of the retriever agent.
//
// Brand-neutral chrome, like the consulting surfaces: the notes are evidence
// that the practice tracks its field, and they serve the cohort and the
// consulting pages equally. Same design system, same nav grammar, so the
// section reads as part of one site rather than a bolted-on blog.
import '../styles/global.css';
// The V5 layer shared with `/` (25 September): header, ground, width, reading
// type, footer. A page template loads after it and refines it.
import '../styles/ds/site-v5.css';
import SeoHead from '../components/SeoHead.astro';
import AskWidget from '../components/AskWidget.astro';
import Track from '../components/Track.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import GoogleTagManagerNoscript from '../components/GoogleTagManagerNoscript.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: unknown[];
  /** Section anchors for the nav — passed in because the themes are data-driven. */
  sections?: { id: string; title: string }[];
}

const { title, description, canonical, schema, sections = [] } = Astro.props;
// <body> takes `lc-v5` (V5's chrome) and `lc-v5-read` (V5's reading type):
// see ds/site-v5.css. Comments stay up here: a JSX comment between </head>
// and <body> makes Astro open an implicit <body> and loses these classes.
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <GoogleTagManager />
    <SeoHead title={title} description={description} canonical={canonical} schema={schema} />
  </head>
  <body class="lc-v5 lc-v5-read">
    <GoogleTagManagerNoscript />
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader
      brandHref="#top"
      sub="Field notes"
      action={{ label: 'The cohort', href: '/' }}
      pageLinks={sections.map((s) => [s.title, `#${s.id}`] as [string, string])}
      related={[
        ['Fractional CAIO', '/caio'],
        ['AI Readiness', '/assessment'],
      ]}
    />

    <main id="main">
      <slot />
    </main>

    <SiteFooter />

    <Track />
    <AskWidget surface="/latest" />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
