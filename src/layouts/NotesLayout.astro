---
// Layout for /latest — the published output of the retriever agent.
//
// Brand-neutral chrome, like the consulting surfaces: the notes are evidence
// that the practice tracks its field, and they serve the cohort and the
// consulting pages equally. Same design system, same nav grammar, so the
// section reads as part of one site rather than a bolted-on blog.
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import AskWidget from '../components/AskWidget.astro';
import Track from '../components/Track.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: unknown[];
  /** Section anchors for the nav — passed in because the themes are data-driven. */
  sections?: { id: string; title: string }[];
}

const { title, description, canonical, schema, sections = [] } = Astro.props;
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} canonical={canonical} schema={schema} />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="wordmark" href="#top">
          <span class="dot"></span> Sunil Mathew
          <span class="wordmark-sub">Field&nbsp;Notes</span>
        </a>
        <nav class="navlinks">
          {sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
          <a href="/caio">Fractional CAIO</a>
          <a href="/assessment">AI Readiness</a>
          <a class="btn btn-primary" style="padding:10px 20px" href="/">The cohort&nbsp;<span class="arrow">→</span></a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <div class="wordmark" style="margin-bottom:14px"><span class="dot"></span> Sunil Mathew</div>
            <p class="muted">What is actually changing in agentic AI — gathered from primary sources, read before it is published.</p>
          </div>
          <div class="foot-col">
            <h5>Field notes</h5>
            {sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
            <a href="#method">How these are gathered</a>
          </div>
          <div class="foot-col">
            <h5>The practice</h5>
            <a href="/">The Living Craft — cohort →</a>
            <a href="/caio">Fractional CAIO retainer →</a>
            <a href="/assessment">AI Readiness Assessment →</a>
          </div>
          <div class="foot-col">
            <h5>Connect</h5>
            <a href="mailto:apply@thelivingcraft.ai">apply@thelivingcraft.ai</a>
            <a href="https://linkedin.com/in/sunil-mathew-466615a" target="_blank" rel="noopener">LinkedIn</a>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© {year} Sunil Mathew</span>
          <span class="mono">Field notes · agentic AI</span>
        </div>
      </div>
    </footer>

    <Track />
    <AskWidget surface="/latest" />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
