---
// Layout for /latest — the published output of the retriever agent.
//
// Brand-neutral chrome, like the consulting surfaces: the notes are evidence
// that the practice tracks its field, and they serve the cohort and the
// consulting pages equally. Same design system, same nav grammar, so the
// section reads as part of one site rather than a bolted-on blog.
import '../styles/global.css';
// The V5 layer shared with `/` (25 September): header, ground, width, reading
// type, footer. A page template loads after it and refines it.
import '../styles/ds/site-v5.css';
import SeoHead from '../components/SeoHead.astro';
import AskWidget from '../components/AskWidget.astro';
import Track from '../components/Track.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import GoogleTagManagerNoscript from '../components/GoogleTagManagerNoscript.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import BrandLockup from '../components/site/BrandLockup.astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: unknown[];
  /** Section anchors for the nav — passed in because the themes are data-driven. */
  sections?: { id: string; title: string }[];
}

const { title, description, canonical, schema, sections = [] } = Astro.props;
const year = new Date().getFullYear();
// <body> takes `lc-v5` (V5's chrome) and `lc-v5-read` (V5's reading type):
// see ds/site-v5.css. Comments stay up here: a JSX comment between </head>
// and <body> makes Astro open an implicit <body> and loses these classes.
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <GoogleTagManager />
    <SeoHead title={title} description={description} canonical={canonical} schema={schema} />
  </head>
  <body class="lc-v5 lc-v5-read">
    <GoogleTagManagerNoscript />
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader
      brandHref="#top"
      sub="Field notes"
      action={{ label: 'The cohort', href: '/' }}
      pageLinks={sections.map((s) => [s.title, `#${s.id}`] as [string, string])}
      related={[
        ['Fractional CAIO', '/caio'],
        ['AI Readiness', '/assessment'],
      ]}
    />

    <main id="main">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <BrandLockup tile />
            <p class="muted">What is actually changing in agentic AI. Gathered from original sources, and read by a person before it is published.</p>
          </div>
          <div class="foot-col">
            <h2>Field notes</h2>
            {sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
            <a href="#method">How these are gathered</a>
          </div>
          <div class="foot-col">
            <h2>The practice</h2>
            <a href="/">The Living Craft · cohort <span aria-hidden="true">→</span></a>
            <a href="/caio">Fractional CAIO retainer <span aria-hidden="true">→</span></a>
            <a href="/assessment">AI Readiness Assessment <span aria-hidden="true">→</span></a>
            <a href="/resources">Resources · free tools <span aria-hidden="true">→</span></a>
          </div>
          <div class="foot-col">
            <h2>Connect</h2>
            <a href="mailto:apply@thelivingcraft.ai">apply@thelivingcraft.ai</a>
            <a href="https://linkedin.com/in/sunil-mathew-466615a" target="_blank" rel="noopener">LinkedIn</a>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© {year} Sunil Mathew · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></span>
          <span class="mono">Field notes · agentic AI</span>
        </div>
      </div>
    </footer>

    <Track />
    <AskWidget surface="/latest" />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
