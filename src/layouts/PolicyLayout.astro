---
// Shell for the policy pages — /privacy and /terms.
//
// Separate from BaseLayout because that nav is all #anchors into the cohort
// single-page, and a policy page is reached from a footer link, a Google
// consent screen, or a search result. Those anchors would all be dead.
//
// THIS SHELL CARRIES NO ANALYTICS, AND THAT IS THE POINT. No Track beacon, no
// Vercel Analytics, no Speed Insights, no Ask widget. A page whose job is to
// tell someone what is collected about them should not be collecting anything
// while they read it — and it means the sentence saying so in privacy.astro is
// true rather than aspirational. /api/track would drop the pageview anyway; its
// path allowlist is the three marketing surfaces only. This makes that
// deliberate instead of incidental.
//
// Indexed, unlike the gated shells: a privacy policy that a crawler or a
// consent screen cannot fetch does not do its job.
import '../styles/global.css';
// The V5 layer shared with `/` (25 September): header, ground, width, reading
// type, footer. A page template loads after it and refines it.
import '../styles/ds/site-v5.css';
import SeoHead from '../components/SeoHead.astro';
// STAGING ONLY (feat/programme-pathways, never merge): the user asked on 15
// October for /privacy and /terms to carry the programme pages' header and
// footer (the 15 October package's). `main` still uses SiteHeader and
// SiteFooter here. The package's footer has no Privacy, Terms or Cookie
// choices links; the pages themselves are those destinations.
import PackageHeader from '../components/programmes/PackageHeader.astro';
import PackageFooter from '../components/programmes/PackageFooter.astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  /** Which policy this is. Unused while the package header is on (staging only). */
  label: string;
}

const { title, description, canonical, label } = Astro.props;
// The package header's Enquire button goes to the programmes hub's enquiry form.
// <body> takes `lc-v5` (V5's chrome) and `lc-v5-read` (V5's reading type):
// see ds/site-v5.css. Comments stay up here: a JSX comment between </head>
// and <body> makes Astro open an implicit <body> and loses these classes.
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} canonical={canonical} />
  </head>
  <body class="lc-v5 lc-v5-read">
    <a class="skip" href="#main">Skip to content</a>
    <PackageHeader cta="Enquire" ctaHref="/programmes/#tell-us-what-you-want-to-achieve" />

    <main id="main">
      <slot />
    </main>

    <PackageFooter />
  </body>
</html>
