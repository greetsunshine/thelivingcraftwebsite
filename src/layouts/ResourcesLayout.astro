---
// Layout for /resources — the working material the practice publishes.
//
// Living Craft chrome rather than the brand-neutral chrome of /latest, and the
// reason is in the artifacts themselves: they are badged "The Living Craft",
// they are teaching material, and they carry the teaching register. Field notes
// are evidence for all three surfaces and stay brand-neutral; these do not.
//
// Separate from BaseLayout because BaseLayout's nav is all #anchors into the
// cohort single-page. Shared where it matters — global.css, SeoHead, Track and
// the Ask widget are the same on every public surface, and since 25 September
// the V5 header and footer (SiteHeader, ds/site-v5.css) are too.
//
// NO GOOGLE TAG MANAGER, ON PURPOSE. The Rule Placement Audit on this layout
// promises "nothing is sent to us", and the GTM container loads Microsoft
// Clarity, which records page text. Sharing chrome with the other layouts
// must never bring GTM with it: GTM lives in those layouts, not in SiteHeader.
import '../styles/global.css';
// The V5 chrome shared with `/` (25 September): header, ground, width, footer.
import '../styles/ds/site-v5.css';
// Every page this layout serves is a tool: the design system's tool template.
// It comes after the V5 layer, so a tool keeps its working heading.
import '../styles/templates/tool.css';
import SeoHead from '../components/SeoHead.astro';
import AskWidget from '../components/AskWidget.astro';
import Track from '../components/Track.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { TOOL_CREDIT } from '../data/resources';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import BrandLockup from '../components/site/BrandLockup.astro';
import FooterSummary from '../components/site/FooterSummary.astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: unknown[];
  /**
   * The resource id of the tool on this page. It marks <main> with `data-tool`,
   * so Track.astro can send `tool_started` on the first use (outreach readiness
   * handoff, 29 September 2026). A page with no working area leaves it out.
   */
  tool?: string;
  /** Series anchors for the nav — passed in because the series are data-driven. */
  sections?: { id: string; title: string }[];
  /**
   * The id of the section on this page that says how to use it, for the
   * footer's "How to use this" link. Omitted, the link is not drawn.
   *
   * Until 29 September 2026 the footer linked every page to `#how`, which only
   * the cost-ceiling workbook had, so the link went nowhere on nine pages (the
   * outreach readiness handoff, item 3). A page names its own section now, and
   * a page with no such section gets no link rather than an empty destination.
   */
  howTo?: string;
}

const { title, description, canonical, schema, sections = [], howTo, tool } = Astro.props;
// `lc-v5` and not `lc-v5-read` on <body>: a tool takes V5's chrome and ground,
// and keeps the design system's working heading and 16px workspace.
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} canonical={canonical} schema={schema} />
    {/* No tag manager on a tool page, ever (CLAUDE.md). The banner still asks,
        because the answer is the site's and the attribution cookies need it
        on the page where a visitor arrived. A yes loads nothing here. */}
    <ConsentBanner ask />
  </head>
  <body class="tool-page lc-v5">
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader
      brandHref="#top"
      sub="Resources"
      action={{ label: 'The cohort', href: '/' }}
      pageLinks={sections.map((s) => [s.title, `#${s.id}`] as [string, string])}
      related={[['Field notes', '/latest']]}
    />

    <main id="main" data-tool={tool}>
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <BrandLockup tile />
            <FooterSummary />
          </div>
          <div class="foot-col">
            <h2>Resources</h2>
            {sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
            {howTo && <a href={`#${howTo}`}>How to use this</a>}
          </div>
          <div class="foot-col">
            <h2>The practice</h2>
            <a href="/">The Living Craft · cohort →</a>
            <a href="/caio">Fractional CAIO retainer →</a>
            <a href="/assessment">AI Readiness Assessment →</a>
            <a href="/latest">Field notes · agentic AI →</a>
          </div>
          <div class="foot-col">
            <h2>Connect</h2>
            <a href="mailto:apply@thelivingcraft.ai">apply@thelivingcraft.ai</a>
            <a href="https://linkedin.com/in/sunil-mathew-466615a" target="_blank" rel="noopener">LinkedIn</a>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© {year} The Living Craft · {TOOL_CREDIT} · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="/communication-preferences">Email preferences</a></span>
          <span class="mono">Resources · agentic system design</span>
        </div>
      </div>
    </footer>

    <Track />
    <AskWidget surface="/resources" />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
