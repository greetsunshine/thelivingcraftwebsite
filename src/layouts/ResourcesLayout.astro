---
// Layout for /resources — the working material the practice publishes.
//
// Living Craft chrome rather than the brand-neutral chrome of /latest, and the
// reason is in the artifacts themselves: they are badged "The Living Craft",
// they are teaching material, and they carry the teaching register. Field notes
// are evidence for all three surfaces and stay brand-neutral; these do not.
//
// Separate from BaseLayout because BaseLayout's nav is all #anchors into the
// cohort single-page. Shared where it matters — global.css, SeoHead, Track and
// the Ask widget are the same on every public surface.
import '../styles/global.css';
// Every page this layout serves is a tool: the design system's tool template.
import '../styles/templates/tool.css';
import SeoHead from '../components/SeoHead.astro';
import AskWidget from '../components/AskWidget.astro';
import Track from '../components/Track.astro';
import { TOOL_CREDIT } from '../data/resources';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Logo from '../components/site/Logo.astro';
import MobileMenu from '../components/site/MobileMenu.astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: unknown[];
  /** Series anchors for the nav — passed in because the series are data-driven. */
  sections?: { id: string; title: string }[];
}

const { title, description, canonical, schema, sections = [] } = Astro.props;
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} canonical={canonical} schema={schema} />
  </head>
  <body class="tool-page">
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="wordmark" href="#top">
          <Logo /> the living craft
          <span class="wordmark-sub">Resources</span>
        </a>
        <nav class="navlinks">
          {sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
          <a href="/latest">Field notes</a>
          <a class="btn btn-primary" style="padding:10px 20px" href="/">The cohort&nbsp;<span class="arrow">→</span></a>
          {/* Phones: the links above are hidden below 900px (global.css), and this
              is how a phone reaches them. Same links, same order. */}
          <MobileMenu>
            {sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
            <a href="/latest">Field notes</a>
          </MobileMenu>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <div class="wordmark" style="margin-bottom:14px"><Logo tile /> the living craft</div>
            <p class="muted">Working material from the practice. Free to use, free to share, and built for the decision it names rather than for an audience.</p>
          </div>
          <div class="foot-col">
            <h5>Resources</h5>
            {sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
            <a href="#how">How to use these</a>
          </div>
          <div class="foot-col">
            <h5>The practice</h5>
            <a href="/">The Living Craft · cohort →</a>
            <a href="/caio">Fractional CAIO retainer →</a>
            <a href="/assessment">AI Readiness Assessment →</a>
            <a href="/latest">Field notes · agentic AI →</a>
          </div>
          <div class="foot-col">
            <h5>Connect</h5>
            <a href="mailto:apply@thelivingcraft.ai">apply@thelivingcraft.ai</a>
            <a href="https://linkedin.com/in/sunil-mathew-466615a" target="_blank" rel="noopener">LinkedIn</a>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© {year} The Living Craft · {TOOL_CREDIT} · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></span>
          <span class="mono">Resources · agentic system design</span>
        </div>
      </div>
    </footer>

    <Track />
    <AskWidget surface="/resources" />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
