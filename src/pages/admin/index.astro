---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import LineChart from '../../components/admin/LineChart.astro';
import Bars from '../../components/admin/Bars.astro';
import { funnel, leadCounts, leads, questionStats, questions, trafficDaily, trafficPaths } from '../../lib/admin/queries';
import { getRadar } from '../../lib/agent/radar';
import { getLatest } from '../../lib/agent/latest';
import { getBudget, formatUsd, WARN_FRACTION } from '../../lib/agent/budget';
import { dbHealth } from '../../lib/admin/health';

const DAYS = 30;

// Cached for ten minutes upstream, so this adds no meaningful latency.
const budget = await getBudget();

// The layout already shouts if something is broken. This panel is the other
// half: proof, when everything is fine, that the console actually asked —
// "no leads yet" means much more when you can see the table answered with 0.
const health = await dbHealth();

// One round trip's worth of latency instead of eight. Every one of these
// degrades to an empty result on its own, so a single slow rollup cannot take
// the page down with it.
const [daily, paths, steps, counts, recent, qStats, gaps] = await Promise.all([
  trafficDaily(DAYS),
  trafficPaths(DAYS),
  funnel(DAYS),
  leadCounts(),
  leads({ limit: 6 }),
  questionStats(DAYS),
  questions({ limit: 5, onlyGaps: true }),
]);

const views = daily.reduce((n, d) => n + Number(d.views), 0);
const visitors = daily.reduce((n, d) => n + Number(d.visitors), 0);

const stepOf = (type: string) => steps.find((s) => s.type === type)?.visitors ?? 0;

// The spine the practice is built on, read as people rather than events: how
// many landed, how many showed intent, how many actually handed over contact.
const FUNNEL = [
  { label: 'Landed on a page', value: stepOf('pageview') },
  { label: 'Followed a cross-page CTA', value: stepOf('cta_click') },
  { label: 'Opened the assistant', value: stepOf('ask_open') },
  { label: 'Asked it something', value: stepOf('ask_question') },
  { label: 'Started an application form', value: stepOf('apply_start') },
  { label: 'Submitted it', value: stepOf('apply_submit') },
];

const radar = await getRadar();
const latest = getLatest();

// null means "never run" — for the radar because no run has been recorded, and
// for latest because a fresh file carries the epoch as its refreshedAt, which
// subtracts to ~20,000 days and reads like a bug rather than "not run yet".
const daysSince = (iso: string | null) => {
  if (!iso) return null;
  const t = Date.parse(iso);
  if (Number.isNaN(t) || t < 86_400_000) return null;
  return Math.floor((Date.now() - t) / 86_400_000);
};

const radarAge = daysSince(radar.refreshedAt);
const latestAge = daysSince(latest.refreshedAt);

const when = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
---

<AdminLayout title="Overview" active="overview">
  <div class="page-head">
    <div>
      <span class="label">Last {DAYS} days</span>
      <h1>Overview</h1>
      <p>Traffic, what people asked, and who left their details.</p>
    </div>
  </div>

  <div class="tiles">
    <div class="tile">
      <div class="n">{views}</div>
      <div class="k label">Page views</div>
      <div class="note">{visitors} unique</div>
    </div>
    <div class="tile">
      <div class="n">{counts.last7}</div>
      <div class="k label">Leads · 7 days</div>
      <div class="note">{counts.total} all time</div>
    </div>
    <div class="tile">
      <div class="n">{qStats.total}</div>
      <div class="k label">Questions asked</div>
      <div class="note">{qStats.captured} led to a handoff</div>
    </div>
    {
      /* Two alert tiles, and both mean "go and do something". An undelivered
         lead never reached the inbox; an unanswered question is a hole in
         facts.ts that a prospect already fell into. */
      counts.undelivered > 0 ? (
        <div class="tile alert">
          <div class="n">{counts.undelivered}</div>
          <div class="k label">Never delivered</div>
          <div class="note">Reached the database, not the inbox</div>
        </div>
      ) : (
        <div class="tile">
          <div class="n">
            {qStats.gaps}
            <small> / {qStats.total}</small>
          </div>
          <div class="k label">Unanswered</div>
          <div class="note">The agent had nothing to say</div>
        </div>
      )
    }
  </div>

  <section class="panel">
    <h2>Traffic</h2>
    <p class="sub">First-party, bots excluded. Unique visitors reset daily by design.</p>
    <div class="card">
      <LineChart points={daily} />
    </div>
  </section>

  <section class="panel">
    <div class="grid-2">
      <div>
        <h2>Pages</h2>
        <p class="sub">Views over {DAYS} days.</p>
        <div class="card">
          <Bars
            rows={paths.map((p) => ({ label: p.path, value: Number(p.views), note: `${p.visitors} uniq` }))}
            empty="No page views recorded yet."
          />
        </div>
      </div>
      <div>
        <h2>Funnel</h2>
        <p class="sub">Distinct visitors reaching each step.</p>
        <div class="card">
          <Bars rows={FUNNEL} limit={6} empty="No events recorded yet." />
        </div>
      </div>
    </div>
  </section>

  <section class="panel">
    <div class="grid-2">
      <div>
        <h2>Latest leads</h2>
        <p class="sub">
          <a href="/admin/leads" style="color:var(--clay)">All leads →</a>
        </p>
        <div class="table-scroll">
          {
            recent.length === 0 ? (
              <p class="empty">No leads yet.</p>
            ) : (
              <table>
                <thead>
                  <tr>
                    <th>When</th>
                    <th>Who</th>
                    <th>Interest</th>
                    <th />
                  </tr>
                </thead>
                <tbody>
                  {recent.map((l) => (
                    <tr>
                      <td class="faint mono" style="font-size:12px;white-space:nowrap">{when(l.created_at)}</td>
                      <td>
                        <div>{l.name ?? '—'}</div>
                        <div class="faint" style="font-size:12.5px">{l.email}</div>
                      </td>
                      <td><span class="pill">{l.interest ?? l.surface}</span></td>
                      <td>{!l.delivered && <span class="pill warn">undelivered</span>}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )
          }
        </div>
      </div>

      <div>
        <h2>Questions it could not answer</h2>
        <p class="sub">
          Each one is a gap in <code class="mono">facts.ts</code>.
          <a href="/admin/questions" style="color:var(--clay)">All questions →</a>
        </p>
        <div class="table-scroll">
          {
            gaps.length === 0 ? (
              <p class="empty">Nothing unanswered.</p>
            ) : (
              <table>
                <tbody>
                  {gaps.map((q) => (
                    <tr>
                      <td>
                        <div>{q.question}</div>
                        <div class="faint mono" style="font-size:11.5px;margin-top:4px">
                          {when(q.created_at)} · {q.surface ?? '/'}
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="panel">
    <h2>Agent spend</h2>
    <p class="sub">
      Month to date, across the visitor assistant and both retrievers — they share one key.
    </p>
    {budget.known ? (
      <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap">
          <div>
            <span class="label">This month</span>
            <p style="margin-top:6px;font-size:26px;font-family:var(--font-display);">
              {formatUsd(budget.spentUsd)}
              <span style="font-size:15px;color:var(--ink-faint)"> of {formatUsd(budget.limitUsd)}</span>
            </p>
          </div>
          <span
            class="label"
            style={`color:${budget.overBudget ? 'var(--clay-deep)' : budget.nearLimit ? 'var(--ochre)' : 'var(--go, #5A7A4C)'}`}
          >
            {budget.overBudget ? 'paused' : budget.nearLimit ? 'near limit' : 'ok'}
          </span>
        </div>
        <div style="height:6px;background:var(--line);border-radius: var(--radius-inner);overflow:hidden;margin-top:12px">
          <div
            style={`height:100%;width:${Math.min(100, Math.round(budget.used * 100))}%;background:${
              budget.overBudget ? 'var(--clay-deep)' : budget.nearLimit ? 'var(--ochre)' : 'var(--clay)'
            }`}
          />
        </div>
        <p class="sub" style="margin-top:10px">
          {budget.overBudget
            ? 'The assistant is declining questions and the retrievers will not run. Raise AGENT_MONTHLY_BUDGET_USD or wait for the month to roll.'
            : budget.nearLimit
              ? `Retrievers stand down above ${Math.round(WARN_FRACTION * 100)}%; the assistant keeps answering until 100%.`
              : 'Read from the Anthropic cost report. This is a soft guard — the Console spend limit is the hard ceiling.'}
        </p>
      </div>
    ) : (
      <div class="card">
        <span class="label">Not tracked</span>
        <p style="margin-top:8px">{budget.note}</p>
        <p class="sub" style="margin-top:8px">
          Needs an organization account — the Admin API is unavailable for individual accounts.
        </p>
      </div>
    )}
  </section>

  <section class="panel">
    <h2>Agents</h2>
    <p class="sub">Both retrievers run weekly and open a PR rather than committing.</p>
    <div class="grid-2">
      <div class="card">
        <span class="label">Radar · operator-facing</span>
        <p style="margin-top:8px">
          <strong>{radar.items.length}</strong> findings on the board,
          {radarAge === null ? ' never run' : ` refreshed ${radarAge} day${radarAge === 1 ? '' : 's'} ago`}.
        </p>
        <p style="margin-top:10px"><a href="/admin/radar" style="color:var(--clay)">Open the radar →</a></p>
      </div>
      <div class="card">
        <span class="label">Latest · read by the visitor agent</span>
        <p style="margin-top:8px">
          <strong>{latest.items.length}</strong> items live,
          {latestAge === null ? ' never run' : ` refreshed ${latestAge} day${latestAge === 1 ? '' : 's'} ago`}.
        </p>
        <p style="margin-top:10px"><a href="/admin/content" style="color:var(--clay)">Review content →</a></p>
      </div>
    </div>
  </section>

  <section class="panel">
    <h2>Storage</h2>
    <p class="sub">
      Every table and rollup the console depends on, probed directly. A count of <code class="mono"
        >0</code
      > here means the table answered and is empty — which is a different thing from a table that is
      not there, and the two used to look identical.
    </p>
    <div class="card">
      {
        !health.configured ? (
          <p class="muted">Supabase is not configured, so there is nothing to probe.</p>
        ) : (
          <>
            <div class="health">
              {health.probes.map((p) => (
                <span class={p.ok ? 'obj' : 'obj bad'} title={p.error ?? ''}>
                  <span class="dot" />
                  {p.name}
                  {p.kind === 'table' && p.ok && <span class="n">{p.rows}</span>}
                </span>
              ))}
            </div>
            <p class="faint" style="font-size:12.5px;margin-top:14px">
              {health.ok
                ? `All ${health.probes.length} responding. Re-checked at most once a minute.`
                : `${health.broken.length} not responding — see the banner at the top of the page.`}
            </p>
          </>
        )
      }
    </div>
  </section>

  <section class="panel">
    <h2>Retention</h2>
    <p class="sub">
      Analytics events are kept 180 days and visitor questions 365, then deleted. Leads and
      learners are never purged on a timer — a real enquiry should not be lost to a cron job, so
      those are erased one person at a time from their own pages.
    </p>
    <div class="card">
      <p class="muted" style="font-size:14px">
        Check first — the count tells you whether this is a routine tidy or something worth
        pausing over.
      </p>
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:14px">
        <button class="btn" id="purgeCheck" disabled={!health.configured}>Check what is stale</button>
        <button class="btn primary" id="purgeApply" disabled hidden>Delete them</button>
      </div>
      <p class="status-line" id="purgeStatus"></p>
      <p class="faint" style="font-size:12.5px;margin-top:10px">
        The windows are function defaults in <code class="mono">supabase/schema.sql</code>, so
        shortening them is a SQL change with no deploy. To run this unattended, enable pg_cron —
        the schedule is written out, commented, at the bottom of that file. Until then the policy
        is only real if someone presses this.
      </p>
    </div>
  </section>

  <script is:inline>
    // Two steps on purpose. The first is read-only and tells you the size of
    // what you are about to do; the second only appears once you have seen it.
    (function () {
      var check = document.getElementById('purgeCheck');
      var apply = document.getElementById('purgeApply');
      var out = document.getElementById('purgeStatus');
      if (!check || !apply || !out) return;

      function call(body) {
        return fetch('/api/admin/purge', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        }).then(function (r) {
          return r.json().then(function (j) { return { ok: r.ok, j: j }; });
        });
      }

      check.addEventListener('click', function () {
        check.disabled = true;
        out.className = 'status-line';
        out.textContent = 'Counting…';

        call({}).then(function (res) {
          check.disabled = false;
          if (!res.ok) {
            out.className = 'status-line err';
            out.textContent = res.j.error || 'Could not check.';
            return;
          }
          var total = res.j.events + res.j.questions;
          out.className = 'status-line';
          if (total === 0) {
            out.textContent = 'Nothing is past its window.';
            apply.hidden = true;
            return;
          }
          out.textContent =
            res.j.events + ' event(s) and ' + res.j.questions + ' question(s) are past their window.';
          apply.hidden = false;
          apply.disabled = false;
        }).catch(function () {
          check.disabled = false;
          out.className = 'status-line err';
          out.textContent = 'Network error.';
        });
      });

      apply.addEventListener('click', function () {
        if (!confirm('Delete everything past its retention window?\n\nThis cannot be undone. Leads and learners are not affected.')) return;
        apply.disabled = true;
        out.className = 'status-line';
        out.textContent = 'Deleting…';

        call({ apply: true }).then(function (res) {
          if (!res.ok) {
            apply.disabled = false;
            out.className = 'status-line err';
            out.textContent = res.j.error || 'Could not purge.';
            return;
          }
          out.className = 'status-line ok';
          out.textContent = 'Deleted ' + res.j.events + ' event(s) and ' + res.j.questions + ' question(s).';
          apply.hidden = true;
        }).catch(function () {
          apply.disabled = false;
          out.className = 'status-line err';
          out.textContent = 'Network error.';
        });
      });
    })();
  </script>
</AdminLayout>
