---
export const prerender = false;

// Sunil's half of the discussion forum.
//
// The job was never "list what was asked". It was "five people are circling the
// same confusion about evals, and it is Wednesday." Opening the forum to peers
// added a second job that matters just as much and is easier to miss:
//
//   THE ROOM ANSWERED AND NOBODY CHECKED IT.
//
// A peer answer left uncorrected becomes what the cohort believes. That queue
// is therefore the first thing on this page — above the clusters, above the
// logistics — because it is the one that quietly costs something when ignored.
//
// Counting is code, per §4. The model supplied the cluster labels and nothing
// else.

import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  listAllThreads,
  repliesByThread,
  clusterThreads,
  needsReview,
  isUnanswered,
  type Reply,
} from '../../../lib/craft/discussion';
import { initials, relativeTime, displayTitle } from '../../../lib/craft/people';

const [threads, replyMap] = await Promise.all([listAllThreads(), repliesByThread()]);
const repliesFor = (id: string): Reply[] => replyMap.get(id) ?? [];

const unchecked = threads.filter((t) => needsReview(t, repliesFor(t.id)));
const waiting = threads.filter((t) => isUnanswered(t) && t.kind === 'content');
const clusters = clusterThreads(threads);
const course = threads.filter((t) => t.kind === 'course');

const when = (iso: string) =>
  new Date(iso).toLocaleString('en-GB', {
    day: 'numeric',
    month: 'short',
    hour: '2-digit',
    minute: '2-digit',
  });

const STATUSES = ['new', 'routed', 'answered'];

const sourceLabel: Record<string, string> = {
  facts: 'from facts.ts',
  session: 'from the session page',
  relay: 'relayed your earlier answer',
  sunil: 'your answer',
};
---

<AdminLayout title="Discussion" active="discussion">
  <div class="page-head">
    <div>
      <span class="label">
        {threads.length} threads · {unchecked.length} unchecked · {waiting.length} with no reply at all
      </span>
      <h1>Discussion</h1>
      <p>
        The cohort's forum. Logistics questions are answered from <code>facts.ts</code> and the
        session pages before anyone sees them — those are listed at the foot. Your reply is the
        only one the system will ever repeat to a later asker; a peer's never is.
      </p>
    </div>
  </div>

  {/* ---- 1. the queue that costs something when ignored ------------------ */}
  <section class="block">
    <header class="block-head">
      <h2>Answered by the room, unchecked by you</h2>
      <span class="count">{unchecked.length}</span>
    </header>
    <p class="block-note">
      Peers have answered these and you have neither replied nor endorsed anything. Whatever
      is written here is what the cohort currently believes.
    </p>

    {unchecked.length === 0 ? (
      <p class="empty">Nothing waiting. Every peer answer has been endorsed or corrected.</p>
    ) : (
      unchecked.map((t) => (
        <article class="thread" data-thread={t.id}>
          <div class="t-head">
            <a class="t-title" href={`/craft/discussion/${t.id}`}>{displayTitle(t.title, t.body)}</a>
            <span class="faint mono when">{relativeTime(t.last_activity)}</span>
          </div>
          <p class="t-meta faint">
            {t.learner_name ?? t.learner_email}
            {t.visibility === 'private' && <span class="pill warn">private</span>}
            {t.capability_id && <span class="pill">{t.capability_id}</span>}
          </p>
          <p class="t-body">{t.body}</p>

          <div class="peer-answers">
            {repliesFor(t.id)
              .filter((r) => r.author_role === 'learner')
              .map((r) => (
                <div class="peer" data-reply={r.id}>
                  <div class="peer-head">
                    <span class="ini" aria-hidden="true">{initials(r.author_name, '')}</span>
                    <span class="peer-who">{r.author_name ?? 'A learner'}</span>
                    <span class="faint mono when">{when(r.created_at)}</span>
                    <button class="endorse" data-reply-id={r.id}>Endorse this</button>
                  </div>
                  <p class="peer-body">{r.body}</p>
                </div>
              ))}
          </div>

          <details class="answer-slot">
            <summary>Answer it yourself</summary>
            <textarea
              class="answer-box"
              rows="4"
              placeholder="Your words. Anything you post here can be relayed verbatim to the next person who asks the same thing — nothing a learner writes ever is."
            ></textarea>
            <div class="answer-actions">
              <button class="btn primary save-answer">Post as Sunil</button>
              <span class="status-line faint"></span>
            </div>
          </details>
        </article>
      ))
    )}
  </section>

  {/* ---- 2. nobody has said anything ------------------------------------- */}
  <section class="block">
    <header class="block-head">
      <h2>No reply at all</h2>
      <span class="count">{waiting.length}</span>
    </header>
    <p class="block-note">
      Nobody in the room has answered these and the syllabus did not settle them. A thread that
      sits here past a session is one the room has quietly decided not to touch.
    </p>

    {waiting.length === 0 ? (
      <p class="empty">Nothing unanswered.</p>
    ) : (
      waiting.map((t) => (
        <article class="thread" data-thread={t.id}>
          <div class="t-head">
            <a class="t-title" href={`/craft/discussion/${t.id}`}>{displayTitle(t.title, t.body)}</a>
            <span class="faint mono when">{relativeTime(t.created_at)}</span>
          </div>
          <p class="t-meta faint">
            {t.learner_name ?? t.learner_email}
            {t.visibility === 'private' && <span class="pill warn">private</span>}
            {t.capability_id && <span class="pill">{t.capability_id}</span>}
          </p>
          <p class="t-body">{t.body}</p>

          <details class="answer-slot">
            <summary>Answer it</summary>
            <textarea class="answer-box" rows="4" placeholder="Your words."></textarea>
            <div class="answer-actions">
              <button class="btn primary save-answer">Post as Sunil</button>
              <span class="status-line faint"></span>
            </div>
          </details>
        </article>
      ))
    )}
  </section>

  {/* ---- 3. the clusters -------------------------------------------------- */}
  <section class="block">
    <header class="block-head">
      <h2>By theme</h2>
      <span class="count">{clusters.length}</span>
    </header>
    <p class="block-note">
      Everything about the material, grouped by the classifier's theme label and ordered by how
      many <em>different</em> people are in each.
    </p>

    {clusters.length === 0 ? (
      <p class="empty">Nothing about the material yet.</p>
    ) : (
      <div class="clusters">
        {clusters.map((c) => (
          <section class="cluster">
            <header class="cluster-head">
              <div>
                <h3>{c.label}</h3>
                {c.capability_id && <span class="pill cap">{c.capability_id}</span>}
              </div>
              <div class="cluster-count">
                <strong>{c.learners}</strong>
                <span>{c.learners === 1 ? 'person' : 'people'}</span>
                {c.open > 0 && <span class="pill open">{c.open} open</span>}
              </div>
            </header>

            <div class="cluster-body">
              {c.threads.map((t) => (
                <div class="cl-row" data-thread={t.id}>
                  <a class="cl-title" href={`/craft/discussion/${t.id}`}>{displayTitle(t.title, t.body)}</a>
                  <span class="cl-facts faint mono">
                    {t.learner_name ?? t.learner_email} · {t.reply_count} {t.reply_count === 1 ? 'reply' : 'replies'} · {relativeTime(t.last_activity)}
                  </span>
                  <span class="cl-actions">
                    <label class="pin">
                      <input type="checkbox" class="pin-box" checked={t.pinned} /> pin
                    </label>
                    <select class="thread-status">
                      {STATUSES.map((s) => (
                        <option value={s} selected={s === t.status}>{s}</option>
                      ))}
                    </select>
                    <span class="status-line faint"></span>
                  </span>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    )}
  </section>

  {/* ---- 4. logistics ----------------------------------------------------- */}
  <section class="block">
    <header class="block-head">
      <h2>Logistics</h2>
      <span class="count">{course.length}</span>
    </header>
    <p class="block-note">
      Answered by code from <code>facts.ts</code> and session frontmatter, and posted into the
      thread as a reply marked <em>not a person</em>. Here so you can see what the syllabus does
      not make obvious — anything marked <em>unanswered</em> fell through and is with you.
    </p>

    {course.length === 0 ? (
      <p class="empty">None yet.</p>
    ) : (
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>When</th><th>Learner</th><th>Asked</th><th>Answered from</th></tr>
          </thead>
          <tbody>
            {course.map((t) => (
              <tr>
                <td data-label="When" class="faint mono" style="font-size:12px;white-space:nowrap">{when(t.created_at)}</td>
                <td data-label="Learner" style="min-width:180px">{t.learner_name ?? t.learner_email}</td>
                <td data-label="Asked" style="max-width:420px">
                  <a href={`/craft/discussion/${t.id}`}>{t.body}</a>
                </td>
                <td data-label="Answered from" style="white-space:nowrap">
                  {t.answer_source
                    ? <span class="pill">{sourceLabel[t.answer_source]}</span>
                    : <span class="pill warn">unanswered — with you</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>
</AdminLayout>

<script>
  function post(body: Record<string, unknown>) {
    return fetch('/api/craft/admin/discussion', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    }).then((r) => r.json().then((j) => ({ ok: r.ok, j })));
  }

  document.querySelectorAll<HTMLElement>('[data-thread]').forEach((row) => {
    const threadId = row.dataset.thread!;
    const line = row.querySelector('.status-line') as HTMLElement | null;
    const say = (text: string, bad = false) => {
      if (!line) return;
      line.textContent = text;
      line.style.color = bad ? 'var(--clay-deep)' : 'var(--good)';
    };

    row.querySelector('.save-answer')?.addEventListener('click', async () => {
      const box = row.querySelector('.answer-box') as HTMLTextAreaElement;
      if (!box.value.trim()) return say('Write an answer first.', true);
      say('Posting…');
      const { ok, j } = await post({ action: 'reply', threadId, body: box.value });
      say(ok ? 'Posted — it can now be relayed.' : (j.error ?? 'Failed'), !ok);
      if (ok) setTimeout(() => window.location.reload(), 700);
    });

    row.querySelectorAll<HTMLButtonElement>('.endorse').forEach((b) => {
      b.addEventListener('click', async () => {
        b.disabled = true;
        const { ok, j } = await post({
          action: 'endorse',
          threadId,
          replyId: b.dataset.replyId,
        });
        if (ok) {
          b.textContent = 'Endorsed';
          setTimeout(() => window.location.reload(), 700);
        } else {
          b.disabled = false;
          say(j.error ?? 'Failed', true);
        }
      });
    });

    row.querySelector('.pin-box')?.addEventListener('change', async (e) => {
      const pinned = (e.target as HTMLInputElement).checked;
      say('Saving…');
      const { ok, j } = await post({ action: 'pin', threadId, pinned });
      say(ok ? (pinned ? 'Pinned.' : 'Unpinned.') : (j.error ?? 'Failed'), !ok);
    });

    row.querySelector('.thread-status')?.addEventListener('change', async (e) => {
      const status = (e.target as HTMLSelectElement).value;
      say('Saving…');
      const { ok, j } = await post({ action: 'status', threadId, status });
      say(ok ? 'Status updated.' : (j.error ?? 'Failed'), !ok);
    });
  });
</script>

<style>
  .block { margin-bottom: 52px; }
  .block-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    border-top: 2px solid var(--ink);
    padding-top: 14px;
  }
  .block-head h2 { font-size: 20px; margin: 0; }
  .block-head .count {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }
  .block-note { max-width: 76ch; font-size: 13px; color: var(--ink-soft); margin: 6px 0 18px; }

  /* --- a thread awaiting something -------------------------------------- */
  .thread { padding: 16px 0; border-top: 1px solid var(--line); }
  .t-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .t-title { font-size: 15px; font-weight: 500; }
  .when { font-size: 11.5px; white-space: nowrap; }
  .t-meta { display: flex; align-items: center; gap: 8px; font-size: 12.5px; margin: 4px 0 8px; }
  .t-body {
    margin: 0;
    white-space: pre-wrap;
    font-size: 13.5px;
    max-width: 78ch;
    color: var(--ink-soft);
  }

  /* --- peer answers, the ones needing a verdict ------------------------- */
  .peer-answers { margin: 14px 0 0; display: flex; flex-direction: column; gap: 12px; }
  .peer {
    padding: 12px 14px;
    background: var(--surface-sunken);
    border-radius: var(--radius-inner);
  }
  .peer-head { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; flex-wrap: wrap; }
  .ini {
    width: 24px;
    height: 24px;
    flex: none;
    border-radius: var(--radius-pill);
    background: var(--noir);
    color: var(--paper-1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 10px;
  }
  .peer-who { font-weight: 500; font-size: 13px; margin-right: auto; }
  .peer-body { margin: 0; white-space: pre-wrap; font-size: 13.5px; max-width: 78ch; }

  .endorse {
    border: 1px solid var(--line-strong);
    background: transparent;
    border-radius: var(--radius-pill);
    padding: 4px 12px;
    font-family: inherit;
    font-size: 11.5px;
    color: var(--clay);
    cursor: pointer;
  }
  .endorse:hover { background: var(--accent-quiet); }
  .endorse:disabled { opacity: 0.6; cursor: default; }

  /* --- answer slot ------------------------------------------------------ */
  .answer-slot { margin-top: 12px; }
  .answer-slot summary { cursor: pointer; font-size: 12.5px; color: var(--clay); }
  .answer-box {
    width: 100%;
    max-width: 720px;
    margin-top: 10px;
    padding: 10px 12px;
    font: inherit;
    font-size: 13.5px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    resize: vertical;
  }
  .answer-actions { display: flex; align-items: center; gap: 12px; margin-top: 10px; flex-wrap: wrap; }
  .status-line { font-size: 12px; }

  /* --- clusters --------------------------------------------------------- */
  .clusters { display: flex; flex-direction: column; gap: 28px; }
  .cluster-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 0 0 10px;
    border-bottom: 1px solid var(--line);
  }
  .cluster-head > div:first-child { display: flex; align-items: baseline; gap: 10px; }
  .cluster-head h3 { font-size: 17px; margin: 0; }
  .cluster-count { display: flex; align-items: baseline; gap: 8px; }
  .cluster-count strong {
    font-family: var(--font-display);
    font-size: 22px;
    font-variant-numeric: tabular-nums;
  }
  .cluster-count span { font-size: 12.5px; color: var(--ink-soft); }

  .cluster-body { display: flex; flex-direction: column; }
  .cl-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px 16px;
    align-items: baseline;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
  }
  .cl-title { font-size: 13.5px; font-weight: 500; }
  .cl-facts { font-size: 11.5px; grid-column: 1; }
  .cl-actions {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .pin { display: flex; align-items: center; gap: 5px; font-size: 11.5px; color: var(--ink-soft); }

  .pill.cap { color: var(--ink-faint); }
  .pill.open { color: var(--clay); border-color: var(--clay); }
  .pill.warn { color: var(--clay-deep); border-color: var(--clay-deep); }

  @media (max-width: 720px) {
    .cl-row { grid-template-columns: 1fr; }
    .cl-actions { grid-column: 1; grid-row: auto; justify-content: flex-start; }
    .t-head { flex-direction: column; gap: 4px; }
  }
</style>
