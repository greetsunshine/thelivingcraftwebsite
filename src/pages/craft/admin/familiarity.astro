---
export const prerender = false;

// Sunil's half of the familiarity re-ask (spec §5.6).
//
// "Six of eight rated A5 at 2 or below" aims week 3 before it is taught. That
// is the whole return on asking the question at week 0, and it was the missing
// half of this feature.
//
// NOTHING HERE ASSIGNS A LEVEL. Every figure is a count over what people said
// about themselves — see §2 and §10 on why a room of eight director-level
// engineers gets counts and not scores.

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';
import { listIntake } from '../../../lib/craft/intake';
import { listFamiliarity, roomByCapability, sayShowFlags } from '../../../lib/craft/familiarity';
import { listAllThreadsWithLearner } from '../../../lib/craft/discussion';
import { listAllPulses, sessionMoves } from '../../../lib/craft/pulses';

const [intakeRows, week6, threads, pulses, sessions] = await Promise.all([
  listIntake(),
  listFamiliarity(),
  listAllThreadsWithLearner(),
  listAllPulses(),
  getCollection('sessions'),
]);

// Did the session move the thing it taught? Paired ratings only — see
// sessionMoves() for why an unpaired mean measures who replied rather than what
// they learned.
const moves = sessionMoves(
  sessions.map((s) => ({
    week: s.data.week,
    title: s.data.title,
    topics: s.data.topics,
    startsAt: s.data.startsAt,
    endsAt: s.data.endsAt,
  })),
  pulses,
);

const submitted = intakeRows.filter((r) => r.submitted_at);
const room = roomByCapability(submitted, week6);

// "Has this person asked anything about this capability?" — the show half of
// say-vs-show. Counted here, from discussion threads that were tagged.
const asked = new Map<string, number>();
for (const d of threads) {
  if (!d.capability_id) continue;
  const key = `${d.learner_id}:${d.capability_id}`;
  asked.set(key, (asked.get(key) ?? 0) + 1);
}
const nameOf = new Map(threads.map((d) => [d.learner_id, d.learner_name ?? d.learner_email]));
const flags = sayShowFlags(submitted, asked);

const cohortSize = submitted.length;
const reAsked = week6.length;

const bar = (values: number[]) => {
  const counts = [1, 2, 3, 4, 5].map((n) => values.filter((v) => v === n).length);
  const total = values.length || 1;
  return counts.map((c, i) => ({ rating: i + 1, count: c, pct: (c / total) * 100 }));
};
---

<AdminLayout title="Familiarity" active="familiarity">
  <div class="page-head">
    <div>
      <span class="label">
        {cohortSize} intake {cohortSize === 1 ? 'response' : 'responses'} · {reAsked} re-asked at week 6
      </span>
      <h1>Familiarity — the room</h1>
      <p>
        Where the room says it is, per capability, weakest first. Self-ratings on the
        intake's own 1–5 behavioural scale — what people believe about themselves, which is
        useful for aiming a session and is not evidence of capability.
      </p>
    </div>
  </div>

  {/* --- did the session move what it taught? ---------------------------- */}
  <section class="moves-block">
    <header class="block-head">
      <h2>What each session moved</h2>
      <span class="count">{moves.length} {moves.length === 1 ? 'session' : 'sessions'}</span>
    </header>
    <p class="block-note">
      The same capabilities rated either side of one session, so the change is attributable
      to that session rather than to six weeks passing. <strong>Smallest movement first</strong> —
      a capability a session failed to shift is the one worth your attention, and a
      biggest-gain ordering buries it. Paired ratings only: someone who answered before and
      not after counts in neither column, because otherwise the difference measures who
      replied rather than what they learned.
    </p>

    {moves.length === 0 ? (
      <p class="empty">
        Nothing yet. A row appears once at least one learner has rated both sides of a
        session — which needs <code>startsAt</code> and <code>endsAt</code> on the session file.
      </p>
    ) : (
      moves.map((m) => (
        <section class="move">
          <header class="move-head">
            <h3>Week {m.week} · {m.title}</h3>
            <span class="faint mono">{m.learners} {m.learners === 1 ? 'learner' : 'learners'} rated both sides</span>
          </header>
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>Capability</th>
                  <th class="num">Before</th>
                  <th class="num">After</th>
                  <th class="num">Change</th>
                  <th class="num">n</th>
                </tr>
              </thead>
              <tbody>
                {m.capabilities.map((c) => (
                  <tr>
                    <td data-label="Capability"><span class="pill">{c.capability}</span> {c.text}</td>
                    <td data-label="Before" class="num faint">{c.before.toFixed(1)}</td>
                    <td data-label="After" class="num">{c.after.toFixed(1)}</td>
                    <td data-label="Change" class="num">
                      <span class={c.change > 0 ? 'up' : c.change < 0 ? 'down' : 'flat'}>
                        {c.change > 0 ? '+' : ''}{c.change.toFixed(1)}
                      </span>
                    </td>
                    <td data-label="n" class="num faint">{c.n}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))
    )}
  </section>

  {cohortSize === 0 ? (
    <p class="empty">No submitted intake responses yet.</p>
  ) : (
    <div class="caps">
      {room.map((c) => (
        <section class="cap">
          <header class="cap-head">
            <span class="pill">{c.id}</span>
            <p class="cap-text">{c.text}</p>
            {c.lowAtStart > 0 && (
              <span class="low">
                <strong>{c.lowAtStart} of {c.before.length}</strong> at 2 or below
              </span>
            )}
          </header>

          <div class="rows">
            <div class="row">
              <span class="row-label label">Week 0</span>
              <div class="scale">
                {bar(c.before).map((b) => (
                  <div class={`slot${b.count ? ' filled' : ''}`} title={`${b.count} rated ${b.rating}`}>
                    <span class="slot-bar" style={`height:${Math.max(b.pct, b.count ? 8 : 0)}%`}></span>
                    <span class="slot-n mono">{b.count || ''}</span>
                    <span class="slot-k mono">{b.rating}</span>
                  </div>
                ))}
              </div>
            </div>

            {c.after.length > 0 && (
              <div class="row">
                <span class="row-label label">Week 6</span>
                <div class="scale">
                  {bar(c.after).map((b) => (
                    <div class={`slot after${b.count ? ' filled' : ''}`} title={`${b.count} rated ${b.rating}`}>
                      <span class="slot-bar" style={`height:${Math.max(b.pct, b.count ? 8 : 0)}%`}></span>
                      <span class="slot-n mono">{b.count || ''}</span>
                      <span class="slot-k mono">{b.rating}</span>
                    </div>
                  ))}
                </div>
                <span class="movement mono faint">
                  {c.moved > 0 ? `+${c.moved}` : c.moved} across {c.after.length}
                  {c.flat > 0 && ` · ${c.flat} unchanged`}
                </span>
              </div>
            )}
          </div>
        </section>
      ))}
    </div>
  )}

  <section class="flags-block">
    <h2>Says, but has not asked</h2>
    <p class="faint">
      Rated a capability 4 or 5 at intake and has asked nothing about it all cohort. Not a
      score and not shown to the learner — a prompt to look, and often just someone who
      genuinely knows it.
    </p>

    {flags.length === 0 ? (
      <p class="empty">Nothing flagged.</p>
    ) : (
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Learner</th><th>Capability</th><th>Self-rating</th><th>Why flagged</th></tr>
          </thead>
          <tbody>
            {flags.map((f) => (
              <tr>
                <td data-label="Learner">{nameOf.get(f.learner_id) ?? f.learner_id.slice(0, 8)}</td>
                <td data-label="Capability"><span class="pill">{f.capability}</span></td>
                <td data-label="Self-rating" class="mono">{f.selfRating}/5</td>
                <td data-label="Why flagged" class="faint">{f.reason}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>
</AdminLayout>

<style>
  .moves-block { margin-bottom: 52px; }
  .block-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    border-top: 2px solid var(--ink);
    padding-top: 14px;
  }
  .block-head h2 { font-size: 20px; margin: 0; }
  .block-head .count {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-faint);
  }
  .block-note { max-width: 78ch; font-size: 13px; color: var(--ink-soft); margin: 6px 0 20px; }
  .block-note strong { color: var(--ink); font-weight: 500; }

  .move { margin-bottom: 26px; }
  .move-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 4px;
  }
  .move-head h3 { font-size: 16px; margin: 0; }
  .move-head span { font-size: 11.5px; }

  /* Direction is the reading, so it gets colour; the magnitude is in the number. */
  .up   { color: var(--good); font-weight: 500; }
  .down { color: var(--clay-deep); font-weight: 500; }
  .flat { color: var(--ink-faint); }
</style>

<style>
  .caps { display: flex; flex-direction: column; gap: 30px; }

  .cap { border-top: 1px solid var(--line); padding-top: 16px; }

  .cap-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .cap-text { margin: 0; flex: 1 1 340px; font-size: 14px; max-width: 70ch; }
  .low { font-size: 13px; color: var(--ink-soft); white-space: nowrap; }
  .low strong { color: var(--clay-deep); }

  .rows { display: flex; flex-direction: column; gap: 10px; }
  .row { display: flex; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
  .row-label { width: 56px; flex: none; padding-bottom: 4px; }

  .scale {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 54px;
  }
  .slot {
    position: relative;
    width: 42px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    gap: 2px;
  }
  .slot-bar {
    width: 100%;
    background: var(--line-strong);
    min-height: 1px;
  }
  .slot.filled .slot-bar { background: var(--ink-faint); }
  .slot.after.filled .slot-bar { background: var(--clay); }
  .slot-n {
    position: absolute;
    top: 0;
    font-size: 11px;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .slot-k { font-size: 10px; color: var(--ink-faint); }

  .movement { font-size: 11.5px; padding-bottom: 4px; }

  .flags-block { margin-top: 64px; padding-top: 20px; border-top: 2px solid var(--ink); }
  .flags-block h2 { font-size: 20px; margin: 0 0 6px; }
  .flags-block > p { max-width: 72ch; font-size: 13.5px; margin-bottom: 20px; }
</style>
