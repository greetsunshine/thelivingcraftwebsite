---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import LineChart from '../../../components/admin/LineChart.astro';
import Bars from '../../../components/admin/Bars.astro';
import { PATHS_CAP, funnel, trafficBreakdown, trafficDaily, trafficPaths } from '../../../lib/admin/queries';
import { labelFor } from '../../../lib/admin/event-labels';

// Range is a link, not a control — the page is server-rendered, so a plain
// query parameter needs no script and survives a bookmark.
const RANGES = [7, 30, 90];
const requested = Number(Astro.url.searchParams.get('days'));
const days = RANGES.includes(requested) ? requested : 30;

const [daily, paths, referrers, countries, devices, steps] = await Promise.all([
  trafficDaily(days),
  trafficPaths(days),
  trafficBreakdown(days, 'referrer_host'),
  trafficBreakdown(days, 'country'),
  trafficBreakdown(days, 'device'),
  funnel(days),
]);

const views = daily.reduce((n, d) => n + Number(d.views), 0);
const visitors = daily.reduce((n, d) => n + Number(d.visitors), 0);
const busiest = daily.reduce((best, d) => (Number(d.views) > Number(best.views) ? d : best), daily[0]);

const stepOf = (type: string) => steps.find((s) => s.type === type)?.visitors ?? 0;
/** For the two events the SERVER writes after a commit. They carry no visitor hash, so count rows. */
const countOf = (type: string) => Number(steps.find((s) => s.type === type)?.events ?? 0);

// The seven events of the revised outreach readiness handoff (29 September
// 2026), in the order a visitor meets them, with the older steps between.
// A cohort link is `cohort_cta_clicked` since that day, not `cta_click`.
// `cta_click` is not added in: it still counts links to /caio, /assessment and
// the booking widget, and adding it would count those as cohort links.
//
// Every row reads ONE key from admin_event_key() in supabase/schema.sql, and no
// two rows are added together. Each row is a count of distinct visitors, and
// summing two of them counts somebody who did both twice. Form starts are split
// by form there; the two that carry no usable form name (`unrecorded`, and
// `other` for a form nobody has listed yet) appear only when they have rows.
// Labels come from src/lib/admin/event-labels.ts, shared with the page detail.
// Every row opens its own detail page: /craft/admin/traffic/step?key=...
const stepHref = (key: string) => `/craft/admin/traffic/step?days=${days}&key=${encodeURIComponent(key)}`;
const step = (key: string) => ({ label: labelFor(key), value: stepOf(key), href: stepHref(key) });
const ifAny = (key: string) => (stepOf(key) > 0 ? [step(key)] : []);
const FUNNEL = [
  step('pageview'),
  step('tool_started'),
  step('useful_result_completed'),
  { label: labelFor('resource_requested'), value: countOf('resource_requested'), href: stepHref('resource_requested') },
  step('requested_delivery_confirmed'),
  step('cohort_cta_clicked'),
  step('form_started:application'),
  { label: labelFor('application_saved'), value: countOf('application_saved'), href: stepHref('application_saved') },
  step('form_started:enquiry'),
  step('form_started:enterprise'),
  step('cta_click'),
  step('form_started:consulting'),
  ...ifAny('form_started:other'),
  ...ifAny('form_started:unrecorded'),
  step('ask_open'),
  step('ask_question'),
];

// A country code alone is a lookup task for the reader. Only the three that
// have a pricing region are named — inventing a full ISO table here would be
// 200 lines of data with no other consumer.
const NAMED: Record<string, string> = { IN: 'India', AE: 'UAE', AU: 'Australia', GB: 'UK', US: 'United States', SG: 'Singapore' };
---

<AdminLayout title="Traffic" active="traffic">
  <div class="page-head">
    <div>
      <span class="label">Last {days} days</span>
      <h1>Traffic</h1>
      <p>
        First-party counts, recorded by the site itself. Bots are excluded and IP addresses are
        never stored — a visitor is a salted daily hash, so the unique count resets at midnight
        UTC and nobody is tracked across days.
      </p>
    </div>
    <div class="cat-nav" style="margin:0">
      {RANGES.map((r) => <a class={r === days ? 'on' : ''} href={`/craft/admin/traffic?days=${r}`}>{r} days</a>)}
    </div>
  </div>

  <div class="tiles">
    <div class="tile">
      <div class="n">{views}</div>
      <div class="k label">Page views</div>
    </div>
    <div class="tile">
      <div class="n">{visitors}</div>
      <div class="k label">Unique visitors</div>
      <div class="note">Counted per day, then summed</div>
    </div>
    <div class="tile">
      <div class="n">{views && visitors ? (views / visitors).toFixed(1) : '—'}</div>
      <div class="k label">Views per visitor</div>
    </div>
    <div class="tile">
      <div class="n">{busiest ? Number(busiest.views) : 0}</div>
      <div class="k label">Busiest day</div>
      <div class="note">
        {busiest ? new Date(`${busiest.day}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }) : '—'}
      </div>
    </div>
  </div>

  <section class="panel">
    <h2>Daily</h2>
    <p class="sub">Hover a column for that day's figures.</p>
    <div class="card">
      <LineChart points={daily} height={220} />
    </div>
  </section>

  <section class="panel">
    <div class="grid-2">
      <div>
        <h2>Pages</h2>
        <p class="sub">Which surface is doing the work. Open a page to see where its visitors came from and went next.</p>
        <div class="card">
          <Bars
            rows={paths.map((p) => ({
              label: p.path,
              value: Number(p.views),
              note: `${p.visitors} uniq`,
              href: `/craft/admin/traffic/page?days=${days}&path=${encodeURIComponent(p.path)}`,
            }))}
            limit={paths.length}
            empty="No page views recorded yet."
          />
          {
            paths.length >= PATHS_CAP && (
              <p class="faint" style="font-size:12.5px;margin-top:12px">
                Showing the {PATHS_CAP} most-viewed pages. Others in this range are not listed.
              </p>
            )
          }
        </div>
      </div>
      <div>
        <h2>Funnel</h2>
        <p class="sub">
          Distinct visitors at each step of the assessment → CAIO → cohort spine. Open a step to see where it happened and where those visitors came from.
        </p>
        <div class="card">
          <Bars rows={FUNNEL} limit={FUNNEL.length} empty="No events recorded yet." />
        </div>
      </div>
    </div>
  </section>

  <section class="panel">
    <div class="grid-2">
      <div>
        <h2>Referrers</h2>
        <p class="sub">Host only — never the full referring URL.</p>
        <div class="card">
          <Bars
            rows={referrers.map((r) => ({ label: r.label, value: Number(r.views) }))}
            empty="Nothing but direct visits so far."
          />
        </div>
      </div>
      <div>
        <h2>Where from</h2>
        <p class="sub">From Vercel's edge header, not a geo-IP lookup of our own.</p>
        <div class="card">
          <Bars
            rows={countries.map((c) => ({ label: NAMED[c.label] ?? c.label, value: Number(c.views) }))}
            empty="No country data yet."
          />
        </div>
      </div>
    </div>
  </section>

  <section class="panel">
    <h2>Device</h2>
    <p class="sub">Worth watching: the consulting pages are read on phones more than the cohort page.</p>
    <div class="card">
      <Bars rows={devices.map((d) => ({ label: d.label, value: Number(d.views) }))} limit={4} empty="No device data yet." />
    </div>
  </section>
</AdminLayout>
