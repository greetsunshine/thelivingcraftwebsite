---
// The ADR surface — one page per week, tied to that week's assignment (§5.5).
//
// WHAT "TIED TO" HAD TO START MEANING. This page used to list every session
// whose `assignment` field was truthy, and weeks 2-6 carry the placeholder
// string "TBD" — so it offered five submit forms headed "Week 2: TBD" for work
// nobody had been set. Sunil's console and the dashboard both excluded the
// placeholder already; this page was the one that did not.
//
// Both halves of the tie now come from src/lib/craft/assignments.ts:
//   - the assignment must EXIST (not the placeholder), and
//   - it must have been GIVEN — the session that sets it has ended, on the same
//     clock the week's knowledge check opens on.
//
// THE TEMPLATE ITSELF STAYS FIXED, on purpose. §5.5 wants week 6 comparable to
// week 1, so the five sections never vary by week. What varies is the brief
// above them. The helper text under each label is the spec's own wording for
// what that section is for, which is more use than "What is the solution?".
import CraftLayout from '../../layouts/CraftLayout.astro';
import { getCollection } from 'astro:content';
import { listLearnerSubmissions, ADR_MAX_CHARS } from '../../lib/craft/submissions';
import { givenAssignments, assignments as allAssignments } from '../../lib/craft/assignments';
import { ADR_SECTIONS, parseAdr, emptyAdr } from '../../lib/craft/adr';
import { renderMarkdown } from '../../lib/craft/markdown';

export const prerender = false;
const learner = Astro.locals.learner!;
const submissions = await listLearnerSubmissions(learner.id);

const sessionData = (await getCollection('sessions')).map((s) => ({
  week: s.data.week,
  title: s.data.title,
  assignment: s.data.assignment,
  endsAt: s.data.endsAt,
}));

const live = givenAssignments(sessionData);
// Written but not yet given — named on the page so an empty list explains
// itself instead of looking broken.
const upcoming = allAssignments(sessionData).filter((a) => !a.given);

// The first one not yet submitted, else the most recent — where someone
// arriving mid-cohort actually wants to land.
const unsubmitted = live.find(
  (a) => !submissions.some((sub) => sub.week === a.week && sub.status === 'submitted'),
);
const defaultWeek = unsubmitted ? unsubmitted.week : (live[live.length - 1]?.week ?? 0);

// The template lives in ONE place now — src/lib/craft/adr.ts. It used to be
// written out three times in this file (parse, render, reassemble), which is the
// same shape of mistake as the four hand-written copies of `'TBD'`, and worse in
// its failure mode: a section the parser did not know about was dropped on the
// next save, taking the learner's text with it.
---

<CraftLayout title="ADRs" learner={learner}>
  <div class="wrap page-narrow" style="max-width: 780px; margin: 0 auto;">
    <h1 style="font-size:clamp(30px,4.4vw,46px);margin:0 0 16px">Architecture Decision Records</h1>
    <p class="lead" style="margin-bottom: 40px;">
      One page per week, on the decision that week's assignment forced. Same seven sections
      every time — so week 6 can be read against week 1, and so can you.
    </p>

    {live.length === 0 ? (
      <div class="adr-blank">
        <h2>No assignment has been set yet</h2>
        <p>
          Each week's decision record unlocks when that session ends and its assignment is
          given. Nothing to write against before then.
        </p>
        {upcoming.length > 0 && (
          <ul class="upcoming">
            {upcoming.map((a) => (
              <li><span class="mono wk">W{a.week}</span> {a.title}</li>
            ))}
          </ul>
        )}
      </div>
    ) : (
    <div class="adr-container">
      <div class="adr-sidebar">
        <h3 class="mono faint" style="font-size:12px;margin-bottom:16px;text-transform:uppercase;letter-spacing:0.05em">Assignments</h3>
        <div class="week-nav">
          {live.map(a => {
            const sub = submissions.find(sub => sub.week === a.week);
            const isDefault = a.week === defaultWeek;
            const done = sub?.status === 'submitted';
            return (
              <button
                class={`week-btn ${isDefault ? 'active' : ''} ${done ? 'submitted' : ''}`}
                data-week={a.week}
              >
                <span class="wk">Week {a.week}</span>
                <span class="title">{a.title}</span>
                {done ? <span class="badge ok">✓</span> : sub ? <span class="badge draft">draft</span> : null}
              </button>
            )
          })}
        </div>

        {upcoming.length > 0 && (
          <p class="later faint">
            {upcoming.length} more {upcoming.length === 1 ? 'assignment' : 'assignments'} unlock
            as those sessions run.
          </p>
        )}
      </div>

      <div class="adr-content">
        {live.map(a => {
          const sub = submissions.find(sub => sub.week === a.week);
          return (
            <div class="week-panel" id={`panel-${a.week}`} style={{ display: a.week === defaultWeek ? 'block' : 'none' }}>
              {/* The brief. The ADR is about THIS, and it should be readable
                  without leaving the form to go and remember what was set. */}
              <div class="brief">
                <p class="mono brief-eyebrow">Week {a.week} assignment · {a.sessionTitle}</p>
                <h2>{a.title}</h2>
                <p class="brief-note">
                  Write the decision this forced you into — not a summary of the session.
                  <a href={`/craft/quiz?week=${a.week}`}>The week {a.week} check</a> rehearsed
                  the same trade-off in the abstract; this is where you record what you
                  actually did about it.
                </p>
              </div>

              <div style="margin-bottom:24px">
                {sub?.status === 'draft' && <p class="faint mono" style="font-size:12px">Draft saved {new Date(sub.updated_at).toLocaleString('en-GB')}</p>}
              </div>

              {sub?.status === 'submitted' ? (
                <div class="submitted-view">
                  <p class="locked-note mono">
                    Submitted{sub.submitted_at ? ` ${new Date(sub.submitted_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long' })}` : ''}.
                    Sunil reads these as a set, so the text is fixed once it is in — ask him if you need it reopened.
                  </p>
                  <div class="markdown-body" set:html={renderMarkdown(sub.adr_markdown)} />
                  {sub.repo_url && (
                    <div style="margin-top:24px;padding-top:16px;border-top:1px solid var(--line);">
                      <a href={sub.repo_url} target="_blank" rel="noopener noreferrer" style="color:var(--clay);font-family:var(--font-mono);font-size:13px">
                        ↗ {sub.repo_url}
                      </a>
                    </div>
                  )}
                </div>
              ) : null}

              <form class="adr-form" method="POST" action="/api/craft/adr" id={`form-${a.week}`} style={{ display: sub?.status === 'submitted' ? 'none' : 'block' }}>
                <input type="hidden" name="week" value={a.week} />

                {(() => {
                  const { sections, unmatched } = sub
                    ? parseAdr(sub.adr_markdown)
                    : { sections: emptyAdr(), unmatched: '' };
                  return (
                    /* Seven fixed sections, never varying by week (§5.5), read
                       from the one module that owns them. The hint under each is
                       the session's own statement of what that section is for. */
                    <div class="fields-group" data-tour="adr-sections">
                      {ADR_SECTIONS.map((s, i) => (
                        <div
                          class={`field${s.loadBearing ? ' load-bearing' : ''}`}
                          style={i === 0 ? undefined : 'margin-top:20px'}
                        >
                          <label for={`${s.id}-${a.week}`}>{s.heading}</label>
                          <p class="hint">
                            {s.hint}
                            {s.loadBearing && (
                              <>
                                {' '}This is the section Sunil reads first — anyone can state a
                                decision, the rejected options are where judgement is visible.
                              </>
                            )}
                          </p>
                          <textarea
                            id={`${s.id}-${a.week}`}
                            name={s.id}
                            data-heading={s.heading}
                            required={s.required}
                            rows={s.rows}
                            placeholder={s.placeholder}
                          >{sections[s.id]}</textarea>
                        </div>
                      ))}

                      {/* Written under the old five-section template. Shown so it
                          is not silently dropped on the next save — the learner
                          moves what still matters into the seven above. */}
                      {unmatched && (
                        <div class="field carried" style="margin-top:20px">
                          <label for={`carried-${a.week}`}>From your earlier draft</label>
                          <p class="hint">
                            These headings are no longer part of the template. Move anything worth
                            keeping into the sections above; this box is not submitted.
                          </p>
                          <textarea id={`carried-${a.week}`} rows="4" readonly>{unmatched}</textarea>
                        </div>
                      )}
                    </div>
                  );
                })()}

                <div class="field" style="margin-top:24px">
                  <label for={`repo-${a.week}`}>Repository URL (optional)</label>
                  <input type="url" id={`repo-${a.week}`} name="repo_url" value={sub?.repo_url ?? ''} placeholder="https://github.com/..." class="input" />
                </div>

                <p class="cap-note faint">
                  One page. {ADR_MAX_CHARS.toLocaleString('en-GB')} characters at most — the cap is
                  the point: it forces a choice about what actually matters.
                </p>

                <div class="actions" data-tour="adr-actions" style="margin-top:24px">
                  <button type="submit" class="btn btn-primary submit-btn" data-submit="true">Submit</button>
                  <button type="submit" class="btn draft-btn" data-submit="false">Save draft</button>
                  <span class="mono msg" style="display:none;"></span>
                </div>
              </form>
            </div>
          )
        })}
      </div>
    </div>
    )}
  </div>
</CraftLayout>

<script>
  import { ADR_SECTIONS, buildAdr } from '../../lib/craft/adr';
  // Navigation
  const btns = document.querySelectorAll('.week-btn');
  const panels = document.querySelectorAll('.week-panel');

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const week = btn.getAttribute('data-week');
      
      btns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      panels.forEach(p => {
        (p as HTMLElement).style.display = p.id === `panel-${week}` ? 'block' : 'none';
      });
    });
  });

  // Forms. Two buttons, one handler: which one was pressed decides whether this
  // is a draft or the final snapshot. A submitted ADR has no edit path at all —
  // reopening one is a conversation with Sunil.
  document.querySelectorAll<HTMLFormElement>('.adr-form').forEach(form => {
    let pressed: HTMLButtonElement | null = null;
    form.querySelectorAll<HTMLButtonElement>('button[type="submit"]').forEach(b => {
      b.addEventListener('click', () => { pressed = b; });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = pressed ?? (form.querySelector('.submit-btn') as HTMLButtonElement);
      const submitting = btn.dataset.submit === 'true';
      const msg = form.querySelector('.msg') as HTMLSpanElement;
      const original = btn.textContent;

      if (submitting && !confirm('Submit this record? The text is fixed once it is in.')) return;

      btn.disabled = true;
      btn.textContent = submitting ? 'Submitting...' : 'Saving...';
      msg.style.display = 'none';

      const formData = new FormData(form);

      // buildAdr() is the one assembler, and parseAdr() reads back what it
      // writes. Reproducing the `## Heading` format here worked right up until
      // the two disagreed — which is the failure this module was created to end.
      const adr_markdown = buildAdr(
        Object.fromEntries(
          ADR_SECTIONS.map((sec) => [sec.id, (formData.get(sec.id) as string) ?? '']),
        ),
      );

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            week: parseInt(formData.get('week') as string, 10),
            adr_markdown,
            repo_url: formData.get('repo_url'),
            submit: submitting,
          }),
        });
        const result = await res.json();
        if (!res.ok) throw new Error(result.error ?? 'Could not save that.');

        if (submitting) {
          window.location.reload();
        } else {
          msg.textContent = 'Draft saved.';
          msg.style.color = 'var(--ink-soft)';
          msg.style.display = 'inline-block';
          btn.disabled = false;
          btn.textContent = original;
        }
      } catch (err) {
        msg.textContent = err instanceof Error ? err.message : 'Could not save that.';
        msg.style.display = 'inline-block';
        msg.style.color = 'var(--danger)';
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  });

</script>

<style>
  .locked-note {
    font-size: 12px;
    color: var(--ink-faint);
    line-height: 1.6;
    margin: 0 0 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
    max-width: 62ch;
  }
  .cap-note {
    font-size: 13px;
    margin: 24px 0 0;
    max-width: 60ch;
  }
  .badge.draft {
    font-size: 10px;
    letter-spacing: var(--tracking-label);
    color: var(--ink-faint);
  }
  .adr-container {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 40px;
  }
  
  .week-nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  
  .week-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 12px 16px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-inner);
    text-align: left;
    cursor: pointer;
    transition: 0.1s;
    position: relative;
  }
  .week-btn:hover {
    background: var(--surface-hover);
  }
  .week-btn.active {
    background: var(--surface);
    border-color: var(--line-strong);
  }
  
  .week-btn .wk {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-faint);
    margin-bottom: 4px;
  }
  .week-btn .title {
    font-size: 14px;
    font-weight: 500;
  }
  .week-btn .badge {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: var(--radius-pill);
    background: var(--surface-invert);
    color: var(--text-on-invert);
  }
  
  .adr-content {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: 40px;
  }
  
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .field label {
    font-weight: 500;
  }

  /* The spec's own statement of what each section is for, in place of the
     generic placeholder text that was here. */
  .hint {
    margin: -4px 0 2px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 62ch;
  }
  .hint strong { color: var(--ink); font-weight: 500; }

  /* §5.5: "Alternatives is the load-bearing section." */
  .field.load-bearing {
    padding-left: 14px;
    border-left: 2px solid var(--accent-ink);
  }

  /* --- the brief ------------------------------------------------------- */
  .brief {
    background: var(--paper-2);
    border-radius: var(--radius-inner);
    padding: 20px 22px;
    margin-bottom: 24px;
  }
  .brief-eyebrow {
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent-ink);
    margin: 0 0 8px;
  }
  .brief h2 {
    font-size: 21px;
    line-height: 1.3;
    margin: 0 0 10px;
  }
  .brief-note {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 64ch;
  }
  .brief-note a { color: var(--clay); }

  /* --- nothing set yet ------------------------------------------------- */
  .adr-blank {
    background: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-raise);
    padding: 48px 36px;
    text-align: center;
  }
  .adr-blank h2 { font-size: 21px; margin: 0 0 10px; }
  .adr-blank > p {
    margin: 0 auto;
    max-width: 50ch;
    color: var(--ink-soft);
    font-size: 15px;
  }
  .upcoming {
    list-style: none;
    margin: 28px auto 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--line);
    max-width: 46ch;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
  }
  .upcoming .wk {
    font-size: 11.5px;
    color: var(--ink-faint);
    margin-right: 8px;
  }

  .later {
    margin-top: 16px;
    font-size: 12px;
    line-height: 1.5;
  }

  textarea, .input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-control);
    background: var(--paper-1);
    font-family: inherit;
    font-size: 15px;
  }
  textarea {
    resize: vertical;
  }
  
  .actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .msg {
    font-size: 12px;
  }
  
  .submitted-view {
    padding: 24px;
    background: var(--paper-1);
    border: 1px solid var(--line);
    border-radius: var(--radius-inner);
  }
  
  /* Basic markdown typography */
  .markdown-body {
    font-size: 15px;
    line-height: 1.6;
  }
  .markdown-body h1, .markdown-body h2, .markdown-body h3 {
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }
  .markdown-body p, .markdown-body ul, .markdown-body pre {
    margin-bottom: 1em;
  }
  .markdown-body pre {
    background: var(--noir);
    color: var(--paper-1);
    padding: 16px;
    border-radius: var(--radius-inner);
    overflow-x: auto;
  }
  
  @media (max-width: 780px) {
    .adr-container {
      grid-template-columns: 1fr;
    }
    .adr-content {
      padding: 24px;
    }
  }

  .page-narrow { padding-top: 40px; padding-bottom: 56px; }

  @media (max-width: 780px) {
    /* 40px under a fixed bar on a phone is a lot of nothing; the room is
       better spent between the blocks below. */
    .page-narrow { padding-top: 24px; padding-bottom: 40px; }
  }
</style>
