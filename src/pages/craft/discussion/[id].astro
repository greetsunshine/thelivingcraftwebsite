---
// One discussion thread.
//
// THIS PAGE IS WHERE THE SAFETY ARGUMENT LIVES. Opening questions up to the
// cohort means answers now arrive from people who may be confidently wrong, in
// a course that sells engineering judgement. The mitigation is not moderation,
// it is that the three voices can never be mistaken for one another:
//
//   Sunil       — accent rule, his name, "Instructor". The course's position.
//   A peer      — their name and face, plainly. Useful, not authoritative.
//   The syllabus— machine-orange, explicitly "not a person", quoting facts.ts
//                 or the session page and nothing else.
//
// And two marks that are deliberately not the same mark:
//   "Solved it for me"  — the asker's report. Anyone's reply can carry it.
//   "Endorsed by Sunil" — the verdict. Only he can give it, from the console.
//
// RENDERING. Learner-written text is printed as text, never through the
// markdown renderer. Astro escapes interpolated expressions, so this is safe by
// construction — but the reason is worth stating: these bodies are now read by
// OTHER learners, and marked() passes raw HTML through untouched. Only bodies
// with a trusted author (Sunil, behind the console password) or a trusted
// generator (code quoting in-repo content) are parsed as markdown.
import CraftLayout from '../../../layouts/CraftLayout.astro';
import { getThread, type Reply } from '../../../lib/craft/discussion';
import { initials, tintOf, relativeTime, displayTitle } from '../../../lib/craft/people';
import { marked } from 'marked';

export const prerender = false;

const learner = Astro.locals.learner!;
const { id } = Astro.params;

const found = id ? await getThread(id, learner.id) : null;

// A private thread that is not theirs returns null from getThread, so a guessed
// URL is a 404 and not a peek. Same rule as the list, restated because a direct
// link is a second door.
if (!found) return Astro.redirect('/craft/discussion');

const { thread, replies } = found;
const isOwner = thread.learner_id === learner.id;
const title = displayTitle(thread.title, thread.body);

/** Trusted authors only — see the note at the top of this file. */
const asMarkdown = (r: Reply) => r.author_role !== 'learner';

const roleName = (r: Reply) =>
  r.author_role === 'instructor'
    ? 'Sunil'
    : r.author_role === 'system'
      ? 'From the syllabus'
      : (r.author_name ?? 'A learner');
---

<CraftLayout title={title} learner={learner} back={{ href: '/craft/discussion', label: 'Discussion' }}>
  <div class="wrap thread-page">
    <article class="op">
      <header class="op-head">
        <span class={`avatar tint-${tintOf(thread.learner_email || thread.learner_id)}`} aria-hidden="true">
          {initials(thread.learner_name, thread.learner_email)}
        </span>
        <div class="op-who">
          <span class="who">{isOwner ? 'You' : (thread.learner_name ?? thread.learner_email)}</span>
          <span class="when faint">{relativeTime(thread.created_at)}</span>
        </div>
        <div class="op-tags">
          {thread.pinned && <span class="tag pinned">Pinned</span>}
          {thread.visibility === 'private' && <span class="tag private">Only Sunil can see this</span>}
          {thread.capability_id && <span class="tag cap">{thread.capability_id}</span>}
        </div>
      </header>

      <h1>{title}</h1>
      <div class="op-body">{thread.body}</div>
    </article>

    <section class="replies" aria-label="Replies">
      <h2 class="replies-head">
        {replies.length === 0
          ? 'No replies yet'
          : `${replies.length} ${replies.length === 1 ? 'reply' : 'replies'}`}
      </h2>

      {replies.length === 0 && (
        <p class="none">
          Nobody has answered this yet. If you know something about it — even partly — say so.
          A wrong answer that gets corrected teaches the room more than silence does.
        </p>
      )}

      {replies.map((r) => (
        <article
          class={`reply role-${r.author_role} ${thread.endorsed_reply_id === r.id ? 'is-endorsed' : ''}`}
          data-reply={r.id}
        >
          <header class="r-head">
            {r.author_role === 'learner' ? (
              <span class={`avatar tint-${tintOf(r.author_name ?? r.learner_id ?? '')}`} aria-hidden="true">
                {initials(r.author_name, '')}
              </span>
            ) : (
              <span class={`avatar mark-${r.author_role}`} aria-hidden="true">
                {r.author_role === 'instructor' ? 'SM' : '§'}
              </span>
            )}

            <span class="r-who">
              <span class="who">
                {r.author_role === 'learner' && r.learner_id === learner.id ? 'You' : roleName(r)}
              </span>
              {r.author_role === 'instructor' && <span class="role-badge">Instructor</span>}
              {r.author_role === 'system' && <span class="role-badge machine">Not a person</span>}
            </span>

            <span class="r-marks">
              {thread.endorsed_reply_id === r.id && <span class="tag endorsed">Endorsed by Sunil</span>}
              {thread.resolved_reply_id === r.id && <span class="tag solved">Solved it</span>}
              <span class="when faint">{relativeTime(r.created_at)}</span>
            </span>
          </header>

          {asMarkdown(r) ? (
            <div class="r-body prose" set:html={marked.parse(r.body)} />
          ) : (
            <div class="r-body">{r.body}</div>
          )}

          {/* The asker's own mark. Their report about their own problem, so only
              they can set it, and they can take it back. */}
          {isOwner && r.author_role !== 'system' && (
            <div class="r-actions">
              <button
                type="button"
                class="mark-btn"
                data-reply-id={r.id}
                data-on={thread.resolved_reply_id === r.id ? '1' : '0'}
              >
                {thread.resolved_reply_id === r.id ? 'Unmark as solved' : 'This solved it'}
              </button>
            </div>
          )}
        </article>
      ))}
    </section>

    <section class="reply-box">
      <h2>{isOwner ? 'Add to your question' : 'Reply'}</h2>
      <form id="replyForm">
        <textarea
          id="replyBody"
          name="body"
          rows="4"
          required
          placeholder={thread.visibility === 'private'
            ? 'Only you and Sunil can see this thread.'
            : 'Answer it, or add what you found out. Say what you are unsure about — that is useful too.'}
        ></textarea>
        <div class="rb-actions">
          <button type="submit" class="btn btn-primary" id="replyBtn">Post reply</button>

          {isOwner && (
            <button type="button" class="btn" id="askSunilBtn">Ask Sunil to weigh in</button>
          )}
          <span class="mono msg" id="replyMsg" hidden></span>
        </div>
      </form>
    </section>
  </div>
</CraftLayout>

<script>
  function initThread() {
    const form = document.getElementById('replyForm') as HTMLFormElement | null;
    if (!form || form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    const btn = document.getElementById('replyBtn') as HTMLButtonElement;
    const msg = document.getElementById('replyMsg') as HTMLElement;
    const body = document.getElementById('replyBody') as HTMLTextAreaElement;
    const threadId = window.location.pathname.split('/').filter(Boolean).pop()!;

    const say = (text: string, bad = true) => {
      msg.textContent = text;
      msg.hidden = false;
      msg.style.color = bad ? 'var(--danger)' : 'var(--agent-human)';
    };

    const post = (payload: Record<string, unknown>) =>
      fetch('/api/craft/discussion', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      }).then(async (r) => ({ ok: r.ok, data: await r.json().catch(() => ({})) }));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!body.value.trim()) return;
      btn.disabled = true;
      btn.textContent = 'Posting…';
      msg.hidden = true;

      const { ok, data } = await post({ action: 'reply', threadId, body: body.value });
      if (ok) {
        // Reloaded rather than appended: the server owns ordering, the avatar
        // tint and the role badge, and re-deriving all three in the browser is
        // three chances to render a reply that looks unlike its refresh.
        window.location.reload();
      } else {
        say((data as any).error ?? 'Could not post that reply.');
        btn.disabled = false;
        btn.textContent = 'Post reply';
      }
    });

    document.getElementById('askSunilBtn')?.addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      b.disabled = true;
      b.textContent = 'Sending…';
      const { ok } = await post({ action: 'ask-sunil', threadId });
      b.textContent = ok ? 'Sunil has been asked' : 'Could not send that';
      if (!ok) b.disabled = false;
    });

    document.querySelectorAll<HTMLButtonElement>('.mark-btn').forEach((b) => {
      b.addEventListener('click', async () => {
        const on = b.dataset.on === '1';
        b.disabled = true;
        const { ok } = await post({
          action: 'resolve',
          threadId,
          replyId: on ? null : b.dataset.replyId,
        });
        if (ok) window.location.reload();
        else { b.disabled = false; say('Could not save that.'); }
      });
    });
  }

  document.addEventListener('astro:page-load', initThread);
</script>

<style>
  .thread-page { padding-top: 24px; padding-bottom: 56px; max-width: 820px; }

  .avatar {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-pill);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--paper-1);
  }
  .tint-0 { background: #2f4858; }
  .tint-1 { background: #5c4b8a; }
  .tint-2 { background: #a04a2a; }
  .tint-3 { background: #1f6b5b; }
  .tint-4 { background: #7a3b52; }
  .tint-5 { background: #4a5d23; }
  .tint-6 { background: #8a6100; }
  .tint-7 { background: #3d5a80; }
  /* Sunil and the syllabus are not people in the tint rotation — they read as
     roles, and must not be mistakable for a learner's face. */
  .mark-instructor { background: var(--noir); color: var(--sun); }
  .mark-system {
    background: var(--agent-machine-bg);
    color: var(--agent-machine);
    font-size: 17px;
  }

  /* --- the question ----------------------------------------------------- */
  .op {
    background: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-raise);
    padding: 28px;
    margin-bottom: 36px;
  }
  .op-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
  .op-who { display: flex; flex-direction: column; gap: 1px; margin-right: auto; }
  .who { font-weight: 500; font-size: 14px; }
  .when { font-size: 12px; }
  .op-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .op h1 { font-size: clamp(23px, 3.4vw, 31px); line-height: 1.25; margin: 0 0 16px; }
  .op-body { white-space: pre-wrap; line-height: 1.65; font-size: 16px; }

  /* --- replies ---------------------------------------------------------- */
  .replies-head {
    font-size: 12px;
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 16px;
  }
  .none { color: var(--ink-soft); max-width: 58ch; margin-bottom: 32px; font-size: 15px; }

  .reply { padding: 20px 0; border-top: 1px solid var(--line); }
  .r-head { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
  .r-who { display: flex; align-items: center; gap: 8px; margin-right: auto; }
  .r-marks { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .r-body { white-space: pre-wrap; line-height: 1.62; font-size: 15.5px; }
  .r-body.prose { white-space: normal; }
  .r-body :global(p) { margin-bottom: 0.9em; }
  .r-body :global(p:last-child) { margin-bottom: 0; }
  .r-body :global(pre) {
    background: var(--noir);
    color: var(--paper-1);
    padding: 14px 16px;
    border-radius: var(--radius-inner);
    overflow-x: auto;
    font-size: 13.5px;
  }
  .r-body :global(code) { font-family: var(--font-mono); font-size: 0.92em; }

  .role-badge {
    font-size: 10.5px;
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    background: var(--noir);
    color: var(--sun);
  }
  .role-badge.machine { background: var(--agent-machine-bg); color: var(--agent-machine); }

  /* Sunil's answer carries the course's authority and has to look like it —
     a rule down the side, not merely a badge that scrolls past. */
  .reply.role-instructor {
    border-top: 0;
    border-left: var(--agent-rule) solid var(--accent-ink);
    background: var(--surface);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    padding: 22px 24px;
    margin: 16px 0;
    box-shadow: var(--shadow-raise);
  }

  /* The syllabus. Quiet, and openly a machine. */
  .reply.role-system {
    border-top: 0;
    background: var(--agent-machine-bg);
    border-radius: var(--radius-card);
    padding: 18px 22px;
    margin: 16px 0;
  }
  .reply.role-system .r-body { font-size: 14.5px; }

  .reply.is-endorsed { position: relative; }

  .tag {
    font-size: 11px;
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-label);
    padding: 4px 9px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    border: 1px solid transparent;
  }
  .tag.endorsed { background: var(--accent-quiet); color: var(--accent-ink-strong); }
  .tag.solved   { background: var(--agent-human-bg); color: var(--agent-human); }
  .tag.private  { border-color: var(--line-strong); color: var(--ink-faint); }
  .tag.pinned   { background: var(--surface-invert); color: var(--text-on-invert); }
  .tag.cap      { border-color: var(--line-strong); color: var(--ink-faint); }

  .r-actions { margin-top: 12px; }
  .mark-btn {
    border: 1px solid var(--line);
    background: transparent;
    border-radius: var(--radius-pill);
    padding: 6px 14px;
    font-family: inherit;
    font-size: 12.5px;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .mark-btn:hover { border-color: var(--line-strong); color: var(--ink); }

  /* --- reply box -------------------------------------------------------- */
  .reply-box {
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .reply-box h2 { font-size: 17px; margin: 0 0 14px; }
  .reply-box textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-field);
    background: var(--paper-1);
    font-family: inherit;
    font-size: 16px;
    line-height: 1.55;
    resize: vertical;
  }
  .rb-actions { display: flex; align-items: center; gap: 12px; margin-top: 14px; flex-wrap: wrap; }
  .msg { font-size: 12px; }

  @media (max-width: 780px) {
    .thread-page { padding-bottom: 40px; }
    .op { padding: 20px 18px; }
    .avatar { width: 32px; height: 32px; font-size: 11.5px; }
    .reply.role-instructor { padding: 18px; }
    .reply.role-system { padding: 16px; }
    .r-marks { width: 100%; padding-left: 44px; }
    .rb-actions .btn { width: 100%; }
  }
</style>
