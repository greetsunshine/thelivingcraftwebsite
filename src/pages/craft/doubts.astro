---
// The doubts inbox, learner side.
//
// What this page must NOT do: answer a content question. Logistics questions
// are answered from the syllabus by code; anything about the material goes to
// Sunil and says so on screen. See the header comment in src/lib/craft/doubts.ts
// for why an "Automated Answer" here was the wrong feature.
import CraftLayout from '../../layouts/CraftLayout.astro';
import { listDoubts, type AnswerSource } from '../../lib/craft/doubts';
import { marked } from 'marked';

export const prerender = false;
const learner = Astro.locals.learner!;
const doubts = await listDoubts(learner.id);

const statusLabel: Record<string, string> = {
  new: 'With Sunil',
  routed: 'Going into a session',
  answered: 'Answered',
};

// Says where an answer came from, so nobody has to guess whether they are
// reading the syllabus or Sunil.
const sourceLabel: Record<AnswerSource, string> = {
  facts: 'From the programme facts',
  session: 'From the session page',
  relay: 'Sunil answered this before',
  sunil: 'Answered by Sunil',
};
---

<CraftLayout title="Your Doubts" learner={learner}>
  <div class="wrap" style="max-width: 780px; margin: 0 auto; padding-top: 40px;">
    <h1 style="font-size:clamp(30px,4.4vw,46px);margin:0 0 16px">Doubts &amp; Questions</h1>
    <p class="lead" style="margin-bottom: 40px;">
      Anything about dates, deadlines or format gets answered here straight away.
      Anything about the material goes to Sunil — those are the ones worth a real answer,
      and they shape what the next session covers.
    </p>

    <form class="doubt-form" method="POST" action="/api/craft/doubts" id="doubtForm">
      <div class="field">
        <label for="body">What's on your mind?</label>
        <textarea id="body" name="body" required rows="4" placeholder="Be as specific as you can. Paste code if you need to."></textarea>
      </div>

      <div class="field radio-group">
        <label class="radio-label">
          <input type="radio" name="kind" value="content" checked />
          <span>About the material <span class="faint">— goes to Sunil</span></span>
        </label>
        <label class="radio-label">
          <input type="radio" name="kind" value="course" />
          <span>Dates, deadlines, format <span class="faint">— answered now</span></span>
        </label>
      </div>

      <div class="actions">
        <button type="submit" class="btn btn-primary" id="submitBtn">Submit</button>
        <span id="submitMsg" class="mono msg" style="display:none;"></span>
      </div>

      <div id="answerArea" class="answer-area" style="display:none">
        <p class="answer-source mono" id="answerSource"></p>
        <div id="answerContent" class="markdown-body"></div>
        <div class="answer-actions">
          <button type="button" class="btn small" id="toSunilBtn">This didn't answer it — send to Sunil</button>
        </div>
      </div>

      <div id="routedArea" class="routed-area" style="display:none">
        <p><strong>Sent to Sunil.</strong> He reads these before the next session — if
        several people ask the same thing, it usually becomes part of it.</p>
      </div>
    </form>

    <hr class="rule" style="margin: 56px 0" />

    <h2 style="font-size:24px;margin-bottom:24px">Past questions</h2>
    {doubts.length > 0 ? (
      <div class="doubts-list">
        {doubts.map((d) => (
          <div class="doubt-card">
            <div class="d-header">
              <span class="mono date">
                {new Date(d.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
              </span>
              <span class={`badge ${d.status}`}>{statusLabel[d.status] ?? d.status}</span>
            </div>
            <p class="d-body">{d.body}</p>

            {d.answer && (
              <div class="d-answer">
                {d.answer_source && (
                  <p class="answer-source mono">{sourceLabel[d.answer_source]}</p>
                )}
                <div class="markdown-body" set:html={marked.parse(d.answer)} />
                {d.answer_source !== 'sunil' && d.status === 'answered' && (
                  <div class="answer-actions">
                    <button type="button" class="btn small to-sunil-btn" data-id={d.id}>
                      This didn't answer it — send to Sunil
                    </button>
                  </div>
                )}
              </div>
            )}

            {!d.answer && d.status !== 'answered' && (
              <p class="waiting faint">With Sunil. He reads these before the next session.</p>
            )}
          </div>
        ))}
      </div>
    ) : (
      <p class="muted">You haven't asked anything yet.</p>
    )}
  </div>
</CraftLayout>

<script>
  import { marked } from 'marked';

  const SOURCE_LABEL: Record<string, string> = {
    facts: 'From the programme facts',
    session: 'From the session page',
    relay: 'Sunil answered this before',
    sunil: 'Answered by Sunil',
  };

  /** Hand a doubt back to Sunil. Never a second machine opinion. */
  async function sendToSunil(id: string, button: HTMLButtonElement) {
    const original = button.textContent;
    button.disabled = true;
    button.textContent = 'Sending…';
    try {
      const res = await fetch('/api/craft/doubts-send-to-sunil', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id }),
      });
      if (!res.ok) throw new Error();
      button.textContent = 'Sent to Sunil';
    } catch {
      button.textContent = 'Could not send that — try again';
      button.disabled = false;
      setTimeout(() => { button.textContent = original; }, 4000);
    }
  }

  const form = document.getElementById('doubtForm') as HTMLFormElement | null;
  const btn = document.getElementById('submitBtn') as HTMLButtonElement | null;
  const msg = document.getElementById('submitMsg') as HTMLSpanElement | null;

  if (form && btn && msg) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Submitting…';
      msg.style.display = 'none';

      const formData = new FormData(form);
      const payload = { body: formData.get('body'), kind: formData.get('kind') };

      const answerArea = document.getElementById('answerArea') as HTMLDivElement;
      const answerSource = document.getElementById('answerSource') as HTMLParagraphElement;
      const answerContent = document.getElementById('answerContent') as HTMLDivElement;
      const routedArea = document.getElementById('routedArea') as HTMLDivElement;
      const toSunilBtn = document.getElementById('toSunilBtn') as HTMLButtonElement;

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await res.json();
        if (!res.ok) throw new Error(result.error ?? 'Failed');

        (form.querySelector('#body') as HTMLTextAreaElement).value = '';
        btn.textContent = 'Submit';
        btn.disabled = false;

        if (result.answer) {
          answerSource.textContent = SOURCE_LABEL[result.answerSource] ?? '';
          answerContent.innerHTML = marked.parse(result.answer) as string;
          answerArea.style.display = 'block';
          routedArea.style.display = 'none';
          toSunilBtn.disabled = false;
          toSunilBtn.textContent = "This didn't answer it — send to Sunil";
          toSunilBtn.onclick = () => sendToSunil(result.id, toSunilBtn);
        } else {
          // Escalation is the expected outcome for anything about the material,
          // so it reads as a result, not a failure.
          routedArea.style.display = 'block';
          answerArea.style.display = 'none';
        }
      } catch (err) {
        msg.textContent = err instanceof Error && err.message !== 'Failed'
          ? err.message
          : 'Could not save that. Try again.';
        msg.style.display = 'inline-block';
        msg.style.color = 'var(--danger)';
        btn.disabled = false;
        btn.textContent = 'Submit';
      }
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.to-sunil-btn').forEach((b) => {
    b.addEventListener('click', () => {
      const id = b.getAttribute('data-id');
      if (id) sendToSunil(id, b);
    });
  });
</script>

<style>
  .doubt-form {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-inner);
    padding: 32px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 24px;
  }
  .field label {
    font-weight: 500;
  }
  textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-control);
    background: var(--paper-1);
    font-family: inherit;
    font-size: 16px;
    resize: vertical;
  }
  .radio-group {
    flex-direction: row;
    gap: 24px;
    flex-wrap: wrap;
  }
  .radio-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: normal;
    cursor: pointer;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .msg {
    font-size: 12px;
  }

  /* --- the answer, and the hand-off ------------------------------------- */

  .answer-area,
  .routed-area {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .routed-area p {
    margin: 0;
    max-width: 60ch;
  }
  .answer-source {
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 10px;
  }
  .answer-actions {
    margin-top: 20px;
  }

  .doubts-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .doubt-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-inner);
    padding: 20px 24px;
  }
  .d-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .date {
    font-size: 12px;
    color: var(--ink-faint);
  }
  .badge {
    font-size: 11px;
    padding: 4px 8px;
    border-radius: var(--radius-pill);
    letter-spacing: var(--tracking-label);
    white-space: nowrap;
  }
  .badge.new {
    background: var(--surface-invert);
    color: var(--text-on-invert);
  }
  .badge.routed {
    background: var(--paper-2);
    color: var(--clay);
    border: 1px solid var(--clay);
  }
  .badge.answered {
    background: var(--paper-2);
    color: var(--ink-soft);
    border: 1px solid var(--line-strong);
  }
  .d-body {
    white-space: pre-wrap;
    line-height: 1.5;
  }
  .d-answer {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .waiting {
    margin-top: 12px;
    font-size: 13px;
  }

  /* Basic markdown typography */
  .markdown-body {
    font-size: 15px;
    line-height: 1.6;
  }
  .markdown-body p, .markdown-body ul, .markdown-body pre {
    margin-bottom: 1em;
  }
  .markdown-body p:last-child {
    margin-bottom: 0;
  }
  .markdown-body pre {
    background: var(--noir);
    color: var(--paper-1);
    padding: 16px;
    border-radius: var(--radius-inner);
    overflow-x: auto;
  }

  @media (max-width: 780px) {
    .doubt-form { padding: 20px 18px; }
    .radio-group { flex-direction: column; gap: 12px; }
    .doubt-card { padding: 16px 18px; }
    .d-header { flex-wrap: wrap; gap: 8px; }
    .answer-actions { width: 100%; }
  }
</style>
