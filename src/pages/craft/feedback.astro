---
import CraftLayout from '../../layouts/CraftLayout.astro';
import { getCollection } from 'astro:content';
import { listLearnerFeedback, listPublishedResponses } from '../../lib/craft/feedback';

export const prerender = false;
const learner = Astro.locals.learner!;
const [feedbacks, changes] = await Promise.all([
  listLearnerFeedback(learner.id),
  // The loop, closed. Spec §5.3: without this the form is theatre and the
  // response rate collapses by week 3.
  listPublishedResponses(),
]);

// Only ask for feedback on taught sessions
const sessions = (await getCollection('sessions'))
  .filter(s => s.data.taughtOn && s.data.week >= 1)
  .sort((a, b) => b.data.week - a.data.week); // Newest first

const submittedWeeks = new Set(feedbacks.map(f => f.week));
const pendingSessions = sessions.filter(s => !submittedWeeks.has(s.data.week));
---

<CraftLayout title="Session Feedback" learner={learner}>
  <div class="wrap" style="max-width: 640px; margin: 0 auto; padding-top: 40px;">
    <h1 style="font-size:clamp(30px,4.4vw,46px);margin:0 0 16px">Session Feedback</h1>
    <p class="lead" style="margin-bottom: 48px;">
      Two questions per session. What you say changes the next one — what changed is
      listed below, so you can see it.
    </p>

    {changes.length > 0 && (
      <section class="changes">
        <h2>What changed</h2>
        <ul>
          {changes.map((c) => (
            <li>
              <span class="label">After week {c.week}</span>
              <p>{c.body}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {pendingSessions.length > 0 ? (
      <div class="feedback-forms">
        {pendingSessions.map(s => (
          <div class="feedback-card">
            <div class="f-header">
              <h2 style="font-size:20px;margin:0">Week {s.data.week}</h2>
              <span class="mono faint">{s.data.title}</span>
            </div>
            
            <form class="feedback-form" method="POST" action="/api/craft/feedback">
              <input type="hidden" name="week" value={s.data.week} />
              
              <div class="field">
                <label for={`landed-${s.data.week}`}>What landed well, or shifted your thinking?</label>
                <textarea id={`landed-${s.data.week}`} name="landed" required rows="3"></textarea>
              </div>

              <div class="field" style="margin-top:24px">
                <label for={`pacing-${s.data.week}`}>What felt too fast, too slow, or unclear?</label>
                <textarea id={`pacing-${s.data.week}`} name="pacing" required rows="3"></textarea>
              </div>

              <div class="actions" style="margin-top:24px">
                <button type="submit" class="btn btn-primary submit-btn">Submit Feedback</button>
                <span class="mono msg" style="display:none;"></span>
              </div>
            </form>
          </div>
        ))}
      </div>
    ) : (
      <div class="feedback-done">
        <h2>All caught up.</h2>
        <p class="muted">You've submitted feedback for all taught sessions.</p>
        <a href="/craft" class="btn" style="margin-top:24px">Back to cohort</a>
      </div>
    )}
  </div>
</CraftLayout>

<script>
  document.querySelectorAll('.feedback-form').forEach(form => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('.submit-btn') as HTMLButtonElement;
      const msg = form.querySelector('.msg') as HTMLSpanElement;
      
      btn.disabled = true;
      btn.textContent = 'Submitting...';
      msg.style.display = 'none';

      const formData = new FormData(form as HTMLFormElement);
      const data = {
        week: parseInt(formData.get('week') as string, 10),
        landed: formData.get('landed'),
        pacing: formData.get('pacing'),
      };

      try {
        const res = await fetch((form as HTMLFormElement).action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        
        if (res.ok) {
          msg.textContent = 'Submitted!';
          msg.style.color = 'var(--clay)';
          msg.style.display = 'inline-block';
          setTimeout(() => window.location.reload(), 800);
        } else {
          throw new Error('Failed to submit');
        }
      } catch (err) {
        msg.textContent = 'Something went wrong.';
        msg.style.display = 'inline-block';
        msg.style.color = 'var(--danger)';
        btn.disabled = false;
        btn.textContent = 'Submit Feedback';
      }
    });
  });
</script>

<style>
  .changes {
    margin-bottom: 48px;
    padding: 24px 26px;
    background: var(--surface);
    border-left: 3px solid var(--clay);
  }
  .changes h2 {
    font-size: 20px;
    margin: 0 0 16px;
  }
  .changes ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .changes .label {
    display: block;
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 4px;
  }
  .changes p {
    margin: 0;
    max-width: 62ch;
    white-space: pre-wrap;
  }

  .feedback-forms {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .feedback-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: 32px 40px;
  }
  
  .f-header {
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .field label {
    font-weight: 500;
  }
  textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-control);
    background: var(--paper-1);
    font-family: inherit;
    font-size: 15px;
    resize: vertical;
  }
  
  .actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .msg {
    font-size: 12px;
  }
  
  .feedback-done {
    text-align: center;
    padding: 64px 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
  }
  .feedback-done h2 {
    font-size: 28px;
    margin-bottom: 12px;
  }
  
  @media (max-width: 600px) {
    .feedback-card {
      padding: 24px;
    }
  }
</style>
