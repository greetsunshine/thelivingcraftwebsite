---
// The course area's front page — what a learner sees on signing in.
//
// Everything factual on this page (weeks, seats, commitment, format, start)
// comes from facts.ts, for the same reason the public pages do: a learner
// reading "6 weeks" here and "5 weeks" on the site they applied through is a
// small thing that costs a lot of trust.
import CraftLayout from '../../layouts/CraftLayout.astro';
import { getCollection } from 'astro:content';
import { cohort, practitioner } from '../../data/facts';
import { getIntake } from '../../lib/craft/intake';
import { suggestionsFor } from '../../lib/craft/reading';
import { listDoubts } from '../../lib/craft/doubts';
import { getLearnerItems, getQuizResponses } from '../../lib/craft/quiz';
import { listLearnerSubmissions } from '../../lib/craft/submissions';
import { listLearnerFeedback } from '../../lib/craft/feedback';
import { getFamiliarity } from '../../lib/craft/familiarity';
import Briefing from '../../components/craft/Briefing.astro';

// Gated: never prerender. A static file under dist/ would be served without the
// middleware ever running, which is the whole gate gone.
export const prerender = false;

const learner = Astro.locals.learner!;

const sessions = (await getCollection('sessions')).sort((a, b) => a.data.week - b.data.week);

// Surfaced on this page rather than only inside week 0, because an unsubmitted
// intake is the one outstanding task a learner has before the cohort starts and
// it should not be two clicks deep.
const intake = await getIntake(learner.id);
const intakeState = intake?.submitted_at ? 'submitted' : intake ? 'draft' : 'todo';
const reading = intakeState === 'submitted' ? suggestionsFor({ ...intake!.technical, ...intake!.leadership }) : [];

const [doubts, quizItems, quizResponses, adrs, feedbacks] = await Promise.all([
  listDoubts(learner.id),
  getLearnerItems(),
  getQuizResponses(learner.id),
  listLearnerSubmissions(learner.id),
  listLearnerFeedback(learner.id),
]);

const openDoubts = doubts.filter(d => d.status !== 'answered').length;
const quizCompleted = new Set(quizResponses.map(r => r.item_id)).size;
const quizTotal = quizItems.length;
// Drafts are not submissions — the dashboard counts what is actually in.
const adrCount = adrs.filter((a) => a.status === 'submitted').length;
const pendingFeedback = sessions.filter(s => s.data.taughtOn && s.data.week >= 1 && !feedbacks.some(f => f.week === s.data.week)).length;

// Undefined on week 0, which is pre-work and belongs to no module.
const moduleOf = (id?: string) => (id ? cohort.modules.find((m) => m.id === id) : undefined);
const ready = sessions.filter((s) => s.data.status === 'ready').length;

// ---------------------------------------------------------------------------
// What is actually outstanding
// ---------------------------------------------------------------------------
// Built from the same reads the counters above use, so the panel can never
// disagree with the numbers on the page. Nothing here is invented: an item
// appears only because a row is missing from a table.
const familiarity = await getFamiliarity(learner.id);
const week6 = sessions.find((s) => s.data.week === 6);

interface Todo {
  id: string;
  label: string;
  detail: string;
  href: string;
  /** Shown as the count chip. Absent when the item is simply one thing to do. */
  count?: number;
}

const todos: Todo[] = [];

if (intakeState !== 'submitted') {
  todos.push({
    id: 'intake',
    label: intakeState === 'draft' ? 'Finish your intake' : 'Your intake',
    detail:
      intakeState === 'draft'
        ? 'You have a saved draft. It is the baseline everything else is measured against.'
        : 'Thirteen questions before Class 1. About 20 minutes.',
    href: '/craft/intake',
  });
}

const quizLeft = Math.max(quizTotal - quizCompleted, 0);
if (quizLeft > 0) {
  todos.push({
    id: 'quiz',
    label: 'Answer the open quiz items',
    detail: 'One at a time, with a confidence rating. Calibration, not examination.',
    href: '/craft/quiz',
    count: quizLeft,
  });
}

// A week is outstanding when it has a real assignment and no SUBMITTED record.
// A saved draft still counts as outstanding — it is not in until it is in.
const adrWeeksDue = sessions
  .filter((s) => s.data.assignment && s.data.assignment !== 'TBD' && s.data.taughtOn)
  .filter((s) => !adrs.some((a) => a.week === s.data.week && a.status === 'submitted'))
  .map((s) => s.data.week);

if (adrWeeksDue.length > 0) {
  todos.push({
    id: 'adr',
    label: adrWeeksDue.length === 1 ? `Write your week ${adrWeeksDue[0]} record` : 'Write your decision records',
    detail: `Outstanding for week${adrWeeksDue.length > 1 ? 's' : ''} ${adrWeeksDue.join(', ')}. One page, and submitting freezes it.`,
    href: '/craft/adr',
    count: adrWeeksDue.length,
  });
}

if (pendingFeedback > 0) {
  todos.push({
    id: 'feedback',
    label: 'Leave session feedback',
    detail: 'Two questions, sixty seconds. It changes the next session, not the next cohort.',
    href: '/craft/feedback',
    count: pendingFeedback,
  });
}

// Only once week 6 has actually been taught — before that the page is a form
// about a week that has not happened.
if (week6?.data.taughtOn && !familiarity?.submitted_at) {
  todos.push({
    id: 'familiarity',
    label: 'Re-rate the thirteen capabilities',
    detail: 'The same questions as week 0, against your own answers. This is the before/after.',
    href: '/craft/familiarity',
  });
}
---

<CraftLayout title="Your cohort" learner={learner}>
  <div class="content-card">
    <section class="hero-black">
      <div class="wrap">
        <div class="eyebrow" style="color: var(--sun);">The Living Craft <span class="num" style="color: var(--ink-faint);">/ cohort 1</span></div>
        <h1 style="font-size:clamp(34px,5vw,56px);margin:20px 0 18px; color: var(--paper-1);">
          Welcome{learner.name ? `, ${learner.name.split(' ')[0]}` : ''}.
        </h1>
        <p class="lead" style="max-width:60ch; color: var(--ink-faint);">
          This is where the material lives — the session outlines, what to do before each one,
          and what to bring to the room. It fills in as we go; nothing here is a recording of a
          course that already exists.
        </p>
      </div>
    </section>

    <div class="card-body">
      <section style="padding-top:0;border-top:0">
        <div class="wrap">
          <button
            type="button"
            class="todo-tab"
            id="todoTab"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="todoPanel"
          >
            <span class="tt-label">To do</span>
            <span class={`tt-count ${todos.length === 0 ? 'clear' : ''}`}>
              {todos.length === 0 ? 'All clear' : todos.length}
            </span>
            <svg class="tt-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>

          <div class="factbar">
            <div><span class="k">Starts</span><span class="v">{cohort.startsOn}</span></div>
            <div><span class="k">Length</span><span class="v">{cohort.weeks} weeks</span></div>
            <div><span class="k">Commitment</span><span class="v">{cohort.commitment}</span></div>
            <div><span class="k">Format</span><span class="v">{cohort.format}</span></div>
          </div>

          <a class={`intake-card ${intakeState}`} href="/craft/intake">
            <span class="ic-state mono">
              {intakeState === 'submitted' ? 'Done' : intakeState === 'draft' ? 'In progress' : 'To do'}
            </span>
            <span class="ic-body">
              <span class="ic-t">Your intake</span>
              <span class="ic-s">
                {
                  intakeState === 'submitted'
                    ? 'Submitted — open it again to change any answer before we meet.'
                    : intakeState === 'draft'
                      ? 'You have a saved draft. Finish it and submit before Class 1.'
                      : 'Your baseline, before Class 1. About 20 minutes.'
                }
              </span>
            </span>
            <span class="arrow">→</span>
          </a>

          <div style="margin-top: 48px;">
            <h2 style="font-size:28px;margin:0 0 20px">Your Briefing</h2>
            <Briefing />
          </div>

          <div style="margin-top: 48px;">
            <h2 style="font-size:28px;margin:0 0 20px">Activity</h2>
            <div class="activity-grid">
              <a href="/craft/doubts" class="activity-card">
                <div class="a-val mono">{openDoubts}</div>
                <div class="a-label">Open doubts</div>
              </a>
              <a href="/craft/quiz" class="activity-card">
                <div class="a-val mono">{quizCompleted}/{quizTotal}</div>
                <div class="a-label">Quiz items completed</div>
              </a>
              <a href="/craft/adr" class="activity-card">
                <div class="a-val mono">{adrCount}</div>
                <div class="a-label">ADRs submitted</div>
              </a>
              <a href="/craft/feedback" class="activity-card">
                <div class="a-val mono">{pendingFeedback}</div>
                <div class="a-label">Feedback pending</div>
              </a>
            </div>
          </div>

          <div style="margin-top: 48px;">
            <h2 style="font-size:28px;margin:0 0 20px">Suggested Reading</h2>
            {reading.length > 0 ? (
              <div class="reading-grid">
                {reading.map((r) => (
                  <a href={r.item.source} target="_blank" rel="noopener noreferrer" class="reading-card">
                    <div class="r-reason mono">{r.reason}</div>
                    <div class="r-title">{r.item.title}</div>
                    <div class="r-meta mono">{r.item.sourceHost}</div>
                  </a>
                ))}
              </div>
            ) : (
              <p class="muted">Complete your intake to get personalised reading based on your baseline.</p>
            )}
          </div>

          <h2 style="font-size:28px;margin:56px 0 8px">Sessions</h2>
          <p class="muted" style="margin-bottom:26px">
            {ready} of {sessions.length} written. Each one unlocks its detail as it is finished —
            you are not missing anything that exists.
          </p>

          <div class="sessions">
            {
              sessions.map((s) => (
                <a class={`srow ${s.data.status}`} href={`/craft/week-${s.data.week}`}>
                  <span class="wk mono">Week {s.data.week}</span>
                  <span class="body">
                    <span class="t">{s.data.title}</span>
                    <span class="s">{s.data.summary}</span>
                    <span class="mod mono">
                      {s.data.module ? `${s.data.module} · ${moduleOf(s.data.module)?.title}` : 'Pre-work'}
                    </span>
                  </span>
                  <span class="state mono">{s.data.status === 'ready' ? 'Ready' : 'In progress'}</span>
                </a>
              ))
            }
          </div>

          <h2 style="font-size:28px;margin:64px 0 8px">What you are expected to bring</h2>
          <p class="muted" style="max-width:70ch;margin-bottom:22px">
            A real system you are accountable for. Every session works on yours, not on a toy —
            which is why the room is capped at {cohort.seats} seats.
          </p>

          <ul class="tlist">
            {
              cohort.outcomes.map((o, i) => (
                <li>
                  <span class="n" style="color: var(--sun);">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <p style="font-size:16px">{o}</p>
                  </div>
                </li>
              ))
            }
          </ul>

          <h2 style="font-size:28px;margin:64px 0 8px">Getting hold of Sunil</h2>
          <p class="muted" style="max-width:70ch">
            Email <a href={`mailto:${practitioner.email}`} style="color:var(--ink);">{practitioner.email}</a>
            — between sessions, not only during them. Bring the system, the constraint, and what you
            have already tried.
          </p>
        </div>
      </section>
      
      <footer class="card-footer">
        <div class="wrap">
          <div class="foot-grid" style="display:flex; justify-content:space-between; margin-bottom:32px;">
            <div>
              <div class="wordmark" style="margin-bottom:14px">
                <span class="dot" style="color:var(--sun);"></span> the living craft
              </div>
              <p class="muted" style="max-width:32ch">
                Your cohort area. Sessions, pre-work, and what to bring to the room.
              </p>
            </div>
            <div class="foot-col">
              <h5 style="font-size:11px; color:var(--ink-faint); margin-bottom:8px;" class="mono">Reach out</h5>
              <a href="mailto:apply@thelivingcraft.ai" style="font-weight:var(--weight-strong); font-size:16px;">apply@thelivingcraft.ai</a>
              <p class="muted" style="margin-top:8px;max-width:26ch">
                Email Sunil directly — there is no support queue, and there does not need to be
                one for eight people.
              </p>
            </div>
          </div>
          <div class="foot-bottom" style="display:flex; justify-content:space-between; padding-top:24px; border-top:1px solid var(--line-hair); color:var(--ink-faint); font-size:12px;">
            <span>© {new Date().getFullYear()} The Living Craft · Sunil Mathew</span>
            <span class="mono">Signed in as {learner.email}</span>
          </div>
        </div>
      </footer>
    </div>
  </div>

  <!-- The to-do panel. Translucent ground so the dashboard stays legible
       behind it — this is a layer over your week, not a separate page. -->
  <div class="todo-scrim" id="todoScrim" hidden>
    <div
      class="todo-panel"
      id="todoPanel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="todoHeading"
    >
      <header class="tp-head">
        <div>
          <h2 id="todoHeading">To do</h2>
          <p class="tp-sub">
            {todos.length === 0
              ? 'Nothing outstanding.'
              : `${todos.length} thing${todos.length > 1 ? 's' : ''} waiting on you.`}
          </p>
        </div>
        <button type="button" class="tp-close" id="todoClose" aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </header>

      {todos.length === 0 ? (
        <p class="tp-empty">
          Everything that was due is in. New items appear here as sessions are taught.
        </p>
      ) : (
        <ul class="tp-list">
          {todos.map((t) => (
            <li>
              <a href={t.href} class="tp-item">
                <span class="tp-body">
                  <span class="tp-label">{t.label}</span>
                  <span class="tp-detail">{t.detail}</span>
                </span>
                {t.count !== undefined && <span class="tp-count">{t.count}</span>}
                <svg class="tp-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</CraftLayout>

<script>
  // The to-do panel. No stored state: it opens on tap and closes on Escape,
  // on the scrim, on the close button, or on following an item.
  function initTodo() {
    const tab = document.getElementById('todoTab');
    const scrim = document.getElementById('todoScrim');
    const panel = document.getElementById('todoPanel');
    const close = document.getElementById('todoClose');
    if (!tab || !scrim || !panel || !close) return;

    const setOpen = (open: boolean) => {
      scrim.hidden = !open;
      tab.setAttribute('aria-expanded', String(open));
      // the scrim fades, so it needs a frame between unhide and the class
      if (open) requestAnimationFrame(() => scrim.classList.add('is-open'));
      else scrim.classList.remove('is-open');
      document.body.style.overflow = open ? 'hidden' : '';
      // focus lands inside the dialog, and returns to the tab on close
      if (open) (panel.querySelector('a, button') as HTMLElement | null)?.focus();
      else (tab as HTMLElement).focus();
    };

    tab.addEventListener('click', () => setOpen(true));
    close.addEventListener('click', () => setOpen(false));

    // only the ground, never a click inside the panel
    scrim.addEventListener('click', (e) => {
      if (e.target === scrim) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !scrim.hidden) setOpen(false);
    });
  }

  document.addEventListener('astro:page-load', initTodo);
</script>


<style>
  .content-card {
    background: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-raise);
    margin-bottom: 48px;
    overflow: hidden;
  }
  .hero-black {
    background: var(--noir);
    padding: 64px 0 44px;
    border-top-left-radius: var(--radius-card);
    border-top-right-radius: var(--radius-card);
  }
  .card-body {
    padding-bottom: 24px;
  }
  .card-footer {
    background: var(--paper-2);
    padding: 48px 0 24px;
    border-top: 1px solid var(--line-hair);
  }
  .factbar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--line);
    border-radius: var(--radius-inner);
    overflow: hidden;
    background: var(--surface);
  }
  .factbar > div {
    padding: 20px 22px;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .factbar > div:last-child {
    border-right: 0;
  }
  .factbar .k {
    font-family:var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: none;
    color: var(--ink-faint);
  }
  .factbar .v {
    font-size: 15px;
    font-weight: 500;
  }

  .intake-card {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr) auto;
    gap: 20px;
    align-items: center;
    margin-top: 28px;
    padding: 22px 26px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 2px solid var(--clay);
    border-radius: var(--radius-inner);
    transition: 0.18s;
  }
  .intake-card:hover {
    background: var(--surface-hover);
  }
  .intake-card.submitted {
    border-left-color: var(--line-strong, var(--line));
  }
  .ic-state {
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: none;
    color: var(--clay);
  }
  .intake-card.submitted .ic-state {
    color: var(--ink-faint);
  }
  .ic-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ic-t {
    font-family:var(--font-display);
    font-size: 20px;
    font-weight:var(--weight-strong);
  }
  .ic-s {
    font-size: 15px;
    color: var(--ink-soft);
    max-width: 66ch;
  }

  .activity-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .activity-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-inner);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: 0.18s;
  }
  .activity-card:hover {
    background: var(--surface-hover);
    border-color: var(--line-strong);
  }
  .a-val {
    font-size: 24px;
    color: var(--clay);
  }
  .a-label {
    font-size: 13px;
    color: var(--ink-faint);
  }

  .reading-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }
  .reading-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-inner);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: 0.18s;
  }
  .reading-card:hover {
    background: var(--surface-hover);
    border-color: var(--line-strong);
  }
  .r-reason {
    font-size: 11px;
    color: var(--clay);
    letter-spacing: var(--tracking-label);
  }
  .r-title {
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1.3;
    font-weight: var(--weight-medium);
    color: var(--ink);
  }
  .r-meta {
    font-size: 11px;
    color: var(--ink-faint);
    margin-top: auto;
  }

  .sessions {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-inner);
    overflow: hidden;
  }
  .srow {
    background: var(--surface);
    display: grid;
    grid-template-columns: 90px 1fr auto;
    gap: 22px;
    align-items: start;
    padding: 24px 26px;
    transition: 0.18s;
  }
  .srow:hover {
    background: var(--surface-hover);
  }
  .review-row:hover {
    background: var(--surface-hover);
  }
  .srow .wk {
    font-size: 12px;
    color: var(--clay);
    letter-spacing: 0.08em;
    padding-top: 3px;
  }
  .srow .body {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .srow .t {
    font-family:var(--font-display);
    font-size: 20px;
    font-weight:var(--weight-strong);
    line-height: 1.25;
  }
  .srow .s {
    font-size: 15px;
    color: var(--ink-soft);
    max-width: 66ch;
  }
  .srow .mod {
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
    margin-top: 3px;
  }
  .srow .state {
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: none;
    color: var(--ink-faint);
    border: 1px solid var(--line);
    border-radius: var(--radius-control);
    padding: 4px 9px;
    white-space: nowrap;
  }
  .srow.ready .state {
    color: var(--clay);
    border-color: var(--line-strong);
  }

  @media (max-width: 780px) {
    .factbar {
      grid-template-columns: repeat(2, 1fr);
    }
    .factbar > div:nth-child(2) {
      border-right: 0;
    }
    .intake-card {
      grid-template-columns: 1fr auto;
      gap: 10px 14px;
    }
    .intake-card .ic-state {
      grid-column: 1 / -1;
    }
    .activity-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .srow {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .srow .state {
      justify-self: start;
    }
  }

  /* --- the to-do tab ----------------------------------------------------- */
  .todo-tab {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: var(--control-h);
    padding: 0 8px 0 20px;
    margin-bottom: 24px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--sun);
    color: var(--ink);
    font-family: inherit;
    font-size: var(--size-3);
    font-weight: var(--weight-medium);
    cursor: pointer;
  }
  .todo-tab:hover { background: var(--accent-hover); }
