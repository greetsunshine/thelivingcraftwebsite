---
// The course area's front page — what a learner sees on signing in.
//
// Everything factual on this page (weeks, seats, commitment, format, start)
// comes from facts.ts, for the same reason the public pages do: a learner
// reading "6 weeks" here and "5 weeks" on the site they applied through is a
// small thing that costs a lot of trust.
import CraftLayout from '../../layouts/CraftLayout.astro';
import { getCollection } from 'astro:content';
import { cohort, practitioner } from '../../data/facts';
import { getIntake } from '../../lib/craft/intake';

// Gated: never prerender. A static file under dist/ would be served without the
// middleware ever running, which is the whole gate gone.
export const prerender = false;

const learner = Astro.locals.learner!;

const sessions = (await getCollection('sessions')).sort((a, b) => a.data.week - b.data.week);

// Surfaced on this page rather than only inside week 0, because an unsubmitted
// intake is the one outstanding task a learner has before the cohort starts and
// it should not be two clicks deep.
const intake = await getIntake(learner.id);
const intakeState = intake?.submitted_at ? 'submitted' : intake ? 'draft' : 'todo';
// Undefined on week 0, which is pre-work and belongs to no module.
const moduleOf = (id?: string) => (id ? cohort.modules.find((m) => m.id === id) : undefined);
const ready = sessions.filter((s) => s.data.status === 'ready').length;

const INTAKE_COPY = {
  submitted: {
    state: 'Done',
    line: 'Submitted — open it again to change any answer before we meet.',
  },
  draft: {
    state: 'In progress',
    line: 'You have a saved draft. Finish it and submit before Class 1.',
  },
  todo: {
    state: 'To do',
    line: 'Your baseline, before Class 1. About 20 minutes.',
  },
} as const;
const intakeCopy = INTAKE_COPY[intakeState];
---

<CraftLayout title="Your cohort" learner={learner}>
  <section class="hero craft-hero">
    <div class="wrap">
      <div class="eyebrow">The Living Craft <span class="num">/ cohort 1</span></div>
      <h1>Welcome{learner.name ? `, ${learner.name.split(' ')[0]}` : ''}.</h1>
      <p class="lead">
        This is where the material lives — the session outlines, what to do before each one,
        and what to bring to the room. It fills in as we go; nothing here is a recording of a
        course that already exists.
      </p>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="facts">
        <div><span class="klabel">Starts</span><span class="v">{cohort.startsOn}</span></div>
        <div><span class="klabel">Length</span><span class="v">{cohort.weeks} weeks</span></div>
        <div><span class="klabel">Commitment</span><span class="v">{cohort.commitment}</span></div>
        <div><span class="klabel">Format</span><span class="v">{cohort.format}</span></div>
      </div>

      <a
        class={`panel marked task ${intakeState === 'submitted' ? 'quiet' : ''}`}
        style="margin-top:var(--space-5)"
        href="/craft/intake"
      >
        <span class={`pill ${intakeState === 'submitted' ? 'done' : 'live'}`}>{intakeCopy.state}</span>
        <span class="body">
          <span class="t">Your intake</span>
          <span class="s">{intakeCopy.line}</span>
        </span>
        <span class="arrow">→</span>
      </a>

      <div class="craft-sec">
        <h2>Sessions</h2>
        <p class="muted">
          {ready} of {sessions.length} written. Each one unlocks its detail as it is finished —
          you are not missing anything that exists.
        </p>

        <div class="stack">
          {
            sessions.map((s) => (
              <a class="row hoverable srow" href={`/craft/week-${s.data.week}`}>
                <span class="klabel accent sess-wk">Week {s.data.week}</span>
                <span class="body">
                  <span class="t">{s.data.title}</span>
                  <span class="s">{s.data.summary}</span>
                  <span class="klabel sess-mod">
                    {s.data.module ? `${s.data.module} · ${moduleOf(s.data.module)?.title}` : 'Pre-work'}
                  </span>
                </span>
                <span class={`pill state ${s.data.status === 'ready' ? 'live' : ''}`}>
                  {s.data.status === 'ready' ? 'Ready' : 'In progress'}
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="craft-sec">
        <h2>What you are expected to bring</h2>
        <p class="muted">
          A real system you are accountable for. Every session works on yours, not on a toy —
          which is why the room is capped at {cohort.seats} seats.
        </p>

        <ul class="tlist">
          {
            cohort.outcomes.map((o, i) => (
              <li>
                <span class="n">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <p>{o}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="craft-sec">
        <h2>Getting hold of Sunil</h2>
        <p class="muted">
          Email <a href={`mailto:${practitioner.email}`} class="inline-link">{practitioner.email}</a>
          — between sessions, not only during them. Bring the system, the constraint, and what you
          have already tried.
        </p>
      </div>
    </div>
  </section>
</CraftLayout>

<style>
  /* Everything this page draws now comes from craft.css. What is left is the
     one link that is prose rather than a control. */
  .inline-link {
    color: var(--clay);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .inline-link:hover {
    color: var(--clay-deep);
  }
</style>
