---
// The course area's front page — what a learner sees on signing in.
//
// Everything factual on this page (weeks, seats, commitment, format, start)
// comes from facts.ts, for the same reason the public pages do: a learner
// reading "6 weeks" here and "5 weeks" on the site they applied through is a
// small thing that costs a lot of trust.
import CraftLayout from '../../layouts/CraftLayout.astro';
import { getCollection } from 'astro:content';
import { cohort, practitioner } from '../../data/facts';
import { getIntake } from '../../lib/craft/intake';

// Gated: never prerender. A static file under dist/ would be served without the
// middleware ever running, which is the whole gate gone.
export const prerender = false;

const learner = Astro.locals.learner!;

const sessions = (await getCollection('sessions')).sort((a, b) => a.data.week - b.data.week);

// Surfaced on this page rather than only inside week 0, because an unsubmitted
// intake is the one outstanding task a learner has before the cohort starts and
// it should not be two clicks deep.
const intake = await getIntake(learner.id);
const intakeState = intake?.submitted_at ? 'submitted' : intake ? 'draft' : 'todo';
// Undefined on week 0, which is pre-work and belongs to no module.
const moduleOf = (id?: string) => (id ? cohort.modules.find((m) => m.id === id) : undefined);
const ready = sessions.filter((s) => s.data.status === 'ready').length;
---

<CraftLayout title="Your cohort" learner={learner}>
  <section class="hero" style="border-top:0;padding:64px 0 44px">
    <div class="wrap">
      <div class="eyebrow">The Living Craft <span class="num">/ cohort 1</span></div>
      <h1 style="font-size:clamp(34px,5vw,56px);margin:20px 0 18px">
        Welcome{learner.name ? `, ${learner.name.split(' ')[0]}` : ''}.
      </h1>
      <p class="lead" style="max-width:60ch">
        This is where the material lives — the session outlines, what to do before each one,
        and what to bring to the room. It fills in as we go; nothing here is a recording of a
        course that already exists.
      </p>
    </div>
  </section>

  <section style="padding-top:0;border-top:0">
    <div class="wrap">
      <div class="factbar">
        <div><span class="k">Starts</span><span class="v">{cohort.startsOn}</span></div>
        <div><span class="k">Length</span><span class="v">{cohort.weeks} weeks</span></div>
        <div><span class="k">Commitment</span><span class="v">{cohort.commitment}</span></div>
        <div><span class="k">Format</span><span class="v">{cohort.format}</span></div>
      </div>

      <a class={`intake-card ${intakeState}`} href="/craft/intake">
        <span class="ic-state mono">
          {intakeState === 'submitted' ? 'Done' : intakeState === 'draft' ? 'In progress' : 'To do'}
        </span>
        <span class="ic-body">
          <span class="ic-t">Your intake</span>
          <span class="ic-s">
            {
              intakeState === 'submitted'
                ? 'Submitted — open it again to change any answer before we meet.'
                : intakeState === 'draft'
                  ? 'You have a saved draft. Finish it and submit before Class 1.'
                  : 'Your baseline, before Class 1. About 20 minutes.'
            }
          </span>
        </span>
        <span class="arrow">→</span>
      </a>

      <h2 style="font-size:28px;margin:56px 0 8px">Sessions</h2>
      <p class="muted" style="margin-bottom:26px">
        {ready} of {sessions.length} written. Each one unlocks its detail as it is finished —
        you are not missing anything that exists.
      </p>

      <div class="sessions">
        {
          sessions.map((s) => (
            <a class={`srow ${s.data.status}`} href={`/craft/week-${s.data.week}`}>
              <span class="wk mono">Week {s.data.week}</span>
              <span class="body">
                <span class="t">{s.data.title}</span>
                <span class="s">{s.data.summary}</span>
                <span class="mod mono">
                  {s.data.module ? `${s.data.module} · ${moduleOf(s.data.module)?.title}` : 'Pre-work'}
                </span>
              </span>
              <span class="state mono">{s.data.status === 'ready' ? 'Ready' : 'In progress'}</span>
            </a>
          ))
        }
      </div>

      <h2 style="font-size:28px;margin:64px 0 8px">What you are expected to bring</h2>
      <p class="muted" style="max-width:70ch;margin-bottom:22px">
        A real system you are accountable for. Every session works on yours, not on a toy —
        which is why the room is capped at {cohort.seats} seats.
      </p>

      <ul class="tlist">
        {
          cohort.outcomes.map((o, i) => (
            <li>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <p style="font-size:16px">{o}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <h2 style="font-size:28px;margin:64px 0 8px">Getting hold of Sunil</h2>
      <p class="muted" style="max-width:70ch">
        Email <a href={`mailto:${practitioner.email}`} style="color:var(--clay)">{practitioner.email}</a>
        — between sessions, not only during them. Bring the system, the constraint, and what you
        have already tried.
      </p>
    </div>
  </section>
</CraftLayout>

<style>
  .factbar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--line);
    border-radius: 3px;
    overflow: hidden;
    background: var(--surface);
  }
  .factbar > div {
    padding: 20px 22px;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .factbar > div:last-child {
    border-right: 0;
  }
  .factbar .k {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .factbar .v {
    font-size: 15px;
    font-weight: 500;
  }

  .intake-card {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr) auto;
    gap: 20px;
    align-items: center;
    margin-top: 28px;
    padding: 22px 26px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 2px solid var(--clay);
    border-radius: 3px;
    transition: 0.18s;
  }
  .intake-card:hover {
    background: #fff;
  }
  .intake-card.submitted {
    border-left-color: var(--line-strong, var(--line));
  }
  .ic-state {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--clay);
  }
  .intake-card.submitted .ic-state {
    color: var(--ink-faint);
  }
  .ic-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ic-t {
    font-family: 'Fraunces', serif;
    font-size: 20px;
    font-weight: 440;
  }
  .ic-s {
    font-size: 15px;
    color: var(--ink-soft);
    max-width: 66ch;
  }

  .sessions {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 3px;
    overflow: hidden;
  }
  .srow {
    background: var(--surface);
    display: grid;
    grid-template-columns: 90px 1fr auto;
    gap: 22px;
    align-items: start;
    padding: 24px 26px;
    transition: 0.18s;
  }
  .srow:hover {
    background: #fff;
  }
  .srow .wk {
    font-size: 12px;
    color: var(--clay);
    letter-spacing: 0.08em;
    padding-top: 3px;
  }
  .srow .body {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .srow .t {
    font-family: 'Fraunces', serif;
    font-size: 20px;
    font-weight: 440;
    line-height: 1.25;
  }
  .srow .s {
    font-size: 15px;
    color: var(--ink-soft);
    max-width: 66ch;
  }
  .srow .mod {
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
    margin-top: 3px;
  }
  .srow .state {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 4px 9px;
    white-space: nowrap;
  }
  .srow.ready .state {
    color: var(--clay);
    border-color: var(--line-strong);
  }

  @media (max-width: 780px) {
    .factbar {
      grid-template-columns: repeat(2, 1fr);
    }
    .factbar > div:nth-child(2) {
      border-right: 0;
    }
    .intake-card {
      grid-template-columns: 1fr auto;
      gap: 10px 14px;
    }
    .intake-card .ic-state {
      grid-column: 1 / -1;
    }
    .srow {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .srow .state {
      justify-self: start;
    }
  }
</style>
