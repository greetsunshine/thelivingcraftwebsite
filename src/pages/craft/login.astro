---
// Learner sign-in. A plain HTML form, no JavaScript — same reasoning as the
// admin login: the one page where a failed script means nobody gets in.
//
// Reached without a session (middleware allowlists it), so it passes no learner
// to CraftLayout and gets the bare shell — wordmark, no nav, no footer
// identity. It used to hand-roll the whole document instead, which is how it
// ended up the only page in the area on the current design system while the
// three behind the gate were still on the previous one.
import CraftLayout from '../../layouts/CraftLayout.astro';

export const prerender = false;

const params = Astro.url.searchParams;
const failed = params.get('e') === '1';
const throttled = params.get('e') === 'throttled';
const wait = params.get('m') ?? '';

// Only ever return to the course area. Without this, ?next= is an open redirect
// wearing the cohort's own login page as a disguise.
const requested = params.get('next') ?? '/craft';
const next = requested.startsWith('/craft') && !requested.startsWith('//') ? requested : '/craft';
---

<CraftLayout title="Sign in">
  <div class="signin">
    <form class="panel" method="POST" action="/api/craft/login">
      <h1>Your cohort</h1>
      <p class="muted">
        Sign in with the email you applied with and the access code Sunil sent you.
      </p>

      <input type="hidden" name="next" value={next} />

      <label>
        <span class="lbl">Email</span>
        <input class="field" type="email" name="email" required autofocus autocomplete="email" inputmode="email" />
      </label>

      <label>
        <span class="lbl">Access code</span>
        <input
          class="field code"
          type="text"
          name="code"
          required
          autocomplete="one-time-code"
          spellcheck="false"
          placeholder="xxxxxx-xxxxxx-xxxxxx-xxxxxx"
        />
      </label>

      {failed && <p class="err">That email and code don't match a seat. Check both, dashes optional.</p>}
      {
        throttled && (
          <p class="err">
            Too many attempts. Try again in {wait} minute{wait === '1' ? '' : 's'}.
          </p>
        )
      }

      <button class="btn btn-primary" type="submit">Sign in</button>

      <p class="help">
        Lost your code? Email <a href="mailto:apply@thelivingcraft.ai">apply@thelivingcraft.ai</a>
        and Sunil will issue a new one — the old one stops working when he does.
      </p>
    </form>
  </div>
</CraftLayout>

<style>
  /* The one thing this page needs that the area does not: a code is read
     character by character when someone is checking it against an email. */
  .code {
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }
</style>
