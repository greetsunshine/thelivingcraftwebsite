---
import CraftLayout from '../../layouts/CraftLayout.astro';
export const prerender = false;
const learner = Astro.locals.learner!;

const threads = [
  {
    from: 'Sunil Mathew',
    initials: 'SM',
    time: '2h ago',
    subject: 'Re: PR #14 — worker death handling',
    preview: "Good instinct on the DLQ. One thing to consider: if your visibility timeout is shorter than your p99 processing time, you'll get duplicate deliveries even when nothing is wrong\u2026",
    unread: true,
  },
  {
    from: 'Learning Agent',
    initials: 'L',
    time: '5h ago',
    subject: 'Week 4 material summary ready',
    preview: "I've finished reading the Week 4 material. Two key concepts to flag: the worker-loop pattern and the idempotency requirement for queue consumers\u2026",
    unread: true,
  },
  {
    from: 'Sunil Mathew',
    initials: 'SM',
    time: 'Aug 22',
    subject: 'Re: Blast radius question from session',
    preview: "The short answer is: you're right that the service mesh boundary is the natural blast-radius boundary, but only if your circuit breakers are actually configured to trip\u2026",
    unread: false,
  },
  {
    from: 'Learning Agent',
    initials: 'L',
    time: 'Aug 19',
    subject: 'Your PR #12 review is ready',
    preview: "I've completed the review of your PR #12. Two observations and one concern flagged. The concern is about the retry logic in worker/api.ts\u2026",
    unread: false,
  },
  {
    from: 'Sunil Mathew',
    initials: 'SM',
    time: 'Aug 14',
    subject: 'Welcome to Cohort 1',
    preview: "Welcome aboard. The pre-work is live — you'll find it under Week 0 in your dashboard. Take your time with the intake; it's not a test, it's a baseline\u2026",
    unread: false,
  },
];
---
<CraftLayout title="Messages" learner={learner}>
  <div class="messages-page">
    <h1 class="messages-title">Messages</h1>
    <p class="messages-sub">Direct messages from Sunil and your learning agent.</p>

    <div class="threads-list">
      {threads.map(t => (
        <a class={`thread-row ${t.unread ? 'unread' : ''}`} href="#">
          <div class={`avatar ${t.initials === 'L' ? 'agent' : ''}`}>
            <span>{t.initials}</span>
          </div>
          <div class="thread-body">
            <div class="thread-top">
              <span class="thread-from">{t.from}</span>
              <span class="mono thread-time">{t.time}</span>
            </div>
            <span class="thread-subject">{t.subject}</span>
            <span class="thread-preview">{t.preview}</span>
          </div>
          {t.unread && <span class="unread-dot"></span>}
        </a>
      ))}
    </div>
  </div>
</CraftLayout>

<style>
  .messages-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 48px 0;
  }
  .messages-title {
    font-size: clamp(28px, 4vw, 40px);
    margin: 0 0 4px;
  }
  .messages-sub {
    color: var(--ink-soft);
    font-size: 15px;
    margin-bottom: 32px;
  }
  .threads-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-inner);
    overflow: hidden;
  }
  .thread-row {
    background: var(--surface);
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px 24px;
    text-decoration: none;
    color: var(--ink);
    transition: background 0.15s;
    position: relative;
  }
  .thread-row:hover {
    background: var(--surface-hover);
  }
  .thread-row.unread {
    background: var(--surface-hover);
  }
  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--paper-2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: var(--weight-strong);
    color: var(--ink-soft);
    flex-shrink: 0;
  }
  .avatar.agent {
    background: var(--sun);
    color: var(--noir);
  }
  .thread-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .thread-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .thread-from {
    font-weight: var(--weight-medium);
    font-size: 14px;
  }
  .thread-time {
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
  }
  .thread-subject {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: var(--weight-strong);
  }
  .thread-preview {
    font-size: 14px;
    color: var(--ink-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .unread-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--clay);
    flex-shrink: 0;
    margin-top: 6px;
  }
</style>
