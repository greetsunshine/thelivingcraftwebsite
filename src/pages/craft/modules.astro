---
import CraftLayout from '../../layouts/CraftLayout.astro';
import { getCollection } from 'astro:content';
import { learnerCohort as cohort } from '../../data/learner-cohort';
import { sessionEnded } from '../../lib/craft/checks';
export const prerender = false;
const learner = Astro.locals.learner!;

// Real state, per week, instead of the invented percentage this page used to
// draw. Three things are knowable and all three come from the session file:
// which module it belongs to, whether its material is written, and whether it
// has been taught. Nothing here is computed from what the learner has done —
// a module is a piece of the syllabus, not a score.
const sessions = (await getCollection('sessions')).sort((a, b) => a.data.week - b.data.week);

const weeksOf = (moduleId: string) =>
  sessions
    .filter((s) => s.data.module === moduleId)
    .map((s) => ({
      week: s.data.week,
      slug: s.id,
      title: s.data.title,
      ready: s.data.status === 'ready',
      taught: sessionEnded(s.data.endsAt),
    }));
---
<CraftLayout title="Modules" learner={learner}>
  <div class="modules-page">
    <h1 class="modules-title">Modules</h1>
    <p class="modules-sub">{cohort.weeks} weeks · {cohort.modules.length} modules</p>

    <div class="modules-grid" data-tour="module-list">
      {cohort.modules.map((m) => {
        const weeks = weeksOf(m.id);
        const taught = weeks.filter((w) => w.taught).length;
        return (
          <div class={`module-card ${taught > 0 && taught < weeks.length ? 'active' : ''}`} data-tour="module-card">
            <div class="module-header">
              <span class="mono module-id">{m.id}</span>
              <span class="mono module-weeks">{m.weeks}</span>
            </div>
            <h3 class="module-name">{m.title}</h3>

            {weeks.length === 0 ? (
              <p class="module-empty">No session file carries this module yet.</p>
            ) : (
              <ul class="module-weeklist">
                {weeks.map((w) => (
                  <li>
                    <a href={`/craft/${w.slug}`}>
                      <span class="mw-n mono">W{w.week}</span>
                      <span class="mw-t">{w.title}</span>
                      <span class={`mw-s mono ${w.taught ? 'taught' : w.ready ? 'ready' : 'draft'}`}>
                        {w.taught ? 'taught' : w.ready ? 'ready' : 'being written'}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        );
      })}
    </div>
  </div>
</CraftLayout>

<style>
  .modules-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 48px 0;
  }
  .modules-title {
    font-size: clamp(28px, 4vw, 40px);
    margin: 0 0 4px;
  }
  .modules-sub {
    color: var(--ink-soft);
    font-size: 15px;
    margin-bottom: 36px;
  }
  .modules-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .module-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-inner);
    padding: 28px;
    transition: all 0.2s;
  }
  .module-card:hover {
    background: var(--surface-hover);
    box-shadow: var(--shadow-raise);
  }
  .module-card.active {
    border-left: 3px solid var(--clay);
  }
  .module-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .module-id {
    font-size: 12px;
    color: var(--clay);
    letter-spacing: 0.08em;
    font-weight: var(--weight-medium);
  }
  .module-weeks {
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
  }
  .module-name {
    font-size: 18px;
    font-family: var(--font-display);
    font-weight: var(--weight-strong);
    margin: 0 0 20px;
    line-height: 1.3;
  }
  .module-empty {
    color: var(--ink-faint);
    font-size: 13px;
    margin: 14px 0 0;
  }
  .module-weeklist {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
  }
  .module-weeklist li + li {
    border-top: 1px solid var(--line);
  }
  .module-weeklist a {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 8px 0;
    color: inherit;
  }
  .module-weeklist a:hover .mw-t {
    color: var(--clay);
  }
  .mw-n {
    font-size: 11px;
    color: var(--ink-faint);
    flex: 0 0 auto;
  }
  .mw-t {
    flex: 1 1 auto;
    font-size: 14px;
    min-width: 0;
  }
  .mw-s {
    flex: 0 0 auto;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .mw-s.taught { color: var(--clay); }
  .mw-s.ready { color: var(--ink-soft); }

  @media (max-width: 780px) {
    .modules-grid { grid-template-columns: 1fr; gap: 14px; }
  }
</style>
