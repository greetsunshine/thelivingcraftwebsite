---
import CraftLayout from '../../layouts/CraftLayout.astro';
export const prerender = false;
const learner = Astro.locals.learner!;

const notes = [
  {
    date: 'Aug 24, 2026',
    week: 4,
    title: 'Visibility timeout pattern for SQS',
    body: 'If the worker dies mid-processing, the message must return to the queue after a timeout. Without this, the message is silently lost. Key insight from Sunil: "A queue without a visibility timeout is a queue that lies to you."',
    tags: ['D4', 'queues', 'reliability'],
  },
  {
    date: 'Aug 19, 2026',
    week: 3,
    title: 'Exponential backoff — when fixed delay fails',
    body: 'Fixed 1s retry loops cause thundering-herd problems against rate-limited APIs. The exponential backoff with jitter pattern is the standard answer. Added to my worker/api.ts after the A1 review flagged it.',
    tags: ['D1', 'retry', 'backoff'],
  },
  {
    date: 'Aug 12, 2026',
    week: 2,
    title: 'Blast radius as a design constraint',
    body: 'Session takeaway: every architectural boundary is a blast-radius decision. The question isn\'t "will this fail?" — it\'s "when this fails, what else dies with it?" Applied this framing to my service mesh config.',
    tags: ['D1', 'architecture', 'blast-radius'],
  },
  {
    date: 'Aug 5, 2026',
    week: 1,
    title: 'First impressions — intake reflections',
    body: 'Completed the intake assessment. Surprised by how much I assumed about my own system\'s failure modes without evidence. The intake forced me to articulate what I actually know vs. what I hope.',
    tags: ['intake', 'reflection'],
  },
];
---
<CraftLayout title="Field Notes" learner={learner}>
  <div class="notes-page">
    <div class="notes-header">
      <div>
        <h1 class="notes-title">Field Notes</h1>
        <p class="notes-sub">Your personal learning journal — observations, insights, and things to remember.</p>
      </div>
      <button class="new-note-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="5" y2="19"/><line x1="5" x2="19" y1="12" y2="12"/></svg>
        New note
      </button>
    </div>

    <div class="notes-list">
      {notes.map(n => (
        <div class="note-card">
          <div class="note-meta">
            <span class="mono note-date">{n.date}</span>
            <span class="mono note-week">Week {n.week}</span>
          </div>
          <h3 class="note-title">{n.title}</h3>
          <p class="note-body">{n.body}</p>
          <div class="note-tags">
            {n.tags.map(t => (
              <span class="mono tag">{t}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</CraftLayout>

<style>
  .notes-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 48px 0;
  }
  .notes-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 36px;
  }
  .notes-title {
    font-size: clamp(28px, 4vw, 40px);
    margin: 0 0 4px;
  }
  .notes-sub {
    color: var(--ink-soft);
    font-size: 15px;
    margin: 0;
  }
  .new-note-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: var(--noir);
    color: var(--paper-1);
    border: none;
    border-radius: var(--radius-control);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: var(--weight-medium);
    cursor: pointer;
    transition: opacity 0.15s;
    white-space: nowrap;
  }
  .new-note-btn:hover {
    opacity: 0.85;
  }
  .notes-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .note-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-inner);
    padding: 28px;
    transition: all 0.15s;
  }
  .note-card:hover {
    background: var(--surface-hover);
    box-shadow: var(--shadow-raise);
  }
  .note-meta {
    display: flex;
    gap: 12px;
    margin-bottom: 10px;
  }
  .note-date {
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
  }
  .note-week {
    font-size: 11px;
    color: var(--clay);
    letter-spacing: 0.06em;
  }
  .note-title {
    font-size: 18px;
    font-family: var(--font-display);
    font-weight: var(--weight-strong);
    margin: 0 0 8px;
  }
  .note-body {
    font-size: 15px;
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 0 0 16px;
    max-width: 70ch;
  }
  .note-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tag {
    font-size: 11px;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    background: var(--paper-2);
    color: var(--ink-soft);
    letter-spacing: var(--tracking-label);
  }
</style>
