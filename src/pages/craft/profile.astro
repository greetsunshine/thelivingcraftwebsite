---
import CraftLayout from '../../layouts/CraftLayout.astro';
import { mockMemberState } from '../../data/mock-dashboard';
export const prerender = false;
const learner = Astro.locals.learner!;
---
<CraftLayout title="Profile" learner={learner}>
  <div class="profile-page">
    <div class="profile-card">
      <div class="profile-avatar">
        <span>{(learner.name ?? learner.email).charAt(0).toUpperCase()}</span>
      </div>
      <div class="profile-info">
        <h1 class="profile-name">{learner.name ?? 'Learner'}</h1>
        <p class="profile-email mono">{learner.email}</p>
        <div class="profile-badges">
          <span class="mono pbadge">Cohort 1</span>
          <span class="mono pbadge status">Active</span>
        </div>
      </div>
    </div>

    <div class="profile-sections">
      <div class="psection">
        <h2 class="psection-title">Dimension Summary</h2>
        <p class="psection-sub">Your current standing across the 5 evaluation dimensions.</p>
        <div class="dim-list">
          {mockMemberState.map(d => (
            <div class="dim-row">
              <div class="dim-left">
                <span class="mono dim-id">{d.dimension}</span>
                <span class="dim-name">{d.title}</span>
              </div>
              <div class="dim-right">
                <div class="dim-bar-track">
                  <div class="dim-bar-fill" style={`width: ${Math.max(d.level * 20, 5)}%`}></div>
                </div>
                <span class="mono dim-level">L{d.level}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="psection">
        <h2 class="psection-title">Activity</h2>
        <p class="psection-sub">Your engagement across the cohort so far.</p>
        <div class="stats-grid">
          <div class="stat-card">
            <span class="stat-value">3</span>
            <span class="stat-label">PRs submitted</span>
          </div>
          <div class="stat-card">
            <span class="stat-value">4</span>
            <span class="stat-label">Field notes</span>
          </div>
          <div class="stat-card">
            <span class="stat-value">12</span>
            <span class="stat-label">Agent conversations</span>
          </div>
          <div class="stat-card">
            <span class="stat-value">87%</span>
            <span class="stat-label">Session attendance</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</CraftLayout>

<style>
  .profile-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 48px 0;
  }
  .profile-card {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-bottom: 48px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--line);
  }
  .profile-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--noir);
    color: var(--paper-1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    font-weight: var(--weight-strong);
    font-family: var(--font-display);
    flex-shrink: 0;
  }
  .profile-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .profile-name {
    font-size: 28px;
    margin: 0;
  }
  .profile-email {
    font-size: 13px;
    color: var(--ink-faint);
    margin: 0;
  }
  .profile-badges {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }
  .pbadge {
    font-size: 11px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--paper-2);
    color: var(--ink-soft);
    letter-spacing: var(--tracking-label);
  }
  .pbadge.status {
    background: rgba(76, 175, 80, 0.12);
    color: #2e7d32;
  }

  .profile-sections {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .psection-title {
    font-size: 22px;
    margin: 0 0 4px;
  }
  .psection-sub {
    color: var(--ink-soft);
    font-size: 14px;
    margin: 0 0 24px;
  }

  .dim-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .dim-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-inner);
  }
  .dim-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .dim-id {
    font-size: 12px;
    color: var(--clay);
    letter-spacing: 0.08em;
    font-weight: var(--weight-medium);
  }
  .dim-name {
    font-size: 15px;
    font-weight: var(--weight-medium);
  }
  .dim-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .dim-bar-track {
    width: 120px;
    height: 6px;
    background: var(--paper-2);
    border-radius: 3px;
    overflow: hidden;
  }
  .dim-bar-fill {
    height: 100%;
    background: var(--clay);
    border-radius: 3px;
  }
  .dim-level {
    font-size: 12px;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
    width: 24px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .stat-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-inner);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: center;
  }
  .stat-value {
    font-size: 28px;
    font-weight: var(--weight-strong);
    font-family: var(--font-display);
  }
  .stat-label {
    font-size: 13px;
    color: var(--ink-soft);
  }
</style>
