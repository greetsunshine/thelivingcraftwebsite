---
import CraftLayout from '../../layouts/CraftLayout.astro';
import { cohort } from '../../data/facts';
export const prerender = false;
const learner = Astro.locals.learner!;

const results = [
  { type: 'Session', title: 'Worker-loop pattern', week: 4, snippet: 'The worker-loop is a durable execution primitive that…', match: 'worker' },
  { type: 'PR Finding', title: 'Missing visibility timeout on queue.pop()', week: 3, snippet: 'The worker pulls from the queue and processes, but does not use a visibility timeout or DLQ…', match: 'worker queue timeout' },
  { type: 'Material', title: 'Bounded failure & blast-radius control', week: 2, snippet: 'A well-designed agentic system confines failure to the smallest blast radius possible…', match: 'blast radius' },
  { type: 'Field Note', title: 'Exponential backoff vs fixed delay', week: 3, snippet: 'The retry loop uses a fixed 1-second delay. For external API calls, this leads to throttling…', match: 'backoff timeout retry' },
  { type: 'Session', title: 'Idempotency and visibility timeouts', week: 4, snippet: 'If your visibility timeout is shorter than your p99 processing time, you will get duplicate deliveries…', match: 'timeout queue' },
];
---
<CraftLayout title="Search" learner={learner}>
  <div class="search-page">
    <h1 class="search-title">Search your cohort</h1>
    <p class="search-sub">Sessions, PR findings, field notes, and course material — all in one place.</p>

    <div class="search-bar">
      <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input type="text" class="search-input" placeholder="Try 'worker loop', 'blast radius', or 'backoff'…" id="search-input" value="worker" />
    </div>

    <div class="search-results" id="search-results">
      {results.map(r => (
        <a class="result-row" href="#" data-match={r.match}>
          <div class="result-type">
            <span class="mono badge">{r.type}</span>
            <span class="mono week">Week {r.week}</span>
          </div>
          <div class="result-body">
            <span class="result-title">{r.title}</span>
            <span class="result-snippet">{r.snippet}</span>
          </div>
          <span class="result-arrow">→</span>
        </a>
      ))}
    </div>
  </div>
</CraftLayout>

<style>
  .search-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 48px 0;
  }
  .search-title {
    font-size: clamp(28px, 4vw, 40px);
    margin: 0 0 8px;
  }
  .search-sub {
    color: var(--ink-soft);
    font-size: 15px;
    margin-bottom: 32px;
  }
  .search-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-inner);
    padding: 14px 20px;
    margin-bottom: 32px;
    transition: border-color 0.2s;
  }
  .search-bar:focus-within {
    border-color: var(--clay);
  }
  .search-icon {
    color: var(--ink-faint);
    flex-shrink: 0;
  }
  .search-input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 16px;
    font-family: var(--font-body);
    background: transparent;
    color: var(--ink);
  }
  .search-input::placeholder {
    color: var(--ink-faint);
  }

  .search-results {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-inner);
    overflow: hidden;
  }
  .result-row {
    background: var(--surface);
    display: grid;
    grid-template-columns: 120px 1fr auto;
    gap: 20px;
    align-items: center;
    padding: 20px 24px;
    text-decoration: none;
    color: var(--ink);
    transition: background 0.15s;
  }
  .result-row:hover {
    background: var(--surface-hover);
  }
  .result-type {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .badge {
    font-size: 11px;
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    background: var(--paper-2);
    color: var(--ink-soft);
    letter-spacing: var(--tracking-label);
    width: fit-content;
  }
  .week {
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
  }
  .result-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .result-title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: var(--weight-strong);
  }
  .result-snippet {
    font-size: 14px;
    color: var(--ink-soft);
    max-width: 60ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .result-arrow {
    color: var(--ink-faint);
    font-size: 18px;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const input = document.getElementById('search-input') as HTMLInputElement;
    const results = document.querySelectorAll('.result-row');
    
    if (!input) return;

    input.addEventListener('input', (e) => {
      const term = (e.target as HTMLInputElement).value.toLowerCase();
      
      results.forEach(row => {
        const title = row.querySelector('.result-title')?.textContent?.toLowerCase() || '';
        const snippet = row.querySelector('.result-snippet')?.textContent?.toLowerCase() || '';
        const match = row.getAttribute('data-match') || '';
        
        if (title.includes(term) || snippet.includes(term) || match.includes(term)) {
          (row as HTMLElement).style.display = 'grid';
        } else {
          (row as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
