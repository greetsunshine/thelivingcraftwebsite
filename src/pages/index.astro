---
/**
 * The cohort page — and the address every campaign link points at.
 *
 * All fifteen October posts carry
 * `learning.thelivingcraft.ai/?utm_source=linkedin&…&utm_content=lc-oct-dNN`.
 * The growth roadmap proposes `/programmes/agentic-systems/` eventually; that
 * is a design target, and it says in terms that the current address keeps
 * working "until routing and redirects are approved and tested". So this stays
 * here, and a move is a redirect exercise with the campaign in mind, not a file
 * rename.
 *
 * WHY THIS IS STILL SERVER-RENDERED
 *
 * It used to be, so the price block could follow the visitor's region. The
 * approved public offer now withholds fees and dates everywhere. Region still
 * reaches the Ask widget as useful enquiry context, but never changes what the
 * site or assistant says about the offer. The no-store header remains while
 * that request-specific context is passed through.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CohortPage from '../components/cohort/CohortPage.astro';
import { EXPLORES, QUESTIONS, STANDFIRST } from '../data/cohort-copy';
import { SITE_ORIGIN, publicCohort } from '../data/facts';

export const prerender = false;

const VALID = ['india', 'dubai', 'australia'] as const;
type Key = (typeof VALID)[number];

const param = Astro.url.searchParams.get('region')?.toLowerCase();
const geoMap: Record<string, Key> = { IN: 'india', AE: 'dubai', AU: 'australia' };
const geo = Astro.request.headers.get('x-vercel-ip-country')?.toUpperCase() ?? '';
const key: Key | undefined = VALID.includes(param as Key) ? (param as Key) : geoMap[geo];

Astro.response.headers.set('Cache-Control', 'no-store');

const title = 'The Living Craft — Design agentic systems, guide your team';
const description = STANDFIRST;

/**
 * STRUCTURED DATA SAYS ONLY WHAT THE PAGE SAYS.
 *
 * The roadmap's rule: structured data "may describe the organisation, person,
 * article, breadcrumbs, course or video only when the visible content supports
 * it". Three things the previous version of this file emitted are therefore
 * gone while the delivered copy is what ships:
 *
 *   * `offers` — the page publishes no price. An Offer node carrying one is a
 *     crawler, and an AI assistant reading that crawler's index, being told a
 *     number no visitor is shown. This is the D1 blast radius in its most
 *     literal form.
 *   * `hasCourseInstance.startDate` and `maximumAttendeeCapacity` — the page
 *     states no start date, and "targets eight members" is not a capacity.
 *   * `syllabusSections` with `timeRequired: 'PT5H'` — that was six weeks at
 *     five hours, and the brief forbids invented module durations by name.
 *
 * `teaches` comes from the five areas the page actually renders.
 *
 * The FAQPage node is built from the same array the page renders, for the same
 * reason. Note the roadmap's own caution: do not expect FAQ markup to secure a
 * rich result. It is here because it is true, not because it is a tactic.
 */
const schema = [
  {
    '@type': 'Course',
    '@id': `${SITE_ORIGIN}/#course`,
    name: publicCohort.name,
    description,
    url: SITE_ORIGIN,
    provider: { '@id': `${SITE_ORIGIN}/#person` },
    instructor: { '@id': `${SITE_ORIGIN}/#person` },
    educationalLevel: 'Advanced',
    teaches: EXPLORES.map((e) => `${e.title}: ${e.body}`),
    hasCourseInstance: [
      {
        '@type': 'CourseInstance',
        courseMode: 'Online',
        // The one commitment figure the delivered copy does state.
        courseWorkload: 'PT30H',
        instructor: { '@id': `${SITE_ORIGIN}/#person` },
      },
    ],
  },
  {
    '@type': 'FAQPage',
    '@id': `${SITE_ORIGIN}/#faq`,
    mainEntity: QUESTIONS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical="/" schema={schema} region={key ?? null}>
  <CohortPage />
</BaseLayout>
