---
// The privacy policy.
//
// Written from the code and from what the live site actually loads, rather
// than from a template. Every claim below names the file (or the place) that
// makes it true, so the next person to change a data path can find the sentence
// that has to change with it:
//
//   visitor identification      src/lib/admin/visitor.ts
//   what a visit records        src/components/Track.astro, src/pages/api/track.ts
//   enquiries and applications  src/pages/api/lead.ts, src/lib/pipeline/forms.ts
//   downloads (the gate)        src/pages/api/pipeline/download.ts, src/lib/pipeline/resources.ts
//   where a visitor came from   src/lib/pipeline/attribution.ts,
//                               src/lib/pipeline/touch-client.ts (the two
//                               cookies, written only with an analytics yes)
//   the named events            src/lib/analytics/events.ts, context.ts
//   assistant transcripts       src/pages/api/ask.ts
//   seats and intake            src/lib/craft/learners.ts, src/lib/craft/intake.ts
//   bookings and invites        src/lib/booking/store.ts, src/lib/booking/google.ts
//   retention and erasure       supabase/schema.sql (admin_purge)
//   the audit's autosave        src/pages/resources/rule-placement-audit.astro
//   third-party tags            the Google Tag Manager container GTM-P4DRQLB8
//                               (src/data/site.ts), loaded by the layouts that
//                               render <GoogleTagManager />, and only after a
//                               yes in the consent banner
//   the consent banner          src/lib/consent/consent.ts, client.ts,
//                               src/components/ConsentBanner.astro
//
// THE THIRD-PARTY TAGS LIVE IN THE GTM CONSOLE, NOT IN THIS REPOSITORY. On 29
// September 2026 the live site was observed loading Google Analytics 4
// (G-S2XJ61GXDD) and Microsoft Clarity (yin1xnh55d) through the container.
// The Meta Pixel, the LinkedIn Insight Tag and the Apollo.io tag are listed at
// the owner's instruction of the same day and were NOT yet observed firing.
// Whoever adds or removes a tag in GTM changes this page in the same week.
//
// NO META CONVERSIONS API. The owner decided on 29 September 2026 to use the
// Meta Pixel only. The Conversions API sends events from a server, where the
// consent banner cannot reach it, and it would carry hashed email addresses.
// If it is ever added, this page needs a paragraph for it first.
//
// IF YOU CHANGE WHAT IS COLLECTED, CHANGE THIS PAGE IN THE SAME COMMIT. A
// privacy policy that has drifted from the system is worse than none.
import PolicyLayout from '../layouts/PolicyLayout.astro';
import { CONTACT_EMAIL } from '../data/site';
import { canonical } from '../data/facts';
import { FORMS } from '../lib/pipeline/forms';
import { MARKETING_CONSENT } from '../lib/pipeline/consent';
import { CONSENT_COOKIE, CONSENT_DAYS } from '../lib/consent/consent';
import { FIRST_TOUCH_COOKIE, SESSION_TOUCH_COOKIE } from '../lib/pipeline/attribution';
import ConsentBanner from '../components/ConsentBanner.astro';

// The field lists are read from the form definitions rather than retyped. A
// field added to a form then appears here on the next deploy, which is the only
// way this section stays true.
const routes = (['application', 'enquiry', 'enterprise'] as const).map((key) => ({
  key,
  title: FORMS[key].title,
  required: FORMS[key].fields.filter((f) => f.required).map((f) => f.label),
  optional: FORMS[key].fields.filter((f) => !f.required).map((f) => f.label),
}));

export const prerender = false;

const title = 'Privacy — The Living Craft';
const description =
  'What this site collects, which analytics and advertising tags it uses, who else receives data, how long it is kept, and how to have it deleted.';

// One date, one place. Shown in the header and in the closing section.
const UPDATED = '29 September 2026';

// The interactive tools and kits that load no tag manager, so none of the
// third-party tags below (ResourcesLayout, and tagManager={false} on the
// design check). Keep this list in step with those layouts.
const TAG_FREE_TOOLS = [
  'the POC Selection Tool',
  'the Model Selection Tool',
  'the Agent Authority Review',
  'the Run-Cost Model',
  'the Cost-Ceiling Workbook',
  'the Rework Cost Check',
  'the Rule Placement Audit',
  'the Agent Memory Audit Kit',
  'the Agent Failure Triage Kit',
  'the Agent Failure Triage Quiz',
  'the Agent Design Check',
];
---

<PolicyLayout title={title} description={description} canonical={canonical('/privacy')} label="Privacy">
  <section class="policy-head">
    <div class="wrap">
      <span class="eyebrow"><span class="num">01</span> Privacy</span>
      <h1>What this site knows about you</h1>
      <p class="lead">
        This practice sells judgement about how AI systems handle data. So this page names the
        fields, the tags, the companies involved and how long things are kept. It is written from
        the code and from what the live site actually loads.
      </p>
      <p class="stamp">Last updated {UPDATED}</p>
    </div>
  </section>

  <section class="policy">
    <div class="wrap">
      <div class="summary">
        <h2>The short version</h2>
        <ul>
          <li>Most public pages can load Google Analytics and Microsoft Clarity, and advertising tags from Meta, LinkedIn and Apollo.io. Each is described below.</li>
          <li>None of them loads until you say yes in the cookie banner. Saying no is one click, and the site works the same either way.</li>
          <li>These tags set cookies, and Clarity can record how you move through a page.</li>
          <li>The interactive tools, this page and the course area load none of them.</li>
          <li>If you fill in a form, download a file, book a call or talk to the assistant, I keep what you gave, because that is the request.</li>
          <li>I do not sell or rent your details to anybody.</li>
          <li>Ask me to delete what I hold and it is deleted, not archived or flagged.</li>
        </ul>
      </div>

      <h2>Who is responsible</h2>
      <p>
        Sunil Mathew, operating as The Living Craft, from Bangalore, India. Under India's Digital
        Personal Data Protection Act 2023, that makes me the Data Fiduciary for everything described
        here, and you the Data Principal.
      </p>
      <p>
        A small number of people help me run the website and its marketing. They can read the
        records described below in my operator console, and they work under my instructions. I
        answer privacy requests myself.
      </p>
      <p>
        Reach me at <a class="ftext-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>

      <h2 id="tags">Analytics and advertising tags</h2>
      <p>
        Most public pages can load Google Tag Manager. It is a container: it loads the tags below,
        and it is where they are switched on and off. It loads only after you allow analytics in
        the cookie banner. When it does, these companies receive data directly from your browser,
        including your IP address, because that is how a browser fetches anything.
      </p>

      <h3>Where they run, and where they do not</h3>
      <p>
        They run on the cohort page, the Fractional CAIO and AI Readiness Assessment pages, the
        field notes, and the reading pages: About, Programmes, Advisory, Contact, the resource and
        tool index pages, the worksheets, the templates and the guides.
      </p>
      <p>They do not run on:</p>
      <ul>
        <li>the interactive tools and kits: {TAG_FREE_TOOLS.join(', ')}</li>
        <li>this page and the terms page</li>
        <li>the page that manages a booked call</li>
        <li>the course area and anything else behind a sign-in</li>
      </ul>
      <p>
        The tools are kept free of them on purpose. Several of them promise that what you type stays
        in your browser, and a session-recording tag on the same page would break that promise.
      </p>

      <h3>Google Analytics</h3>
      <p>
        Counts visits and tells me which pages are read, where visitors came from, and roughly where
        they are, from their IP address. It sets the cookies <code>_ga</code> and
        <code>_ga_S2XJ61GXDD</code>, which last up to two years and let Google recognise the same
        browser when it returns. Google keeps the data for the period set in my account, at most
        14 months.
      </p>

      <h3>Microsoft Clarity</h3>
      <p>
        Records how visitors use a page: scrolling, clicks, mouse movement and what was on the
        screen. I use it to see where a page confuses people. It sets <code>_clck</code> (one
        year) and <code>_clsk</code> (one day) on this site, and Microsoft sets its own cookies,
        such as <code>MUID</code> and <code>CLID</code>, on its own domains.
      </p>
      <p>
        Clarity is designed to hide what you type into form fields. Text shown on the page can
        still appear in a recording, and that includes a conversation with the assistant once it
        is on screen. Microsoft keeps recordings for 30 days and summary data for up to 13 months.
      </p>

      <h3>Meta Pixel</h3>
      <p>
        Meta runs Facebook and Instagram. The Meta Pixel tells Meta that a browser visited a page or
        took an action here, such as submitting a form. I use this to measure whether advertising
        brings people to the site, and to show adverts to people who have visited. It sets the
        cookie <code>_fbp</code>, which lasts about three months.
      </p>
      <p>
        The pixel runs in your browser, and only if you allowed advertising. Nothing is sent to
        Meta from this site's servers. The pixel is set up without Meta's "advanced matching",
        so it does not send Meta your name, email address or phone number from a form.
      </p>

      <h3>LinkedIn Insight Tag</h3>
      <p>
        Tells LinkedIn that a LinkedIn member visited or took an action here. I use it to measure
        LinkedIn adverts, to see the kinds of roles and companies that visit, and to show adverts
        to people who have visited. LinkedIn sets its own cookies. It says it removes direct
        identifiers within seven days and keeps the rest for up to 180 days.
      </p>

      <h3>Apollo.io</h3>
      <p>
        Apollo.io keeps a database of businesses and business contacts. Its tag tells Apollo which
        pages were visited and from which network. Apollo uses that to work out which companies
        visited, and it may match a visit to people in its database. I use it to see which
        organisations are interested in this work. Apollo sets its own cookie.
      </p>

      <h3 id="choices">Asking first</h3>
      <p>
        None of these tags loads until you say yes. The first time you open a page here, a banner
        asks. On the interactive tools the answer is saved for the rest of the site, and none of
        these tags loads on those tools either way. You can accept all, reject all, or choose:
      </p>
      <ul>
        <li><strong>Analytics:</strong> Google Analytics and Microsoft Clarity, and this site's own two cookies that remember where your visit began (described under <a class="ftext-link" href="#came-from">where your visit came from</a>).</li>
        <li><strong>Advertising:</strong> Meta, LinkedIn and Apollo.io. They load through the same container as the analytics tags, so they only run when analytics is also on.</li>
      </ul>
      <p>
        If you reject, or close the page without answering, nothing on this list loads. Your
        answer is kept in one cookie, <code>{CONSENT_COOKIE}</code>, for {CONSENT_DAYS} days. After
        that, or when this list of tags changes, you are asked again.
      </p>
      <p>
        You can change your answer at any time with "Cookie choices" at the foot of those pages, or
        with the button below. Turning a category off deletes the cookies its tags set on this
        site and reloads the page. Cookies a company set on its own domain, such as Microsoft's,
        can only be removed in your browser or with that company.
      </p>
      <p>
        <button type="button" class="consent-open" data-consent-open>Change your cookie choices</button>
      </p>
      <ConsentBanner />
      <p>
        You can also block them yourself: most browsers can block third-party cookies, and a
        content blocker stops the tags from loading at all. Google publishes an opt-out add-on for
        Google Analytics. Meta and LinkedIn let you turn off adverts based on other websites in
        your account's advert settings.
      </p>

      <h2>What this site records itself</h2>

      <h3>When you read a page</h3>
      <p>
        This site keeps its own simple record of visits on the cohort page, the Fractional CAIO
        page, the AI Readiness Assessment page, and every page under <code>/resources/</code> and
        <code>/tools/</code>. Nothing is recorded by this site's own code on this page, on the
        field notes, on the other reading pages, or behind a sign-in.
      </p>
      <p>Each recorded event holds:</p>
      <ul>
        <li>which page, and what happened on it: a view, opening the assistant or asking it something, starting a form, a field the form refused (which field and why, never what you typed), following a link to another part of the practice or to the cohort (with which button it was), starting to use a tool, reaching a tool's result, or receiving a file you asked for. The tool events name the tool and nothing you entered into it</li>
        <li>a random identifier for that one event, so that an event sent twice is stored once</li>
        <li>whether it came from the live site or a test copy of it, and your answer in the cookie banner at the time</li>
        <li>the <em>host</em> you arrived from, such as <code>linkedin.com</code>, never the full link</li>
        <li>your country, from the hosting layer, and your region only if it is in the page address</li>
        <li>whether the device is a phone or a computer</li>
        <li>a visitor identifier, described next</li>
      </ul>
      <p>
        <strong>This identifier is deliberately short-lived.</strong> It is a cryptographic hash of
        your IP address, your browser's user-agent string, a secret held on the server, and
        <em>today's date</em>. Because the date is part of it, it changes at midnight UTC, and the
        same person returning next week is an unrelated row. The raw IP address is used to compute
        the hash and is never written to storage by this site. Automated crawlers are dropped
        before anything is recorded.
      </p>
      <p>
        This short-lived identifier is this site's own. The Google Analytics and Clarity cookies
        described above do recognise a returning browser, for as long as those cookies last.
      </p>

      <h3>When you submit an enquiry or application</h3>
      <p>
        Submissions are emailed to me through a form-delivery service, and written to my own
        database so that I have a searchable history. That second copy also records whether the
        email went through, because a failed delivery used to be invisible.
      </p>
      <p>
        The three routes into the programme ask for these fields, and nothing else on those
        pages collects personal details. No file upload is offered anywhere on this site, and you
        are asked not to send confidential company material.
      </p>
      {
        routes.map((route) => (
          <div class="route-fields">
            <h4>{route.title}</h4>
            <p><strong>Required:</strong> {route.required.join(', ')}</p>
            {route.optional.length > 0 && (
              <p><strong>Optional:</strong> {route.optional.join(', ')}</p>
            )}
          </div>
        ))
      }
      <p>
        When a submission or a download request is saved, the server also records that it was
        saved, with an opaque record number and no personal details. That is how I count
        applications without counting button presses.
      </p>
      <p>
        The forms ask one optional question, "How did you first hear about The Living Craft?", with
        a list of answers and a short line for anything to add. That answer is kept beside your
        submission and apart from the campaign tags below. It is never sent to an analytics tag.
      </p>
      <h4 id="came-from">Where your visit came from</h4>
      <p>
        With each submission and each download request I also keep where your visit came from:
        the campaign tags in the address you arrived on (such as <code>utm_source</code>), the
        host of the site that sent you, and the page you started on. That tells me which posts and
        pages bring people here.
      </p>
      <p>
        <strong>If you have not allowed analytics</strong>, no cookie is used for this, and only
        the page the form is on is counted. If you arrived on a guide and applied on the cohort
        page, I see the cohort page and not the guide.
      </p>
      <p>
        <strong>If you have allowed analytics</strong>, this site writes two small cookies of its
        own on the page where you arrive from another site, a link or a bookmark:
      </p>
      <ul>
        <li><code>{SESSION_TOUCH_COOKIE}</code> holds how this visit began. It is deleted when you close the browser, and the next arrival replaces it.</li>
        <li><code>{FIRST_TOUCH_COOKIE}</code> holds how your first visit began. It is written once and kept for 400 days.</li>
      </ul>
      <p>
        Each holds the campaign tags, the page, the host of the site that sent you and the date.
        Neither holds an identifier, your IP address or anything you typed, and moving between
        pages of this site never changes them. They are read only when you send a form or ask for
        a file, and only while your answer in the banner is still yes. Turning analytics off
        deletes them.
      </p>
      <p>
        Records are grouped by email address. A download and a later application from the same
        address sit under one person. You are shown a reference when a submission is saved.
        Nothing on this site looks a record up by that reference. No card details are collected
        anywhere on this site, and there is nothing to pay to apply.
      </p>

      <h3>When you download a file</h3>
      <p>
        Every file on the resource pages asks for your name and email address first: the
        workbooks, the PDFs, the worksheets, the templates and the print copies. I keep your name,
        your email address, which resource and which file you asked for, when, and where your
        visit came from, as described above.
      </p>
      <p>
        A download is not permission to market to you. It starts no email sequence. The address is
        used to send you that resource once, when email sending is switched on. Today no email is
        sent by machine at all.
      </p>
      <p>
        When a file is built from your own answers, such as a scored PDF, your answers go into the
        file and are not stored. Two tools never send what you type anywhere: the Rule Placement
        Audit and the Agent Design Check build their files in your browser.
      </p>

      <h3>When you tick the marketing box</h3>
      <p>The forms carry one optional tick box, in these words:</p>
      <blockquote><p>{MARKETING_CONSENT.wording}</p></blockquote>
      <p>
        It starts unticked and nothing depends on it. Your application is treated the same either
        way. A receipt confirming that your request was saved is not marketing.
      </p>
      <p>
        What you agreed to is stored with the words you were shown, under a version label. If that
        sentence is ever reworded, it becomes a new version, and your record keeps pointing at the
        words above.
      </p>
      <p>
        No follow-up email is sent today. The sequence is built and switched off, pending a
        verified sending domain and a monitored reply mailbox.
      </p>

      <h3>When you talk to the assistant</h3>
      <p>
        The assistant on the public pages is automated. It is a Claude model from Anthropic, not
        Sunil. Your question and its answer are sent to Anthropic to produce the reply. Both are
        stored here with the page you asked from, your country, and some counters about how the
        answer was produced.
      </p>
      <p>
        A short session identifier ties one conversation together. It lives in the browser tab's
        memory, is never written to your device, and is gone when you close the tab.
      </p>
      <p>
        I read these conversations. They show me what my pages fail to explain. Please do not type
        anything confidential into a chat box on any website, including this one.
      </p>

      <h3>When you book a call</h3>
      <p>
        Booking a discovery, scope or cohort call records your name, email address, company, job
        title, anything you write in the notes field, your timezone, and the time you chose.
      </p>
      <p>
        The booking is created as an event in my Google Calendar with you as a guest, which sends
        you the invitation and the video link. So your name, email address and notes are passed to
        Google as part of the event. Cancelling removes it from both calendars.
      </p>
      <p>
        The link in your invitation that lets you reschedule carries a secret. Only a hash of it is
        stored here. Please do not forward that invitation.
      </p>

      <h3>If you join the cohort</h3>
      <p>
        Participants get an access code for the course area. I store your name, email, which
        cohort you are in, and a hash of that code. <strong>The code itself is never
        stored</strong>, so a copy of the database does not let anyone sign in as you.
      </p>
      <p>
        The pre-cohort questionnaire and the work you do in the course area are stored against your
        seat. I read them and use them to plan the sessions. What you post in the cohort's
        discussion forum is visible to the other participants; everything else is not.
      </p>

      <h2>Cookies and what is stored in your browser</h2>
      <p>If you allow them, the tags above set their own cookies:</p>
      <ul>
        <li>Google Analytics: <code>_ga</code> and <code>_ga_S2XJ61GXDD</code>, up to two years</li>
        <li>Microsoft Clarity: <code>_clck</code> (one year) and <code>_clsk</code> (one day), plus Microsoft's own cookies on its domains, and one session-storage entry, <code>_cltk</code>, which is cleared when the tab closes</li>
        <li>Meta: <code>_fbp</code>, about three months</li>
        <li>LinkedIn and Apollo.io: their own cookies, described in their policies</li>
      </ul>
      <p>This site's own code writes very little:</p>
      <ul>
        <li><code>{CONSENT_COOKIE}</code>, which remembers your answer in the cookie banner for {CONSENT_DAYS} days. It holds the two answers and the date, and nothing that identifies you</li>
        <li>only if you allowed analytics: <code>{SESSION_TOUCH_COOKIE}</code> (until the browser closes) and <code>{FIRST_TOUCH_COOKIE}</code> (400 days), which remember where a visit began, as described under <a class="ftext-link" href="#came-from">where your visit came from</a></li>
        <li>one cookie that keeps you signed in to the course area, if you hold a seat</li>
        <li>one cookie that keeps me signed in to my operator console</li>
        <li>on the Rule Placement Audit only, your rows are saved in your own browser's local storage, so that closing the tab does not lose them. They are never sent to me, and clearing your browser's site data removes them</li>
      </ul>
      <p>
        Both sign-in cookies are signed, marked HttpOnly so that no script can read them, sent only
        over HTTPS, and restricted to this site.
      </p>

      <h2>Who else processes it</h2>
      <p>Each entry says what reaches them.</p>
      <dl class="parties">
        <div>
          <dt>Vercel</dt>
          <dd>Hosts the site and runs its server code. Sees every request, and supplies the country a visit is recorded with. Vercel also keeps its own aggregate traffic counts on the public pages, including the tools, but not on this page or behind a sign-in.</dd>
        </div>
        <div>
          <dt>Supabase</dt>
          <dd>The database behind everything this site records. Reachable only with a server-side key that never reaches a browser.</dd>
        </div>
        <div>
          <dt>Web3Forms</dt>
          <dd>Delivers form submissions to my inbox. Receives whatever you typed into the form.</dd>
        </div>
        <div>
          <dt>Anthropic</dt>
          <dd>Provides the Claude model behind the assistant. Receives your question and the context needed to answer it.</dd>
        </div>
        <div>
          <dt>Google</dt>
          <dd>Tag Manager and Analytics, as described above. Calendar, only when you book a call: it receives the event, your name, your email address and your notes.</dd>
        </div>
        <div>
          <dt>Microsoft</dt>
          <dd>Clarity, as described above.</dd>
        </div>
        <div>
          <dt>Meta</dt>
          <dd>The Meta Pixel, as described above.</dd>
        </div>
        <div>
          <dt>LinkedIn</dt>
          <dd>The Insight Tag, as described above.</dd>
        </div>
        <div>
          <dt>Apollo.io</dt>
          <dd>Its website tag, as described above.</dd>
        </div>
        <div>
          <dt>GitHub</dt>
          <dd>Holds the site's source code. No personal data from this site is sent there.</dd>
        </div>
      </dl>
      <p>
        Meta and LinkedIn are advertising networks, and Apollo.io is a business-contact database.
        I do not sell, rent or trade your details to them or to anybody else.
      </p>
      <p>
        Several of these companies process data outside India, mostly in the United States. The
        Act allows that, except to countries the Government of India restricts.
      </p>

      <h2>How long it is kept</h2>
      <table class="retention">
        <thead>
          <tr><th>What</th><th>Kept for</th><th>Why that long</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>This site's visit records</td>
            <td>180 days</td>
            <td>The identifier has already rotated daily, so an old row answers no question worth keeping it for.</td>
          </tr>
          <tr>
            <td>Assistant conversations</td>
            <td>365 days</td>
            <td>These carry text you typed. A year is long enough to see what my pages keep failing to explain.</td>
          </tr>
          <tr>
            <td>Enquiries and applications</td>
            <td>Until you ask me to delete it</td>
            <td>A real enquiry must not be lost to an automated job. There is a copy in my inbox either way.</td>
          </tr>
          <tr>
            <td>Download requests</td>
            <td>Until you ask me to delete it</td>
            <td>It records what you asked for and that you gave your address for it.</td>
          </tr>
          <tr>
            <td>Booked calls</td>
            <td>Until you ask me to delete it</td>
            <td>A record of a conversation. Cancelled bookings are kept as cancelled rather than erased.</td>
          </tr>
          <tr>
            <td>Seats and course work</td>
            <td>Until you ask me to delete it</td>
            <td>A participant record outlasts the cohort. Withdrawn seats are kept deliberately.</td>
          </tr>
          <tr>
            <td>Google Analytics</td>
            <td>At most 14 months</td>
            <td>The period set in my account, within Google's limit.</td>
          </tr>
          <tr>
            <td>Microsoft Clarity</td>
            <td>30 days; summaries 13 months</td>
            <td>Microsoft's own limits for recordings and for summary data.</td>
          </tr>
          <tr>
            <td>Meta, LinkedIn, Apollo.io</td>
            <td>Their own policies</td>
            <td>Each company sets its own period. Follow the links below.</td>
          </tr>
        </tbody>
      </table>
      <p>
        The first two windows are enforced by the database itself, with a floor that refuses a
        window shorter than thirty days, so a mistyped number cannot empty a table.
      </p>
      <p>
        The companies' own policies:
        <a class="ftext-link" href="https://policies.google.com/privacy" rel="noopener">Google</a>,
        <a class="ftext-link" href="https://www.microsoft.com/en-us/privacy/privacystatement" rel="noopener">Microsoft</a>,
        <a class="ftext-link" href="https://www.facebook.com/privacy/policy/" rel="noopener">Meta</a>,
        <a class="ftext-link" href="https://www.linkedin.com/legal/privacy-policy" rel="noopener">LinkedIn</a>,
        <a class="ftext-link" href="https://www.apollo.io/privacy-policy" rel="noopener">Apollo.io</a>.
      </p>

      <h2>Your rights, and what happens when you use them</h2>
      <p>
        Under the Act you can ask for a summary of what I hold about you, ask me to correct or
        complete it, ask me to delete it, withdraw a consent you gave, and nominate someone to act
        for you. Email <a class="ftext-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> and
        say which. I reply myself, and I aim to do it within thirty days. If you are not satisfied
        with my answer, you can complain to the Data Protection Board of India.
      </p>
      <p>
        <strong>Deletion means deletion.</strong> The row is removed from the database, not flagged
        as hidden or moved to an archive. Deleting a person also removes their download requests.
        Deleting a participant also deletes their questionnaire answers and course work. Deleting a
        booking cancels the calendar event first.
      </p>
      <p>Three honest limits:</p>
      <ul>
        <li>Emails you sent me, and the email copy of any form you submitted, live in my mail account and are deleted there as a separate step.</li>
        <li>This site's own visit records hold nothing that links back to you, so there is nothing of yours in them to return or delete.</li>
        <li>Google, Microsoft, Meta, LinkedIn and Apollo.io hold their data against a cookie or an account, not against your name in my records. Clearing your cookies breaks that link. For anything more, tell me and I will use what their tools allow, or contact them directly through the links above.</li>
      </ul>

      <h2>What this site does not do</h2>
      <ul>
        <li>No selling, renting or trading of your details.</li>
        <li>No automated decisions about you. Applications are read by me.</li>
        <li>No marketing email without the tick box above, and none at all is being sent today.</li>
        <li>No third-party tags before you say yes, and none at all on the interactive tools, on this page, or behind a sign-in.</li>
      </ul>

      <h2>Children</h2>
      <p>
        This is a professional programme for practising engineers, and it is not intended for
        anyone under 18. I do not knowingly collect anything from a child. If you believe a child
        has sent me something, write to me and I will delete it.
      </p>

      <h2>Security</h2>
      <p>
        Everything is served over HTTPS. The database refuses every key except one held on the
        server, which is never sent to a browser. Access codes and reschedule links are stored only
        as hashes. The operator console is password-gated and excluded from search engines.
      </p>
      <p>
        No system is perfectly secure. If you find a problem here, write to me and I will fix it
        and tell you what happened.
      </p>

      <h2>Changes to this page</h2>
      <p>
        This page is versioned alongside the code it describes, and it changes when the site does.
        The date at the top is the date it last changed. There is no archive of earlier versions,
        and changes are noted here rather than announced by email.
      </p>

      <div class="closing">
        <p>
          <strong>Last updated {UPDATED}.</strong> Questions about any of this, or a request to see
          or delete what I hold, go to
          <a class="ftext-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
        </p>
      </div>
    </div>
