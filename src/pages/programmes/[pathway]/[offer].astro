---
/**
 * The six offer pages under /programmes/, one route, from the 15 October 2026
 * landing-page package:
 *
 *   /programmes/agentic-systems/focused-agent-build/
 *   /programmes/agentic-systems/design-and-build-a-poc/
 *   /programmes/agentic-systems/design-to-deployment/
 *   /programmes/career-preparation/focused-mock-interview/
 *   /programmes/career-preparation/interview-preparation-and-practice/
 *   /programmes/career-preparation/agentic-ai-career-transition-roadmap/
 *
 * Every word and figure comes from src/data/programme-offers.ts. The page is
 * the order of that entry's sections, then the enquiry form with this offer
 * already chosen. An unknown pair of segments rewrites to /404.
 */
import '../../../styles/templates/programme.css';
import PracticeLayout from '../../../layouts/PracticeLayout.astro';
import ProgrammeHero from '../../../components/programmes/ProgrammeHero.astro';
import ProgrammeSection from '../../../components/programmes/ProgrammeSection.astro';
import RouteForm from '../../../components/cohort/RouteForm.astro';
import { SITE_ORIGIN } from '../../../data/facts';
import { PATHWAYS, PORTRAIT, interestsFor, offerFacts, offerFor } from '../../../data/programme-offers';

const o = offerFor(Astro.params.pathway ?? '', Astro.params.offer ?? '');
if (!o) return Astro.rewrite('/404');

const p = PATHWAYS[o.pathway];
const path = `/programmes/${o.pathway}/${o.slug}/`;

const schema = [
  {
    '@type': 'BreadcrumbList',
    '@id': `${SITE_ORIGIN}${path}#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Programmes', item: `${SITE_ORIGIN}/programmes/` },
      { '@type': 'ListItem', position: 2, name: p.short, item: `${SITE_ORIGIN}/programmes/${o.pathway}/` },
      { '@type': 'ListItem', position: 3, name: o.name },
    ],
  },
];

const compareLabel = o.pathway === 'agentic-systems' ? 'Compare Build programmes' : 'Compare career packages';
---

<PracticeLayout
  bodyClass="programme-page offer-page"
  title={`${o.name} — The Living Craft`}
  description={o.description}
  canonical={path}
  schema={schema}
  action={{ label: 'Enquire', href: '#enquire' }}
  related={[
    ['All programmes', '/programmes/'],
    [PATHWAYS['agentic-systems'].short, '/programmes/agentic-systems/'],
    [PATHWAYS['career-preparation'].short, '/programmes/career-preparation/'],
  ]}
  stickyApply={false}
>
  {/* PRICING REVIEW: the fee in the eyebrow comes from programme-offers.ts and
      is not yet calibrated. See the header of that file. */}
  <ProgrammeHero
    crumbs={[
      { label: 'Programmes', href: '/programmes/' },
      { label: p.short, href: `/programmes/${o.pathway}/` },
      { label: o.name },
    ]}
    eyebrow={`${o.name} · ${offerFacts(o)}`}
    title={o.hero.title}
    lede={o.hero.lede}
    cta={{ label: o.hero.cta, href: '#enquire' }}
    image={o.hero.image}
    portrait={o.hero.portrait ? PORTRAIT : undefined}
  />

  {o.sections.map((section) => <ProgrammeSection section={section} />)}

  <section class="wrap" id="enquire">
    <div class="sec-head">
      <p class="eyebrow">Next step</p>
      <h2>{o.enquiry.heading}</h2>
      <p class="lead">{o.enquiry.intro}</p>
    </div>
    <RouteForm
      route="enquiry"
      id="enquiry-form"
      heading="Send your enquiry"
      intro="This is an enquiry, not an application or a booking."
      choices={{ interest: interestsFor(o.pathway) }}
      preset={{ interest: o.slug }}
    />
  </section>

  <section class="wrap pg-related">
    <p>
      <a class="textlink" href={`/programmes/${o.pathway}/#choose`}>{compareLabel}</a>
      <span aria-hidden="true"> · </span>
      <a class="textlink" href="/programmes/">View both pathways</a>
    </p>
  </section>
</PracticeLayout>
