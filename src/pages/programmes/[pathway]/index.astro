---
/**
 * /programmes/agentic-systems/ and /programmes/career-preparation/ — one page
 * per pathway, from the 15 October 2026 landing-page package. Each compares
 * its three offers in a table, then gives each offer a short card, then the
 * enquiry form.
 *
 * Every word and figure comes from src/data/programme-offers.ts. Read that
 * file's header before changing a fee: it says what is not yet reviewed.
 *
 * Rendered on request like every public page here (see CLAUDE.md, "A
 * prerendered route decides this at BUILD time"), so an unknown pathway is a
 * rewrite to /404, the same draft gate the guide pages use.
 *
 * /programmes/enterprise/ is a static route beside this one and wins over it;
 * Astro ranks a static segment above a dynamic one.
 */
import '../../../styles/templates/programme.css';
import PracticeLayout from '../../../layouts/PracticeLayout.astro';
import ProgrammeHero from '../../../components/programmes/ProgrammeHero.astro';
import ProgrammeSection from '../../../components/programmes/ProgrammeSection.astro';
import RouteForm from '../../../components/cohort/RouteForm.astro';
import { SITE_ORIGIN } from '../../../data/facts';
import {
  PATHWAYS,
  PORTRAIT,
  interestsFor,
  isPathway,
  offersIn,
  type PathwayKey,
} from '../../../data/programme-offers';

const key = Astro.params.pathway;
if (!isPathway(key)) return Astro.rewrite('/404');

const p = PATHWAYS[key];
const offers = offersIn(key);
const other = PATHWAYS[(key === 'agentic-systems' ? 'career-preparation' : 'agentic-systems') as PathwayKey];
const path = `/programmes/${key}/`;

// A link can choose the offer in advance: ?interest=career-readiness-review.
// Only a value this page offers is honoured; anything else is ignored.
const interests = interestsFor(key);
const asked = Astro.url.searchParams.get('interest');
const preset = asked && interests.includes(asked) ? { interest: asked } : undefined;

const schema = [
  {
    '@type': 'BreadcrumbList',
    '@id': `${SITE_ORIGIN}${path}#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Programmes', item: `${SITE_ORIGIN}/programmes/` },
      { '@type': 'ListItem', position: 2, name: p.short },
    ],
  },
];

/** "10" on the Build table; "1 hour", "3 hours" on the Career one, as the package prints them. */
const hoursCell = (hours: number) => (key === 'agentic-systems' ? String(hours) : `${hours} ${hours === 1 ? 'hour' : 'hours'}`);
/** The Build table states independent work per week; the column reads "4–5 hours/week". */
const perWeek = (s?: string) => s?.replace(' per week', '/week') ?? '';
---

<PracticeLayout
  bodyClass="programme-page pathway-page"
  title={`${p.name} — The Living Craft`}
  description={p.description}
  canonical={path}
  schema={schema}
  action={{ label: 'Enquire', href: '#enquire' }}
  related={[
    ['All programmes', '/programmes/'],
    [PATHWAYS['agentic-systems'].short, '/programmes/agentic-systems/'],
    [PATHWAYS['career-preparation'].short, '/programmes/career-preparation/'],
  ]}
  stickyApply={false}
>
  <ProgrammeHero
    crumbs={[{ label: 'Programmes', href: '/programmes/' }, { label: p.short }]}
    eyebrow={p.name}
    title={p.hero.title}
    lede={p.hero.lede}
    cta={{ label: p.hero.cta, href: '#choose' }}
    image={p.hero.image}
    portrait={p.hero.portrait ? PORTRAIT : undefined}
  />

  {p.intro.map((section) => <ProgrammeSection section={section} />)}

  {/* ── the comparison, then one card per offer ─────────────────────────── */}
  <section class="wrap" id="choose">
    <div class="sec-head">
      <h2>{p.tableHeading}</h2>
    </div>

    {/* PRICING REVIEW: these fees come from programme-offers.ts and are not
        yet calibrated. See the header of that file. */}
    <div class="lc-table-scroll pg-table" role="region" aria-label={`${p.short} comparison`} tabindex="0">
      <table class="lc-table">
        <thead>
          <tr>
            <th scope="col">{key === 'agentic-systems' ? 'Programme' : 'Package'}</th>
            <th scope="col">{p.table.summary}</th>
            <th scope="col">{p.table.hours}</th>
            {p.table.independent && <th scope="col">{p.table.independent}</th>}
            <th scope="col">{p.table.fee}</th>
          </tr>
        </thead>
        <tbody>
          {
            offers.map((o) => (
              <tr>
                <th scope="row">
                  <a class="textlink" href={`/programmes/${key}/${o.slug}/`}>
                    {o.name}
                  </a>
                </th>
                <td>{o.summary}</td>
                <td class="num">{hoursCell(o.hours)}</td>
                {p.table.independent && <td>{perWeek(o.independentWork)}</td>}
                <td class="num">{o.fee}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <ol class="pg-offers">
      {
        offers.map((o, i) => (
          <li class="pg-offer">
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{o.name}</h3>
              <p class="pg-fit">{o.fit}</p>
              {o.card.map((para) => (
                <p>{para}</p>
              ))}
              <a class="pg-go" href={`/programmes/${key}/${o.slug}/`}>
                Explore {o.name}&nbsp;<span class="arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {
    key === 'agentic-systems' && (
      <>
        <ProgrammeSection section={p.after[0]} />
        {/* The package's team section and its team form. The form is the
            enterprise route from forms.ts, the same definition the cohort
            page renders at /#team, so it is one form in two places rather
            than a second definition. */}
        <section class="wrap" id="team">
          <div class="sec-head">
            <h2>Developing a whole team?</h2>
          </div>
          <div class="prose stack">
            <p>
              An enterprise programme starts with the team’s existing capability and the work it
              needs to handle. The discussion can cover architecture, evaluation, operating
              boundaries and shared approaches to reviewing designs.
            </p>
            <p>
              Team scope, live hours, group size, schedule and fee are agreed separately. Individual
              sponsorship is also a distinct route.
              <a class="textlink" href="/programmes/enterprise/">Read about enterprise learning</a>.
            </p>
          </div>
          <RouteForm
            route="enterprise"
            id="team-form"
            heading="Discuss your team"
            intro="Share the capability your team wants to develop and the work it needs to handle. The team will discuss an appropriate learning scope with you."
          />
        </section>
        {p.after.slice(1).map((section) => <ProgrammeSection section={section} />)}
      </>
    )
  }
  {key === 'career-preparation' && p.after.map((section) => <ProgrammeSection section={section} />)}

  {/* ── the enquiry ──────────────────────────────────────────────────────── */}
  <section class="wrap" id="enquire">
    <div class="sec-head">
      <p class="eyebrow">Next step</p>
      <h2>{p.enquiry.heading}</h2>
      <p class="lead">{p.enquiry.intro}</p>
    </div>
    <RouteForm
      route="enquiry"
      id="enquiry-form"
      heading="Send your enquiry"
      intro="This is an enquiry, not an application or a booking."
      choices={{ interest: interests }}
      preset={preset}
    />
  </section>

  <section class="wrap pg-related">
    <p>
      <a class="textlink" href={`/programmes/${other.key}/`}>{p.crossLink}</a>
      <span aria-hidden="true"> · </span>
      <a class="textlink" href="/programmes/">View both pathways</a>
    </p>
  </section>
</PracticeLayout>
