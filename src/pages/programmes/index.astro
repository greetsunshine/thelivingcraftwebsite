---
/**
 * /programmes/ — the page for somebody who has decided the subject is right and
 * has not decided which route into it is theirs.
 *
 * THE ROADMAP ROW THIS PAGE IS WRITTEN AGAINST
 *
 *   "Visitor choosing individual or group learning. Unsure which route fits;
 *    explain cohort, individual sponsorship and enterprise separately.
 *    Evidence: current offer facts. Next step: corresponding programme page."
 *
 * Three routes, and the reason they get one page rather than three is that the
 * reader's question is comparative. Somebody who does not know whether to apply
 * themselves or ask their employer cannot answer that from two pages that each
 * describe only their own route.
 *
 * ═══════════════════════════════════════════════════════════════════════════
 * THE COHORT LIVES AT `/`. DO NOT LINK IT AS /programmes/agentic-systems/.
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * All fifteen October campaign posts point at learning.thelivingcraft.ai/ with
 * utm_content=lc-oct-dNN. The roadmap proposes /programmes/agentic-systems/ as
 * a design target and says in terms that the current address keeps working
 * "until routing and redirects are approved and tested". Creating that path —
 * even as a copy, even as a redirect — before that work is done splits the
 * campaign's destination in two.
 *
 * WHAT MUST NOT BE ADDED
 *
 *   * Fees, dates or week counts. The V4 public copy withholds them; every
 *     offer sentence on this page comes from src/data/offer-display.ts, and
 *     the five learning areas come from src/data/cohort-copy.ts so this page
 *     and the cohort page cannot drift apart. Never restate either inline.
 *   * "30 live hours" against the ENTERPRISE route. That figure is the open
 *     cohort's, from the delivered copy. The enterprise programme's schedule
 *     is "agreed for the group" and its hours are not a published fact.
 *   * A response-time promise. One business day to acknowledge is a proposal
 *     "subject to capacity agreement" and the operating guide forbids it in
 *     public copy as a guarantee.
 */
import PracticeLayout from '../../layouts/PracticeLayout.astro';
import {
  COHORT_SIZE,
  COHORT_SIZE_CELL,
  COMMITMENT,
  COMMITMENT_CELL,
  FEES_NOTE,
} from '../../data/offer-display';
import { EXPLORES } from '../../data/cohort-copy';

const title = 'Programmes — The Living Craft';
const description =
  'Three routes into the same practical work on agentic system design: the open cohort for an individual, an employer-funded place, and an enterprise programme for a team.';
---

<PracticeLayout title={title} description={description} canonical="/programmes/">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Programmes</p>
      <h1>Three routes into <em>the same work</em></h1>
      <p class="credential">
        An individual applies to the open cohort. An employer can fund that same
        individual place. A team is a separate enterprise programme with its own
        schedule and its own scoping conversation. What you do is the same in every
        case: build a working agentic system and practise explaining the decisions
        behind it.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/">Explore the open cohort&nbsp;<span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href="/programmes/enterprise/">Learning for a team</a>
      </div>
      <p class="hero-note">{COMMITMENT} {COHORT_SIZE}</p>
    </div>
  </section>

  {/* ── the three routes ─────────────────────────────────────────────────── */}
  <section class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Which route fits</p>
      <h2>Choose by <em>who decides</em> and who pays</h2>
    </div>
    <div class="cards3">
      <a class="card" href="/">
        <span class="k">Route one</span>
        <h3>The open cohort</h3>
        <p>
          You are an experienced engineer, architect or engineering leader joining as
          an individual, alongside people from other organisations. Admission is by
          application, after a conversation about fit.
        </p>
        <span class="go">Read the cohort page <span class="arrow" aria-hidden="true">→</span></span>
      </a>
      <a class="card" href="/#apply">
        <span class="k">Route two</span>
        <h3>An employer-funded place</h3>
        <p>
          The same cohort place, paid for by your organisation. Apply as an individual
          and ask for the employer-funding summary; the application asks whether you
          are self-funded or exploring employer support.
        </p>
        <span class="go">Apply and name the funding route <span class="arrow" aria-hidden="true">→</span></span>
      </a>
      <a class="card" href="/programmes/enterprise/">
        <span class="k">Route three</span>
        <h3>A programme for your team</h3>
        <p>
          A group from one organisation, with a schedule agreed for the group. This is
          a separate purchase and a separate scoping conversation — never counted as a
          set of individual applications.
        </p>
        <span class="go">Enterprise learning <span class="arrow" aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  {/* ── what is the same ─────────────────────────────────────────────────── */}
  <section class="wrap">
    <div class="sec-head">
      <p class="eyebrow">The work itself</p>
      <h2>The same five areas, <em>whichever route</em></h2>
    </div>
    <div class="prose intro">
      <p>
        The route decides who you sit with, who pays and how the schedule is agreed. It
        does not change the subject. Every route works through the same five areas
        against a system you have actually built.
      </p>
    </div>
    <ol class="tlist">
      {
        EXPLORES.map((item, i) => (
          <li>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="aside">
      The <a class="textlink" href="/resources/">published guides</a> work through
      several of these in full, if you would rather read the method before deciding.
    </p>
  </section>

  {/* ── how the routes differ ────────────────────────────────────────────── */}
  <section class="wrap">
    <div class="sec-head">
      <p class="eyebrow">How they differ</p>
      <h2>The parts that are <em>not the same</em></h2>
    </div>

    <div class="cards3 compare">
      <div class="panel">
        <h3>Open cohort</h3>
        <div class="detail-row"><span class="dk">Who is in the room</span><span class="dv">Individuals from different organisations</span></div>
        <div class="detail-row"><span class="dk">Live hours</span><span class="dv">{COMMITMENT_CELL}</span></div>
        <div class="detail-row"><span class="dk">Group size</span><span class="dv">{COHORT_SIZE_CELL}</span></div>
        <div class="detail-row"><span class="dk">Admission</span><span class="dv">By application, after a fit conversation</span></div>
        <div class="detail-row"><span class="dk">Next step</span><span class="dv"><a class="textlink" href="/">The cohort page</a></span></div>
      </div>

      <div class="panel">
        <h3>Employer-funded place</h3>
        <div class="detail-row"><span class="dk">Who is in the room</span><span class="dv">The same open cohort</span></div>
        <div class="detail-row"><span class="dk">Live hours</span><span class="dv">{COMMITMENT_CELL}</span></div>
        <div class="detail-row"><span class="dk">What is different</span><span class="dv">A funding summary your organisation can act on</span></div>
        <div class="detail-row"><span class="dk">Admission</span><span class="dv">Your application, on its own merits</span></div>
        <div class="detail-row"><span class="dk">Next step</span><span class="dv"><a class="textlink" href="/#apply">Apply and say “employer support”</a></span></div>
      </div>

      <div class="panel">
        <h3>Enterprise programme</h3>
        <div class="detail-row"><span class="dk">Who is in the room</span><span class="dv">One organisation’s group</span></div>
        <div class="detail-row"><span class="dk">Live hours</span><span class="dv">Schedule agreed for the group</span></div>
        <div class="detail-row"><span class="dk">Group size</span><span class="dv">Normally 8–10 participants</span></div>
        <div class="detail-row"><span class="dk">Admission</span><span class="dv">A scoping conversation, not an application</span></div>
        <div class="detail-row"><span class="dk">Next step</span><span class="dv"><a class="textlink" href="/programmes/enterprise/">Enterprise learning</a></span></div>
      </div>
    </div>
  </section>

  {/* ── evidence, and the limits of it ───────────────────────────────────── */}
  <section class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Before you choose</p>
      <h2>What is settled, and <em>what is not</em></h2>
    </div>
    <div class="prose stack">
      <p>
        <strong>Applying is not a purchase.</strong> It starts a discussion. Admission,
        payment and attendance confirmation are three separate steps, and each one
        involves a different person saying yes.
      </p>
      <p>
        <strong>Industry-specific practice is the default.</strong> You do not need a
        company project, and confidential company material should not be sent with an
        application or an enquiry. Company-specific work needs its own conversation
        about scope and permission.
      </p>
      <p><strong>There is no certificate.</strong> The focus is the capability you develop through the work.</p>
      <p>{FEES_NOTE}</p>
    </div>

    <aside class="pending">
      <h3>Facts this page is waiting on</h3>
      <ul>
        <li>
          The enterprise programme’s hours, delivery format and commercial terms.
          <span class="who">Sunil for scope, finance for terms</span>
        </li>
      </ul>
    </aside>
  </section>

  {/* ── next step ────────────────────────────────────────────────────────── */}
  <section class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Next step</p>
      <h2>Start where <em>your decision is</em></h2>
    </div>
    <div class="cards2">
      <a class="card" href="/">
        <span class="k">For yourself</span>
        <h3>The open cohort</h3>
        <p>
          The full page: who it is for, the returns example, the five areas, the
          commitment, and the application and enquiry forms.
        </p>
        <span class="go">Read it <span class="arrow" aria-hidden="true">→</span></span>
      </a>
      <a class="card" href="/programmes/enterprise/">
        <span class="k">For a team</span>
        <h3>Enterprise learning</h3>
        <p>
          Readiness, what a group works on together, how coordination is handled and
          how a scoping conversation begins.
        </p>
        <span class="go">Read it <span class="arrow" aria-hidden="true">→</span></span>
      </a>
    </div>
    <p class="aside">
      Advising a team through a live design decision is a different thing again —
      see <a class="textlink" href="/advisory/">advisory</a>, or
      <a class="textlink" href="/contact/">contact</a> for which route goes where.
    </p>
    <p class="revised">
      Written <time datetime="2026-09-11">11 September 2026</time>. Pending Sunil’s
      factual approval.
    </p>
  </section>
</PracticeLayout>

<style>
  .intro {
    margin-bottom: var(--space-6);
  }

  .aside {
    max-width: var(--measure-prose);
    margin-top: var(--space-5);
    font-size: var(--size-3);
    color: var(--text-quiet);
    line-height: var(--lh-normal);
  }

  /* The comparison. Three white cards rather than a table: a five-row table at
     390px is a horizontal scroller, and these rows stack honestly. */
  .compare .panel {
    display: flex;
    flex-direction: column;
  }
  .compare h3 {
    font-size: var(--size-5);
    font-weight: var(--weight-strong);
    color: var(--text-loud);
    margin-bottom: var(--space-3);
  }
  .compare .detail-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .compare .dv {
    max-width: 24ch;
  }

  .pending {
    margin-top: var(--space-6);
  }

  .revised {
    margin-top: var(--space-7);
    font-family: var(--font-mono);
    font-size: var(--size-1);
    color: var(--text-quiet);
  }

  /* Below the three-column breakpoint the label/value pair has room again, so
     the rows keep their two-column shape until the phone breakpoint proper. */
  @media (max-width: 560px) {
    .compare .detail-row {
      flex-direction: column;
      gap: var(--space-1);
    }
    .compare .dv {
      text-align: left;
      max-width: none;
    }
  }
</style>
