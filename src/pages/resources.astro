---
// /resources — the working material the practice publishes.
//
// Static: the list is a committed data module, so the page is baked at build and
// changes when src/data/resources.ts does. Nothing here reads an offer fact —
// price, seats and dates stay in facts.ts and are not restated on this surface.
import ResourcesLayout from '../layouts/ResourcesLayout.astro';
import { SITE_ORIGIN } from '../data/facts';
import {
  publishedResources,
  resourceSeries,
  newestResourceDate,
  longDate,
  isDownload,
  SERIES_BLURBS,
} from '../data/resources';

export const prerender = true;

const series = resourceSeries();
const sections = series.map((s) => ({
  id: s.name.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
  title: s.name,
}));
const updated = longDate(newestResourceDate());
const count = publishedResources.length;

const title = 'Resources — tools for designing agentic systems · The Living Craft';
const description = `Free working material from the practice: scored checklists, decision matrices and templates for designing agentic systems that reach production. ${count === 1 ? 'One resource' : `${count} resources`}, last updated ${updated}.`;

// CollectionPage + ItemList of CreativeWork. These are things we authored, so
// unlike /latest the author claim is legitimate here.
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE_ORIGIN}/resources#page`,
    name: 'Resources — agentic system design',
    description,
    url: `${SITE_ORIGIN}/resources`,
    isPartOf: { '@id': `${SITE_ORIGIN}/#person` },
    author: { '@id': `${SITE_ORIGIN}/#person` },
    dateModified: newestResourceDate(),
    about: ['Agentic AI architecture', 'AI proof of concept evaluation', 'LLM reliability'],
    mainEntity: {
      '@type': 'ItemList',
      itemListOrder: 'https://schema.org/ItemListUnordered',
      numberOfItems: count,
      itemListElement: publishedResources.map((r, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'CreativeWork',
          '@id': `${SITE_ORIGIN}/resources#${r.id}`,
          name: r.title,
          description: r.summary,
          url: r.url,
          datePublished: r.publishedAt,
          author: { '@id': `${SITE_ORIGIN}/#person` },
          isAccessibleForFree: true,
          learningResourceType: r.kind,
        },
      })),
    },
  },
];
---

<ResourcesLayout title={title} description={description} canonical="/resources" schema={schema} sections={sections}>
  <!-- Hero -->
  <section class="hero" id="top" style="border-top:0">
    <div class="wrap">
      <div class="eyebrow">Resources <span class="num">/ {series.length === 1 ? sections[0].title.toLowerCase() : `${series.length} series`}</span></div>
      <h1>The tools, not the <em>talk</em>.</h1>
      <p class="lead">
        Working material from the practice, free to use and free to pass on. Each one exists for a
        decision somebody actually has to make, and each one is specific enough to be wrong — which
        is the only kind worth publishing.
      </p>
      <p class="hero-note mono">
        {count === 1 ? '1 resource' : `${count} resources`} · last updated {updated}
      </p>
    </div>
  </section>

  <!-- How to use these -->
  <section id="how">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><span class="num">00</span> How to use these</span>
        <h2>Built to be used in a room, not read alone.</h2>
      </div>
      <div class="prose">
        <p>
          Every resource here scores or decides something. That means it is most useful with the
          two or three people who disagree about the answer, and least useful as a download you
          skim. Where a resource asks several people to score the same thing, have everyone commit
          privately before anyone speaks. The disagreements are the finding.
        </p>
        <p>
          Nothing here needs an account, a licence or an email address. Take them into your own
          documents, change the thresholds to suit your risk, and keep them.
        </p>
      </div>
    </div>
  </section>

  <!-- The resources, by series -->
  {series.map((group, gi) => (
    <section id={sections[gi].id}>
      <div class="wrap">
        <div class="sec-head">
          <span class="eyebrow"><span class="num">{String(gi + 1).padStart(2, '0')}</span> {group.name}</span>
          <h2>{SERIES_BLURBS[group.name] ?? group.name}</h2>
        </div>

        {group.items.map((r) => (
          <article class="resource" id={r.id}>
            <div class="resource-head">
              <span class="eyebrow"><span class="num">{r.number}</span> {r.kind}</span>
              <h3>{r.title}</h3>
              <p class="resource-summary">{r.summary}</p>
            </div>

            <div class="resource-body">
              <p>{r.description}</p>

              <h4 class="resource-sub">What you can do with it</h4>
              <ul class="tlist">
                {r.useFor.map((u) => <li>{u}</li>)}
              </ul>

              <div class="resource-foot">
                <a
                  class="btn btn-primary"
                  href={r.url}
                  {...(isDownload(r.url) ? { download: '' } : {})}
                  {...(r.url.startsWith('/') ? {} : { target: '_blank', rel: 'noopener' })}
                >
                  {isDownload(r.url) ? 'Download' : 'Open'} {r.title}
                  {r.fileSize && <span class="fsize">&nbsp;· {r.fileSize}</span>}
                  &nbsp;<span class="arrow">→</span>
                </a>
                <span class="mono faint">{r.format}</span>
              </div>
              <p class="mono faint resource-date">Published {longDate(r.publishedAt)}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}

  <!-- Close -->
  <section class="final">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><span class="num">→</span> Where these come from</span>
        <h2>These are offcuts from the <em>teaching</em>.</h2>
      </div>
      <div class="prose">
        <p>
          Each of these started as something a room needed. They are published because a checklist
          nobody outside the room can read is a checklist that only ever gets used eight times a
          year. The cohort is where they get argued about with someone who has carried the outcome,
          which is the part a template cannot do on its own.
        </p>
      </div>
      <p class="hero-cta">
        <a class="btn btn-primary" href="/">See the cohort&nbsp;<span class="arrow">→</span></a>
        <a class="btn btn-ghost" href="/latest">Field notes&nbsp;<span class="arrow">→</span></a>
      </p>
    </div>
  </section>
</ResourcesLayout>

<style>
  /* Page-specific. The design system owns hero/sec-head/card/tlist/btn; this is
     the one piece only this page has — a long-form resource entry. It follows
     .card rather than inventing: white panel, shadow, no border. The system's
     rule is a panel gets a shadow or a border, never both. */
  /* global.css resets every margin and has no .prose p rule, so sibling
     paragraphs collide. Scoped here rather than fixed in global.css, because
     that file is shared with three live pages and this is not that change.
     /caio has the same defect today. */
  .prose p + p {
    margin-top: var(--space-4);
  }

  .resource {
    margin-top: var(--space-6);
    padding: var(--space-6);
    background: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-raise);
  }
  .resource:first-of-type {
    margin-top: 0;
  }
  .resource-head h3 {
    font-size: clamp(var(--size-6), 3.2vw, var(--size-8));
    margin: var(--space-3) 0 0;
  }
  .resource-summary {
    margin: var(--space-3) 0 0;
    font-size: var(--size-4);
    color: var(--ink-soft);
    max-width: 58ch;
  }
  .resource-body {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    /* A hairline inside an already-raised panel is legal; a border on it is not. */
    border-top: 1px solid var(--line);
  }
  .resource-body > p {
    max-width: 66ch;
  }
  .resource-sub {
    margin: var(--space-5) 0 var(--space-3);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--size-1);
    color: var(--ink-soft);
    font-weight: var(--weight-medium);
  }
  .resource-foot {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
  .resource-foot .mono {
    font-size: var(--size-1);
    max-width: 44ch;
    line-height: 1.5;
  }
  .fsize { opacity: 0.7; font-weight: var(--weight-normal); }
  .resource-date {
    margin-top: var(--space-4);
    font-size: var(--size-1);
  }
  @media (max-width: 640px) {
    .resource { padding: var(--space-5); }
  }
</style>
