    #record, #tests { break-before: page; }
    .sub { break-after: avoid; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>

<script>
  // The only script on the page. There is no PDF file to download: the browser
  // makes one from the print stylesheet above, which is why the button says
  // what it opens. Nothing is stored, and nothing is posted.
  document.getElementById('pdf')?.addEventListener('click', () => window.print());
</script>
