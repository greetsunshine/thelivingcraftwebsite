  .cstep { color: var(--text-loud); font-weight: var(--weight-strong); }
  .cwhy { color: var(--text-quiet); font-size: var(--size-2); margin-top: var(--space-2); }

  /* ── 10 the protocol ──────────────────────────────────────────────────── */
  ol.protocol { list-style: none; display: flex; flex-direction: column; gap: var(--space-3); max-width: 860px; }
  ol.protocol li {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: var(--space-4);
    align-items: baseline;
    background: var(--surface-panel);
    border-radius: var(--radius-inner);
    box-shadow: var(--shadow-raise);
