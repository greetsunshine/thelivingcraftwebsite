  }
  ul.annot li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-ink-strong);
    margin-top: 9px;
  }

  /* ── 07 the checklist ─────────────────────────────────────────────────── */
  ol.check { list-style: none; display: flex; flex-direction: column; gap: var(--space-3); max-width: 860px; }
  ol.check li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: var(--space-4);
    align-items: start;
    background: var(--surface-panel);
