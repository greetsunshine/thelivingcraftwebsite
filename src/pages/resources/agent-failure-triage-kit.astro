  .nextrow { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }

  /* ── print ────────────────────────────────────────────────────────────── */
  @media print {
    .controls, .nextrow { display: none !important; }
    .cls, ol.tree li, ol.check li, ol.protocol li, ol.beats {
      box-shadow: none;
