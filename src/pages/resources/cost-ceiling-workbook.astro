    max-width: var(--measure-prose);
    padding-left: var(--space-5);
    position: relative;
  }
  ul.notes li::before, ul.caveats li::before {
    content: '';
    position: absolute;
    left: 0;
    top: .6em;
    width: 8px;
    height: 1px;
    background: var(--accent-ink);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── responsive: two columns collapse to a toggled one ──────────────── */
  @media (max-width: 900px) {
    .calc { padding: var(--space-5); }
    .cols { gap: var(--space-5); }
    dl.tabs > div { grid-template-columns: 1fr; gap: var(--space-1); }
  }

  @media (max-width: 720px) {
    .cols { grid-template-columns: 1fr; }
    .scen-toggle { display: flex; }
    /* Only the chosen scenario is on screen. Both stay in the DOM, so both
       still feed the calculation and the comparison below stays true. */
    .cols[data-show='normal'] .col[data-col='storm'],
    .cols[data-show='storm'] .col[data-col='normal'] { display: none; }
    .cols.single { grid-template-columns: 1fr; }
    .f input[type='number'], .f select { max-width: none; }
    .res dd { min-width: 0; }
    ol.answers li, ol.tests li { grid-template-columns: 28px 1fr; gap: var(--space-3); }
  }

  @media (max-width: 420px) {
    .calc { padding: var(--space-4); border-radius: var(--radius-inner); }
    .headline { padding: var(--space-4); }
  }

  /* ── print ──────────────────────────────────────────────────────────── */
  @media print {
    .calc-bar, .scen-toggle, .hero-cta, .final .btn { display: none !important; }
    .calc, .opt, .headline { box-shadow: none; border: 1px solid var(--border-hair); break-inside: avoid; }
    .scroll { overflow: visible !important; }
    table.reg, table.prices { min-width: 0 !important; font-size: 9px; }
    .cols { grid-template-columns: repeat(2, 1fr) !important; }
    .cols .col { display: block !important; }
    thead { display: table-header-group; }
    tr, .step, ol.tests li, ol.protocol li { break-inside: avoid; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>

<script>
  /**
   * The calculator.
   *
   * Everything numeric comes from src/lib/costCeiling.ts. This file reads the
   * DOM into that module's input shape, asks it for an answer, and writes the
   * formatted strings back. It contains no arithmetic of its own, deliberately:
   * a second copy of a formula here is how the page and the workbook end up
   * disagreeing about what an attempt costs.
   *
   * It is a MODULE script, not `is:inline`. Astro bundles it through Vite, so
   * the import works and `astro check` type-checks it. An inline script cannot
   * import, which is the trap pair.astro fell into.
   */
  import {
    PRICE_CARD,
    computeWorkbook,
    exampleValues,
    outputs,
    type WorkbookInputs,
  } from '../../lib/costCeiling';

  const root = document.getElementById('calc');

  if (root) {
    /** The only state. A closure — no localStorage, no sessionStorage, nothing posted. */
    let state: WorkbookInputs = exampleValues();

    const live = document.getElementById('calcLive');

    /** Formatted once on the server and handed over, so the two renders agree. */
    const CHECKED = root.dataset.checked ?? '';
    const inputs = Array.from(
      root.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-scope][data-key]'),
    );

    // ── reading the DOM ───────────────────────────────────────────────────

    /** Where a control's value belongs on the state object. */
    const bagFor = (scope: string, group: string): Record<string, unknown> | null => {
      const s = state as unknown as Record<string, any>;
      if (group === 'attempt' || group === 'period') return s[scope]?.[group] ?? null;
      if (group === 'custom') {
        const attempt = s[scope]?.attempt;
        if (!attempt) return null;
        attempt.customPrices = attempt.customPrices ?? {};
        return attempt.customPrices;
      }
      return s[group] ?? null;
    };

    const read = (el: HTMLInputElement | HTMLSelectElement): void => {
      const { scope, group, key, kind } = el.dataset;
      if (!scope || !group || !key) return;
      const bag = bagFor(scope, group);
      if (!bag) return;

      if (el instanceof HTMLInputElement && el.type === 'checkbox') {
        bag[key] = el.checked;
        return;
      }

      const raw = el.value;

      if (kind === 'text') {
        bag[key] = raw;
        return;
      }

      // An empty custom price is a BLANK, not a zero. Deleting the key lets
      // pricesFor() apply the same fallback a blank on the price card gets.
      if (group === 'custom' && raw.trim() === '') {
        delete bag[key];
        return;
      }

      const n = Number(raw);
      // A half-typed "-" or "1e" is not a number yet. Keep the last good value
      // rather than flashing every figure to zero while somebody types.
      if (!Number.isFinite(n)) return;

      // Percent fields are shown as percentages and stored as fractions. This
      // is the one place that conversion happens.
      bag[key] = kind === 'percent' ? n / 100 : n;
    };

    const readAll = (): void => inputs.forEach(read);

    // ── writing the answers back ──────────────────────────────────────────

    const cells = Array.from(root.querySelectorAll<HTMLElement>('[data-out]'));

    const render = (): void => {
      const result = computeWorkbook(state);
      const o = outputs(result);

      for (const cell of cells) {
        const key = cell.dataset.out;
        if (!key) continue;
        // Every [data-out] element holds the figure and nothing else — no
        // surrounding spaces, no punctuation — so this is a plain replacement.
        cell.textContent = o[key] ?? '—';
      }

      // Mark the cheapest option. An attribute, not a class, so the styling and
      // the meaning stay in one place.
      for (const opt of root.querySelectorAll<HTMLElement>('[data-opt]')) {
        if (opt.dataset.opt === result.stopping.lowest) opt.setAttribute('data-lowest', '');
        else opt.removeAttribute('data-lowest');
      }

      // The price source line beside each model select.
      for (const note of root.querySelectorAll<HTMLElement>('[data-price-note]')) {
        const scope = note.dataset.priceNote;
        if (!scope) continue;
        const id = (state as unknown as Record<string, any>)[scope]?.attempt?.model;
        const model = PRICE_CARD.find((m) => m.id === id);
        note.textContent = model?.source
          ? `${model.source} · checked ${CHECKED}`
          : 'Your own rate. Nothing was checked for you.';
      }

      // Custom price inputs appear only when the Custom row is chosen.
      for (const box of root.querySelectorAll<HTMLElement>('[data-custom]')) {
        const scope = box.dataset.custom;
        if (!scope) continue;
        const id = (state as unknown as Record<string, any>)[scope]?.attempt?.model;
        box.hidden = id !== 'custom';
      }

      announce(o);
    };

    // ── announcing, without spamming ──────────────────────────────────────

    let announceTimer = 0;

    /**
     * One short sentence, 900ms after the last keystroke.
     *
     * The result cells are not inside a live region on purpose. Forty figures
     * announced on every keystroke is not accessibility; it is the reason
     * people switch a screen reader off on a page like this.
     */
    const announce = (o: Record<string, string>): void => {
      if (!live) return;
      window.clearTimeout(announceTimer);
      announceTimer = window.setTimeout(() => {
        live.textContent =
          `Storm night: cost per attempt ${o['storm.costPerAttempt']}, ` +
          `agent cost per case ${o['storm.costPerCase']}, ` +
          `fully loaded cost per accepted result ${o['storm.costPerAccepted']}. ` +
          `Lowest-cost option when the ceiling trips: ${o['stopping.lowest']}.`;
      }, 900);
    };

    // ── analytics: three events, none of them carrying an input value ─────

    let interacted = false;
    const track = (type: string, meta?: Record<string, unknown>): void => {
      const fn = (window as unknown as { lcTrack?: (t: string, m?: unknown) => void }).lcTrack;
      if (typeof fn === 'function') fn(type, meta ?? null);
    };

    // ── wiring ───────────────────────────────────────────────────────────

    const onChange = (): void => {
      if (!interacted) {
        interacted = true;
        track('calculator_interaction', { resource: 'cost-ceiling-workbook' });
      }
      readAll();
      render();
    };

    for (const el of inputs) {
      el.addEventListener('input', onChange);
      el.addEventListener('change', onChange);
    }

    document.getElementById('reset')?.addEventListener('click', () => {
      state = exampleValues();
      for (const el of inputs) {
        const { scope, group, key, kind } = el.dataset;
        // `continue`, not `return`. An early return here would abandon the
        // reset part-way through and leave half the fields on their old values.
        if (!scope || !group || !key) continue;

        if (group === 'custom') {
          (el as HTMLInputElement).value = '';
          continue;
        }

        const bag = bagFor(scope, group);
        const value = bag?.[key];
        if (value === undefined) continue;

        if (el instanceof HTMLInputElement && el.type === 'checkbox') {
          el.checked = Boolean(value);
        } else if (kind === 'percent') {
          el.value = String(Math.round(Number(value) * 1000) / 10);
        } else {
          el.value = String(value);
        }
      }
      render();
      live && (live.textContent = 'Reset to the example values.');
    });

    // ── the mobile scenario toggle ───────────────────────────────────────

    for (const group of root.querySelectorAll<HTMLElement>('.scen-toggle')) {
      const cols = group.parentElement?.querySelector<HTMLElement>('.cols');
      group.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-scen]');
        if (!btn || !cols) return;
        cols.dataset.show = btn.dataset.scen ?? 'normal';
        for (const b of group.querySelectorAll('button')) {
          b.setAttribute('aria-pressed', String(b === btn));
        }
      });
    }

    // ── the step nav, upgraded from links to tabs ────────────────────────
    //
    // Without this script the four steps are all visible and the nav is four
    // in-page links. With it, one step shows at a time. The upgrade happens
    // here rather than in the markup so the no-script page is the readable one.

    const nav = document.getElementById('stepsNav');
    const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));

    if (nav && steps.length) {
      const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-step-link]'));
      const tabs: HTMLButtonElement[] = [];

      nav.setAttribute('role', 'tablist');

      links.forEach((link, i) => {
        const tab = document.createElement('button');
        tab.type = 'button';
        tab.textContent = link.textContent;
        tab.id = `tab-${link.dataset.stepLink}`;
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-controls', `step-${link.dataset.stepLink}`);
        tab.dataset.stepLink = link.dataset.stepLink ?? '';
        tab.setAttribute('aria-selected', String(i === 0));
        tab.tabIndex = i === 0 ? 0 : -1;
        link.replaceWith(tab);
        tabs.push(tab);
      });

      steps.forEach((step, i) => {
        step.setAttribute('role', 'tabpanel');
        step.setAttribute('aria-labelledby', `tab-${step.dataset.step}`);
        step.tabIndex = 0;
        step.hidden = i !== 0;
      });

      const select = (index: number, focus = true): void => {
        tabs.forEach((t, i) => {
          t.setAttribute('aria-selected', String(i === index));
          t.tabIndex = i === index ? 0 : -1;
        });
        steps.forEach((s, i) => {
          s.hidden = i !== index;
        });
        if (focus) tabs[index]?.focus();
      };

      nav.addEventListener('click', (e) => {
        const tab = (e.target as HTMLElement).closest<HTMLButtonElement>('[role="tab"]');
        if (tab) select(tabs.indexOf(tab), false);
      });

      nav.addEventListener('keydown', (e) => {
        const current = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
        if (current < 0) return;
        if (e.key === 'ArrowRight') select((current + 1) % tabs.length);
        else if (e.key === 'ArrowLeft') select((current - 1 + tabs.length) % tabs.length);
        else if (e.key === 'Home') select(0);
        else if (e.key === 'End') select(tabs.length - 1);
        else return;
        e.preventDefault();
      });

      // "Try the calculator" and any other in-page link to a step must open it.
      for (const link of document.querySelectorAll<HTMLAnchorElement>('a[href^="#step-"]')) {
        link.addEventListener('click', () => {
          const id = link.getAttribute('href')?.slice(1);
          const index = steps.findIndex((s) => s.id === id);
          if (index >= 0) select(index, false);
        });
      }
    }

    render();
  }

  // ── the two events that are not about the calculator ───────────────────
  //
  // Delegated at the document, so both download buttons and the apply link are
  // covered without instrumenting each one.

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target?.closest) return;

    const fn = (window as unknown as { lcTrack?: (t: string, m?: unknown) => void }).lcTrack;
    if (typeof fn !== 'function') return;

    if (target.closest('[data-download]')) {
      fn('resource_download', { resource: 'cost-ceiling-workbook' });
    } else if (target.closest('[data-apply]')) {
      fn('cohort_apply_click', { resource: 'cost-ceiling-workbook' });
    }
  });
</script>
