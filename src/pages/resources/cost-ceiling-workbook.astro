  }
  ol.tests li:last-child { border-bottom: 0; }
  .tn { font-family: var(--font-mono); color: var(--accent-ink-strong); }
  .tbody { display: flex; flex-direction: column; gap: 2px; max-width: 86ch; }
  .tbody strong { color: var(--text-body); }
  .tbody span { font-size: var(--size-2); color: var(--text-quiet); }

  /* ── tabs and legend ────────────────────────────────────────────────── */
  dl.tabs { display: flex; flex-direction: column; }
  dl.tabs > div {
    display: grid;
    grid-template-columns: 140px 1fr;
