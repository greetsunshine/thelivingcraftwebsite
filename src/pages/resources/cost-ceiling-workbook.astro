    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-hair);
    vertical-align: top;
    font-size: var(--size-2);
    color: var(--text-quiet);
    text-align: left;
  }
  .grid tbody th { color: var(--text-body); font-weight: var(--weight-medium); white-space: nowrap; }
  .grid tbody tr:last-child td, .grid tbody tr:last-child th { border-bottom: 0; }
  .quiet { color: var(--text-quiet); }

  /* ── register ───────────────────────────────────────────────────────── */
  table.reg { min-width: 1400px; }
  table.reg td, table.reg th { vertical-align: top; }
  table.prices { min-width: 900px; }
  table.prices td { font-variant-numeric: tabular-nums; }

  ul.blanks { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: var(--space-2); }
  ul.blanks li {
    font-size: var(--size-2);
    color: var(--text-quiet);
    padding: var(--space-3) var(--space-4);
    background: var(--surface-sunken);
    border-radius: var(--radius-inner);
  }

  ol.tests { list-style: none; display: flex; flex-direction: column; }
  ol.tests li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-4) 0;
