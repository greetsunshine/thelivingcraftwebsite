  }
  dl.tabs > div:last-child { border-bottom: 0; }
  dl.tabs dt { font-weight: var(--weight-strong); color: var(--text-body); }
  dl.tabs dd { font-size: var(--size-2); color: var(--text-quiet); max-width: 82ch; }

  ul.legend { list-style: none; display: flex; flex-direction: column; gap: var(--space-3); }
  ul.legend li { display: flex; align-items: baseline; gap: var(--space-3); font-size: var(--size-2); color: var(--text-quiet); }
  .sw { width: 14px; height: 14px; border-radius: 3px; flex: none; border: 1px solid var(--border-field); }
  .sw-input { background: #2f5fd0; }
  .sw-assumption { background: #ffe08a; }
  .sw-linked { background: #2f8a4f; }
  .sw-formula { background: var(--ink-1); }

  ul.notes, ul.caveats { list-style: none; display: flex; flex-direction: column; gap: var(--space-3); }
  ul.notes li, ul.caveats li {
    font-size: var(--size-2);
