---
/**
 * /resources/gate-routing-map — the Gate Routing Map.
 *
 * A workbook for engineers who run agentic systems through automated release
 * gates. It answers one question: which of my agent's gate results should
 * block, go to a human, or wait on a downstream system? A gate that only says
 * pass or fail treats every result the same, and agent results are not all
 * the same kind of thing.
 *
 * The tool is the Excel workbook. This page describes it and hands it over.
 * Every word the page and the workbook share comes from
 * src/data/gate-routing-map.ts; every figure in the worked example is computed
 * by src/lib/gateRouting.ts, so the page cannot print a number the workbook
 * would not produce (tools/gate-routing-map/verify_xlsx.py).
 *
 * THE DOWNLOAD IS GATED, although the brief said "no email gate". CLAUDE.md,
 * "The download gate" (decided 19 September 2026), puts every file a resource
 * page hands out behind ResourceGate, and the file lives in downloads/, which
 * is not a public URL. Sunil confirmed the gate for the Rework Cost Check and
 * the Citation Fit Check when their briefs said the same.
 *
 * Released 11 October 2026. The row in src/data/resources.ts is what lists it
 * on /resources, the sitemap and /llms.txt, and what lets the gate hand the
 * file over: resolveResource() only knows tools that have a row there. Not
 * featured, so there is no row in resource-choices.ts.
 */
import ResourcesLayout from '../../layouts/ResourcesLayout.astro';
import ClosingCta from '../../components/site/ClosingCta.astro';
import CohortIntroLink from '../../components/site/CohortIntroLink.astro';
import ResourceCredit from '../../components/ResourceCredit.astro';
import ResourceGate from '../../components/ResourceGate.astro';
import { SITE_ORIGIN } from '../../data/facts';
import { longDate } from '../../data/resources';
import {
  CHECKS,
  DECISION_MEANING,
  READY_AT,
  MAX_TOTAL,
  checklistResult,
  finalRoute,
  inventorySummary,
  requirementsSummary,
  routeReadiness,
} from '../../lib/gateRouting';
import {
  RESOURCE_ID,
  TITLE,
  TAGLINE,
  BRING,
  DO,
  LEAVE,
  WHY,
  KINDS,
  ROUTE_TABLE,
  TABS,
  EXAMPLE_LABEL,
  EXAMPLE_CASES,
  EXAMPLE_REQUIREMENTS,
  EXAMPLE_ANSWERS,
  EXAMPLE_MIN_TRIALS,
  CLOSING,
  LICENCE_LINE,
  PUBLISHED_AT,
  DOWNLOAD_KIND,
} from '../../data/gate-routing-map';

const canonical = `/resources/${RESOURCE_ID}`;
const url = `${SITE_ORIGIN}${canonical}`;

// The promises the page makes in words. A wrong count fails the first render.
const critical = CHECKS.filter((c) => c.critical);
if (CHECKS.length !== 10) throw new Error(`gate routing map: ${CHECKS.length} checks, promised 10`);
if (critical.length !== 4) throw new Error(`gate routing map: ${critical.length} critical checks, promised 4`);
if (TABS.length !== 3) throw new Error(`gate routing map: ${TABS.length} tabs, promised 3`);

// The worked example, read through the same module the tests and the workbook verifier use.
const exInv = inventorySummary(EXAMPLE_CASES);
const exReq = requirementsSummary(EXAMPLE_CASES, EXAMPLE_REQUIREMENTS, EXAMPLE_MIN_TRIALS);
const exResult = checklistResult(EXAMPLE_ANSWERS);
const exRows = EXAMPLE_CASES.map((c, i) => ({
  name: c.name,
  route: finalRoute(c),
  ...routeReadiness(finalRoute(c), c.deterministic, EXAMPLE_REQUIREMENTS[i], EXAMPLE_MIN_TRIALS),
}));
const unverified = exRows.find((r) => r.route === 'Check downstream' && r.ready === false);
const notReadyRows = exRows.filter((r) => r.ready === false);
const listJoin = (xs: (string | number)[]) =>
  xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`;

const title = `${TITLE} — which gate results should block, go to a human, or wait downstream? · The Living Craft`;
// Under 155 characters.
const description =
  'A workbook for agent release gates: give every gate case a route, check each route has what it needs, and decide if the gate is ready to decide releases.';

const schema = [
  {
    '@type': 'HowTo',
    '@id': `${url}#howto`,
    name: TITLE,
    description,
    url,
    author: { '@id': `${SITE_ORIGIN}/#person` },
    ...(PUBLISHED_AT ? { datePublished: PUBLISHED_AT } : {}),
    isAccessibleForFree: true,
    license: 'https://creativecommons.org/licenses/by/4.0/',
    step: TABS.map((t, i) => ({ '@type': 'HowToStep', position: i + 1, name: t.name, text: t.ask })),
  },
];

const sections = [
  { id: 'why', title: 'Why' },
  { id: 'routes', title: 'The four routes' },
  { id: 'tabs', title: 'The three tabs' },
  { id: 'checks', title: '10 checks' },
  { id: 'example', title: 'Worked example' },
];

const routeClass = (r: string) => `route route-${r.toLowerCase().replace(/\s+/g, '-')}`;
---

<ResourcesLayout title={title} description={description} canonical={canonical} schema={schema} sections={sections} howTo="opening">
  <!-- Hero: title, tagline, author, then what to bring, do and leave with, then the action. -->
  <section class="hero" id="top" style="border-top:0">
    <div class="wrap">
      <div class="eyebrow">
        <a href="/resources" class="crumb">Resources</a>
        <span class="num">/ agentic system design</span>
      </div>
      <h1>{TITLE}</h1>
      <p class="lead">{TAGLINE}</p>
      <ResourceCredit />

      <dl class="opening" id="opening">
        <div class="open-row">
          <dt class="mono">What to bring</dt>
          <dd>{BRING}</dd>
        </div>
        <div class="open-row">
          <dt class="mono">What to do</dt>
          <dd>{DO}</dd>
        </div>
        <div class="open-row">
          <dt class="mono">What you leave with</dt>
          <dd>{LEAVE}</dd>
        </div>
      </dl>

      <p class="hero-cta controls">
        <button class="btn btn-primary" type="button" data-gate={DOWNLOAD_KIND} data-download={DOWNLOAD_KIND}>
          Download the Gate Routing Map&nbsp;<span class="arrow" aria-hidden="true">→</span>
        </button>
      </p>
      <p class="hero-note mono">Excel workbook · also opens in Google Sheets and LibreOffice · free</p>
      <CohortIntroLink />
    </div>
  </section>

  <!-- Why this exists -->
  <section id="why">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Why this exists</span>
        <h2>Pass or fail treats every result the same. <em>Agent results are not the same kind of thing.</em></h2>
      </div>
      <div class="prose">
        <p>{WHY}</p>
        <p>A gate that only says pass or fail treats every result the same way. But among an agent’s results:</p>
        <ul class="kinds">
          {KINDS.map((k) => <li>{k}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- The four routes, then the three questions -->
  <section id="routes">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">The four routes</span>
        <h2>Every gate case gets one, <em>and each route needs something before the release</em>.</h2>
      </div>
      <div class="scroll" tabindex="0" role="region" aria-label="The four routes">
        <table class="grid routes">
          <thead>
            <tr>
              <th>Route</th>
              <th>Use it when</th>
              <th>What the route needs before the release</th>
            </tr>
          </thead>
          <tbody>
            {ROUTE_TABLE.map((r) => (
              <tr>
                <td class="cname"><span class={routeClass(r.route)}>{r.route}</span></td>
                <td data-label="Use it when">{r.when}</td>
                <td data-label="What the route needs before the release">{r.needs}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="sub">The three questions</h3>
      <div class="scroll" tabindex="0" role="region" aria-label="The three questions, one per tab">
        <table class="grid questions">
          <thead>
            <tr>
              <th>#</th>
              <th>Question</th>
              <th>Tab</th>
            </tr>
          </thead>
          <tbody>
            {TABS.map((t, i) => (
              <tr>
                <td class="tn mono">{i + 1}</td>
                <td class="cname">{t.ask}</td>
                <td class="mono tabname">{t.sheet}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 01 to 03, one per tab: what it asks, and the one mistake it catches -->
  <section id="tabs">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">The three tabs</span>
        <h2>One question each, <em>and the mistake it catches</em>.</h2>
      </div>
      <div class="threegrid">
        {TABS.map((t) => (
          <div class="three" id={`tab-${t.n}`}>
            <span class="threename mono">{t.n} · {t.name}</span>
            <p class="threeask">{t.ask}</p>
            <p class="qflag"><span class="flaglbl mono">The mistake it catches</span> {t.catches}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The ten checks -->
  <section id="checks">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">The {CHECKS.length} checks</span>
        <h2>Four are critical. <em>One No on any of them is a Hold.</em></h2>
      </div>
      <p class="prose-lead">
        Each check is answered Yes, Partial or No, and scores 2, 1 or 0. A No on any check marked critical
        means Hold. Otherwise {READY_AT} or more out of {MAX_TOTAL}, with every critical check answered Yes, is
        Ready. Anything less is Fix first.
      </p>
      <ol class="qs">
        {CHECKS.map((c) => (
          <li>
            <span class="qn mono">{String(c.n).padStart(2, '0')}</span>
            <div>
              <p class="qask">
                {c.critical && <span class="tag">Critical</span>}
                {c.text}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- The worked example -->
  <section id="example">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Worked example · Illustrative</span>
        <h2>An order-support agent, <em>held</em>.</h2>
      </div>
      <p class="prose-lead">{EXAMPLE_LABEL} It is filled in on the workbook’s last tab.</p>
      <div class="threegrid">
        <div class="three">
          <span class="threename mono">Gate cases</span>
          <p class="threeask">{exInv.listed}</p>
          <p class="threebody">
            {exInv.byRoute.Block} Block, {exInv.byRoute['Human decides']} Human decides, {exInv.byRoute['Check downstream']} Check downstream and {exInv.byRoute.Track} Track.
            {exInv.overrides === 1 ? 'One case was' : `${exInv.overrides} cases were`} moved off the suggested route, with a written reason.
          </p>
        </div>
        <div class="three">
          <span class="threename mono">Routes not ready</span>
          <p class="threeask">{exReq.notReady}</p>
          <p class="threebody">
            {unverified && <>One is “{unverified.name}”. The payments service never verified the contract before deploying.</>}
          </p>
          <ul class="whylist">
            {notReadyRows.filter((r) => r !== unverified).map((r) => <li>{r.name}: {r.why.toLowerCase()}.</li>)}
          </ul>
        </div>
        <div class="three">
          <span class="threename mono">Decision</span>
          <p class="threeask">{exResult.decision}</p>
          <p class="threebody">
            {DECISION_MEANING[exResult.decision ?? 'Hold']} Critical checks {listJoin(exResult.criticalNo)} were answered No. Total {exResult.total} of {MAX_TOTAL}.
          </p>
        </div>
      </div>
      <p class="prose-note">
        The first thing to fix is check {exResult.nextCheck?.n}. {exResult.nextStep}
      </p>
    </div>
  </section>

  <!-- Closing -->
  <section class="final" id="close">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Closing</span>
        <h2>{CLOSING}</h2>
      </div>
      <ClosingCta result>
        <button slot="download" class="btn btn-ghost" type="button" data-gate={DOWNLOAD_KIND} data-download={DOWNLOAD_KIND}>Download the Gate Routing Map&nbsp;<span class="arrow" aria-hidden="true">↓</span></button>
      </ClosingCta>
      <p class="mono faint pubdate">
        Published {PUBLISHED_AT ? longDate(PUBLISHED_AT) : '[PLACEHOLDER: publish date, Sunil to confirm]'} · {LICENCE_LINE} · © The Living Craft
      </p>
    </div>
  </section>
  <ResourceGate
    resource={RESOURCE_ID}
    lead="The workbook holds the three working tabs, blank, and a worked example of an order-support agent on its own tab."
  />
</ResourcesLayout>

<style>
  /* The same rules the Agent Memory Audit Kit and the Citation Fit Check pages
     carry under the same names. The one addition is the route label, which
     uses the theme's quiet fills and their inks. */
  .crumb { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .prose { max-width: var(--measure-prose); }
  .prose p + p { margin-top: var(--space-4); }
  .prose-lead { color: var(--text-quiet); max-width: var(--measure-prose); margin-bottom: var(--space-5); }
  .prose-note { font-size: var(--size-2); color: var(--text-quiet); max-width: var(--measure-prose); margin-top: var(--space-4); }
  .pubdate { margin-top: var(--space-5); font-size: var(--size-1); }
  .hero .controls { margin-top: var(--space-6); }
  .kinds { margin-top: var(--space-3); padding-left: var(--space-5); display: grid; gap: var(--space-2); }

  .sub {
    margin: var(--space-7) 0 var(--space-3);
    font-size: var(--size-6);
    font-weight: var(--weight-heavy);
    color: var(--text-loud);
  }

  /* ── the opening (rework-cost-check.astro) ────────────────────────────── */
  .opening { display: grid; gap: var(--space-4); max-width: var(--measure-prose); margin-top: var(--space-6); }
  .open-row { display: grid; gap: var(--space-1); }
  @media (min-width: 720px) {
    .opening { max-width: none; }
    .open-row { grid-template-columns: 180px 1fr; gap: var(--space-5); align-items: start; }
  }
  .open-row dt { font-size: var(--size-1); color: var(--accent-ink); font-weight: var(--weight-strong); padding-top: 3px; }
  .open-row dd { color: var(--text-body); max-width: var(--measure-prose); }

  /* ── cards (agent-memory-audit-kit.astro, "the three questions") ──────── */
  .threegrid { display: grid; gap: var(--space-4); }
  @media (min-width: 860px) { .threegrid { grid-template-columns: repeat(3, 1fr); } }
  .three {
    background: var(--surface-panel);
    border-radius: var(--radius-inner);
    box-shadow: var(--shadow-raise);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .threename { font-size: var(--size-1); color: var(--accent-ink-strong); font-weight: var(--weight-medium); }
  .threeask { font-family: var(--font-heading); font-size: var(--size-6); font-weight: var(--weight-heavy); color: var(--text-loud); }
  .threebody { color: var(--text-quiet); font-size: var(--size-2); margin-top: var(--space-2); }

  /* ── tables (agent-memory-audit-kit.astro) ────────────────────────────── */
  .scroll { overflow-x: auto; border-radius: var(--radius-inner); }
  .scroll:focus-visible { outline: var(--focus-w) solid var(--focus-ring); outline-offset: var(--focus-offset); }
  table.grid { border-collapse: collapse; width: 100%; background: var(--surface-panel); }
  .grid thead th {
    background: var(--texture-forest);
    color: var(--text-on-invert);
    text-align: left;
    font-family: var(--font-mono);
    font-size: var(--size-1);
    font-weight: var(--weight-medium);
    padding: var(--space-3) var(--space-4);
    vertical-align: bottom;
  }
  .grid tbody td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-hair);
    vertical-align: top;
    font-size: var(--size-2);
    color: var(--text-quiet);
  }
  .grid tbody tr:last-child td { border-bottom: 0; }
  .cname { color: var(--text-body); font-weight: var(--weight-medium); min-width: 150px; }
  .tn { color: var(--text-quiet); }
  .tabname { white-space: nowrap; }
  .tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent-ink-strong);
    background: var(--accent-quiet);
    border-radius: var(--radius-pill);
    padding: 1px var(--space-2);
    margin-right: var(--space-2);
    vertical-align: 1px;
  }

  /* A route label: the same quiet fill and ink as the workbook's route cells,
     and always the route's word, so the colour is never the only signal. */
  .route {
    display: inline-block;
    font-weight: var(--weight-strong);
    border-radius: var(--radius-pill);
    padding: 2px var(--space-3);
    white-space: nowrap;
  }
  .route-block { background: var(--danger-quiet); color: var(--danger); }
  .route-human-decides { background: var(--accent-quiet); color: var(--accent-ink); }
  .route-check-downstream { background: var(--info-quiet); color: var(--info); }
  /* On a phone the routes table becomes one block per route. Three columns at
     375px squeezed the third to a word a line. */
  @media (max-width: 719px) {
    .routes thead { display: none; }
    .routes tr { display: block; padding: var(--space-4); border-bottom: 1px solid var(--border-hair); }
    .routes tr:last-child { border-bottom: 0; }
    .grid.routes tbody td { display: block; border: 0; padding: var(--space-2) 0 0; }
    .routes td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-size: var(--size-1);
      color: var(--accent-ink);
      font-weight: var(--weight-strong);
    }
  }
  .whylist { color: var(--text-quiet); font-size: var(--size-2); padding-left: var(--space-5); display: grid; gap: var(--space-1); }
  .route-track { background: var(--surface-hover); color: var(--text-quiet); }

  /* ── the checks (agent-memory-audit-kit.astro, "the twelve questions") ── */
  ol.qs { list-style: none; display: flex; flex-direction: column; gap: var(--space-3); max-width: 860px; }
  ol.qs li {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: var(--space-4);
    align-items: start;
    background: var(--surface-panel);
    border-radius: var(--radius-inner);
    box-shadow: var(--shadow-raise);
    padding: var(--space-4) var(--space-5);
  }
  .qn { color: var(--text-quiet); font-size: var(--size-1); padding-top: 3px; }
  .qask { color: var(--text-loud); font-weight: var(--weight-strong); }
  .qflag { color: var(--text-quiet); font-size: var(--size-2); margin-top: var(--space-2); }
  .flaglbl { color: var(--danger); font-size: 12px; margin-right: var(--space-2); }
</style>

<script>
  // The beacon only, the same as the memory kit. A download is counted when
  // the gate hands the file over, not when its button is clicked: the click
  // only opens the dialog. If the beacon is absent nothing happens.
  const RESOURCE = 'gate-routing-map';

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    const fn = (window as unknown as { lcTrack?: (t: string, m?: unknown) => void }).lcTrack;
    if (!target?.closest || typeof fn !== 'function') return;
    if (target.closest('[data-apply]')) fn('cohort_apply_click', { resource: RESOURCE });
  });

  document.addEventListener('lc:download', (e) => {
    const fn = (window as unknown as { lcTrack?: (t: string, m?: unknown) => void }).lcTrack;
    if (typeof fn !== 'function') return;
    const d = (e as CustomEvent<{ kind: string }>).detail;
    fn('resource_download', { resource: RESOURCE, file: d.kind });
  });
</script>
