  }
  /* Marked, not ranked: the two rows a quality review will not raise. */
  .keyrow .q { color: var(--accent-ink-strong); }
  .why {
    margin: var(--space-2) 0 var(--space-4);
    font-size: var(--size-2);
    color: var(--text-quiet);
    max-width: 64ch;
  }
  .wchip {
    font-size: var(--size-1);
    color: var(--text-body);
    background: var(--surface-panel);
    border-radius: var(--radius-pill);
    padding: 4px 12px;
    white-space: nowrap;
    margin-top: 2px;
  }
  .wchip.unset { color: var(--text-quiet); }
  .wown {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--size-1);
    color: var(--text-quiet);
    white-space: nowrap;
  }
  .wown select {
