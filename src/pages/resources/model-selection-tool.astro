---
// /resources/model-selection-tool — The Model Selection Tool.
//
// This REPLACED /resources/model-selection-checklist (a page to tick and
// print), which had replaced /resources/contract-agent-test-kit. Both old
// addresses redirect here from astro.config.mjs. Do not re-add a link to
// either: the redirects are the only things that should still know them.
//
// Built against /resources/poc-screen as the reference. Where the two differ
// in layout, interaction, wording style, PDF or checks, the POC tool wins.
//
// THE TOOL IS SIX STEPS: Start, the four sections A to D, and the result. One
// step is on screen at a time, with a progress bar that fills as rows are
// answered. The steps are only hidden by the script: without JavaScript, and in
// print, every step is on the page in order, so a crawler and a printer see the
// whole tool. Step state is a number in the closure, like the answers.
//
// Answers are a closure and die with the tab. No localStorage, no
// sessionStorage. The one thing that leaves the browser is the PDF request:
// name, email and the assessment go to /api/pipeline/resource-pdf, which
// records the person (the V4 addendum's "optional email request"), checks and
// builds the PDF from the same data module this page renders from, and hands
// it back with the list of checks it passed. The answers are used for the file
// and not stored; the dialog says so.
//
// Every string here comes from src/data/model-selection-tool.ts. The page's
// script imports that module too (Vite bundles it), so the live score bar, the
// result summary and the PDF all read one rubric: `readAssessment()`.
import ResourcesLayout from '../../layouts/ResourcesLayout.astro';
import ResourceCredit from '../../components/ResourceCredit.astro';
import ResourceGate from '../../components/ResourceGate.astro';
import { SITE_ORIGIN } from '../../data/facts';
import { publishedResources, longDate } from '../../data/resources';
import {
  TOOL_NAME,
  PURPOSE,
  HOW_TO_USE,
  HOW_TO_RUN,
  PROFILES,
  STEP_QUESTION,
  STEP_WHY,
  GATES,
  GATES_CLOSER,
  CRITERIA,
  WEIGHTS_NOTE,
  KEY_ROWS_NOTE,
  OWN_WEIGHT_ROWS,
  OWN_WEIGHT_DEFAULT,
  OWN_WEIGHT_MAX,
  DISQUALIFIERS,
  DISQUALIFIERS_CLOSER,
  CASE_SHAPES,
  CASES_CLOSER,
  DOMAINS,
  METHOD,
  METHOD_CLOSER,
  RECORD,
  RETEST_TRIGGERS,
  RECORD_CLOSER,
  AFTERNOON,
  AFTERNOON_CLOSER,
  CUT_LINES,
  EXAMPLES,
  EXAMPLES_NOTE,
  GATE_COUNT,
  ANSWER_COUNT,
} from '../../data/model-selection-tool';

const meta = publishedResources.find((r) => r.id === 'model-selection-tool')!;

const title = `${TOOL_NAME} — is this model fit for this step? · The Living Craft`;
const description =
  'A scored tool for choosing a model for one step of an agentic system. Choose the step, answer ten deployment gates from the model card, score twelve behaviours from your own test runs, and check four disqualifiers. The score and the outcome update as you answer. Two reference candidates to load, and a decision record to write when you choose.';

const schema = [
  {
    '@type': 'HowTo',
    '@id': `${SITE_ORIGIN}/resources/model-selection-tool#howto`,
    name: TOOL_NAME,
    description,
    url: `${SITE_ORIGIN}/resources/model-selection-tool`,
    author: { '@id': `${SITE_ORIGIN}/#person` },
    datePublished: meta.publishedAt,
    isAccessibleForFree: true,
    totalTime: 'PT4H5M',
    step: AFTERNOON.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.body,
      text: `${s.body} (${s.minutes})`,
    })),
  },
];

const pad = (n: number) => String(n).padStart(2, '0');

// The four sections, as the steps between Start and Result. The script and
// the progress bar both read the step order from the DOM, so the markup is
// the one place it is written.
const sections = [
  { letter: 'A', name: 'The step', question: 'What job is this model being staffed on?' },
  { letter: 'B', name: 'Deployment gates', question: 'Can this model be deployed where you need it, on the terms you need?' },
  { letter: 'C', name: 'Behaviour under test', question: 'What did ten runs on your own four cases show?' },
  { letter: 'D', name: 'Disqualifiers', question: 'Did it do the one thing that ends a candidate?' },
];
const steps = [
  { key: 'start', dot: '0', name: 'Start' },
  ...sections.map((s) => ({ key: s.letter.toLowerCase(), dot: s.letter, name: s.name })),
  { key: 'result', dot: '✓', name: 'Result' },
];
const STEP_COUNT = steps.length;

---

<ResourcesLayout title={title} description={description} canonical="/resources/model-selection-tool" schema={schema}>
  <!-- Hero -->
  <section class="hero" id="top" style="border-top:0">
    <div class="wrap">
      <div class="eyebrow">
        <a href="/resources" class="crumb">Resources</a>
        <span class="num">/ {meta.series.toLowerCase()} {meta.number}</span>
      </div>
      <h1>{TOOL_NAME}</h1>
      <p class="lead">
        Find out whether one candidate model is fit for <em>one step</em> of your system. Ten
        gates from the model card, twelve behaviours from your own test runs, four
        disqualifiers, in four short steps. Each answer says what earns it, so two people
        scoring the same ten runs land on the same number.
      </p>
      <p class="hero-note mono">
        {ANSWER_COUNT} answers · {sections.length} sections · two hard gates · one afternoon
      </p>
      <ResourceCredit />
    </div>
  </section>

  {/* The tool, inside one framed shell. Everything the score bar has to stay
      above lives inside this element: a sticky element only sticks within its
      parent. The frame is the tool's edge, so the page's section rhythm stops
      at it and the steps use `.inner` for their gutters, not `.wrap`. */}
  <section class="tool-section">
  <div class="wrap">
  <div class="tool" id="tool" data-step="0">
    <div class="scorebar-wrap">
      <div class="inner">
        <div class="scorebar" id="verdict" data-b="none" role="status" aria-live="polite">
          <div class="sb-score">
            <span id="pct">—</span><span class="of">%</span>
          </div>
          <div class="sb-text">
            <span class="band" id="band">Not started</span>
            <span class="sb-note" id="note">{ANSWER_COUNT} answers to give. Choose the step first.</span>
          </div>
          <div class="sb-secs mono" aria-label="Score by section">
            <span class="sb-sec" title="The step">A <b id="sb-a">—</b></span>
            <span class="sb-sec" title="Deployment gates">B <b id="sb-b">0</b>/{GATE_COUNT} pass</span>
            <span class="sb-sec" title="Behaviour under test">C <b id="sb-c">—</b>/<span id="sb-cmax">—</span></span>
            <span class="sb-sec" title="Disqualifiers">D <b id="sb-d">0</b> hit</span>
          </div>
        </div>

        {/* The progress bar. The fill is answers given out of twenty-seven; the
            pips are the six steps, and each one is a button that jumps there. */}
        <div class="progress" aria-label="Progress">
          <div class="p-track" role="progressbar" aria-valuemin="0" aria-valuemax={ANSWER_COUNT} aria-valuenow="0" id="p-track">
            <div class="p-fill" id="p-fill" style="width:0%"></div>
          </div>
          <div class="p-row">
            <ol class="p-steps" id="p-steps">
              {steps.map((s, i) => (
                <li>
                  <button type="button" class="p-step" data-go={i} aria-current={i === 0 ? 'step' : undefined}>
                    <span class="p-dot mono">{s.dot}</span>
                    <span class="p-label">{s.name}</span>
                  </button>
                </li>
              ))}
            </ol>
            <span class="p-text mono" id="p-text">Step 1 of {STEP_COUNT} · 0 of {ANSWER_COUNT} answered</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Step 0: start -->
    <section class="step" id="step-start" data-index="0">
      <div class="inner">
        <div class="stepnav top">
          <span class="stepnote mono">Six steps. About fifteen minutes once the runs are done.</span>
          <button class="btn btn-primary" type="button" data-go="1">Start scoring&nbsp;<span class="arrow">→</span></button>
        </div>
        <div class="about">
          <div class="about-col">
            <span class="eyebrow"><span class="num">01</span> What this tool is for</span>
            <ul class="plain">
              {PURPOSE.map((p) => <li>{p}</li>)}
            </ul>
          </div>
          <div class="about-col">
            <span class="eyebrow"><span class="num">02</span> How to use it</span>
            <ol class="steps">
              {HOW_TO_USE.map((p) => <li>{p}</li>)}
            </ol>
          </div>
        </div>

        <div class="rules">
          <div class="sec-head">
            <span class="eyebrow"><span class="num">03</span> Rules for scoring</span>
            <h2 class="step-title" tabindex="-1">Five rules. Break one and the score <em>stops meaning much</em>.</h2>
          </div>
          <ol class="howto">
            {HOW_TO_RUN.map((h) => (
              <li>
                <strong>{h.lead}</strong> {h.rest}
              </li>
            ))}
          </ol>
        </div>

        <p class="examples-note">{EXAMPLES_NOTE}</p>
        <div class="stepnav">
          <button class="btn btn-primary" type="button" data-go="1">Start scoring&nbsp;<span class="arrow">→</span></button>
          {EXAMPLES.map((ex) => (
            <button class="btn btn-ghost load-example" data-example={ex.id} type="button">Load reference candidate {ex.id.toUpperCase()}</button>
          ))}
        </div>
      </div>
    </section>

    <!-- Step 1: A · the step -->
    <section id="step-a" class="step qsection" data-index="1">
      <div class="inner">
        <div class="stepnav top">
          <button class="btn btn-ghost" type="button" data-go="0">← Back</button>
          <span class="stepnote mono">Step 2 of {STEP_COUNT}</span>
          <button class="btn btn-primary" type="button" data-go="2">Next&nbsp;<span class="arrow">→</span></button>
        </div>
        <div class="shead">
          <span class="sletter">A</span>
          <div class="stitle">
            <h2 class="sname step-title" tabindex="-1">{sections[0].name}</h2>
            <p class="squestion">{sections[0].question}</p>
          </div>
          <span class="ssub mono" aria-label="Section A answer"><b id="secsub-a">Not chosen</b></span>
        </div>
        <p class="sblurb">One answer. It sets every weight in section C, so it comes first.</p>

        <div class="item" id="row-profile" data-k="profile" data-i="0">
          <span class="qn mono">A1</span>
          <div class="qbody">
            <p class="q">{STEP_QUESTION}</p>
            <p class="why">{STEP_WHY}</p>
            <div class="anchors" role="group" aria-label="The step">
              {PROFILES.map((p, v) => (
                <button type="button" class="anchor" id={`profile${v}`} data-k="profile" data-i="0" data-v={v} aria-pressed="false">
                  <span class="av mono">{p.name}</span>
                  <span class="at">{p.cost}</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <div class="stepnav">
          <button class="btn btn-ghost" type="button" data-go="0">← Back</button>
          <span class="stepnote mono" id="stepnote-A">0 of 1 answered in this step</span>
          <button class="btn btn-primary" type="button" data-go="2">Next&nbsp;<span class="arrow">→</span></button>
        </div>
      </div>
    </section>

    <!-- Step 2: B · deployment gates -->
    <section id="step-b" class="step qsection" data-index="2">
      <div class="inner">
        <div class="stepnav top">
          <button class="btn btn-ghost" type="button" data-go="1">← Back</button>
          <span class="stepnote mono">Step 3 of {STEP_COUNT}</span>
          <button class="btn btn-primary" type="button" data-go="3">Next&nbsp;<span class="arrow">→</span></button>
        </div>
        <div class="shead">
          <span class="sletter">B</span>
          <div class="stitle">
            <h2 class="sname step-title" tabindex="-1">{sections[1].name}</h2>
            <p class="squestion">{sections[1].question}</p>
          </div>
          <span class="sgate">Hard gate</span>
          <span class="ssub mono" aria-label="Section B passes"><b id="secsub-b">0</b>/{GATE_COUNT} pass</span>
        </div>
        <p class="sblurb">
          Ten answers from the model card and the contract, before you run anything. Any fail here ends
          the candidate whatever it scores elsewhere.
        </p>

        {GATES.map((g, i) => (
          <div class="item gate" id={`row-gate-${i}`} data-k="gate" data-i={i}>
            <span class="qn mono">B{i + 1}</span>
            <div class="qbody">
              <p class="q">{g.q}</p>
              <p class="why">{g.cost}</p>
              <div class="anchors two" role="group" aria-label={`Gate ${i + 1}: ${g.short}`}>
                <button type="button" class="anchor" id={`gate${i}v1`} data-k="gate" data-i={i} data-v="1" aria-pressed="false">
                  <span class="av mono">Passes</span>
                  <span class="at">{g.passes}</span>
                </button>
                <button type="button" class="anchor fail" id={`gate${i}v0`} data-k="gate" data-i={i} data-v="0" aria-pressed="false">
                  <span class="av mono">Fails</span>
                  <span class="at">Not confirmed, or confirmed and it does not meet the line above.</span>
                </button>
              </div>
            </div>
          </div>
        ))}
        <p class="callout">{GATES_CLOSER}</p>

        <div class="stepnav">
          <button class="btn btn-ghost" type="button" data-go="1">← Back</button>
          <span class="stepnote mono" id="stepnote-B">0 of {GATE_COUNT} answered in this step</span>
          <button class="btn btn-primary" type="button" data-go="3">Next&nbsp;<span class="arrow">→</span></button>
        </div>
      </div>
    </section>

    <!-- Step 3: C · behaviour under test -->
    <section id="step-c" class="step qsection" data-index="3">
      <div class="inner">
        <div class="stepnav top">
          <button class="btn btn-ghost" type="button" data-go="2">← Back</button>
          <span class="stepnote mono">Step 4 of {STEP_COUNT}</span>
          <button class="btn btn-primary" type="button" data-go="4">Next&nbsp;<span class="arrow">→</span></button>
        </div>
        <div class="shead">
          <span class="sletter">C</span>
          <div class="stitle">
            <h2 class="sname step-title" tabindex="-1">{sections[2].name}</h2>
            <p class="squestion">{sections[2].question}</p>
          </div>
          <span class="ssub mono" aria-label="Section C weighted score"><b id="secsub-c">—</b>/<span id="secsub-cmax">—</span></span>
        </div>
        <p class="sblurb">
          Twelve behaviours, each scored 0, 1 or 2 against a written threshold. The weight beside each row
          comes from the step you chose in A. {KEY_ROWS_NOTE}
        </p>

        {CRITERIA.map((c, i) => {
          const k = OWN_WEIGHT_ROWS.indexOf(i);
          return (
            <div class={`item${c.key ? ' keyrow' : ''}`} id={`row-score-${i}`} data-k="score" data-i={i}>
              <span class="qn mono">C{pad(i + 1)}</span>
              <div class="qbody">
                <div class="qtop">
                  <p class="q">{c.q}</p>
                  {k < 0 ? (
                    <span class="wchip mono" id={`w${i}`}>Weight —</span>
                  ) : (
                    <label class="wown mono">
                      Weight, you set it
                      <select id={`own${k}`} data-k={k}>
                        {Array.from({ length: OWN_WEIGHT_MAX }, (_, n) => n + 1).map((n) => (
                          <option value={n} selected={n === OWN_WEIGHT_DEFAULT}>{n}</option>
                        ))}
                      </select>
                    </label>
                  )}
                </div>
                <p class="why">{c.why}{c.key ? ' A quality review will not raise this row.' : ''}</p>
                <div class="anchors" role="group" aria-label={`Score for row ${i + 1}: ${c.short}`}>
                  {c.a.map((text, v) => (
                    <button type="button" class="anchor" id={`score${i}v${v}`} data-k="score" data-i={i} data-v={v} aria-pressed="false">
                      <span class="av mono">{v}</span>
                      <span class="at">{text}</span>
                    </button>
                  ))}
                </div>
              </div>
            </div>
          );
        })}
        <p class="callout">{WEIGHTS_NOTE}</p>

        <div class="stepnav">
          <button class="btn btn-ghost" type="button" data-go="2">← Back</button>
          <span class="stepnote mono" id="stepnote-C">0 of {CRITERIA.length} answered in this step</span>
          <button class="btn btn-primary" type="button" data-go="4">Next&nbsp;<span class="arrow">→</span></button>
        </div>
      </div>
    </section>

    <!-- Step 4: D · disqualifiers -->
    <section id="step-d" class="step qsection" data-index="4">
      <div class="inner">
        <div class="stepnav top">
          <button class="btn btn-ghost" type="button" data-go="3">← Back</button>
          <span class="stepnote mono">Step 5 of {STEP_COUNT}</span>
          <button class="btn btn-primary" type="button" data-go="5">See the result&nbsp;<span class="arrow">→</span></button>
        </div>
        <div class="shead">
          <span class="sletter">D</span>
          <div class="stitle">
            <h2 class="sname step-title" tabindex="-1">{sections[3].name}</h2>
            <p class="squestion">{sections[3].question}</p>
          </div>
          <span class="sgate">Hard gate</span>
          <span class="ssub mono" aria-label="Section D hits"><b id="secsub-d">0</b> hit</span>
        </div>
        <p class="sblurb">
          Four things. If any one of them happened on any run, the candidate is out, whatever it scored in C.
        </p>

        {DISQUALIFIERS.map((d, i) => (
          <div class="item gate" id={`row-dq-${i}`} data-k="dq" data-i={i}>
            <span class="qn mono">D{i + 1}</span>
            <div class="qbody">
              <p class="q">{d.q}</p>
              <p class="why">{d.why}</p>
              <div class="anchors two" role="group" aria-label={`Disqualifier ${i + 1}: ${d.short}`}>
                <button type="button" class="anchor" id={`dq${i}v0`} data-k="dq" data-i={i} data-v="0" aria-pressed="false">
                  <span class="av mono">Did not happen</span>
                  <span class="at">Not on any of the ten runs, on any of the four cases.</span>
                </button>
                <button type="button" class="anchor fail" id={`dq${i}v1`} data-k="dq" data-i={i} data-v="1" aria-pressed="false">
                  <span class="av mono">Happened</span>
                  <span class="at">At least once. Write down which run and keep the output as evidence.</span>
                </button>
              </div>
            </div>
          </div>
        ))}
        <p class="callout stop">{DISQUALIFIERS_CLOSER}</p>

        <div class="stepnav">
          <button class="btn btn-ghost" type="button" data-go="3">← Back</button>
          <span class="stepnote mono" id="stepnote-D">0 of {DISQUALIFIERS.length} answered in this step</span>
          <button class="btn btn-primary" type="button" data-go="5">See the result&nbsp;<span class="arrow">→</span></button>
        </div>
      </div>
    </section>

    <!-- Step 5: the result -->
    <section class="step" id="step-result" data-index={STEP_COUNT - 1}>
      <div class="inner">
        <div class="stepnav top">
          <button class="btn btn-ghost" type="button" data-go={STEP_COUNT - 2}>← Back</button>
          <span class="stepnote mono">Step {STEP_COUNT} of {STEP_COUNT}</span>
          <button class="btn btn-ghost" type="button" data-go="1">Change an answer</button>
        </div>
        <div class="sec-head">
          <span class="eyebrow"><span class="num">04</span> Your result</span>
          <h2 class="step-title" tabindex="-1">The outcome, read against the <em>rubric</em>.</h2>
        </div>
        <div class="resultcard" id="resultcard" data-b="none">
          <div class="r-head">
            <span class="r-score mono"><b id="r-pct">—</b>%</span>
            <span class="r-band" id="r-band">Not started</span>
          </div>
          <p class="r-example mono" id="r-example" hidden></p>
          <p class="r-what" id="r-what">
            Give all {ANSWER_COUNT} answers to read the outcome. Until then this shows the running score, and a blank row in C counts as 0.
          </p>
          <div class="r-secs" id="r-secs"></div>
          <p class="r-gate" id="r-gate" hidden></p>
          <div class="r-fix" id="r-fix" hidden>
            <h3>Fix first</h3>
            <p class="r-fixlead">Rows scored 0 first, then 1, heaviest weight first. Each names the test case that is the evidence for it. A row scored 1 needs a named cover before it is accepted; a row scored 0 needs a fix or a narrower step.</p>
            <ol id="r-fixlist"></ol>
          </div>
          <div class="r-actions" role="group" aria-label="Assessment controls">
            <button class="btn btn-primary" id="pdf" type="button" data-gate="pdf">Get the PDF</button>
            <button class="btn btn-ghost" id="blank" type="button">New assessment</button>
          </div>
        </div>

        <div class="rubric">
          <div class="sec-head">
            <span class="eyebrow"><span class="num">05</span> The rubric</span>
            <h2>Agree these <em>before</em> you score, not after.</h2>
          </div>
          <p class="prose-lead">
            The two gates are checked first and ignore the score. The percentage is your weighted score over the
            weighted maximum for the step you chose, so it means the same thing whichever job the model has.
            The row that matches your result is highlighted.
          </p>
          {CUT_LINES.map((c) => (
            <div class="cutrow" id={`cut-${c.key}`} data-b={c.key}>
              <div class="cutscore mono">{c.score}</div>
              <div class="cutname">{c.name}</div>
              <div class="cutwhat">{c.what}</div>
            </div>
          ))}
        </div>

        <div class="stepnav">
          <button class="btn btn-ghost" type="button" data-go={STEP_COUNT - 2}>← Back</button>
          <button class="btn btn-ghost" type="button" data-go="1">Change an answer</button>
        </div>
      </div>
    </section>
  </div>
  </div>
  </section>

  <!-- Build the test set -->
  <section id="cases">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><span class="num">06</span> Build the test set</span>
        <h2>Four cases, built out of <em>your own work</em>. They are the evidence for section C.</h2>
      </div>
      <p class="prose-lead">
        Use real inputs with the names removed. A public benchmark cannot tell you how a model behaves on
        the documents your team actually receives. Each card says which rows in C it is the evidence for.
      </p>
      <div class="cases">
        {CASE_SHAPES.map((c) => (
          <div class="case" id={`case-${c.n}`}>
            <div class="chead">
              <span class="cn mono">Case {c.n}</span>
              <h3>{c.name}</h3>
            </div>
            <p class="crow"><span class="clabel mono">How to build it</span> {c.build}</p>
            <p class="crow"><span class="clabel mono">Right answer</span> {c.right}</p>
            <p class={`crow${c.failure ? ' watch' : ''}`}>
              <span class="clabel mono">{c.watchLabel}</span> {c.watch}
            </p>
            <p class="crow reveals mono">Evidence for {c.reveals.map((n) => `C${pad(n)}`).join(' · ')}</p>
          </div>
        ))}
      </div>
      <p class="callout">{CASES_CLOSER}</p>

      <h3 class="sub">The same three cases, in four different jobs</h3>
      <p class="prose-note">
        Illustrations of how to build a case. They describe no real team, product or system. Case 1 is
        not in the table because an ordinary case looks the same in every job.
      </p>
      <div class="scroll">
        <table class="grid domains">
          <thead>
            <tr>
              <th>The job</th>
              <th>Case 2 · missing input</th>
              <th>Case 3 · planted item</th>
              <th>Case 4 · closing deadline</th>
            </tr>
          </thead>
          <tbody>
            {DOMAINS.map((d) => (
              <tr>
                <td class="cname">{d.job}</td>
                <td>{d.missing}</td>
                <td>{d.planted}</td>
                <td>{d.deadline}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Method -->
  <section id="method">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><span class="num">07</span> Score what is missing</span>
        <h2>The step most teams skip, because <em>nothing is on the page</em> to mark wrong.</h2>
      </div>
      <ol class="method">
        {METHOD.map((m) => (
          <li>
            <span class="mn mono">{m.n}</span>
            <span class="mbody">{m.body}</span>
          </li>
        ))}
      </ol>
      <p class="callout">{METHOD_CLOSER}</p>
    </div>
  </section>

  <!-- Decision record -->
  <section id="record">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><span class="num">08</span> The decision record</span>
        <h2>One page. Written when you decide, <em>not afterwards</em>.</h2>
      </div>
      <p class="prose-lead">
        Your result above gives the first half: the step, the score, the rows to fix. Print this section
        to fill in the rest, or copy the headings into your own architecture decision record.
      </p>
      <div class="rec">
        {RECORD.map((g) => (
          <div class="recgroup">
            <h3 class="recheading mono">{g.heading}</h3>
            {g.fields.map((f) => (
              <p class="recfield"><span class="rlabel">{f}</span><span class="rline"></span></p>
            ))}
          </div>
        ))}
      </div>

      <h3 class="sub">Re-test if any of these happen</h3>
      <ul class="retest">
        {RETEST_TRIGGERS.map((t) => <li>{t}</li>)}
      </ul>
      <p class="recfield next"><span class="rlabel">Next re-test due</span><span class="rline"></span></p>
      <p class="callout">{RECORD_CLOSER}</p>
    </div>
  </section>

  <!-- The afternoon -->
  <section id="afternoon">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><span class="num">09</span> Run it in an afternoon</span>
        <h2>Four hours and five minutes, <em>in this order</em>.</h2>
      </div>
      <ol class="protocol">
        {AFTERNOON.map((s) => (
          <li>
            <div class="pmeta"><span class="pn mono">{s.n}</span><span class="pmin mono">{s.minutes}</span></div>
            <div class="pbody"><p>{s.body}</p></div>
          </li>
        ))}
      </ol>
      <p class="callout">{AFTERNOON_CLOSER}</p>
    </div>
  </section>

  <!-- Close -->
  <section class="final">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><span class="num">→</span> What comes next</span>
        <h2>This picks a model. It does not tell you the system <em>holds up</em>.</h2>
      </div>
      <div class="prose">
        <p>
          Everything you scored is a claim about one step on one day. Keeping that claim true needs an
          eval set you run again when the version moves, and a register that catches the work the model
          never mentions. That part takes a room.
        </p>
      </div>
      <p class="hero-cta">
        <a class="btn btn-primary" href="/">See the cohort&nbsp;<span class="arrow">→</span></a>
        <a class="btn btn-ghost" href="/resources">All resources&nbsp;<span class="arrow">→</span></a>
      </p>
      <p class="mono faint pubdate">Published {longDate(meta.publishedAt)} · free to use and to pass on</p>
    </div>
  </section>

  <ResourceGate resource="model-selection-tool" lead="The PDF carries your twenty-seven answers, the weighted score, the outcome and the rows to fix first, and is checked before it is handed over." manual />
</ResourcesLayout>

<style>
  /* global.css resets every margin and has no .prose p rule, so sibling
     paragraphs collide. Scoped, as on the other resource pages. */
  .prose p + p { margin-top: var(--space-4); }

  /* ── the frame ────────────────────────────────────────────────────────── */
  /* One white shell on the mist ground, the app-shell radius and the overlay
     shadow the design system gives a shell. `overflow: clip` rounds the corners
     without making the frame a scroll container, which `hidden` would, and a
     scroll container is what stops the score bar sticking to the viewport. */
  .tool-section { padding-top: var(--space-6); }
  .tool {
    background: var(--surface-panel);
    border-radius: var(--radius-shell);
    box-shadow: var(--shadow-overlay);
    overflow: clip;
  }
  .inner { padding: 0 var(--space-7); }
  /* Page-scale display headings read as a landing page inside a tool. Step
     them down one size inside the shell; the section names stay as they are. */
  .tool .sec-head h2 { font-size: var(--size-7); }
  .tool .sec-head { margin-bottom: var(--space-5); }

  /* ── steps ────────────────────────────────────────────────────────────── */
  /* Without the script every step is visible. With it, only the current one.
     `data-step` on the tool is the cursor; each step carries its index. */
  .tool.js .step { display: none; }
  .tool.js .step.current { display: block; }
  .step { padding: var(--space-5) 0 var(--space-7); }
  /* The heading takes focus from the script after a step change, so a screen
     reader announces where it landed. It has tabindex="-1", so Tab never
     reaches it, and the ring would only ever show to a mouse user, in berry,
     looking like an error. */
  .step-title:focus, .step-title:focus-visible { outline: none; }

  .stepnav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-hair);
  }
  .stepnav .btn-primary { margin-left: auto; }
  .stepnav.top {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-hair);
    margin-bottom: var(--space-5);
  }
  .stepnote { font-size: var(--size-1); color: var(--text-quiet); }
  /* Without the script the steps are all on the page, so the buttons that move
     between them do nothing useful and are hidden. */
  .tool:not(.js) .stepnav [data-go], .tool:not(.js) .p-step, .tool:not(.js) .load-example { display: none; }
  .examples-note {
    margin-top: var(--space-6);
    font-size: var(--size-2);
    color: var(--text-quiet);
    max-width: var(--measure-prose);
  }
  /* The start step's bottom nav carries the two load buttons; the primary
     button keeps its place on the right. */
  #step-start .stepnav:not(.top) .btn-primary { order: 3; }

  /* ── about ────────────────────────────────────────────────────────────── */
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-7);
  }
  .about-col {
    background: var(--surface-sunken);
    border-radius: var(--radius-card);
    padding: var(--space-5) var(--space-6);
  }
  .about-col .eyebrow { display: block; margin-bottom: var(--space-4); }
  ul.plain, ol.steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: 0;
    margin: 0;
    list-style: none;
  }
  ul.plain li {
    position: relative;
    padding-left: var(--space-5);
  }
  ul.plain li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--sun);
  }
  ol.steps { counter-reset: s; }
  ol.steps li {
    counter-increment: s;
    position: relative;
    padding-left: var(--space-6);
  }
  ol.steps li::before {
    content: counter(s);
    position: absolute;
    left: 0;
    top: 0.1em;
    font-family: var(--font-mono);
    font-size: var(--size-1);
    font-weight: var(--weight-strong);
    color: var(--text-on-invert);
    background: var(--noir);
    border-radius: var(--radius-pill);
    width: 20px;
    height: 20px;
    display: inline-grid;
    place-items: center;
  }

  /* ── scoring rules ────────────────────────────────────────────────────── */
  ol.howto {
    list-style: none;
    counter-reset: h;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--measure-prose);
    padding: 0;
    margin: 0;
  }
  ol.howto li {
    counter-increment: h;
    position: relative;
    padding-left: var(--space-7);
  }
  ol.howto li::before {
    content: counter(h);
    position: absolute;
    left: 0;
    top: 1px;
    font-family: var(--font-mono);
    font-size: var(--size-1);
    color: var(--text-quiet);
  }
  ol.howto strong { font-weight: var(--weight-strong); }

  /* ── the score bar ────────────────────────────────────────────────────── */
  /* The frame's header. Sticky under the nav; flat, with a hairline under it,
     because it sits inside the shell rather than floating over the page. Its
     parent is `.tool`, which wraps every step, so it holds through the whole
     tool and releases before the test cases. */
  .scorebar-wrap {
    position: sticky;
    /* The nav is 76px on a desktop and wraps taller on a phone. The script
       measures it and sets --nav-h; the fallback is the desktop height. */
    top: var(--nav-h, 76px);
    z-index: var(--z-sticky);
    background: var(--surface-panel);
    border-bottom: 1px solid var(--border-hair);
  }
  .scorebar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    padding: var(--space-4) 0 var(--space-3);
  }
  .sb-score {
    font-family: var(--font-mono);
    font-size: var(--size-7);
    font-weight: var(--weight-strong);
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .sb-score .of {
    font-size: var(--size-3);
    color: var(--text-quiet);
  }
  .sb-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .band {
    font-size: var(--size-4);
    font-weight: var(--weight-heavy);
    letter-spacing: var(--tracking-display);
    line-height: var(--lh-snug);
  }
  .sb-note {
    font-size: var(--size-1);
    color: var(--text-quiet);
  }
  .sb-secs {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: var(--size-1);
    color: var(--text-quiet);
  }
  .sb-sec {
    background: var(--surface-sunken);
    border-radius: var(--radius-pill);
    padding: 3px 10px;
    white-space: nowrap;
  }
  .sb-sec b { color: var(--text-body); font-weight: var(--weight-strong); }
  /* Bands read through colour on the word, not a yellow chip — sun is reserved
     for things you can click, so it cannot carry a status. */
  [data-b='stop'] .band, [data-b='gate'] .band, [data-b='dq'] .band,
  [data-b='stop'] .r-band, [data-b='gate'] .r-band, [data-b='dq'] .r-band { color: var(--danger); }
  [data-b='cover'] .band, [data-b='cover'] .r-band { color: var(--accent-ink); }
  [data-b='fit'] .band, [data-b='fit'] .r-band { color: var(--text-loud); }
  [data-b='none'] .band, [data-b='none'] .r-band { color: var(--text-quiet); }

  /* ── the progress bar ─────────────────────────────────────────────────── */
  /* Joined to the score bar as one panel. The fill is sun, and it is the one
     yellow thing here that is not a control, so it stays a thin line. */
  .progress { padding: 0 0 var(--space-3); }
  .p-track {
    height: 4px;
    background: var(--surface-sunken);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }
  .p-fill {
    height: 100%;
    background: var(--sun);
    border-radius: var(--radius-pill);
    transition: width var(--motion-base, 160ms) ease;
  }
  .p-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-3);
  }
  .p-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .p-step {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: transparent;
    border: 0;
    border-radius: var(--radius-pill);
    padding: 3px 10px 3px 4px;
    cursor: pointer;
    font: inherit;
    font-size: var(--size-1);
    color: var(--text-quiet);
  }
  .p-step:hover { background: var(--surface-hover); color: var(--text-body); }
  .p-step:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .p-dot {
    width: 20px;
    height: 20px;
    border-radius: var(--radius-pill);
    background: var(--surface-sunken);
    display: inline-grid;
    place-items: center;
    font-size: 11px;
    font-weight: var(--weight-strong);
    color: var(--text-quiet);
  }
  .p-step[aria-current='step'] { color: var(--text-loud); }
  .p-step[aria-current='step'] .p-dot { background: var(--noir); color: var(--text-on-invert); }
  .p-step.done .p-dot { background: var(--sun); color: var(--text-on-accent); }
  .p-text { font-size: var(--size-1); color: var(--text-quiet); white-space: nowrap; }

  /* ── question sections ────────────────────────────────────────────────── */
  .shead {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: start;
    gap: var(--space-3) var(--space-4);
    margin-bottom: var(--space-3);
  }
  .sletter {
    font-family: var(--font-mono);
    font-size: var(--size-2);
    font-weight: var(--weight-strong);
    color: var(--text-on-invert);
    background: var(--noir);
    border-radius: var(--radius-pill);
    width: 28px;
    height: 28px;
    display: inline-grid;
    place-items: center;
    margin-top: 4px;
  }
  .stitle { min-width: 0; }
  .sname { font-size: var(--size-6); line-height: var(--lh-tight); }
  .squestion {
    margin: var(--space-1) 0 0;
    font-size: var(--size-3);
    color: var(--text-quiet);
  }
  .sgate {
    font-family: var(--font-mono);
    font-size: var(--size-1);
    color: var(--danger);
    background: var(--danger-quiet);
    border-radius: var(--radius-pill);
    padding: 4px 12px;
    margin-top: 6px;
    white-space: nowrap;
  }
  .ssub {
    font-size: var(--size-2);
    color: var(--text-quiet);
    background: var(--surface-sunken);
    border-radius: var(--radius-pill);
    padding: 4px 12px;
    margin-top: 4px;
    white-space: nowrap;
  }
  .ssub b { color: var(--text-body); font-weight: var(--weight-strong); }
  .sblurb {
    color: var(--text-quiet);
    max-width: var(--measure-prose);
    margin: 0 0 var(--space-5) calc(28px + var(--space-4));
  }

  /* One grid per row: the number in a fixed gutter, everything else in the
     second column, so the question, the reason and the anchors all share one
