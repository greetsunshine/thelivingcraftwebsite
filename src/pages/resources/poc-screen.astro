---
// /resources/poc-screen — The POC Selection Tool, self-hosted.
//
// This was a published Artifact. It now lives here because an Artifact is
// private until it is shared, and a resource on a public page whose link only
// opens for its author is worse than no resource. Self-hosting also makes the
// twelve questions crawlable, which is the point of publishing them at all.
//
// THE TOOL IS SIX STEPS: Start, the four sections A to D, and the result. One
// step is on screen at a time, with a progress bar that fills as questions are
// answered. The steps are only hidden by the script: without JavaScript, and in
// print, every step is on the page in order, so a crawler and a printer see the
// whole tool. Step state is a number in the closure, like the scores.
//
// Scores are a closure and die with the tab. No localStorage, no sessionStorage.
// The one thing that leaves the browser is the PDF request: name, email and
// the twelve scores go to /api/pipeline/resource-pdf, which records the person
// (the V4 addendum's "optional email request"), checks and builds the PDF from
// the same data module this page renders from, and hands it back with the list
// of checks it passed. The scores are used for the file and not stored; the
// dialog says so.
//
// Every string here comes from src/data/poc-screen.ts. The page's script
// imports that module too (Vite bundles it), so the live score bar, the result
// summary, the copied scorecard and the PDF all read one rubric.
import ResourcesLayout from '../../layouts/ResourcesLayout.astro';
import ResourceCredit from '../../components/ResourceCredit.astro';
import { SITE_ORIGIN } from '../../data/facts';
import { publishedResources, longDate } from '../../data/resources';
import {
  TOOL_NAME,
  PURPOSE,
  HOW_TO_USE,
  HOW_TO_RUN,
  SECTIONS,
  MAX_SCORE,
  QUESTION_COUNT,
  CUT_LINES,
  MOVES,
} from '../../data/poc-screen';
import { RESOURCE_FIELDS } from '../../lib/pipeline/resources';

const meta = publishedResources.find((r) => r.id === 'poc-screen')!;

const title = `${TOOL_NAME} — can this agent proof of concept reach production? · The Living Craft`;
const description =
  'A scored checklist for deciding whether an agent proof of concept can reach production, used before you build. Twelve questions in four sections, each with the definition of what earns a 0, a 1 and a 2. One hard gate on failure containment. The score and the outcome update as you answer.';

const schema = [
  {
    '@type': 'HowTo',
    '@id': `${SITE_ORIGIN}/resources/poc-screen#howto`,
    name: TOOL_NAME,
    description,
    url: `${SITE_ORIGIN}/resources/poc-screen`,
    author: { '@id': `${SITE_ORIGIN}/#person` },
    datePublished: meta.publishedAt,
    isAccessibleForFree: true,
    step: SECTIONS.map((s, i) => ({
      '@type': 'HowToSection',
      position: i + 1,
      name: `${s.letter} — ${s.name}`,
      description: s.blurb,
      itemListElement: s.items.map((it, j) => ({
        '@type': 'HowToStep',
        position: j + 1,
        name: it.short,
        text: it.q,
      })),
    })),
  },
];

// Flat index per item, computed here so the markup does not have to count.
let n = 0;
const rows = SECTIONS.map((s) => ({
  ...s,
  max: s.items.length * 2,
  items: s.items.map((it) => ({ ...it, i: n++ })),
}));

// The six steps, in order. The script and the progress bar both read this
// list from the DOM, so the markup is the one place the order is written.
const steps = [
  { key: 'start', dot: '0', name: 'Start' },
  ...SECTIONS.map((s) => ({ key: s.letter.toLowerCase(), dot: s.letter, name: s.name })),
  { key: 'result', dot: '✓', name: 'Result' },
];
const STEP_COUNT = steps.length;

const nameField = RESOURCE_FIELDS.find((f) => f.name === 'name')!;
const emailField = RESOURCE_FIELDS.find((f) => f.name === 'email')!;
---

<ResourcesLayout title={title} description={description} canonical="/resources/poc-screen" schema={schema}>
  <!-- Hero -->
  <section class="hero" id="top" style="border-top:0">
    <div class="wrap">
      <div class="eyebrow">
        <a href="/resources" class="crumb">Resources</a>
        <span class="num">/ {meta.series.toLowerCase()} {meta.number}</span>
      </div>
      <h1>{TOOL_NAME}</h1>
      <p class="lead">
        Score an agent proof of concept <em>before</em> you build it, and find out whether it can
        reach production. Twelve questions in four short steps. Each one says what earns a 0, a 1
        and a 2, so two people scoring the same idea land on the same number.
      </p>
      <p class="hero-note mono">
        {QUESTION_COUNT} questions · {SECTIONS.length} sections · maximum {MAX_SCORE} · one hard gate
      </p>
      <ResourceCredit />
    </div>
  </section>

  {/* The tool, inside one framed shell. Everything the score bar has to stay
      above lives inside this element: a sticky element only sticks within its
      parent. The frame is the tool's edge, so the page's section rhythm stops
      at it and the steps use `.inner` for their gutters, not `.wrap`. */}
  <section class="tool-section">
  <div class="wrap">
  <div class="tool" id="tool" data-step="0">
    <div class="scorebar-wrap">
      <div class="inner">
        <div class="scorebar" id="verdict" data-b="none" role="status" aria-live="polite">
          <div class="sb-score">
            <span id="total">0</span><span class="of">/{MAX_SCORE}</span>
          </div>
          <div class="sb-text">
            <span class="band" id="band">Not started</span>
            <span class="sb-note" id="note">{QUESTION_COUNT} questions to answer. A blank counts as 0.</span>
          </div>
          <div class="sb-secs mono" aria-label="Score by section">
            {rows.map((s) => (
              <span class="sb-sec" data-sec={s.letter} title={s.name}>
                {s.letter} <b id={`sec-${s.letter}`}>0</b>/{s.max}
              </span>
            ))}
          </div>
        </div>

        {/* The progress bar. The fill is answered questions out of twelve; the
            pips are the six steps, and each one is a button that jumps there. */}
        <div class="progress" aria-label="Progress">
          <div class="p-track" role="progressbar" aria-valuemin="0" aria-valuemax={QUESTION_COUNT} aria-valuenow="0" id="p-track">
            <div class="p-fill" id="p-fill" style="width:0%"></div>
          </div>
          <div class="p-row">
            <ol class="p-steps" id="p-steps">
              {steps.map((s, i) => (
                <li>
                  <button type="button" class="p-step" data-go={i} aria-current={i === 0 ? 'step' : undefined}>
                    <span class="p-dot mono">{s.dot}</span>
                    <span class="p-label">{s.name}</span>
                  </button>
                </li>
              ))}
            </ol>
            <span class="p-text mono" id="p-text">Step 1 of {STEP_COUNT} · 0 of {QUESTION_COUNT} answered</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Step 0: start -->
    <section class="step" id="step-start" data-index="0">
      <div class="inner">
        <div class="stepnav top">
          <span class="stepnote mono">Six steps. About ten minutes.</span>
          <button class="btn btn-primary" type="button" data-go="1">Start scoring&nbsp;<span class="arrow">→</span></button>
        </div>
        <div class="about">
          <div class="about-col">
            <span class="eyebrow"><span class="num">01</span> What this tool is for</span>
            <ul class="plain">
              {PURPOSE.map((p) => <li>{p}</li>)}
            </ul>
          </div>
          <div class="about-col">
            <span class="eyebrow"><span class="num">02</span> How to use it</span>
            <ol class="steps">
              {HOW_TO_USE.map((p) => <li>{p}</li>)}
            </ol>
          </div>
        </div>

        <div class="rules">
          <div class="sec-head">
            <span class="eyebrow"><span class="num">03</span> Rules for scoring in a room</span>
            <h2 class="step-title" tabindex="-1">Five rules that decide whether this is useful or <em>theatre</em>.</h2>
          </div>
          <ol class="howto">
            {HOW_TO_RUN.map((h) => (
              <li>
                <strong>{h.lead}</strong> {h.rest}
              </li>
            ))}
          </ol>
        </div>

        <div class="stepnav">
          <button class="btn btn-primary" type="button" data-go="1">Start scoring&nbsp;<span class="arrow">→</span></button>
          <button class="btn btn-ghost" id="example" type="button">Load the worked example</button>
        </div>
      </div>
    </section>

    <!-- Steps 1 to 4: the twelve -->
    {rows.map((s, si) => (
      <section id={`step-${s.letter.toLowerCase()}`} class="step qsection" data-index={si + 1}>
        <div class="inner">
          <div class="stepnav top">
            <button class="btn btn-ghost" type="button" data-go={si}>← Back</button>
            <span class="stepnote mono">Step {si + 2} of {STEP_COUNT}</span>
            <button class="btn btn-primary" type="button" data-go={si + 2}>
              {si + 1 < SECTIONS.length ? 'Next' : 'See the result'}&nbsp;<span class="arrow">→</span>
            </button>
          </div>
          <div class="shead">
            <span class="sletter">{s.letter}</span>
            <div class="stitle">
              <h2 class="sname step-title" tabindex="-1">{s.name}</h2>
              <p class="squestion">{s.question}</p>
            </div>
            {s.gate && <span class="sgate">Hard gate</span>}
            <span class="ssub mono" aria-label={`Section ${s.letter} score`}>
              <b id={`secsub-${s.letter}`}>0</b>/{s.max}
            </span>
          </div>
          <p class="sblurb">{s.blurb}</p>

          {s.items.map((it) => (
            <div class={`item${s.gate ? ' gate' : ''}`} id={`row-${it.i}`} data-i={it.i}>
              <span class="qn mono">{String(it.i + 1).padStart(2, '0')}</span>
              <div class="qbody">
                <p class="q">{it.q}</p>
                <p class="why">{it.why}</p>
                <div class="anchors" role="group" aria-label={`Score for question ${it.i + 1}: ${it.short}`}>
                  {it.a.map((text, v) => (
                    <button
                      type="button"
                      class="anchor"
                      id={`q${it.i}v${v}`}
                      data-q={it.i}
                      data-v={v}
                      aria-pressed="false"
                    >
                      <span class="av mono">{v}</span>
                      <span class="at">{text}</span>
                    </button>
                  ))}
                </div>
              </div>
            </div>
          ))}

          <div class="stepnav">
            <button class="btn btn-ghost" type="button" data-go={si}>← Back</button>
            <span class="stepnote mono" id={`stepnote-${s.letter}`}>0 of {s.items.length} answered in this step</span>
            <button class="btn btn-primary" type="button" data-go={si + 2}>
              {si + 1 < SECTIONS.length ? 'Next' : 'See the result'}&nbsp;<span class="arrow">→</span>
            </button>
          </div>
        </div>
      </section>
    ))}

    <!-- Step 5: the result -->
    <section class="step" id="step-result" data-index={STEP_COUNT - 1}>
      <div class="inner">
        <div class="stepnav top">
          <button class="btn btn-ghost" type="button" data-go={STEP_COUNT - 2}>← Back</button>
          <span class="stepnote mono">Step {STEP_COUNT} of {STEP_COUNT}</span>
          <button class="btn btn-ghost" type="button" data-go="1">Change an answer</button>
        </div>
        <div class="sec-head">
          <span class="eyebrow"><span class="num">04</span> Your result</span>
          <h2 class="step-title" tabindex="-1">The outcome, read against the <em>rubric</em>.</h2>
        </div>
        <div class="resultcard" id="resultcard" data-b="none">
          <div class="r-head">
            <span class="r-score mono"><b id="r-total">0</b>/{MAX_SCORE}</span>
            <span class="r-band" id="r-band">Not started</span>
          </div>
          <p class="r-what" id="r-what">
            Answer all {QUESTION_COUNT} questions to read the outcome. Until then this shows the running total, and a blank counts as 0.
          </p>
          <div class="r-secs" id="r-secs"></div>
          <p class="r-gate" id="r-gate" hidden></p>
          <div class="r-fix" id="r-fix" hidden>
            <h3>Fix first</h3>
            <p class="r-fixlead">Lowest scores first, with the move that answers each one before the agent exists.</p>
            <ol id="r-fixlist"></ol>
          </div>
          <div class="r-actions" role="group" aria-label="Assessment controls">
            <button class="btn btn-primary" id="pdf" type="button">Get the PDF</button>
            <button class="btn btn-ghost" id="blank" type="button">New assessment</button>
          </div>
        </div>

        <div class="rubric">
          <div class="sec-head">
            <span class="eyebrow"><span class="num">05</span> The rubric</span>
            <h2>Agree these <em>before</em> you score, not after.</h2>
          </div>
          <p class="prose-lead">
            A total one point above a line is a narrow, not a yes. The row that matches your result is highlighted.
          </p>
          {CUT_LINES.map((c) => (
            <div class="cutrow" id={`cut-${c.key}`} data-b={c.key}>
              <div class="cutscore mono">{c.score}</div>
              <div class="cutname">{c.name}</div>
              <div class="cutwhat">{c.what}</div>
            </div>
          ))}
        </div>

        <div class="stepnav">
          <button class="btn btn-ghost" type="button" data-go={STEP_COUNT - 2}>← Back</button>
          <button class="btn btn-ghost" type="button" data-go="1">Change an answer</button>
        </div>
      </div>
    </section>
  </div>
  </div>
  </section>

  <!-- The four moves -->
  <section id="moves">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><span class="num">06</span> Before you build</span>
        <h2>Four ways to answer most questions <em>before</em> you build the agent.</h2>
      </div>
      <p class="prose-lead">
        Listed from cheapest to most expensive. Each one costs less than a pilot that fails in
        front of a customer.
      </p>
      {MOVES.map((m) => (
        <div class="move" id={`move-${m.num}`}>
          <div class="mnum mono">{m.num}</div>
          <div class="mbody">
            <h3 class="mname">{m.name}</h3>
            <p>{m.body}</p>
            <div class="mmeta mono">
              <span>Cost: {m.cost}</span>
              <span class="ans">Answers {m.answers.map((q) => String(q).padStart(2, '0')).join(' · ')}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Close -->
  <section class="final">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><span class="num">→</span> Where this comes from</span>
        <h2>The score is the easy half. The <em>argument</em> is the other one.</h2>
      </div>
      <div class="prose">
        <p>
          A blank scorecard is useful and costs nothing to give away. What it cannot do on its own
          is settle the rows where two people scored two points apart. That is where the real
          disagreement about the system lives, and that part takes a room.
        </p>
      </div>
      <p class="hero-cta">
        <a class="btn btn-primary" href="/">See the cohort&nbsp;<span class="arrow">→</span></a>
        <a class="btn btn-ghost" href="/resources">All resources&nbsp;<span class="arrow">→</span></a>
      </p>
      <p class="mono faint pubdate">Published {longDate(meta.publishedAt)} · free to use and to pass on</p>
    </div>
  </section>

  {/* The PDF request. A native dialog: focus is trapped, Escape closes it,
      and nothing else on the page needs a script to make that true. */}
  <dialog class="pdf-dialog" id="pdf-dialog" aria-labelledby="pdf-title">
    <form method="dialog" id="pdf-form" novalidate>
      <span class="eyebrow"><span class="num">PDF</span> Your scored copy</span>
      <h2 id="pdf-title">Get the PDF</h2>
      <p class="pdf-lead">
        The PDF carries your twelve answers, the score, the outcome and what to fix first. It is
        built against a name and an email address, and checked before it is handed over.
      </p>
      <div class="pdf-grid">
        <label>
          {nameField.label}
          <input type="text" name="name" autocomplete={nameField.autocomplete} maxlength={nameField.max} required />
        </label>
        <label>
          {emailField.label}
          <input type="email" name="email" autocomplete={emailField.autocomplete} maxlength={emailField.max} required />
        </label>
      </div>
      <input class="hp" type="text" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <p class="pdf-note">
        Your scores go into the file and are not stored. Your address is used to send you this
        tool once. It does not start any other email.
      </p>
      <p class="pdf-status" id="pdf-status" role="status" aria-live="polite"></p>
      <ul class="pdf-checks mono" id="pdf-checks" hidden></ul>
      <div class="pdf-actions">
        <button class="btn btn-primary" id="pdf-submit" type="submit">Build the PDF</button>
        <button class="btn btn-ghost" id="pdf-cancel" type="button">Cancel</button>
      </div>
    </form>
  </dialog>
</ResourcesLayout>

<style>
  /* ── the frame ────────────────────────────────────────────────────────── */
  /* One white shell on the mist ground, the app-shell radius and the overlay
     shadow the design system gives a shell. `overflow: clip` rounds the corners
     without making the frame a scroll container, which `hidden` would, and a
     scroll container is what stops the score bar sticking to the viewport. */
  .tool-section { padding-top: var(--space-6); }
  .tool {
    background: var(--surface-panel);
    border-radius: var(--radius-shell);
    box-shadow: var(--shadow-overlay);
    overflow: clip;
  }
  .inner { padding: 0 var(--space-7); }
  /* Page-scale display headings read as a landing page inside a tool. Step
     them down one size inside the shell; the section names stay as they are. */
  .tool .sec-head h2 { font-size: var(--size-7); }
  .tool .sec-head { margin-bottom: var(--space-5); }

  /* ── steps ────────────────────────────────────────────────────────────── */
  /* Without the script every step is visible. With it, only the current one.
     `data-step` on the tool is the cursor; each step carries its index. */
  .tool.js .step { display: none; }
  .tool.js .step.current { display: block; }
  .step { padding: var(--space-5) 0 var(--space-7); }
  /* The heading takes focus from the script after a step change, so a screen
     reader announces where it landed. It has tabindex="-1", so Tab never
     reaches it, and the ring would only ever show to a mouse user, in berry,
     looking like an error. */
  .step-title:focus, .step-title:focus-visible { outline: none; }

  .stepnav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-hair);
  }
  .stepnav .btn-primary { margin-left: auto; }
  .stepnav.top {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-hair);
    margin-bottom: var(--space-5);
  }
  .stepnote { font-size: var(--size-1); color: var(--text-quiet); }
  /* Without the script the steps are all on the page, so the buttons that move
     between them do nothing useful and are hidden. */
  .tool:not(.js) .stepnav [data-go], .tool:not(.js) .p-step { display: none; }

  /* ── about ────────────────────────────────────────────────────────────── */
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-7);
  }
  .about-col {
    background: var(--surface-sunken);
    border-radius: var(--radius-card);
    padding: var(--space-5) var(--space-6);
  }
  .about-col .eyebrow { display: block; margin-bottom: var(--space-4); }
  ul.plain, ol.steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: 0;
    margin: 0;
    list-style: none;
  }
  ul.plain li {
    position: relative;
    padding-left: var(--space-5);
  }
  ul.plain li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--sun);
  }
  ol.steps { counter-reset: s; }
  ol.steps li {
    counter-increment: s;
    position: relative;
    padding-left: var(--space-6);
  }
  ol.steps li::before {
    content: counter(s);
    position: absolute;
    left: 0;
    top: 0.1em;
    font-family: var(--font-mono);
    font-size: var(--size-1);
    font-weight: var(--weight-strong);
    color: var(--text-on-invert);
    background: var(--noir);
    border-radius: var(--radius-pill);
    width: 20px;
    height: 20px;
    display: inline-grid;
    place-items: center;
  }

  /* ── scoring rules ────────────────────────────────────────────────────── */
  ol.howto {
    list-style: none;
    counter-reset: h;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--measure-prose);
    padding: 0;
    margin: 0;
  }
  ol.howto li {
    counter-increment: h;
    position: relative;
    padding-left: var(--space-7);
  }
  ol.howto li::before {
    content: counter(h);
    position: absolute;
    left: 0;
    top: 1px;
    font-family: var(--font-mono);
    font-size: var(--size-1);
    color: var(--text-quiet);
  }
  ol.howto strong { font-weight: var(--weight-strong); }

  /* ── the score bar ────────────────────────────────────────────────────── */
  /* Sticky under the nav. Its parent is `.tool`, which wraps every step, so it
     holds through the whole tool and releases before the moves. */
  /* The frame's header. Sticky under the nav; flat, with a hairline under it,
     because it sits inside the shell rather than floating over the page. */
  .scorebar-wrap {
    position: sticky;
    /* The nav is 76px on a desktop and wraps taller on a phone. The script
       measures it and sets --nav-h; the fallback is the desktop height. */
    top: var(--nav-h, 76px);
    z-index: var(--z-sticky);
    background: var(--surface-panel);
    border-bottom: 1px solid var(--border-hair);
  }
  .scorebar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    padding: var(--space-4) 0 var(--space-3);
  }
  .sb-score {
    font-family: var(--font-mono);
    font-size: var(--size-7);
    font-weight: var(--weight-strong);
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .sb-score .of {
    font-size: var(--size-3);
    color: var(--text-quiet);
  }
  .sb-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .band {
    font-size: var(--size-4);
    font-weight: var(--weight-heavy);
    letter-spacing: var(--tracking-display);
    line-height: var(--lh-snug);
  }
  .sb-note {
    font-size: var(--size-1);
    color: var(--text-quiet);
  }
  .sb-secs {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: var(--size-1);
    color: var(--text-quiet);
  }
  .sb-sec {
    background: var(--surface-sunken);
    border-radius: var(--radius-pill);
    padding: 3px 10px;
    white-space: nowrap;
  }
  .sb-sec b { color: var(--text-body); font-weight: var(--weight-strong); }
  /* Bands read through colour on the word, not a yellow chip — sun is reserved
     for things you can click, so it cannot carry a status. */
  [data-b='stop'] .band, [data-b='gate'] .band, [data-b='stop'] .r-band, [data-b='gate'] .r-band { color: var(--danger); }
  [data-b='narrow'] .band, [data-b='narrow'] .r-band { color: var(--accent-ink); }
  [data-b='go'] .band, [data-b='go'] .r-band { color: var(--text-loud); }
  [data-b='none'] .band, [data-b='none'] .r-band { color: var(--text-quiet); }

  /* ── the progress bar ─────────────────────────────────────────────────── */
  /* Joined to the score bar as one panel: the bar's bottom corners are square
     and the progress block carries the rounded ones. The fill is sun, and it is
     the one yellow thing here that is not a control, so it stays a thin line. */
  .progress { padding: 0 0 var(--space-3); }
  .p-track {
    height: 4px;
    background: var(--surface-sunken);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }
  .p-fill {
    height: 100%;
    background: var(--sun);
    border-radius: var(--radius-pill);
    transition: width var(--motion-base, 160ms) ease;
  }
  .p-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-3);
  }
  .p-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .p-step {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: transparent;
    border: 0;
    border-radius: var(--radius-pill);
    padding: 3px 10px 3px 4px;
    cursor: pointer;
    font: inherit;
    font-size: var(--size-1);
    color: var(--text-quiet);
  }
  .p-step:hover { background: var(--surface-hover); color: var(--text-body); }
  .p-step:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .p-dot {
    width: 20px;
    height: 20px;
    border-radius: var(--radius-pill);
    background: var(--surface-sunken);
    display: inline-grid;
    place-items: center;
    font-size: 11px;
    font-weight: var(--weight-strong);
    color: var(--text-quiet);
  }
  .p-step[aria-current='step'] { color: var(--text-loud); }
  .p-step[aria-current='step'] .p-dot { background: var(--noir); color: var(--text-on-invert); }
  .p-step.done .p-dot { background: var(--sun); color: var(--text-on-accent); }
  .p-text { font-size: var(--size-1); color: var(--text-quiet); white-space: nowrap; }

  /* ── question sections ────────────────────────────────────────────────── */
  .shead {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: start;
    gap: var(--space-3) var(--space-4);
    margin-bottom: var(--space-3);
  }
  .sletter {
    font-family: var(--font-mono);
    font-size: var(--size-2);
    font-weight: var(--weight-strong);
    color: var(--text-on-invert);
    background: var(--noir);
    border-radius: var(--radius-pill);
    width: 28px;
    height: 28px;
    display: inline-grid;
    place-items: center;
    margin-top: 4px;
  }
  .stitle { min-width: 0; }
  .sname { font-size: var(--size-6); line-height: var(--lh-tight); }
  .squestion {
    margin: var(--space-1) 0 0;
    font-size: var(--size-3);
    color: var(--text-quiet);
  }
  .sgate {
    font-family: var(--font-mono);
    font-size: var(--size-1);
    color: var(--danger);
    background: var(--danger-quiet);
    border-radius: var(--radius-pill);
    padding: 4px 12px;
    margin-top: 6px;
    white-space: nowrap;
  }
  .ssub {
    font-size: var(--size-2);
    color: var(--text-quiet);
    background: var(--surface-sunken);
    border-radius: var(--radius-pill);
    padding: 4px 12px;
    margin-top: 4px;
    white-space: nowrap;
  }
  .ssub b { color: var(--text-body); font-weight: var(--weight-strong); }
  .sblurb {
    color: var(--text-quiet);
    max-width: var(--measure-prose);
    margin: 0 0 var(--space-5) calc(28px + var(--space-4));
  }

  /* One grid per question: the number in a fixed gutter, everything else in
     the second column, so the question, the reason and the three anchors all
     share one left edge. */
  .item {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 0 var(--space-3);
    background: var(--surface-sunken);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    margin-bottom: var(--space-4);
  }
  /* A zeroed gate row is the one thing on the page that must not be missable. */
  .item.gate.zeroed {
    outline: var(--border-w-rule) solid var(--danger-mark);
    outline-offset: 0;
  }
  .qn {
    font-size: var(--size-1);
    color: var(--text-quiet);
    padding-top: 6px;
  }
  .qbody { min-width: 0; }
  .q {
    margin: 0;
    font-size: var(--size-4);
    font-weight: var(--weight-strong);
    line-height: var(--lh-snug);
  }
  .why {
    margin: var(--space-2) 0 var(--space-4);
    font-size: var(--size-2);
    color: var(--text-quiet);
    max-width: 64ch;
  }

  .anchors {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }
  .anchor {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-align: left;
    background: var(--surface-panel);
    border: 0;
    border-radius: var(--radius-inner);
    padding: var(--space-4);
    cursor: pointer;
    font: inherit;
    color: var(--text-body);
    transition: background var(--motion-fast, 90ms) ease, color var(--motion-fast, 90ms) ease;
  }
  .anchor:hover { background: var(--surface-hover); }
  .anchor:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .anchor .av {
    font-size: var(--size-1);
    font-weight: var(--weight-strong);
    color: var(--text-quiet);
  }
  .anchor .at { font-size: var(--size-2); line-height: var(--lh-snug); }
  /* Selected is sun: these are buttons, so yellow still means clickable. */
  .anchor[aria-pressed='true'] {
    background: var(--surface-sun);
    color: var(--text-on-accent);
  }
  .anchor[aria-pressed='true'] .av { color: var(--text-on-accent); }

  /* ── the result ───────────────────────────────────────────────────────── */
  .resultcard {
    background: var(--surface-sunken);
    border-radius: var(--radius-card);
    padding: var(--space-6);
    margin-bottom: var(--space-7);
  }
  .r-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin-bottom: var(--space-3);
  }
  .r-score {
    font-size: var(--size-8);
    font-weight: var(--weight-strong);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text-quiet);
  }
  .r-score b { color: var(--text-body); }
  .r-band {
    font-size: var(--size-6);
    font-weight: var(--weight-heavy);
    letter-spacing: var(--tracking-display);
    line-height: var(--lh-tight);
  }
  .r-what {
    max-width: var(--measure-prose);
    margin: 0 0 var(--space-5);
  }
  .r-secs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  /* The section boxes and the fix-first rows are created by the script, so
     they never carry Astro's scoping attribute. `:global()` is what lets these
     rules reach them; the parents above are in the template and stay scoped. */
  .r-secs :global(.r-sec) {
    background: var(--surface-panel);
    border-radius: var(--radius-inner);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .r-secs :global(.r-sec .k) {
    font-family: var(--font-mono);
    font-size: var(--size-1);
    color: var(--text-quiet);
  }
  .r-secs :global(.r-sec .v) {
    font-family: var(--font-mono);
    font-size: var(--size-5);
    font-weight: var(--weight-strong);
  }
  .r-secs :global(.r-sec .v small) { font-size: var(--size-2); color: var(--text-quiet); font-weight: var(--weight-regular); }
  .r-secs :global(.r-sec .n) { font-size: var(--size-1); color: var(--text-quiet); }
  .r-secs :global(.r-sec.low .v) { color: var(--danger); }
  .r-gate {
    color: var(--danger);
    font-weight: var(--weight-strong);
    max-width: var(--measure-prose);
    margin: 0 0 var(--space-5);
  }
  .r-fix h3 { font-size: var(--size-4); margin: 0 0 var(--space-1); }
  .r-fixlead { font-size: var(--size-2); color: var(--text-quiet); margin: 0 0 var(--space-3); }
  .r-fix ol {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-5);
    display: flex;
    flex-direction: column;
  }
  .r-fix :global(li) {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--border-hair);
    font-size: var(--size-2);
  }
  .r-fix :global(li:last-child) { border-bottom: 1px solid var(--border-hair); }
  .r-fix :global(.fn) { font-family: var(--font-mono); font-size: var(--size-1); color: var(--text-quiet); padding-top: 3px; }
  .r-fix :global(.fn.zero) { color: var(--danger); }
  .r-fix :global(.ft b) { font-weight: var(--weight-strong); }
  .r-fix :global(.ft .fm) { display: block; margin-top: 2px; color: var(--accent-ink); }
  .r-fix :global(.ft .fm a) { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .r-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: center; }

  /* ── rubric ───────────────────────────────────────────────────────────── */
  .prose-lead {
    color: var(--text-quiet);
    max-width: var(--measure-prose);
    margin-bottom: var(--space-5);
  }
  .cutrow {
    display: grid;
    grid-template-columns: 120px 240px 1fr;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-inner);
    margin-bottom: var(--space-3);
    background: var(--surface-sunken);
    opacity: 0.55;
    transition: opacity var(--motion-base, 160ms) ease;
  }
  .cutrow.active { opacity: 1; background: var(--surface-panel); box-shadow: var(--shadow-raise); }
  .cutscore { font-size: var(--size-2); font-weight: var(--weight-strong); }
  .cutname { font-weight: var(--weight-strong); }
  .cutwhat { font-size: var(--size-2); color: var(--text-quiet); }
  .cutrow[data-b='gate'].active .cutscore,
  .cutrow[data-b='stop'].active .cutscore { color: var(--danger); }
  .cutrow[data-b='narrow'].active .cutscore { color: var(--accent-ink); }

  /* ── the four moves ───────────────────────────────────────────────────── */
  .move {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--border-hair);
  }
  .move:last-of-type { border-bottom: 1px solid var(--border-hair); }
  .mnum { font-size: var(--size-2); color: var(--text-quiet); padding-top: 4px; }
  .mname { font-size: var(--size-5); margin: 0 0 var(--space-2); }
  .mbody p { max-width: var(--measure-prose); margin: 0; }
  .mmeta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-3);
    font-size: var(--size-1);
    color: var(--text-quiet);
  }
  .mmeta .ans { color: var(--accent-ink); }

  .crumb { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .pubdate { margin-top: var(--space-5); font-size: var(--size-1); }

  /* ── the PDF dialog ───────────────────────────────────────────────────── */
  .pdf-dialog {
    /* The reset zeroes margin on everything, which also removes the
       browser's own centring of a modal dialog. Put it back. */
    margin: auto;
    border: 0;
    padding: 0;
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    overflow: auto;
    background: var(--surface-panel);
    color: var(--text-body);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-overlay);
  }
  .pdf-dialog::backdrop { background: rgba(22, 33, 46, 0.45); }
  .pdf-dialog form { padding: var(--space-6); }
  .pdf-dialog .eyebrow { display: block; margin-bottom: var(--space-3); }
  .pdf-dialog h2 { font-size: var(--size-6); margin: 0 0 var(--space-3); }
  .pdf-lead { margin: 0 0 var(--space-5); }
  .pdf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .pdf-dialog label {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-family: var(--font-marginal);
    font-size: var(--size-1);
    color: var(--text-quiet);
  }
  .pdf-dialog input {
    font-family: var(--font-body);
    font-size: var(--size-3);
    color: var(--text-body);
    background: var(--surface-panel);
    border: var(--border-w-rule) solid var(--border-field);
    border-radius: var(--radius-field);
    padding: 0 var(--space-4);
    height: var(--control-h);
    width: 100%;
  }
  .pdf-dialog input:focus { outline: none; border-color: var(--text-body); }
  .pdf-dialog input:focus-visible { outline: var(--focus-w) solid var(--focus-ring); outline-offset: var(--focus-offset); }
  .pdf-dialog .hp { position: absolute !important; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .pdf-note { margin: var(--space-4) 0 0; font-size: var(--size-2); color: var(--text-quiet); }
  .pdf-status { margin: var(--space-3) 0 0; font-size: var(--size-2); min-height: 1.4em; }
  .pdf-status.err { color: var(--danger); }
  .pdf-status.ok { color: var(--text-loud); }
  .pdf-checks {
    list-style: none;
    padding: var(--space-3) var(--space-4);
    margin: var(--space-3) 0 0;
    background: var(--surface-sunken);
    border-radius: var(--radius-inner);
    font-size: var(--size-1);
    color: var(--text-quiet);
    display: flex;
    flex-direction: column;
    gap: 3px;
    max-height: 180px;
    overflow: auto;
  }
  .pdf-checks :global(li) { display: flex; gap: var(--space-2); }
  .pdf-checks :global(li b) { flex: 0 0 5ch; font-weight: var(--weight-strong); color: var(--text-body); }
  .pdf-checks :global(li.fail b) { color: var(--danger); }
  .pdf-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-4); }
  .pdf-dialog button[disabled] { opacity: 0.42; pointer-events: none; }

  @media (max-width: 860px) {
    .tool { border-radius: var(--radius-panel); }
    .inner { padding: 0 var(--space-4); }
    .about { grid-template-columns: 1fr; }
    .scorebar { grid-template-columns: auto 1fr; }
    .sb-secs { grid-column: 1 / -1; }
    .sb-score { font-size: var(--size-6); }
    .band { font-size: var(--size-3); }
    .p-label { display: none; }
    .p-step { padding-right: 4px; }
    .p-text { white-space: normal; }
    .shead { grid-template-columns: auto 1fr; }
    .sgate, .ssub { grid-column: 2; justify-self: start; margin-top: 0; }
    .sblurb { margin-left: 0; }
    .item { grid-template-columns: 1fr; }
    .qn { padding-top: 0; margin-bottom: var(--space-1); }
    .anchors { grid-template-columns: 1fr; }
    .r-secs { grid-template-columns: 1fr 1fr; }
    .cutrow { grid-template-columns: 1fr; gap: var(--space-2); }
    .pdf-grid { grid-template-columns: 1fr; }
    .stepnav .btn-primary { margin-left: 0; }
  }

  /* ── print: every step, in order, as a scorecard ──────────────────────── */
  @media print {
    .tool.js .step { display: block; }
    .scorebar-wrap { position: static; }
    .tool { box-shadow: none; border: 1px solid var(--border-hair); }
    .resultcard, .about-col { border: 1px solid var(--border-hair); }
    .stepnav, .hero-cta, .r-actions, .pdf-dialog, .p-steps { display: none !important; }
    .item { box-shadow: none; border: 1px solid var(--border-hair); break-inside: avoid; }
    .cutrow { opacity: 1 !important; break-inside: avoid; }
    .move, .anchor, .resultcard { break-inside: avoid; }
    .anchor { border: 1px solid var(--border-hair); }
    .anchor[aria-pressed='true'] { outline: 2px solid var(--ink-1); }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>

<script>
  // Scores are a plain array in this closure, and the step is a number beside
  // it. Never written to localStorage, never posted except inside the PDF
  // request, and gone when the tab closes.
  //
  // This is a module script, so it imports the same data module the page
  // rendered from. The score bar, the result summary, the copied scorecard
  // and (on the server) the PDF all read one rubric: `readScores()`.
  import {
    EXAMPLE,
    FLAT,
    QUESTION_COUNT,
    SECTIONS,
    moveFor,
    readScores,
  } from '../../data/poc-screen';

  const $ = (id: string) => document.getElementById(id)!;
  const pad = (n: number) => String(n).padStart(2, '0');

  let state: (number | null)[] = new Array(QUESTION_COUNT).fill(null);

  // ---- the steps ----------------------------------------------------------

  const tool = $('tool');
  const stepEls = [...tool.querySelectorAll<HTMLElement>('.step')];
  const STEP_COUNT = stepEls.length;
  const LAST = STEP_COUNT - 1;
  let step = 0;
  tool.classList.add('js');

  // Which questions live in which step. Step 0 and the last have none.
  const stepQuestions = stepEls.map((el) => [...el.querySelectorAll<HTMLElement>('.item')].map((i) => Number(i.dataset.i)));

  function stepLabel(i: number) {
    if (i === 0) return 'Start';
    if (i === LAST) return 'Result';
    return `${SECTIONS[i - 1].letter} ${SECTIONS[i - 1].name}`;
  }

  function goTo(i: number, move = true) {
    step = Math.max(0, Math.min(LAST, i));
    tool.dataset.step = String(step);
    stepEls.forEach((el, k) => el.classList.toggle('current', k === step));
    updateProgress();
    if (!move) return;
    // Scroll so the tool's top sits just under the nav. The score bar is the
    // tool's first child, so the step heading lands directly beneath it.
    const navH = document.querySelector('header.nav')?.getBoundingClientRect().height ?? 76;
    const top = tool.getBoundingClientRect().top + window.scrollY;
    window.scrollTo({ top: Math.max(0, top - navH - 8), behavior: 'smooth' });
    stepEls[step].querySelector<HTMLElement>('.step-title')?.focus({ preventScroll: true });
  }

  function updateProgress() {
    const answered = state.filter((v) => v !== null).length;
    $('p-fill').style.width = `${(answered / QUESTION_COUNT) * 100}%`;
    $('p-track').setAttribute('aria-valuenow', String(answered));
    $('p-text').textContent = `Step ${step + 1} of ${STEP_COUNT} · ${stepLabel(step)} · ${answered} of ${QUESTION_COUNT} answered`;
    document.querySelectorAll<HTMLButtonElement>('.p-step').forEach((b) => {
      const i = Number(b.dataset.go);
      if (i === step) b.setAttribute('aria-current', 'step');
      else b.removeAttribute('aria-current');
      // A section step is "done" once all of its questions are answered.
      const qs = stepQuestions[i];
      b.classList.toggle('done', qs.length > 0 && qs.every((q) => state[q] !== null));
    });
    stepQuestions.forEach((qs, i) => {
      if (!qs.length) return;
      const note = document.getElementById(`stepnote-${SECTIONS[i - 1].letter}`);
      if (note) note.textContent = `${qs.filter((q) => state[q] !== null).length} of ${qs.length} answered in this step`;
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) => {
    b.addEventListener('click', () => goTo(Number(b.dataset.go)));
  });

  // ---- the read, in the bar's words ---------------------------------------

  function bandLine(r: ReturnType<typeof readScores>) {
    if (r.band?.key === 'gate') {
      const names = r.gateZero.map((i) => `${pad(i + 1)} ${FLAT[i].short}`).join(', ');
      return {
        key: 'gate',
        band: r.band.name,
        note: `A 0 in section B on ${names}. Fix that before the total matters.`,
      };
    }
    if (!r.complete) {
      const left = QUESTION_COUNT - r.answered;
      return {
        key: 'none',
        band: r.answered === 0 ? 'Not started' : 'In progress',
        note: `${left} ${left === 1 ? 'question' : 'questions'} to answer. A blank counts as 0.`,
      };
    }
    return { key: r.band!.key, band: r.band!.name, note: r.band!.what };
  }

  // ---- render -------------------------------------------------------------

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  }

  function renderResult(r: ReturnType<typeof readScores>, line: ReturnType<typeof bandLine>) {
    const card = $('resultcard');
    card.dataset.b = line.key;
    $('r-total').textContent = String(r.total);
    $('r-band').textContent = line.band;
    $('r-what').textContent = r.complete || r.band
      ? line.note
      : `Answer all ${QUESTION_COUNT} questions to read the outcome. Until then this shows the running total, and a blank counts as 0.`;

    $('r-secs').replaceChildren(
      ...r.sections.map((s) => {
        const box = el('div', `r-sec${s.score <= s.max / 3 && s.answered > 0 ? ' low' : ''}`);
        box.append(el('span', 'k', `${s.letter} · ${s.name}`));
        const v = el('span', 'v', String(s.score));
        v.append(el('small', undefined, `/${s.max}`));
        box.append(v);
        const left = s.max / 2 - s.answered;
        box.append(el('span', 'n', left ? `${left} unanswered` : 'all answered'));
        return box;
      }),
    );

    const gate = $('r-gate');
    if (r.gateZero.length) {
      gate.hidden = false;
      gate.textContent = `Hard gate. Section B has a 0 on ${r.gateZero
        .map((i) => `${pad(i + 1)} ${FLAT[i].short}`)
        .join(', ')}. This stops the proof of concept whatever the total.`;
    } else {
      gate.hidden = true;
    }

    const weak = FLAT.map((it, i) => ({ it, i, v: state[i] }))
      .filter((x) => x.v === 0 || x.v === 1)
      .sort((a, b) => (a.v ?? 0) - (b.v ?? 0) || Number(b.it.gate) - Number(a.it.gate));
    $('r-fix').hidden = weak.length === 0;
    $('r-fixlist').replaceChildren(
      ...weak.map((x) => {
        const li = el('li');
        li.append(el('span', `fn${x.v === 0 ? ' zero' : ''}`, pad(x.i + 1)));
        const t = el('div', 'ft');
        t.append(el('b', undefined, `${x.it.short}, scored ${x.v}${x.it.gate ? ' (hard gate)' : ''}. `), document.createTextNode(x.it.a[x.v ?? 0]));
        const m = moveFor(x.i + 1);
        if (m) {
          const fm = el('span', 'fm');
          const a = el('a', undefined, `Move ${m.num}: ${m.name}`);
          a.href = `#move-${m.num}`;
          fm.append(a);
          t.append(fm);
        }
        li.append(t);
        return li;
      }),
    );
  }

  function update() {
    state.forEach((v, i) => {
      for (let k = 0; k < 3; k++) {
        document.getElementById(`q${i}v${k}`)?.setAttribute('aria-pressed', String(v === k));
      }
      document.getElementById(`row-${i}`)?.classList.toggle('zeroed', v === 0 && FLAT[i].gate);
    });

    const r = readScores(state);
    const line = bandLine(r);

    $('total').textContent = String(r.total);
    $('band').textContent = line.band;
    $('note').textContent = line.note;
    $('verdict').dataset.b = line.key;
    for (const s of r.sections) {
      $(`sec-${s.letter}`).textContent = String(s.score);
      $(`secsub-${s.letter}`).textContent = String(s.score);
    }

    renderResult(r, line);
    updateProgress();

    for (const key of ['gate', 'go', 'narrow', 'stop']) {
      document.getElementById(`cut-${key}`)?.classList.toggle('active', r.band?.key === key);
    }
  }

  // ---- controls -----------------------------------------------------------

  document.querySelectorAll<HTMLButtonElement>('.anchor').forEach((b) => {
    b.addEventListener('click', () => {
      const q = Number(b.dataset.q);
      const v = Number(b.dataset.v);
      // Clicking the selected anchor again clears it, so a mis-click is undoable.
      state[q] = state[q] === v ? null : v;
      update();
    });
  });

  $('blank').addEventListener('click', () => {
    state = new Array(QUESTION_COUNT).fill(null);
    update();
    goTo(1);
  });

  $('example').addEventListener('click', () => {
    state = EXAMPLE.slice();
    update();
    goTo(LAST);
  });

  // The score bar sticks under the nav, and the nav is taller when its links
  // wrap on a narrow screen. Measure it rather than guess.
  const nav = document.querySelector<HTMLElement>('header.nav');
  const bar = document.querySelector<HTMLElement>('.scorebar-wrap');
  function placeBar() {
    if (nav && bar) bar.style.setProperty('--nav-h', `${Math.round(nav.getBoundingClientRect().height)}px`);
  }
  placeBar();
  window.addEventListener('resize', placeBar);

  // ---- the PDF ------------------------------------------------------------

  const dialog = document.getElementById('pdf-dialog') as HTMLDialogElement;
  const form = document.getElementById('pdf-form') as HTMLFormElement;
  const pdfStatus = $('pdf-status');
  const pdfChecks = $('pdf-checks');
  const submit = document.getElementById('pdf-submit') as HTMLButtonElement;
  const cancel = $('pdf-cancel');

  function openPdf() {
    pdfStatus.textContent = '';
    pdfStatus.className = 'pdf-status';
    pdfChecks.hidden = true;
    pdfChecks.replaceChildren();
    submit.disabled = false;
    cancel.textContent = 'Cancel';
    if (typeof dialog.showModal === 'function') dialog.showModal();
    else dialog.setAttribute('open', '');
  }
  $('pdf').addEventListener('click', openPdf);
  cancel.addEventListener('click', () => dialog.close());

  function say(text: string, kind: 'ok' | 'err' | '') {
    pdfStatus.textContent = text;
    pdfStatus.className = `pdf-status${kind ? ` ${kind}` : ''}`;
  }

  function showChecks(checks: { name: string; ok: boolean }[]) {
    if (!Array.isArray(checks) || !checks.length) return;
    pdfChecks.replaceChildren(
      ...checks.map((c) => {
        const li = el('li', c.ok ? undefined : 'fail');
        li.append(el('b', undefined, c.ok ? 'ok' : 'failed'), document.createTextNode(c.name));
        return li;
      }),
    );
    pdfChecks.hidden = false;
  }

  function download(base64: string, filename: string) {
    const bin = atob(base64);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    const url = URL.createObjectURL(new Blob([bytes], { type: 'application/pdf' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 60_000);
  }

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    if (!name || !email) {
      say('Both fields are needed.', 'err');
      return;
    }

    submit.disabled = true;
    say('Checking and building the PDF.', '');

    // One key per attempt. A retry after a network error is a new attempt; a
    // repeat click while this one runs is stopped by the disabled button.
    const requestKey =
      typeof crypto.randomUUID === 'function'
        ? crypto.randomUUID()
        : `${Date.now()}-${Math.random().toString(16).slice(2)}`;

    try {
      const res = await fetch('/api/pipeline/resource-pdf', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          resource: 'poc-screen',
          requestKey,
          answers: { name, email },
          botcheck: String(data.get('botcheck') ?? ''),
          scores: state,
          search: location.search,
          referrer: document.referrer,
          entryPath: location.pathname,
        }),
      });
      const body = await res.json().catch(() => ({}));

      if (!res.ok || !body.ok || typeof body.pdf !== 'string') {
        const errs = Array.isArray(body.errors) ? body.errors.map((e: { message: string }) => e.message).join(' ') : '';
        say(errs || body.error || 'We could not build the PDF just now. Try again in a moment.', 'err');
        showChecks(body.checks);
        submit.disabled = false;
        return;
      }

      download(body.pdf, body.filename || 'poc-selection-tool-scored.pdf');
      cancel.textContent = 'Close';

      const checks = Array.isArray(body.checks) ? body.checks : [];
      const passed = checks.filter((c: { ok: boolean }) => c.ok).length;
      const checkLine = checks.length ? ` Checked before download: ${passed} of ${checks.length} checks passed.` : '';
      say(`Your PDF is downloading.${checkLine} ${body.saved ? (body.delivery ?? '') : (body.note ?? '')}`.trim(), 'ok');
      showChecks(checks);
    } catch {
      say('The request did not reach the server. Check the connection and try again.', 'err');
      submit.disabled = false;
    }
  });

  update();
  goTo(0, false);
</script>
