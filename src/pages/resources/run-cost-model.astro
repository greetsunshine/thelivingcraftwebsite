  }

  /* One mist card per section, the reference's card inside the shell. The
     label column and the value columns share one set of tracks, so every
     input sits under its option's name and every label starts on one edge. */
  .grid {
    background: var(--surface-sunken);
    border-radius: var(--radius-card);
    padding: var(--space-2) var(--space-5);
    overflow: hidden;
  }
  .grow {
    display: grid;
