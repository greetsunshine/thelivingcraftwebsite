---
// /resources/run-cost-model — The Run-Cost Model Tool, self-hosted.
//
// Until 17 September 2026 this was an Excel workbook in public/downloads. It
// is now a page in the same shape as the POC Selection Tool: the inputs are
// typed here, every line is worked out as it is typed, and the result is read
// against a rubric. The workbook is still offered at the foot of the page for
// people who need the model in a budget meeting; the formulas are the same.
//
// Two tabs. "Your model" is the tool. "Reference example" is the ordering
// agent across 40 sites with every line filled, rendered here on the server
// from the same data module, and loadable into the tool with one button.
//
// Inputs are a closure and die with the tab. No localStorage, no
// sessionStorage. The one thing that leaves the browser is the PDF request:
// name, email and the inputs go to /api/pipeline/resource-pdf, which records
// the person (the V4 addendum's "optional email request"), builds the PDF from
// the same data module this page renders from, and hands it back. The inputs
// are used for the file and not stored; the dialog says so.
//
// Every string here comes from src/data/run-cost-model.ts. The page's script
// imports that module too (Vite bundles it), so the live bar, the computed
// lines, the result, the copied text and the PDF all read one set of formulas.
import ResourcesLayout from '../../layouts/ResourcesLayout.astro';
import { SITE_ORIGIN } from '../../data/facts';
import { publishedResources, longDate } from '../../data/resources';
import {
  TOOL_NAME,
  PURPOSE,
  HOW_TO_USE,
  HOW_TO_RUN,
  LIMITS,
  ARMS,
  SECTIONS,
  TOTALS,
  FORGOTTEN_ROWS,
  INPUT_COUNT,
  OUTCOMES,
  EXAMPLE,
  EXAMPLE_STORY,
  readModel,
  unitOf,
  fmtInput,
  fmtComputed,
  fmtMoney,
  type SharedKey,
  type ArmRowKey,
} from '../../data/run-cost-model';
import { RESOURCE_FIELDS } from '../../lib/pipeline/resources';

const meta = publishedResources.find((r) => r.id === 'run-cost-model')!;

const title = `${TOOL_NAME} — what an AI agent costs to run, against three cheaper ways to do the same job · The Living Craft`;
const description =
  'An interactive cost model for an agent proposal. Four options side by side over one period: a rules workflow, the same rules rebuilt on a written spec, a model-assisted draft, and a full agent with tools. Build cost kept apart from run cost, quality beside cost, and the nine operating lines most business cases leave out. Every line is worked out as you type; the result names the option with the lowest cost per acceptable outcome.';

const schema = [
  {
    '@type': 'HowTo',
    '@id': `${SITE_ORIGIN}/resources/run-cost-model#howto`,
    name: TOOL_NAME,
    description,
    url: `${SITE_ORIGIN}/resources/run-cost-model`,
    author: { '@id': `${SITE_ORIGIN}/#person` },
    datePublished: meta.publishedAt,
    isAccessibleForFree: true,
    step: SECTIONS.map((s) => ({
      '@type': 'HowToSection',
      position: s.num,
      name: s.name,
      description: s.blurb,
      itemListElement: s.inputs.map((it, j) => ({
        '@type': 'HowToStep',
        position: j + 1,
        name: it.label,
        text: it.why,
      })),
    })),
  },
];

// The reference example, worked out here so the tab reads without a script.
const ex = readModel(EXAMPLE);
const exCur = EXAMPLE.currency;
const exLead = ex.arms.find((a) => a.key === ex.leader)!;

const nameField = RESOURCE_FIELDS.find((f) => f.name === 'name')!;
const emailField = RESOURCE_FIELDS.find((f) => f.name === 'email')!;
---

<ResourcesLayout title={title} description={description} canonical="/resources/run-cost-model" schema={schema}>
  <!-- Hero -->
  <section class="hero" id="top" style="border-top:0">
    <div class="wrap">
      <div class="eyebrow">
        <a href="/resources" class="crumb">Resources</a>
        <span class="num">/ {meta.series.toLowerCase()} {meta.number}</span>
      </div>
      <h1>{TOOL_NAME}</h1>
      <p class="lead">
        Put a number on an agent proposal <em>before</em> anyone commits to building it. Four ways of
        doing the same job, costed side by side, with the operating lines most business cases leave
        out. The number it lands on is cost per acceptable outcome.
      </p>
      <p class="hero-note mono">
        {ARMS.length} options · {SECTIONS.length} sections · {INPUT_COUNT} lines · 1 reference example
      </p>
    </div>
  </section>

  <!-- Purpose and how to use -->
  <section id="about">
    <div class="wrap">
      <div class="about">
        <div class="about-col">
          <span class="eyebrow"><span class="num">01</span> What this tool is for</span>
          <ul class="plain">
            {PURPOSE.map((p) => <li>{p}</li>)}
          </ul>
        </div>
        <div class="about-col">
          <span class="eyebrow"><span class="num">02</span> How to use it</span>
          <ol class="steps">
            {HOW_TO_USE.map((p) => <li>{p}</li>)}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- Rules -->
  <section id="rules">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><span class="num">03</span> Rules for using it in a budget conversation</span>
        <h2>Five rules that decide whether the number is <em>evidence</em> or a guess.</h2>
      </div>
      <ol class="howto">
        {HOW_TO_RUN.map((h) => (
          <li>
            <strong>{h.lead}</strong> {h.rest}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Tabs -->
  <section id="tabs-section">
    <div class="wrap">
      <div class="tabs" role="tablist" aria-label="Your model or the reference example">
        <button class="tab" role="tab" id="tab-model" aria-selected="true" aria-controls="panel-model" type="button">Your model</button>
        <button class="tab" role="tab" id="tab-example" aria-selected="false" aria-controls="panel-example" type="button">Reference example</button>
      </div>
      <noscript>
        <p class="noscript">The model needs JavaScript to work out the lines as you type. Without it, the
          reference example below shows every line filled and every total, and the rubric says how the
          outcome was reached.</p>
      </noscript>
    </div>
  </section>

  {/* Everything the bar has to stay above lives inside this one element. A
      sticky element only sticks within its parent, so the bar's parent has
      to be as tall as the sections and the result together. */}
  <div class="scoring" id="panel-model" role="tabpanel" aria-labelledby="tab-model">
    <div class="scorebar-wrap">
      <div class="wrap">
        <div class="scorebar" id="verdict" data-b="none" role="status" aria-live="polite">
          <div class="sb-score">
            <span id="lead-cost">—</span><span class="of" id="lead-of"> per acceptable outcome</span>
          </div>
          <div class="sb-text">
            <span class="band" id="band">Not started</span>
            <span class="sb-note" id="note">{INPUT_COUNT} lines to fill. A blank is unknown, not zero.</span>
          </div>
          <div class="sb-secs mono" aria-label="Cost per acceptable outcome by option">
            {ARMS.map((a) => (
              <span class="sb-sec" id={`pill-${a.key}`} title={`${a.name}: ${a.legend}`}>
                {a.short} <b id={`pill-v-${a.key}`}>—</b>
              </span>
            ))}
          </div>
          <div class="sb-prog mono" id="progress">0/{INPUT_COUNT} lines set</div>
        </div>
      </div>
    </div>

    <section id="score">
      <div class="wrap">
        <div class="controls" role="group" aria-label="Model controls">
          <button class="btn btn-ghost" id="blank" type="button">New model</button>
          <button class="btn btn-ghost" id="load-example" type="button">Load the reference example</button>
          <button class="btn btn-ghost" id="copy" type="button">Copy the model</button>
          <button class="btn btn-ghost" id="print" type="button">Print</button>
          <button class="btn btn-primary" id="pdf" type="button">Get the PDF</button>
          <span class="copied mono" id="copied" role="status" aria-live="polite"></span>
        </div>

        <div class="arms" aria-label="The four options being compared">
          {ARMS.map((a) => (
            <div class="arm">
              <span class="armname">{a.name}</span>
              <p class="armwhat">{a.what}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- The seven sections -->
    {SECTIONS.map((s) => (
      <section id={`section-${s.num}`} class="qsection">
        <div class="wrap">
          <div class="shead">
            <span class="sletter">{s.num}</span>
            <div class="stitle">
              <h2 class="sname">{s.name}</h2>
              <p class="squestion">{s.question}</p>
            </div>
            <span class="ssub mono">{s.scope === 'shared' ? 'shared by all four options' : 'one value per option'}</span>
          </div>
          <p class="sblurb">{s.blurb}</p>

          <div class={`grid ${s.scope}`}>
            {s.num === 1 && (
              <div class="grow input">
                <div class="glabel">
                  <label for="in-currency">Currency label</label>
                  <span class="gunit mono">free text</span>
                  <p class="gwhy">Such as INR or USD. Shown in front of every money figure. Not counted as a line.</p>
                </div>
                <span class="gcell">
                  <input type="text" id="in-currency" maxlength="12" placeholder="e.g. INR" autocomplete="off" />
                </span>
              </div>
            )}
            {s.scope === 'arm' && (
              <div class="grow ghead">
                <span class="glabel"></span>
                {ARMS.map((a) => (
                  <span class="garm">
                    <b class="mono">{a.short}</b>
                    <small class="glegend">{a.legend}</small>
                  </span>
                ))}
              </div>
            )}
            {s.inputs.map((row) => (
              <div class={`grow input${row.forgotten ? ' forgot' : ''}`}>
                <div class="glabel">
                  {s.scope === 'shared' ? (
                    <label for={`in-${row.key}`}>{row.label}</label>
                  ) : (
                    <span class="glabel-t" id={`lbl-${row.key}`}>{row.label}</span>
                  )}
                  <span class="gunit mono" data-kind={row.kind}>{unitOf(row.kind, '')}</span>
                  {row.forgotten && <span class="gforgot mono">often left out</span>}
                  <p class="gwhy">{row.why}</p>
                </div>
                {s.scope === 'shared' ? (
                  <span class="gcell">
                    <input
                      type="number"
                      id={`in-${row.key}`}
                      data-scope="shared"
                      data-key={row.key}
                      min="0"
                      step="any"
                      inputmode="decimal"
                      placeholder={`e.g. ${fmtInput(EXAMPLE.shared[row.key as SharedKey])}`}
                    />
                  </span>
                ) : (
                  ARMS.map((a) => (
                    <span class="gcell">
                      <span class="cellarm mono" aria-hidden="true" title={a.legend}>{a.short}</span>
                      <input
                        type="number"
                        id={`in-${a.key}-${row.key}`}
                        data-scope="arm"
                        data-arm={a.key}
                        data-key={row.key}
                        min="0"
                        step="any"
                        inputmode="decimal"
                        placeholder={`e.g. ${fmtInput(EXAMPLE.arms[a.key][row.key as ArmRowKey])}`}
                        aria-label={`${row.label}, ${a.name}`}
                      />
                    </span>
                  ))
                )}
              </div>
            ))}
            {s.computed.map((row) => (
              <div class="grow computed">
                <div class="glabel">
                  <span class="glabel-c">{row.label}</span>
                  <p class="gwhy">{row.why}</p>
                </div>
                {s.scope === 'shared' ? (
                  <output class="gcell out mono" id={`c-${row.key}`} aria-label={row.label}>—</output>
                ) : (
                  ARMS.map((a) => (
                    <output class="gcell out mono" id={`c-${row.key}-${a.key}`} aria-label={`${row.label}, ${a.name}`}>—</output>
                  ))
                )}
              </div>
            ))}
          </div>
        </div>
      </section>
    ))}

    <!-- The result -->
    <section id="result">
      <div class="wrap">
        <div class="sec-head">
          <span class="eyebrow"><span class="num">04</span> Your result</span>
          <h2>The outcome, read against the <em>rubric</em>.</h2>
        </div>
        <div class="resultcard" id="resultcard" data-b="none">
          <div class="r-head">
            <span class="r-band" id="r-band">Not started</span>
            <span class="r-lead mono" id="r-lead"></span>
          </div>
          <p class="r-what" id="r-what">
            Fill every one of the {INPUT_COUNT} lines to read the outcome. Until then this shows each total as soon as the lines that feed it are filled.
          </p>
          <ul class="r-flags" id="r-flags"></ul>
          <div class="r-secs" id="r-secs"></div>

          <table class="rtable" id="r-table">
            <thead>
              <tr>
                <th scope="col"><span class="visually-hidden">Line</span></th>
                {ARMS.map((a) => <th scope="col">{a.short}<small class="thlegend">{a.legend}</small></th>)}
              </tr>
            </thead>
            <tbody>
              {TOTALS.map((row) => (
                <tr class={row.key === 'perOutcome' ? 'key' : ''}>
                  <th scope="row">{row.label}<span class="twhy">{row.why}</span></th>
                  {ARMS.map((a) => <td class="mono" id={`t-${row.key}-${a.key}`}>—</td>)}
                </tr>
              ))}
            </tbody>
          </table>

          <div class="r-fix" id="r-fix" hidden>
            <h3>Check these assumptions first</h3>
            <p class="r-fixlead">The leading option first, then the full agent, then the rest. Each one is a line that decides the answer and is usually guessed.</p>
            <ol id="r-fixlist"></ol>
          </div>
          <div class="r-actions">
            <button class="btn btn-primary" id="pdf2" type="button">Get the PDF</button>
            <button class="btn btn-ghost" id="copy2" type="button">Copy the model</button>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Reference example -->
  <div id="panel-example" role="tabpanel" aria-labelledby="tab-example" class="example-panel">
    <section id="example">
      <div class="wrap">
        <div class="sec-head">
          <span class="eyebrow"><span class="num">Reference example</span></span>
          <h2>{EXAMPLE_STORY.title}, every line <em>already filled</em>.</h2>
        </div>
        <div class="prose ex-story">
          {EXAMPLE_STORY.lines.map((l) => <p>{l}</p>)}
        </div>
        <div class="controls">
          <button class="btn btn-primary" id="load-example-2" type="button">Load this example into your model</button>
          <a class="btn btn-ghost" href="#tab-model" id="to-model">Back to your model</a>
        </div>

        <div class="resultcard ex-result" data-b={ex.outcome?.key ?? 'none'}>
          <div class="r-head">
            <span class="r-band">{ex.outcome?.name}</span>
            <span class="r-lead mono">Leading option: {exLead.name} · {fmtMoney(exLead.values.perOutcome, exCur, true)} per acceptable outcome</span>
          </div>
          <p class="r-what">{ex.outcome?.what}</p>
          <ul class="r-flags">
            {ex.flags.map((f) => <li class={f.key}>{f.text}</li>)}
          </ul>
          <table class="rtable">
            <thead>
              <tr>
                <th scope="col"><span class="visually-hidden">Line</span></th>
                {ARMS.map((a) => <th scope="col">{a.short}<small class="thlegend">{a.legend}</small></th>)}
              </tr>
            </thead>
            <tbody>
              {TOTALS.map((row) => (
                <tr class={row.key === 'perOutcome' ? 'key' : ''}>
                  <th scope="row">{row.label}</th>
                  {ex.arms.map((a) => (
                    <td class={`mono${a.key === ex.leader && row.key === 'perOutcome' ? ' is-lead' : ''}${(row.key === 'net' && (a.values.net ?? 0) < 0) || (row.key === 'breakEven' && a.breakEvenState === 'never') ? ' bad' : ''}`}>
                      {fmtComputed(row, a.values[row.key as keyof typeof a.values], exCur, a.breakEvenState)}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
          {ex.checks.length > 0 && (
            <div class="r-fix">
              <h3>Check these assumptions first</h3>
              <ol>
                {ex.checks.map((c, i) => (
                  <li>
                    <span class="fn">{String(i + 1).padStart(2, '0')}</span>
                    <div class="ft">{c.text}</div>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </div>

        {SECTIONS.map((s) => (
          <div class="ex-section">
            <div class="shead">
              <span class="sletter">{s.num}</span>
              <div class="stitle">
                <h3 class="sname">{s.name}</h3>
                <p class="squestion">{s.question}</p>
              </div>
            </div>
            <table class="extable">
              <thead>
                <tr>
                  <th scope="col">Line</th>
                  <th scope="col">Unit</th>
                  {s.scope === 'shared' ? <th scope="col">Value</th> : ARMS.map((a) => <th scope="col">{a.short}<small class="thlegend">{a.legend}</small></th>)}
                </tr>
              </thead>
              <tbody>
                {s.num === 1 && (
                  <tr>
                    <th scope="row">Currency label</th>
                    <td class="unit mono">free text</td>
                    <td class="mono">{EXAMPLE.currency}</td>
                  </tr>
                )}
                {s.inputs.map((row) => (
                  <tr class={row.forgotten ? 'forgot' : ''}>
                    <th scope="row">{row.label}{row.forgotten && <span class="gforgot mono">often left out</span>}</th>
                    <td class="unit mono">{unitOf(row.kind, exCur)}</td>
                    {s.scope === 'shared' ? (
                      <td class="mono">{fmtInput(EXAMPLE.shared[row.key as SharedKey])}</td>
                    ) : (
                      ARMS.map((a) => <td class="mono">{fmtInput(EXAMPLE.arms[a.key][row.key as ArmRowKey])}</td>)
                    )}
                  </tr>
                ))}
                {s.computed.map((row) => (
                  <tr class="calc">
                    <th scope="row">{row.label}</th>
                    <td class="unit mono">worked out</td>
                    {s.scope === 'shared' ? (
                      <td class="mono">{fmtComputed(row, ex.shared.values[row.key as keyof typeof ex.shared.values], exCur)}</td>
                    ) : (
                      ex.arms.map((a) => <td class="mono">{fmtComputed(row, a.values[row.key as keyof typeof a.values], exCur, a.breakEvenState)}</td>)
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </div>
    </section>
  </div>

  <!-- The rubric -->
  <section id="rubric">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><span class="num">05</span> How the outcome is read</span>
        <h2>Agree this <em>before</em> the numbers go in, not after.</h2>
      </div>
      <p class="prose-lead">
        The leading option is the one with the lowest cost per acceptable outcome among the options
        that save money against the manual baseline over the period. The row that matches your
        result is highlighted.
      </p>
      {OUTCOMES.map((o) => (
        <div class="cutrow" id={`cut-${o.key}`} data-b={o.key}>
          <div class="cutscore">{o.when}</div>
          <div class="cutname">{o.name}</div>
          <div class="cutwhat">{o.what}</div>
        </div>
      ))}
      <p class="prose-lead flags-lead">
        Three flags sit beside the outcome and do not change it. <strong>Disagreement:</strong> cost per
        case and cost per acceptable outcome pick different options. <strong>Never breaks
        even:</strong> an option costs more to run each month than doing it by hand. <strong>Beyond the
        period:</strong> an option pays back, but after the months you modelled.
      </p>
    </div>
  </section>

  <!-- The nine lines -->
  <section id="forgotten">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><span class="num">06</span> The nine lines teams leave out</span>
        <h2>The model bill is usually the <em>smallest</em> line.</h2>
      </div>
      <p class="prose-lead">
        Each of these is marked <span class="gforgot mono inline">often left out</span> in the model above.
        Together they are most of what it costs to run an agent, and none of them appears in a demo.
      </p>
      {FORGOTTEN_ROWS.map((row, i) => (
        <div class="move">
          <div class="mnum mono">{String(i + 1).padStart(2, '0')}</div>
          <div class="mbody">
            <h3 class="mname">{row.label}</h3>
            <p>{row.why}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Close -->
  <section class="final">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><span class="num">07</span> What this model does not price</span>
        <h2>A number you can take to a budget conversation. Not the <em>whole</em> argument.</h2>
      </div>
      <ul class="plain limits">
        {LIMITS.map((l) => <li>{l}</li>)}
      </ul>
      <div class="prose">
        <p>
          An agent proposal is also a commitment to operate an agent. This tool turns that sentence
          into a number. Sometimes the number says build it. The reference example is a case where it
          did not, and where the build was still worth doing, because it produced the written
          specification that made the cheap option good.
        </p>
      </div>
      <p class="hero-cta">
        <a class="btn btn-primary" href="/">See the cohort&nbsp;<span class="arrow">→</span></a>
        <a class="btn btn-ghost" href="/resources">All resources&nbsp;<span class="arrow">→</span></a>
        <a class="btn btn-ghost" href="/downloads/agent-run-cost-model.xlsx" download>The same model as an Excel workbook&nbsp;<span class="arrow">↓</span></a>
      </p>
      <p class="mono faint pubdate">Published {longDate(meta.publishedAt)} · free to use and to pass on</p>
    </div>
  </section>

  {/* The PDF request. A native dialog: focus is trapped, Escape closes it,
      and nothing else on the page needs a script to make that true. */}
  <dialog class="pdf-dialog" id="pdf-dialog" aria-labelledby="pdf-title">
    <form method="dialog" id="pdf-form" novalidate>
      <span class="eyebrow"><span class="num">PDF</span> Your model</span>
      <h2 id="pdf-title">Get the PDF</h2>
      <p class="pdf-lead">
        The PDF carries every line you typed, every total, the outcome and the assumptions to check.
        It is built against a name and an email address.
      </p>
      <div class="pdf-grid">
        <label>
          {nameField.label}
          <input type="text" name="name" autocomplete={nameField.autocomplete} maxlength={nameField.max} required />
        </label>
        <label>
          {emailField.label}
          <input type="email" name="email" autocomplete={emailField.autocomplete} maxlength={emailField.max} required />
        </label>
      </div>
      <input class="hp" type="text" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <p class="pdf-note">
        Your figures go into the file and are not stored. Your address is used to send you this
        tool once. It does not start any other email.
      </p>
      <p class="pdf-status" id="pdf-status" role="status" aria-live="polite"></p>
      <div class="pdf-actions">
        <button class="btn btn-primary" id="pdf-submit" type="submit">Build the PDF</button>
        <button class="btn btn-ghost" id="pdf-cancel" type="button">Cancel</button>
      </div>
    </form>
  </dialog>
</ResourcesLayout>

<style>
  /* ── about ────────────────────────────────────────────────────────────── */
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }
  .about-col {
    background: var(--surface-panel);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-raise);
    padding: var(--space-5) var(--space-6);
  }
  .about-col .eyebrow { display: block; margin-bottom: var(--space-4); }
  ul.plain, ol.steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: 0;
    margin: 0;
    list-style: none;
  }
  ul.plain li {
    position: relative;
    padding-left: var(--space-5);
  }
  ul.plain li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--sun);
  }
  ol.steps { counter-reset: s; }
  ol.steps li {
    counter-increment: s;
    position: relative;
    padding-left: var(--space-6);
  }
  ol.steps li::before {
    content: counter(s);
    position: absolute;
    left: 0;
    top: 0.1em;
    font-family: var(--font-mono);
    font-size: var(--size-1);
    font-weight: var(--weight-strong);
    color: var(--text-on-invert);
    background: var(--noir);
    border-radius: var(--radius-pill);
    width: 20px;
    height: 20px;
    display: inline-grid;
    place-items: center;
  }

  /* ── rules ────────────────────────────────────────────────────────────── */
  ol.howto {
    list-style: none;
    counter-reset: h;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--measure-prose);
    padding: 0;
    margin: 0;
  }
  ol.howto li {
    counter-increment: h;
    position: relative;
    padding-left: var(--space-7);
  }
  ol.howto li::before {
    content: counter(h);
    position: absolute;
    left: 0;
    top: 1px;
    font-family: var(--font-mono);
    font-size: var(--size-1);
    color: var(--text-quiet);
  }
  ol.howto strong { font-weight: var(--weight-strong); }

  /* ── tabs ─────────────────────────────────────────────────────────────── */
  #tabs-section { padding-bottom: 0; }
  .tabs {
    display: flex;
    gap: var(--space-2);
    border-bottom: 1px solid var(--border-hair);
  }
  .tab {
    font: inherit;
    font-weight: var(--weight-strong);
    font-size: var(--size-3);
    color: var(--text-quiet);
    background: none;
    border: 0;
    border-bottom: 3px solid transparent;
    padding: var(--space-3) var(--space-4);
    margin-bottom: -1px;
    cursor: pointer;
  }
  .tab:hover { color: var(--text-body); }
  .tab:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .tab[aria-selected='true'] { color: var(--text-body); border-bottom-color: var(--sun); }
  .noscript { margin-top: var(--space-4); color: var(--text-quiet); max-width: var(--measure-prose); }

  /* ── controls ─────────────────────────────────────────────────────────── */
  #score { padding-top: var(--space-5); padding-bottom: 0; }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }
  .copied { font-size: var(--size-1); color: var(--text-quiet); }

  .arms {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .arm {
    background: var(--surface-panel);
    border-radius: var(--radius-inner);
    box-shadow: var(--shadow-raise);
    padding: var(--space-4);
  }
  .armname { display: block; font-weight: var(--weight-strong); margin-bottom: var(--space-1); }
  .armwhat { margin: 0; font-size: var(--size-2); color: var(--text-quiet); }

  /* ── the bar ──────────────────────────────────────────────────────────── */
  .scorebar-wrap {
    position: sticky;
    top: var(--nav-h, 76px);
    z-index: var(--z-sticky);
    padding: var(--space-3) 0;
    background: var(--surface-sunken);
  }
  .scorebar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    background: var(--surface-panel);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-raise);
    padding: var(--space-3) var(--space-5);
  }
  .sb-score {
    font-family: var(--font-mono);
    font-size: var(--size-6);
    font-weight: var(--weight-strong);
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .sb-score .of {
    font-size: var(--size-1);
    font-weight: var(--weight-regular);
    color: var(--text-quiet);
    letter-spacing: 0;
  }
  .sb-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .band {
    font-size: var(--size-4);
    font-weight: var(--weight-heavy);
    letter-spacing: var(--tracking-display);
    line-height: var(--lh-snug);
  }
  .sb-note { font-size: var(--size-1); color: var(--text-quiet); }
  /* Four pills as a two-by-two block. A single row of four would take the
     width the outcome text needs, and the grid would squeeze that column. */
  .sb-secs { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-1) var(--space-2); font-size: var(--size-1); color: var(--text-quiet); }
  .sb-sec {
    background: var(--surface-sunken);
    border-radius: var(--radius-pill);
    padding: 3px 10px;
    white-space: nowrap;
  }
  .sb-sec b { color: var(--text-body); font-weight: var(--weight-strong); }
  .sb-sec.is-lead { outline: 2px solid var(--ink-1); }
  .sb-prog { font-size: var(--size-1); color: var(--text-quiet); white-space: nowrap; }
  /* Outcomes read through colour on the word, never a yellow chip: sun is for
     things you can click. */
  [data-b='manual'] .band, [data-b='manual'] .r-band { color: var(--danger); }
  [data-b='rules'] .band, [data-b='rules'] .r-band,
  [data-b='rules2'] .band, [data-b='rules2'] .r-band { color: var(--accent-ink); }
  [data-b='assisted'] .band, [data-b='assisted'] .r-band,
  [data-b='agent'] .band, [data-b='agent'] .r-band { color: var(--text-loud); }
  [data-b='none'] .band, [data-b='none'] .r-band { color: var(--text-quiet); }

  /* ── sections ─────────────────────────────────────────────────────────── */
  .qsection { padding-top: var(--space-7); padding-bottom: 0; }
  .shead {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: var(--space-3) var(--space-4);
    margin-bottom: var(--space-3);
  }
  .sletter {
    font-family: var(--font-mono);
    font-size: var(--size-2);
    font-weight: var(--weight-strong);
    color: var(--text-on-invert);
    background: var(--noir);
    border-radius: var(--radius-pill);
    width: 28px;
    height: 28px;
    display: inline-grid;
    place-items: center;
    margin-top: 4px;
  }
  .stitle { min-width: 0; }
  .sname { font-size: var(--size-6); line-height: var(--lh-tight); margin: 0; }
  .squestion { margin: var(--space-1) 0 0; font-size: var(--size-3); color: var(--text-quiet); }
  .ssub {
    font-size: var(--size-1);
    color: var(--text-quiet);
    background: var(--surface-panel);
    border-radius: var(--radius-pill);
    padding: 4px 12px;
    margin-top: 6px;
    white-space: nowrap;
  }
  .sblurb {
    color: var(--text-quiet);
    max-width: var(--measure-prose);
    margin: 0 0 var(--space-5) calc(28px + var(--space-4));
  }

  /* One grid per section. The label column and the value columns share one
     set of tracks, so every input in a section sits under its option's name
     and every label starts on one left edge. */
  .grid {
    background: var(--surface-panel);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-raise);
    padding: var(--space-2) var(--space-5);
    /* The computed rows bleed to the card's edge; clip them to its corners. */
    overflow: hidden;
  }
  .grow {
    display: grid;
    align-items: start;
    gap: var(--space-3) var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--border-hair);
  }
  .grow:first-child { border-top: 0; }
  .grid.shared .grow { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
  .grid.arm .grow { grid-template-columns: minmax(0, 1.7fr) repeat(4, minmax(0, 1fr)); }
  .grow.ghead { padding: var(--space-3) 0 var(--space-2); border-top: 0; }
  .garm {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--size-1);
    color: var(--text-quiet);
    text-align: right;
    padding-right: var(--space-3);
  }
  .garm b { font-weight: var(--weight-strong); color: var(--text-body); }
  /* The legend: what the column is, in a few words, under its name in every
     table. The four cards under the controls say the same thing at length,
     and they have scrolled away by section 3. */
  .glegend, .thlegend {
    display: block;
    font-family: var(--font-body);
    font-size: var(--size-1);
    font-weight: var(--weight-regular);
    color: var(--text-quiet);
    line-height: var(--lh-snug);
    white-space: normal;
  }
  .thlegend { margin-top: 2px; }
  .glabel { min-width: 0; }
  .glabel label, .glabel-t, .glabel-c {
    display: block;
    font-weight: var(--weight-strong);
    line-height: var(--lh-snug);
  }
  .glabel-c { color: var(--text-quiet); }
  .gunit {
    display: inline-block;
    margin-top: 2px;
    margin-right: var(--space-2);
    font-size: var(--size-1);
    color: var(--text-quiet);
  }
  .gforgot {
    display: inline-block;
    margin-top: 2px;
    font-size: var(--size-1);
    color: var(--accent-ink);
    background: var(--surface-sunken);
    border-radius: var(--radius-pill);
    padding: 1px 8px;
    vertical-align: middle;
  }
  .gforgot.inline { margin: 0 2px; }
  .gwhy {
    margin: var(--space-1) 0 0;
    font-size: var(--size-2);
    color: var(--text-quiet);
    max-width: 52ch;
  }
  .gcell { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .cellarm { display: none; font-size: var(--size-1); color: var(--text-quiet); }
  .grid input {
    font-family: var(--font-mono);
    font-size: var(--size-2);
    color: var(--text-body);
    background: var(--surface-panel);
    border: var(--border-w-rule) solid var(--border-field);
    border-radius: var(--radius-field);
    padding: 0 var(--space-3);
    height: 40px;
    width: 100%;
    min-width: 0;
    text-align: right;
  }
  .grid input[type='text'] { text-align: left; }
  .grid input::placeholder { color: var(--text-quiet); opacity: 0.7; }
  .grid input:focus { outline: none; border-color: var(--text-body); }
  .grid input:focus-visible { outline: var(--focus-w) solid var(--focus-ring); outline-offset: var(--focus-offset); }
  /* A filled field is sun: yellow means the value is yours and can be changed. */
  .grid input.set { background: var(--surface-sun); color: var(--text-on-accent); border-color: transparent; }
  .grow.computed { background: var(--surface-sunken); margin: 0 calc(-1 * var(--space-5)); padding-left: var(--space-5); padding-right: var(--space-5); }
  .out {
    display: block;
    text-align: right;
    padding: 9px var(--space-3) 0 0;
    font-size: var(--size-2);
    font-weight: var(--weight-strong);
    color: var(--text-quiet);
  }
  .out.has { color: var(--text-body); }

  /* ── the result ───────────────────────────────────────────────────────── */
  #result { padding-top: var(--space-7); }
  .resultcard {
    background: var(--surface-panel);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-raise);
    padding: var(--space-6);
  }
  .r-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-bottom: var(--space-3);
  }
  .r-band {
    font-size: var(--size-6);
    font-weight: var(--weight-heavy);
    letter-spacing: var(--tracking-display);
    line-height: var(--lh-tight);
  }
  .r-lead { font-size: var(--size-1); color: var(--text-quiet); }
  .r-what { max-width: var(--measure-prose); margin: 0 0 var(--space-4); }
  .r-flags {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: var(--measure-prose);
  }
  .r-flags:empty { display: none; }
  .r-flags :global(li) {
    font-size: var(--size-2);
    font-weight: var(--weight-strong);
    padding-left: var(--space-5);
    position: relative;
  }
  .r-flags :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--ink-1);
  }
  .r-flags :global(li.never), .r-flags :global(li.beyond) { color: var(--danger); }
  .r-flags :global(li.never)::before, .r-flags :global(li.beyond)::before { background: var(--danger); }
  .r-secs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .r-secs :global(.r-sec) {
    background: var(--surface-sunken);
    border-radius: var(--radius-inner);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .r-secs :global(.r-sec.is-lead) { outline: 2px solid var(--ink-1); }
  .r-secs :global(.r-sec .k) { font-family: var(--font-mono); font-size: var(--size-1); color: var(--text-quiet); }
  .r-secs :global(.r-sec .v) { font-family: var(--font-mono); font-size: var(--size-4); font-weight: var(--weight-strong); }
  .r-secs :global(.r-sec .v small) { display: block; font-size: var(--size-1); color: var(--text-quiet); font-weight: var(--weight-regular); }
  .r-secs :global(.r-sec .n) { font-size: var(--size-1); color: var(--text-quiet); }
  .r-secs :global(.r-sec .n.bad) { color: var(--danger); }

  .rtable {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-5);
    font-size: var(--size-2);
  }
  .rtable th, .rtable td { padding: var(--space-2) var(--space-3); border-top: 1px solid var(--border-hair); vertical-align: top; text-align: right; }
  .rtable thead th { border-top: 0; font-family: var(--font-mono); font-size: var(--size-1); font-weight: var(--weight-strong); color: var(--text-body); vertical-align: bottom; }
  .rtable tbody th { text-align: left; font-weight: var(--weight-strong); }
  .rtable tbody th .twhy { display: block; font-weight: var(--weight-regular); font-size: var(--size-1); color: var(--text-quiet); max-width: 40ch; }
  .rtable tr.key th, .rtable tr.key td { background: var(--surface-sunken); }
  .rtable td.is-lead { font-weight: var(--weight-strong); color: var(--text-loud); }
  .rtable td.bad { color: var(--danger); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .r-fix h3 { font-size: var(--size-4); margin: 0 0 var(--space-1); }
  .r-fixlead { font-size: var(--size-2); color: var(--text-quiet); margin: 0 0 var(--space-3); max-width: var(--measure-prose); }
  .r-fix ol { list-style: none; padding: 0; margin: 0 0 var(--space-5); display: flex; flex-direction: column; }
  .r-fix :global(li) {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--border-hair);
    font-size: var(--size-2);
  }
  .r-fix :global(li:last-child) { border-bottom: 1px solid var(--border-hair); }
  .r-fix :global(.fn) { font-family: var(--font-mono); font-size: var(--size-1); color: var(--text-quiet); padding-top: 3px; }
  .r-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }

  /* ── the reference example ────────────────────────────────────────────── */
  .example-panel[hidden] { display: none; }
  .ex-story { max-width: var(--measure-prose); margin-bottom: var(--space-5); }
  .ex-story p { margin: 0 0 var(--space-3); }
  #example .controls { margin-bottom: var(--space-6); }
  .ex-result { margin-bottom: var(--space-7); }
  .ex-section { margin-bottom: var(--space-6); }
  .ex-section .sname { font-size: var(--size-5); }
  .extable {
    width: 100%;
    border-collapse: collapse;
    background: var(--surface-panel);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-raise);
    font-size: var(--size-2);
    margin-left: 0;
  }
  .extable th, .extable td { padding: var(--space-2) var(--space-3); border-top: 1px solid var(--border-hair); text-align: right; vertical-align: top; }
  .extable thead th { border-top: 0; font-family: var(--font-mono); font-size: var(--size-1); font-weight: var(--weight-strong); color: var(--text-body); vertical-align: bottom; }
  .extable thead th:first-child, .extable tbody th { text-align: left; }
  .extable tbody th { font-weight: var(--weight-regular); }
  .extable td.unit { text-align: left; color: var(--text-quiet); font-size: var(--size-1); white-space: nowrap; }
  .extable tr.calc th, .extable tr.calc td { background: var(--surface-sunken); font-weight: var(--weight-strong); }
  .extable tr.calc td.unit { font-weight: var(--weight-regular); }
  .extable .gforgot { margin-left: var(--space-2); }

  /* ── rubric ───────────────────────────────────────────────────────────── */
  .prose-lead { color: var(--text-quiet); max-width: var(--measure-prose); margin-bottom: var(--space-5); }
  .flags-lead { margin-top: var(--space-5); margin-bottom: 0; }
  .flags-lead strong { color: var(--text-body); }
  .cutrow {
    display: grid;
    grid-template-columns: 260px 240px 1fr;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-inner);
    margin-bottom: var(--space-3);
    background: var(--surface-panel);
    opacity: 0.55;
    transition: opacity var(--motion-base, 160ms) ease;
  }
  .cutrow.active { opacity: 1; box-shadow: var(--shadow-raise); }
  .cutscore { font-size: var(--size-2); color: var(--text-quiet); }
  .cutname { font-weight: var(--weight-strong); }
  .cutwhat { font-size: var(--size-2); color: var(--text-quiet); }
  .cutrow[data-b='manual'].active .cutname { color: var(--danger); }
  .cutrow[data-b='rules'].active .cutname, .cutrow[data-b='rules2'].active .cutname { color: var(--accent-ink); }

  /* ── the nine lines ───────────────────────────────────────────────────── */
  .move {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--border-hair);
  }
  .move:last-of-type { border-bottom: 1px solid var(--border-hair); }
  .mnum { font-size: var(--size-2); color: var(--text-quiet); padding-top: 4px; }
  .mname { font-size: var(--size-4); margin: 0 0 var(--space-1); }
  .mbody p { max-width: var(--measure-prose); margin: 0; font-size: var(--size-2); color: var(--text-quiet); }

  /* ── close ────────────────────────────────────────────────────────────── */
  .limits { max-width: var(--measure-prose); margin: 0 auto var(--space-5); text-align: left; }
  .final .prose { margin-bottom: var(--space-5); }
  .crumb { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .pubdate { margin-top: var(--space-5); font-size: var(--size-1); }

  /* ── the PDF dialog ───────────────────────────────────────────────────── */
  .pdf-dialog {
    margin: auto;
    border: 0;
    padding: 0;
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    overflow: auto;
    background: var(--surface-panel);
    color: var(--text-body);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-overlay);
  }
  .pdf-dialog::backdrop { background: rgba(22, 33, 46, 0.45); }
  .pdf-dialog form { padding: var(--space-6); }
  .pdf-dialog .eyebrow { display: block; margin-bottom: var(--space-3); }
  .pdf-dialog h2 { font-size: var(--size-6); margin: 0 0 var(--space-3); }
  .pdf-lead { margin: 0 0 var(--space-5); }
  .pdf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .pdf-dialog label {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-family: var(--font-marginal);
    font-size: var(--size-1);
    color: var(--text-quiet);
  }
  .pdf-dialog input {
    font-family: var(--font-body);
    font-size: var(--size-3);
    color: var(--text-body);
    background: var(--surface-panel);
    border: var(--border-w-rule) solid var(--border-field);
    border-radius: var(--radius-field);
    padding: 0 var(--space-4);
    height: var(--control-h);
    width: 100%;
  }
  .pdf-dialog input:focus { outline: none; border-color: var(--text-body); }
  .pdf-dialog input:focus-visible { outline: var(--focus-w) solid var(--focus-ring); outline-offset: var(--focus-offset); }
  .pdf-dialog .hp { position: absolute !important; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .pdf-note { margin: var(--space-4) 0 0; font-size: var(--size-2); color: var(--text-quiet); }
  .pdf-status { margin: var(--space-3) 0 0; font-size: var(--size-2); min-height: 1.4em; }
  .pdf-status.err { color: var(--danger); }
  .pdf-status.ok { color: var(--text-loud); }
  .pdf-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-4); }
  .pdf-dialog button[disabled] { opacity: 0.42; pointer-events: none; }

  @media (max-width: 960px) {
    .grid.arm .grow { grid-template-columns: minmax(0, 1.4fr) repeat(4, minmax(0, 1fr)); }
    .garm { padding-right: var(--space-2); }
  }
  @media (max-width: 860px) {
    .about { grid-template-columns: 1fr; }
    .scorebar { grid-template-columns: auto 1fr; }
    .sb-secs { grid-column: 1 / -1; grid-template-columns: 1fr 1fr; }
    .sb-prog { display: none; }
    .sb-score { font-size: var(--size-5); }
    .band { font-size: var(--size-3); }
    .arms { grid-template-columns: 1fr 1fr; }
    .shead { grid-template-columns: auto 1fr; }
    .ssub { grid-column: 2; justify-self: start; margin-top: 0; }
    .sblurb { margin-left: 0; }
    .grid.shared .grow, .grid.arm .grow { grid-template-columns: 1fr; }
    .grow.ghead { display: none; }
    .cellarm { display: block; }
    .gcell { flex-direction: row; align-items: center; gap: var(--space-3); }
    .cellarm { flex: 0 0 72px; }
    .out { padding-top: 0; text-align: left; }
    .grow.computed .gcell { flex-direction: row; }
    .r-secs { grid-template-columns: 1fr 1fr; }
    .cutrow { grid-template-columns: 1fr; gap: var(--space-2); }
    .pdf-grid { grid-template-columns: 1fr; }
    .rtable, .extable { display: block; overflow-x: auto; }
  }

  /* ── print: this is a model people print ──────────────────────────────── */
  @media print {
    .scorebar-wrap { position: static; background: none; }
    .scorebar, .resultcard, .about-col, .grid, .arm { box-shadow: none; border: 1px solid var(--border-hair); }
    .controls, .hero-cta, .r-actions, .pdf-dialog, .tabs, .noscript { display: none !important; }
    .example-panel[hidden] { display: block; }
    .grid, .grow, .cutrow, .move, .resultcard, .ex-section { break-inside: avoid; }
    .cutrow { opacity: 1 !important; }
    .grid input { border: 1px solid var(--border-hair); }
    .grid input.set { outline: 2px solid var(--ink-1); }
    #example { break-before: page; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>

<script>
  // The inputs are one object in this closure. Never written to localStorage,
  // never posted except inside the PDF request, and gone when the tab closes.
  //
  // This is a module script, so it imports the same data module the page
  // rendered from. The bar, every computed line, the result, the copied text
  // and (on the server) the PDF all read one set of formulas: `readModel()`.
  import {
    ARMS,
    ARM_ROWS,
    EXAMPLE,
    INPUT_COUNT,
    OUTCOMES,
    SECTIONS,
    SHARED_ROWS,
    TOOL_NAME,
    TOTALS,
    armByKey,
    blankInputs,
    fmtComputed,
    fmtInput,
    fmtMoney,
    fmtMonths,
    readModel,
    unitOf,
    type ArmKey,
    type ArmRowKey,
    type Cell,
    type ModelInputs,
    type RowKind,
    type SharedKey,
  } from '../../data/run-cost-model';

  const $ = (id: string) => document.getElementById(id)!;
  const pad = (n: number) => String(n).padStart(2, '0');

  let state: ModelInputs = blankInputs();

  // The bar sticks under the nav, and the nav is taller when its links wrap
  // on a narrow screen. Measure it rather than guess.
  const nav = document.querySelector<HTMLElement>('header.nav');
  const bar = document.querySelector<HTMLElement>('.scorebar-wrap');
  function placeBar() {
    if (nav && bar) bar.style.setProperty('--nav-h', `${Math.round(nav.getBoundingClientRect().height)}px`);
  }
  placeBar();
  window.addEventListener('resize', placeBar);

  // ---- tabs ---------------------------------------------------------------

  const tabModel = $('tab-model');
  const tabExample = $('tab-example');
  const panelModel = $('panel-model');
  const panelExample = $('panel-example');

  function showTab(which: 'model' | 'example') {
    const model = which === 'model';
    tabModel.setAttribute('aria-selected', String(model));
    tabExample.setAttribute('aria-selected', String(!model));
    panelModel.hidden = !model;
    panelExample.hidden = model;
    placeBar();
  }
  tabModel.addEventListener('click', () => showTab('model'));
  tabExample.addEventListener('click', () => showTab('example'));
  $('to-model').addEventListener('click', (ev) => {
    ev.preventDefault();
    showTab('model');
    $('tabs-section').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  showTab('model');

  // ---- inputs -------------------------------------------------------------

  const inputs = Array.from(document.querySelectorAll<HTMLInputElement>('.grid input[type="number"]'));
  const currencyInput = $('in-currency') as HTMLInputElement;

  function parseCell(raw: string): Cell {
    const t = raw.trim();
    if (t === '') return null;
    const n = Number(t);
    return Number.isFinite(n) && n >= 0 ? n : null;
  }

  /** Copy the state into the fields, for New model and Load example. */
  function writeInputs() {
    currencyInput.value = state.currency;
    for (const el of inputs) {
      const key = el.dataset.key!;
      const v = el.dataset.scope === 'shared' ? state.shared[key as SharedKey] : state.arms[el.dataset.arm as ArmKey][key as ArmRowKey];
      el.value = v === null ? '' : String(v);
    }
  }

  for (const el of inputs) {
    el.addEventListener('input', () => {
      const v = parseCell(el.value);
      const key = el.dataset.key!;
      if (el.dataset.scope === 'shared') state.shared[key as SharedKey] = v;
      else state.arms[el.dataset.arm as ArmKey][key as ArmRowKey] = v;
      update();
    });
  }
  currencyInput.addEventListener('input', () => {
    state.currency = currencyInput.value.slice(0, 12);
    update();
  });

  // ---- render -------------------------------------------------------------

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  }

  function setOut(id: string, text: string) {
    const o = document.getElementById(id);
    if (!o) return;
    o.textContent = text;
    o.classList.toggle('has', text !== '—');
  }

  const isExample = () => JSON.stringify(state) === JSON.stringify(EXAMPLE);

  function update() {
    const r = readModel(state);
    const cur = state.currency;

    // Fields: a filled one is sun.
    for (const e of inputs) e.classList.toggle('set', e.value.trim() !== '');
    // Units follow the currency label.
    document.querySelectorAll<HTMLElement>('.gunit[data-kind]').forEach((u) => {
      u.textContent = unitOf(u.dataset.kind as RowKind, cur);
    });

    // Computed lines under each section.
    for (const s of SECTIONS) {
      for (const row of s.computed) {
        if (s.scope === 'shared') {
          setOut(`c-${row.key}`, fmtComputed(row, r.shared.values[row.key as keyof typeof r.shared.values], cur));
        } else {
          for (const a of r.arms) setOut(`c-${row.key}-${a.key}`, fmtComputed(row, a.values[row.key as keyof typeof a.values], cur, a.breakEvenState));
        }
      }
    }

    // The bar.
    const lead = r.leader ? r.arms.find((a) => a.key === r.leader)! : null;
    const left = r.totalInputs - r.filled;
    $('lead-cost').textContent = lead ? fmtMoney(lead.values.perOutcome, cur, true) : '—';
    $('lead-of').textContent = lead ? ` per acceptable outcome, ${lead.short}` : ' per acceptable outcome';
    let bandKey = 'none';
    let bandText = 'Not started';
    let noteText = `${INPUT_COUNT} lines to fill. A blank is unknown, not zero.`;
    if (r.outcome) {
      bandKey = r.outcome.key;
      bandText = r.outcome.name;
      noteText = lead
        ? `Leading option: ${lead.name}. Net ${fmtMoney(lead.values.net, cur)} against doing it by hand over ${fmtInput(state.shared.months)} months.`
        : 'No option saves money against the manual baseline over the period.';
    } else if (r.filled > 0) {
      bandText = 'In progress';
      noteText = `${left} ${left === 1 ? 'line' : 'lines'} to fill. Each total appears once the lines that feed it are filled.`;
    }
    $('verdict').dataset.b = bandKey;
    $('band').textContent = bandText;
    $('note').textContent = noteText;
    $('progress').textContent = `${r.filled}/${INPUT_COUNT} lines set`;
    for (const a of r.arms) {
      $(`pill-v-${a.key}`).textContent = fmtMoney(a.values.perOutcome, cur, true);
      $(`pill-${a.key}`).classList.toggle('is-lead', a.key === r.leader);
    }

    // The result card.
    const card = $('resultcard');
    card.dataset.b = bandKey;
    $('r-band').textContent = bandText;
    $('r-lead').textContent = lead ? `Leading option: ${lead.name} · ${fmtMoney(lead.values.perOutcome, cur, true)} per acceptable outcome` : '';
    $('r-what').textContent = r.outcome
      ? r.outcome.what
      : `Fill every one of the ${INPUT_COUNT} lines to read the outcome. Until then this shows each total as soon as the lines that feed it are filled.`;
    $('r-flags').replaceChildren(...r.flags.map((f) => el('li', f.key, f.text)));

    $('r-secs').replaceChildren(
      ...r.arms.map((a) => {
        const box = el('div', `r-sec${a.key === r.leader ? ' is-lead' : ''}`);
        box.append(el('span', 'k', a.name));
        const v = el('span', 'v', fmtMoney(a.values.perOutcome, cur, true));
        v.append(el('small', undefined, 'per acceptable outcome'));
        box.append(v);
        let n = '';
        let bad = false;
        if (a.breakEvenState === 'never') { n = 'Never breaks even'; bad = true; }
        else if (a.breakEvenState === 'beyond') { n = `Breaks even in month ${fmtMonths(a.values.breakEven)}, after the period`; bad = true; }
        else if (a.breakEvenState === 'inside') n = `Breaks even in month ${fmtMonths(a.values.breakEven)}`;
        else n = `${a.filled}/${ARM_ROWS.length} lines set`;
        box.append(el('span', `n${bad ? ' bad' : ''}`, n));
        const top = a.blocks[0];
        if (top && top.share !== null && top.value !== null && r.complete) {
          box.append(el('span', 'n', `Largest run line: ${top.name.toLowerCase()}, ${Math.round(top.share * 100)}%`));
        }
        return box;
      }),
    );

    for (const row of TOTALS) {
      for (const a of r.arms) {
        const td = $(`t-${row.key}-${a.key}`);
        td.textContent = fmtComputed(row, a.values[row.key as keyof typeof a.values], cur, a.breakEvenState);
        td.classList.toggle('is-lead', row.key === 'perOutcome' && a.key === r.leader);
        td.classList.toggle('bad', (row.key === 'net' && (a.values.net ?? 0) < 0) || (row.key === 'breakEven' && a.breakEvenState === 'never'));
      }
    }

    const fix = $('r-fix');
    fix.hidden = r.checks.length === 0;
    $('r-fixlist').replaceChildren(
      ...r.checks.map((c, i) => {
        const li = el('li');
        li.append(el('span', 'fn', pad(i + 1)));
        li.append(el('div', 'ft', c.text));
        return li;
      }),
    );

    for (const o of OUTCOMES) {
      document.getElementById(`cut-${o.key}`)?.classList.toggle('active', r.outcome?.key === o.key);
    }
  }

  // ---- controls -----------------------------------------------------------

  $('blank').addEventListener('click', () => {
    state = blankInputs();
    writeInputs();
    update();
    $('section-1').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  function loadExample() {
    state = JSON.parse(JSON.stringify(EXAMPLE)) as ModelInputs;
    writeInputs();
    update();
    showTab('model');
    $('section-1').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  $('load-example').addEventListener('click', loadExample);
  $('load-example-2').addEventListener('click', loadExample);

  $('print').addEventListener('click', () => window.print());

  function modelText(): string {
    const r = readModel(state);
    const cur = state.currency;
    const lines: string[] = [`${TOOL_NAME} — learning.thelivingcraft.ai/resources/run-cost-model`, ''];
    if (isExample()) lines.push('Reference example: an ordering agent across 40 sites, unchanged.', '');
    lines.push(`Currency: ${cur || '(not set)'}`, '');
    const cols = (cells: string[]) => cells.map((c, i) => (i === 0 ? c.padEnd(44) : c.padStart(16))).join('');
    for (const s of SECTIONS) {
      lines.push(`${s.num}  ${s.name}`);
      if (s.scope === 'arm') lines.push(cols(['', ...ARMS.map((a) => a.short)]));
      for (const row of s.inputs) {
        const label = `${row.forgotten ? '* ' : ''}${row.label} (${unitOf(row.kind, cur)})`;
        if (s.scope === 'shared') lines.push(cols([label, fmtInput(state.shared[row.key as SharedKey])]));
        else lines.push(cols([label, ...ARMS.map((a) => fmtInput(state.arms[a.key][row.key as ArmRowKey]))]));
      }
      for (const row of s.computed) {
        if (s.scope === 'shared') lines.push(cols([`= ${row.label}`, fmtComputed(row, r.shared.values[row.key as keyof typeof r.shared.values], cur)]));
        else lines.push(cols([`= ${row.label}`, ...r.arms.map((a) => fmtComputed(row, a.values[row.key as keyof typeof a.values], cur, a.breakEvenState))]));
      }
      lines.push('');
    }
    lines.push('Totals', cols(['', ...ARMS.map((a) => a.short)]));
    for (const row of TOTALS) {
      lines.push(cols([row.label, ...r.arms.map((a) => fmtComputed(row, a.values[row.key as keyof typeof a.values], cur, a.breakEvenState))]));
    }
    lines.push('');
    if (r.outcome) {
      lines.push(`Outcome: ${r.outcome.name}`);
      if (r.leader) lines.push(`Leading option: ${armByKey(r.leader).name}`);
      lines.push(r.outcome.what);
      for (const f of r.flags) lines.push(`Flag: ${f.text}`);
      if (r.checks.length) lines.push('', 'Check these assumptions first:');
      r.checks.forEach((c, i) => lines.push(`${pad(i + 1)}  ${c.text}`));
    } else {
      lines.push(`Incomplete: ${r.totalInputs - r.filled} lines blank. A blank is unknown, not zero.`);
    }
    lines.push('', '* = one of the nine lines teams leave out');
    return lines.join('\n');
  }

  async function copyModel() {
    const status = $('copied');
    try {
      await navigator.clipboard.writeText(modelText());
      status.textContent = 'Model copied';
    } catch {
      status.textContent = 'Copy blocked by the browser. Use Print instead.';
    }
    setTimeout(() => (status.textContent = ''), 4000);
  }
  $('copy').addEventListener('click', copyModel);
  $('copy2').addEventListener('click', () => {
    copyModel();
    $('copied').scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  // ---- the PDF ------------------------------------------------------------

  const dialog = document.getElementById('pdf-dialog') as HTMLDialogElement;
  const form = document.getElementById('pdf-form') as HTMLFormElement;
  const pdfStatus = $('pdf-status');
  const submit = document.getElementById('pdf-submit') as HTMLButtonElement;
  const cancel = $('pdf-cancel');

  function openPdf() {
    pdfStatus.textContent = '';
    pdfStatus.className = 'pdf-status';
    submit.disabled = false;
    cancel.textContent = 'Cancel';
    if (typeof dialog.showModal === 'function') dialog.showModal();
    else dialog.setAttribute('open', '');
  }
  $('pdf').addEventListener('click', openPdf);
  $('pdf2').addEventListener('click', openPdf);
  cancel.addEventListener('click', () => dialog.close());

  function say(text: string, kind: 'ok' | 'err' | '') {
    pdfStatus.textContent = text;
    pdfStatus.className = `pdf-status${kind ? ` ${kind}` : ''}`;
  }

  function download(base64: string, filename: string) {
    const bin = atob(base64);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    const url = URL.createObjectURL(new Blob([bytes], { type: 'application/pdf' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 60_000);
  }

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    if (!name || !email) {
      say('Both fields are needed.', 'err');
      return;
    }

    submit.disabled = true;
    say('Building the PDF.', '');

    // One key per attempt. A retry after a network error is a new attempt; a
    // repeat click while this one runs is stopped by the disabled button.
    const requestKey =
      typeof crypto.randomUUID === 'function'
        ? crypto.randomUUID()
        : `${Date.now()}-${Math.random().toString(16).slice(2)}`;

    try {
      const res = await fetch('/api/pipeline/resource-pdf', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          resource: 'run-cost-model',
          requestKey,
          answers: { name, email },
          botcheck: String(data.get('botcheck') ?? ''),
          inputs: state,
          isExample: isExample(),
          search: location.search,
          referrer: document.referrer,
          entryPath: location.pathname,
        }),
      });
      const body = await res.json().catch(() => ({}));

      if (!res.ok || !body.ok || typeof body.pdf !== 'string') {
        const errs = Array.isArray(body.errors) ? body.errors.map((e: { message: string }) => e.message).join(' ') : '';
        say(errs || body.error || 'We could not build the PDF just now. Use Print on the page instead.', 'err');
        submit.disabled = false;
        return;
      }

      download(body.pdf, body.filename || 'run-cost-model.pdf');
      cancel.textContent = 'Close';
      say(`Your PDF is downloading. ${(body.saved ? body.delivery : body.note) ?? ''}`.trim(), 'ok');
    } catch {
      say('The request did not reach the server. Check the connection and try again, or use Print.', 'err');
      submit.disabled = false;
    }
  });

  // Nothing is stored between visits, so the fields start blank; the browser
  // may restore typed values on a back-navigation, and this reads them.
  for (const e of inputs) {
    const v = parseCell(e.value);
    if (v === null) continue;
    if (e.dataset.scope === 'shared') state.shared[e.dataset.key as SharedKey] = v;
    else state.arms[e.dataset.arm as ArmKey][e.dataset.key as ArmRowKey] = v;
  }
  state.currency = currencyInput.value.slice(0, 12);
  update();
</script>
