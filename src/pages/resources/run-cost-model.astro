     between them do nothing useful and are hidden. */
  .tool:not(.js) .stepnav [data-go], .tool:not(.js) .p-step, .tool:not(.js) #blank, .tool:not(.js) #blank-start, .tool:not(.js) #blank-start-2 { display: none; }

  /* ── the loaded example ───────────────────────────────────────────────── */
  .example-notice {
    background: var(--surface-sunken);
    border-radius: var(--radius-card);
    padding: var(--space-5) var(--space-6);
    margin-bottom: var(--space-6);
