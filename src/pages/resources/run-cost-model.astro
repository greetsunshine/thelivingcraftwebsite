---
// /resources/run-cost-model — The Run-Cost Model Tool, self-hosted.
//
// Until 17 September 2026 this was an Excel workbook in public/downloads. It
// is now a page in the same shape as the POC Selection Tool, which is the
// reference for every tool here: one framed shell, a sticky score bar and
// progress bar, one step per section, a result step, and an email-gated PDF
// that is checked before it is handed over.
//
// THE TOOL IS NINE STEPS: Start, the seven sections, and the result. One step
// is on screen at a time. The steps are only hidden by the script: without
// JavaScript, and in print, every step is on the page in order, so a crawler
// and a printer see the whole tool. Step state is a number in the closure.
//
// THE REFERENCE EXAMPLE IS LOADED WHEN YOU ARRIVE. Eighty-three lines is a lot
// to face blank, so the page opens on the ordering agent across 40 sites with
// every line filled, says so in the bar and on the Start step, and lets you
// change any figure or start from a blank model. The example values and every
// worked-out line are rendered on the server, so the filled model is readable
// with no script at all. The Excel workbook, with the same rows and formulas,
// is offered on the Start step for anyone who would rather fill it offline.
//
// Inputs are a closure and die with the tab. No localStorage, no
// sessionStorage. The one thing that leaves the browser is the PDF request:
// name, email and the inputs go to /api/pipeline/resource-pdf, which checks
// the file before anything is saved, records the person, builds the PDF from
// the same data module this page renders from, and hands it back with the
// list of checks it passed. The inputs are used for the file and not stored.
//
// Every string here comes from src/data/run-cost-model.ts. The page's script
// imports that module too (Vite bundles it), so the bar, every computed line,
// the result and (on the server) the PDF all read one set of formulas.
import ResourcesLayout from '../../layouts/ResourcesLayout.astro';
import ResourceCredit from '../../components/ResourceCredit.astro';
import { SITE_ORIGIN } from '../../data/facts';
import { publishedResources, longDate } from '../../data/resources';
import {
  TOOL_NAME,
  PURPOSE,
  HOW_TO_USE,
  HOW_TO_RUN,
  EXAMPLE_NOTICE,
  LIMITS,
  ARMS,
  ARMS_NOTE,
  SECTIONS,
  TOTALS,
  FORGOTTEN_ROWS,
  INPUT_COUNT,
  OUTCOMES,
  EXAMPLE,
  readModel,
  unitOf,
  fmtInput,
  fmtComputed,
  fmtMoney,
  fmtMonths,
  type SharedKey,
  type ArmRowKey,
  type ArmComputedKey,
} from '../../data/run-cost-model';
import { RESOURCE_FIELDS } from '../../lib/pipeline/resources';

const meta = publishedResources.find((r) => r.id === 'run-cost-model')!;
const WORKBOOK = '/downloads/agent-run-cost-model.xlsx';

const title = `${TOOL_NAME} — what an AI agent costs to run, against three cheaper ways to do the same job · The Living Craft`;
const description =
  'An interactive cost model for an agent proposal. Four options side by side over one period: a rules workflow, the same rules rebuilt on a written spec, a model-assisted draft, and a full agent with tools. Build cost kept apart from run cost, quality beside cost, and the nine operating lines most business cases leave out. Every line is worked out as you type; the result names the option with the lowest cost per acceptable outcome.';

const schema = [
  {
    '@type': 'HowTo',
    '@id': `${SITE_ORIGIN}/resources/run-cost-model#howto`,
    name: TOOL_NAME,
    description,
    url: `${SITE_ORIGIN}/resources/run-cost-model`,
    author: { '@id': `${SITE_ORIGIN}/#person` },
    datePublished: meta.publishedAt,
    isAccessibleForFree: true,
    step: SECTIONS.map((s) => ({
      '@type': 'HowToSection',
      position: s.num,
      name: s.name,
      description: s.blurb,
      itemListElement: s.inputs.map((it, j) => ({
        '@type': 'HowToStep',
        position: j + 1,
        name: it.label,
        text: it.why,
      })),
    })),
  },
];

// The reference example is the initial state. Worked out here so every
// computed line and the result render on the server, filled in.
const ex = readModel(EXAMPLE);
const cur = EXAMPLE.currency;
const exLead = ex.arms.find((a) => a.key === ex.leader) ?? null;

// The nine steps, in order. The script and the progress bar both read this
// list from the DOM, so the markup is the one place the order is written.
const steps = [
  { key: 'start', dot: '0', name: 'Start' },
  ...SECTIONS.map((s) => ({ key: `s${s.num}`, dot: String(s.num), name: s.short })),
  { key: 'result', dot: '✓', name: 'Result' },
];
const STEP_COUNT = steps.length;

const nameField = RESOURCE_FIELDS.find((f) => f.name === 'name')!;
const emailField = RESOURCE_FIELDS.find((f) => f.name === 'email')!;

const breakEvenNote = (a: (typeof ex.arms)[number]) =>
  a.breakEvenState === 'never'
    ? 'Never breaks even'
    : a.breakEvenState === 'beyond'
      ? `Breaks even in month ${fmtMonths(a.values.breakEven)}, after the period`
      : a.breakEvenState === 'inside'
        ? `Breaks even in month ${fmtMonths(a.values.breakEven)}`
        : `${a.filled}/19 lines set`;
---

<ResourcesLayout title={title} description={description} canonical="/resources/run-cost-model" schema={schema}>
  <!-- Hero -->
  <section class="hero" id="top" style="border-top:0">
    <div class="wrap">
      <div class="eyebrow">
        <a href="/resources" class="crumb">Resources</a>
        <span class="num">/ {meta.series.toLowerCase()} {meta.number}</span>
      </div>
      <h1>{TOOL_NAME}</h1>
      <p class="lead">
        Put a number on an agent proposal <em>before</em> anyone commits to building it. Four ways
        of doing the same job, costed side by side in seven short steps, with the operating lines
        most business cases leave out. The number it lands on is cost per acceptable outcome.
      </p>
      <p class="hero-note mono">
        {ARMS.length} options · {SECTIONS.length} sections · {INPUT_COUNT} lines · reference example loaded
      </p>
      <ResourceCredit />
    </div>
  </section>

  {/* The tool, inside one framed shell. Everything the score bar has to stay
      above lives inside this element: a sticky element only sticks within its
      parent. The frame is the tool's edge, so the page's section rhythm stops
      at it and the steps use `.inner` for their gutters, not `.wrap`. */}
  <section class="tool-section">
  <div class="wrap">
  <div class="tool" id="tool" data-step="0">
    <div class="scorebar-wrap">
      <div class="inner">
        <div class="scorebar" id="verdict" data-b={ex.outcome?.key ?? 'none'} role="status" aria-live="polite">
          <div class="sb-score">
            <span id="lead-cost">{exLead ? fmtMoney(exLead.values.perOutcome, cur, true) : '—'}</span>
            <span class="of" id="lead-of">{exLead ? `per acceptable outcome, ${exLead.short}` : 'per acceptable outcome'}</span>
          </div>
          <div class="sb-text">
            <span class="band" id="band">{ex.outcome?.name ?? 'Not started'}</span>
            <span class="sb-note" id="note">{EXAMPLE_NOTICE.lead} Change any figure to make the model yours.</span>
          </div>
          <div class="sb-secs mono" aria-label="Cost per acceptable outcome by option">
            {ex.arms.map((a) => (
              <span class={`sb-sec${a.key === ex.leader ? ' is-lead' : ''}`} id={`pill-${a.key}`} title={`${a.name}: ${ARMS.find((x) => x.key === a.key)!.legend}`}>
                {a.short} <b id={`pill-v-${a.key}`}>{fmtMoney(a.values.perOutcome, cur, true)}</b>
              </span>
            ))}
          </div>
        </div>

        {/* The progress bar. The fill is lines set out of 83; the pips are the
            nine steps, and each one is a button that jumps there. */}
        <div class="progress" aria-label="Progress">
          <div class="p-track" role="progressbar" aria-valuemin="0" aria-valuemax={INPUT_COUNT} aria-valuenow={ex.filled} id="p-track">
            <div class="p-fill" id="p-fill" style={`width:${(ex.filled / INPUT_COUNT) * 100}%`}></div>
          </div>
          <div class="p-row">
            <ol class="p-steps" id="p-steps">
              {steps.map((s, i) => (
                <li>
                  <button type="button" class="p-step" data-go={i} aria-current={i === 0 ? 'step' : undefined}>
                    <span class="p-dot mono">{s.dot}</span>
                    <span class="p-label">{s.name}</span>
                  </button>
                </li>
              ))}
            </ol>
            <span class="p-text mono" id="p-text">Step 1 of {STEP_COUNT} · {ex.filled} of {INPUT_COUNT} lines set</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Step 0: start -->
    <section class="step" id="step-start" data-index="0">
      <div class="inner">
        <div class="stepnav top">
          <span class="stepnote mono">Nine steps. About twenty minutes with your own figures.</span>
          <button class="btn btn-primary" type="button" data-go="1">Start with the example&nbsp;<span class="arrow">→</span></button>
        </div>

        <div class="example-notice" id="example-notice">
          <span class="eyebrow"><span class="num">Loaded</span> Reference example</span>
          <p><strong>{EXAMPLE_NOTICE.lead}</strong> {EXAMPLE_NOTICE.rest}</p>
          <div class="notice-actions">
            <button class="btn btn-ghost" id="blank-start" type="button">Start from a blank model</button>
            <a class="btn btn-ghost" href={WORKBOOK} download>Download Excel version&nbsp;<span class="arrow">↓</span></a>
          </div>
        </div>

        <div class="about">
          <div class="about-col">
            <span class="eyebrow"><span class="num">01</span> What this tool is for</span>
            <ul class="plain">
              {PURPOSE.map((p) => <li>{p}</li>)}
            </ul>
          </div>
          <div class="about-col">
            <span class="eyebrow"><span class="num">02</span> How to use it</span>
            <ol class="steps">
              {HOW_TO_USE.map((p) => <li>{p}</li>)}
            </ol>
          </div>
        </div>

        <div class="arms" aria-label="The four options being compared">
          {ARMS.map((a) => (
            <div class="arm">
              <span class="armname">{a.name}</span>
              <p class="armwhat">{a.what}</p>
            </div>
          ))}
        </div>
        <p class="arms-note">{ARMS_NOTE}</p>

        <div class="rules">
          <div class="sec-head">
            <span class="eyebrow"><span class="num">03</span> Rules for using it in a budget conversation</span>
            <h2 class="step-title" tabindex="-1">Five rules that decide whether the number is <em>evidence</em> or a guess.</h2>
          </div>
          <ol class="howto">
            {HOW_TO_RUN.map((h) => (
              <li>
                <strong>{h.lead}</strong> {h.rest}
              </li>
            ))}
          </ol>
        </div>

        <div class="stepnav">
          <button class="btn btn-primary" type="button" data-go="1">Start with the example&nbsp;<span class="arrow">→</span></button>
          <button class="btn btn-ghost" id="blank-start-2" type="button">Start from a blank model</button>
        </div>
      </div>
    </section>

    <!-- Steps 1 to 7: the sections -->
    {SECTIONS.map((s) => (
      <section id={`step-s${s.num}`} class="step qsection" data-index={s.num}>
        <div class="inner">
          <div class="stepnav top">
            <button class="btn btn-ghost" type="button" data-go={s.num - 1}>← Back</button>
            <span class="stepnote mono">Step {s.num + 1} of {STEP_COUNT}</span>
            <button class="btn btn-primary" type="button" data-go={s.num + 1}>
              {s.num < SECTIONS.length ? 'Next' : 'See the result'}&nbsp;<span class="arrow">→</span>
            </button>
          </div>
          <div class="shead">
            <span class="sletter">{s.num}</span>
            <div class="stitle">
              <h2 class="sname step-title" tabindex="-1">{s.name}</h2>
              <p class="squestion">{s.question}</p>
            </div>
            <span class="ssub mono">{s.scope === 'shared' ? 'shared by all four options' : 'one value per option'}</span>
          </div>
          <p class="sblurb">{s.blurb}</p>

          <div class={`grid ${s.scope}`}>
            {s.num === 1 && (
              <div class="grow input">
                <div class="glabel">
                  <label for="in-currency">Currency label</label>
                  <span class="gunit mono">free text</span>
                  <p class="gwhy">Such as INR or USD. Shown in front of every money figure. Not counted as a line.</p>
                </div>
                <span class="gcell">
                  <input type="text" id="in-currency" maxlength="12" placeholder="e.g. INR" autocomplete="off" value={EXAMPLE.currency} class="set" />
                </span>
              </div>
            )}
            {s.scope === 'arm' && (
              <div class="grow ghead">
                <span class="glabel"></span>
                {ARMS.map((a) => (
                  <span class="garm">
                    <b class="mono">{a.short}</b>
                    <small class="glegend">{a.legend}</small>
                  </span>
                ))}
              </div>
            )}
            {s.inputs.map((row) => (
              <div class={`grow input${row.forgotten ? ' forgot' : ''}`}>
                <div class="glabel">
                  {s.scope === 'shared' ? (
                    <label for={`in-${row.key}`}>{row.label}</label>
                  ) : (
                    <span class="glabel-t" id={`lbl-${row.key}`}>{row.label}</span>
                  )}
                  <span class="gunit mono" data-kind={row.kind}>{unitOf(row.kind, cur)}</span>
                  {row.forgotten && <span class="gforgot mono">often left out</span>}
                  <p class="gwhy">{row.why}</p>
                </div>
                {s.scope === 'shared' ? (
                  <span class="gcell">
                    <input
                      type="number"
                      id={`in-${row.key}`}
                      class="set"
                      data-scope="shared"
                      data-key={row.key}
                      min="0"
                      step="any"
                      inputmode="decimal"
                      value={EXAMPLE.shared[row.key as SharedKey]}
                      placeholder={`e.g. ${fmtInput(EXAMPLE.shared[row.key as SharedKey])}`}
                    />
                  </span>
                ) : (
                  ARMS.map((a) => (
                    <span class="gcell">
                      <span class="cellarm mono" aria-hidden="true" title={a.legend}>{a.short}</span>
                      <input
                        type="number"
                        id={`in-${a.key}-${row.key}`}
                        class="set"
                        data-scope="arm"
                        data-arm={a.key}
                        data-key={row.key}
                        min="0"
                        step="any"
                        inputmode="decimal"
                        value={EXAMPLE.arms[a.key][row.key as ArmRowKey]}
                        placeholder={`e.g. ${fmtInput(EXAMPLE.arms[a.key][row.key as ArmRowKey])}`}
                        aria-label={`${row.label}, ${a.name}`}
                      />
                    </span>
                  ))
                )}
              </div>
            ))}
            {s.computed.map((row) => (
              <div class="grow computed">
                <div class="glabel">
                  <span class="glabel-c">{row.label}</span>
                  <p class="gwhy">{row.why}</p>
                </div>
                {s.scope === 'shared' ? (
                  <output class="gcell out mono has" id={`c-${row.key}`} aria-label={row.label}>
                    {fmtComputed(row, ex.shared.values[row.key as keyof typeof ex.shared.values], cur)}
                  </output>
                ) : (
                  ex.arms.map((a) => (
                    <output class="gcell out mono has" id={`c-${row.key}-${a.key}`} aria-label={`${row.label}, ${a.name}`}>
                      {fmtComputed(row, a.values[row.key as ArmComputedKey], cur, a.breakEvenState)}
                    </output>
                  ))
                )}
              </div>
            ))}
          </div>

          <div class="stepnav">
            <button class="btn btn-ghost" type="button" data-go={s.num - 1}>← Back</button>
            <span class="stepnote mono" id={`stepnote-${s.num}`}></span>
            <button class="btn btn-primary" type="button" data-go={s.num + 1}>
              {s.num < SECTIONS.length ? 'Next' : 'See the result'}&nbsp;<span class="arrow">→</span>
            </button>
          </div>
        </div>
      </section>
    ))}

    <!-- Step 8: the result -->
    <section class="step" id="step-result" data-index={STEP_COUNT - 1}>
      <div class="inner">
        <div class="stepnav top">
          <button class="btn btn-ghost" type="button" data-go={STEP_COUNT - 2}>← Back</button>
          <span class="stepnote mono">Step {STEP_COUNT} of {STEP_COUNT}</span>
          <button class="btn btn-ghost" type="button" data-go="1">Change a figure</button>
        </div>
        <div class="sec-head">
          <span class="eyebrow"><span class="num">04</span> Your result</span>
          <h2 class="step-title" tabindex="-1">The outcome, read against the <em>rubric</em>.</h2>
        </div>
        <div class="resultcard" id="resultcard" data-b={ex.outcome?.key ?? 'none'}>
          <div class="r-head">
            <span class="r-band" id="r-band">{ex.outcome?.name ?? 'Not started'}</span>
            <span class="r-lead mono" id="r-lead">{exLead ? `Leading option: ${exLead.name} · ${fmtMoney(exLead.values.perOutcome, cur, true)} per acceptable outcome` : ''}</span>
          </div>
          <p class="r-example mono" id="r-example">{EXAMPLE_NOTICE.lead} These are the example's numbers, not yours.</p>
          <p class="r-what" id="r-what">{ex.outcome?.what}</p>
          <ul class="r-flags" id="r-flags">
            {ex.flags.map((f) => <li class={f.key}>{f.text}</li>)}
          </ul>
          <div class="r-secs" id="r-secs">
            {ex.arms.map((a) => (
              <div class={`r-sec${a.key === ex.leader ? ' is-lead' : ''}`}>
                <span class="k">{a.name}</span>
                <span class="v">{fmtMoney(a.values.perOutcome, cur, true)}<small>per acceptable outcome</small></span>
                <span class={`n${a.breakEvenState === 'never' || a.breakEvenState === 'beyond' ? ' bad' : ''}`}>{breakEvenNote(a)}</span>
                {a.blocks[0]?.share !== null && a.blocks[0]?.value !== null && (
                  <span class="n">Largest run line: {a.blocks[0].name.toLowerCase()}, {Math.round((a.blocks[0].share ?? 0) * 100)}%</span>
                )}
              </div>
            ))}
          </div>

          <table class="rtable" id="r-table">
            <thead>
              <tr>
                <th scope="col"><span class="visually-hidden">Line</span></th>
                {ARMS.map((a) => <th scope="col">{a.short}<small class="thlegend">{a.legend}</small></th>)}
              </tr>
            </thead>
            <tbody>
              {TOTALS.map((row) => (
                <tr class={row.key === 'perOutcome' ? 'key' : ''}>
                  <th scope="row">{row.label}<span class="twhy">{row.why}</span></th>
                  {ex.arms.map((a) => (
                    <td
                      class={`mono${a.key === ex.leader && row.key === 'perOutcome' ? ' is-lead' : ''}${(row.key === 'net' && (a.values.net ?? 0) < 0) || (row.key === 'breakEven' && a.breakEvenState === 'never') ? ' bad' : ''}`}
                      id={`t-${row.key}-${a.key}`}
                    >
                      {fmtComputed(row, a.values[row.key as ArmComputedKey], cur, a.breakEvenState)}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>

          <div class="r-fix" id="r-fix" hidden={ex.checks.length === 0}>
            <h3>Check these assumptions first</h3>
            <p class="r-fixlead">The leading option first, then the full agent, then the rest. Each one is a line that decides the answer and is usually guessed.</p>
            <ol id="r-fixlist">
              {ex.checks.map((c, i) => (
                <li>
                  <span class="fn">{String(i + 1).padStart(2, '0')}</span>
                  <div class="ft">{c.text}</div>
                </li>
              ))}
            </ol>
          </div>
          <div class="r-actions" role="group" aria-label="Model controls">
            <button class="btn btn-primary" id="pdf" type="button">Get the PDF</button>
            <button class="btn btn-ghost" id="blank" type="button">New model</button>
          </div>
        </div>

        <div class="rubric">
          <div class="sec-head">
            <span class="eyebrow"><span class="num">05</span> How the outcome is read</span>
            <h2>Agree this <em>before</em> the numbers go in, not after.</h2>
          </div>
          <p class="prose-lead">
            The leading option is the one with the lowest cost per acceptable outcome among the
            options that save money against the manual baseline over the period. The row that
            matches your result is highlighted.
          </p>
          {OUTCOMES.map((o) => (
            <div class={`cutrow${ex.outcome?.key === o.key ? ' active' : ''}`} id={`cut-${o.key}`} data-b={o.key}>
              <div class="cutscore">{o.when}</div>
              <div class="cutname">{o.name}</div>
              <div class="cutwhat">{o.what}</div>
            </div>
          ))}
          <p class="prose-lead flags-lead">
            Three flags sit beside the outcome and do not change it. <strong>Disagreement:</strong> cost
            per case and cost per acceptable outcome pick different options. <strong>Never breaks
            even:</strong> an option costs more to run each month than doing it by hand. <strong>Beyond
            the period:</strong> an option pays back, but after the months you modelled.
          </p>
        </div>

        <div class="stepnav">
          <button class="btn btn-ghost" type="button" data-go={STEP_COUNT - 2}>← Back</button>
          <button class="btn btn-ghost" type="button" data-go="1">Change a figure</button>
        </div>
      </div>
    </section>
  </div>
  </div>
  </section>

  <!-- The nine lines -->
  <section id="forgotten">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><span class="num">06</span> The nine lines teams leave out</span>
        <h2>The model bill is usually the <em>smallest</em> line.</h2>
      </div>
      <p class="prose-lead">
        Each of these is marked <span class="gforgot mono inline">often left out</span> in the model above.
        Together they are most of what it costs to run an agent, and none of them appears in a demo.
      </p>
      {FORGOTTEN_ROWS.map((row, i) => (
        <div class="move">
          <div class="mnum mono">{String(i + 1).padStart(2, '0')}</div>
          <div class="mbody">
            <h3 class="mname">{row.label}</h3>
            <p>{row.why}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Close -->
  <section class="final">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><span class="num">07</span> What this model does not price</span>
        <h2>A number you can take to a budget conversation. Not the <em>whole</em> argument.</h2>
      </div>
      <ul class="plain limits">
        {LIMITS.map((l) => <li>{l}</li>)}
      </ul>
      <div class="prose">
        <p>
          An agent proposal is also a commitment to operate an agent. This tool turns that sentence
          into a number. Sometimes the number says build it. The reference example is a case where it
          did not, and where the build was still worth doing, because it produced the written
          specification that made the cheap option good.
        </p>
      </div>
      <p class="hero-cta">
        <a class="btn btn-primary" href="/">See the cohort&nbsp;<span class="arrow">→</span></a>
        <a class="btn btn-ghost" href="/resources">All resources&nbsp;<span class="arrow">→</span></a>
        <a class="btn btn-ghost" href={WORKBOOK} download>Download Excel version&nbsp;<span class="arrow">↓</span></a>
      </p>
      <p class="mono faint pubdate">Published {longDate(meta.publishedAt)} · free to use and to pass on</p>
    </div>
  </section>

  {/* The PDF request. A native dialog: focus is trapped, Escape closes it,
      and nothing else on the page needs a script to make that true. */}
  <dialog class="pdf-dialog" id="pdf-dialog" aria-labelledby="pdf-title">
    <form method="dialog" id="pdf-form" novalidate>
      <span class="eyebrow"><span class="num">PDF</span> Your model</span>
      <h2 id="pdf-title">Get the PDF</h2>
      <p class="pdf-lead">
        The PDF carries every line you typed, every total, the outcome and the assumptions to check.
        It is built against a name and an email address, and checked before it is handed over.
      </p>
      <div class="pdf-grid">
        <label>
          {nameField.label}
          <input type="text" name="name" autocomplete={nameField.autocomplete} maxlength={nameField.max} required />
        </label>
        <label>
          {emailField.label}
          <input type="email" name="email" autocomplete={emailField.autocomplete} maxlength={emailField.max} required />
        </label>
      </div>
      <input class="hp" type="text" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <p class="pdf-note">
        Your figures go into the file and are not stored. Your address is used to send you this
        tool once. It does not start any other email.
      </p>
      <p class="pdf-status" id="pdf-status" role="status" aria-live="polite"></p>
      <ul class="pdf-checks mono" id="pdf-checks" hidden></ul>
      <div class="pdf-actions">
        <button class="btn btn-primary" id="pdf-submit" type="submit">Build the PDF</button>
        <button class="btn btn-ghost" id="pdf-cancel" type="button">Cancel</button>
      </div>
    </form>
  </dialog>
</ResourcesLayout>

<style>
  /* ── the frame ────────────────────────────────────────────────────────── */
  /* One white shell on the mist ground, the app-shell radius and the overlay
