  /* ── about ────────────────────────────────────────────────────────────── */
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }
  .about-col {
    background: var(--surface-sunken);
    border-radius: var(--radius-card);
