  }
  .thlegend { margin-top: 2px; }
  .glabel { min-width: 0; }
  .glabel label, .glabel-t, .glabel-c { display: block; font-weight: var(--weight-strong); line-height: var(--lh-snug); }
  .glabel-c { color: var(--text-quiet); }
  .gunit { display: inline-block; margin-top: 2px; margin-right: var(--space-2); font-size: var(--size-1); color: var(--text-quiet); }
  .gforgot {
