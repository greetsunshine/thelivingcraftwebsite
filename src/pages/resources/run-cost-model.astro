  .stitle { min-width: 0; }
  .sname { font-size: var(--size-6); line-height: var(--lh-tight); margin: 0; }
  .squestion { margin: var(--space-1) 0 0; font-size: var(--size-3); color: var(--text-quiet); }
  .ssub {
