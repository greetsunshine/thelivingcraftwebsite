  .cellarm { display: none; font-size: var(--size-1); color: var(--text-quiet); }
  /* Answer fields are white on the mist card, and a filled one is sun: the
     same rule as the reference's anchors, yellow means the value is yours. */
  .grid input {
    font-family: var(--font-mono);
    font-size: var(--size-2);
    color: var(--text-body);
    background: var(--surface-panel);
    border: var(--border-w-rule) solid transparent;
    border-radius: var(--radius-field);
    padding: 0 var(--space-3);
    height: 40px;
    width: 100%;
    min-width: 0;
    text-align: right;
  }
  .grid input[type='text'] { text-align: left; }
  .grid input::placeholder { color: var(--text-quiet); opacity: 0.7; }
  .grid input:focus { outline: none; border-color: var(--text-body); }
  .grid input:focus-visible { outline: var(--focus-w) solid var(--focus-ring); outline-offset: var(--focus-offset); }
  .grid input.set { background: var(--surface-sun); color: var(--text-on-accent); }
  .grow.computed { background: var(--surface-panel); margin: 0 calc(-1 * var(--space-5)); padding-left: var(--space-5); padding-right: var(--space-5); }
  .out {
    display: block;
    text-align: right;
    padding: 9px var(--space-3) 0 0;
    font-size: var(--size-2);
    font-weight: var(--weight-strong);
    color: var(--text-quiet);
  }
  .out.has { color: var(--text-body); }

  /* ── the result ───────────────────────────────────────────────────────── */
  .resultcard {
    background: var(--surface-sunken);
    border-radius: var(--radius-card);
    padding: var(--space-6);
    margin-bottom: var(--space-7);
  }
  .r-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--space-2) var(--space-5); margin-bottom: var(--space-2); }
  .r-band {
    font-size: var(--size-6);
    font-weight: var(--weight-heavy);
    letter-spacing: var(--tracking-display);
    line-height: var(--lh-tight);
  }
  .r-lead { font-size: var(--size-1); color: var(--text-quiet); }
  .r-example { margin: 0 0 var(--space-3); font-size: var(--size-1); color: var(--accent-ink); }
  .r-example[hidden] { display: none; }
  .r-what { max-width: var(--measure-prose); margin: 0 0 var(--space-4); }
  .r-flags { list-style: none; padding: 0; margin: 0 0 var(--space-5); display: flex; flex-direction: column; gap: var(--space-2); max-width: var(--measure-prose); }
  .r-flags:empty { display: none; }
  .r-flags :global(li) { font-size: var(--size-2); font-weight: var(--weight-strong); padding-left: var(--space-5); position: relative; }
  .r-flags :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--ink-1);
  }
  .r-flags :global(li.never), .r-flags :global(li.beyond) { color: var(--danger); }
  .r-flags :global(li.never)::before, .r-flags :global(li.beyond)::before { background: var(--danger-mark); }
  .r-secs { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-3); margin-bottom: var(--space-5); }
  /* The boxes and the check rows are rebuilt by the script, so they never
     carry Astro's scoping attribute. `:global()` is what lets these rules
     reach them; the parents stay scoped. */
  .r-secs :global(.r-sec) {
    background: var(--surface-panel);
    border-radius: var(--radius-inner);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .r-secs :global(.r-sec.is-lead) { outline: 2px solid var(--ink-1); }
  .r-secs :global(.r-sec .k) { font-family: var(--font-mono); font-size: var(--size-1); color: var(--text-quiet); }
  .r-secs :global(.r-sec .v) { font-family: var(--font-mono); font-size: var(--size-4); font-weight: var(--weight-strong); }
  .r-secs :global(.r-sec .v small) { display: block; font-size: var(--size-1); color: var(--text-quiet); font-weight: var(--weight-regular); }
  .r-secs :global(.r-sec .n) { font-size: var(--size-1); color: var(--text-quiet); }
  .r-secs :global(.r-sec .n.bad) { color: var(--danger); }

  .rtable { width: 100%; border-collapse: collapse; margin-bottom: var(--space-5); font-size: var(--size-2); }
  .rtable th, .rtable td { padding: var(--space-2) var(--space-3); border-top: 1px solid var(--border-hair); vertical-align: top; text-align: right; }
  .rtable thead th { border-top: 0; font-family: var(--font-mono); font-size: var(--size-1); font-weight: var(--weight-strong); color: var(--text-body); vertical-align: bottom; }
  .rtable tbody th { text-align: left; font-weight: var(--weight-strong); }
  .rtable tbody th .twhy { display: block; font-weight: var(--weight-regular); font-size: var(--size-1); color: var(--text-quiet); max-width: 40ch; }
  .rtable tr.key th, .rtable tr.key td { background: var(--surface-panel); }
  .rtable td.is-lead { font-weight: var(--weight-strong); color: var(--text-loud); }
  .rtable td.bad { color: var(--danger); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .r-fix h3 { font-size: var(--size-4); margin: 0 0 var(--space-1); }
  .r-fixlead { font-size: var(--size-2); color: var(--text-quiet); margin: 0 0 var(--space-3); max-width: var(--measure-prose); }
  .r-fix ol { list-style: none; padding: 0; margin: 0 0 var(--space-5); display: flex; flex-direction: column; }
  .r-fix :global(li) { display: grid; grid-template-columns: 40px 1fr; gap: var(--space-3); padding: var(--space-3) 0; border-top: 1px solid var(--border-hair); font-size: var(--size-2); }
  .r-fix :global(li:last-child) { border-bottom: 1px solid var(--border-hair); }
  .r-fix :global(.fn) { font-family: var(--font-mono); font-size: var(--size-1); color: var(--text-quiet); padding-top: 3px; }
  .r-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: center; }

  /* ── rubric ───────────────────────────────────────────────────────────── */
  .prose-lead { color: var(--text-quiet); max-width: var(--measure-prose); margin-bottom: var(--space-5); }
  .flags-lead { margin-top: var(--space-5); margin-bottom: 0; }
  .flags-lead strong { color: var(--text-body); }
  .cutrow {
    display: grid;
    grid-template-columns: 260px 240px 1fr;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-inner);
    margin-bottom: var(--space-3);
    background: var(--surface-sunken);
    opacity: 0.55;
    transition: opacity var(--motion-base, 160ms) ease;
  }
  .cutrow.active { opacity: 1; background: var(--surface-panel); box-shadow: var(--shadow-raise); }
  .cutscore { font-size: var(--size-2); color: var(--text-quiet); }
  .cutname { font-weight: var(--weight-strong); }
  .cutwhat { font-size: var(--size-2); color: var(--text-quiet); }
  .cutrow[data-b='manual'].active .cutname { color: var(--danger); }
  .cutrow[data-b='rules'].active .cutname, .cutrow[data-b='rules2'].active .cutname { color: var(--accent-ink); }

  /* ── the nine lines ───────────────────────────────────────────────────── */
  .move { display: grid; grid-template-columns: 56px 1fr; gap: var(--space-4); padding: var(--space-4) 0; border-top: 1px solid var(--border-hair); }
  .move:last-of-type { border-bottom: 1px solid var(--border-hair); }
  .mnum { font-size: var(--size-2); color: var(--text-quiet); padding-top: 4px; }
  .mname { font-size: var(--size-4); margin: 0 0 var(--space-1); }
  .mbody p { max-width: var(--measure-prose); margin: 0; font-size: var(--size-2); color: var(--text-quiet); }

  /* ── close ────────────────────────────────────────────────────────────── */
  .limits { max-width: var(--measure-prose); margin: 0 auto var(--space-5); text-align: left; }
  .final .prose { margin-bottom: var(--space-5); }
  .crumb { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .pubdate { margin-top: var(--space-5); font-size: var(--size-1); }

  /* ── the PDF dialog ───────────────────────────────────────────────────── */
  .pdf-dialog {
    margin: auto;
    border: 0;
    padding: 0;
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    overflow: auto;
    background: var(--surface-panel);
    color: var(--text-body);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-overlay);
  }
  .pdf-dialog::backdrop { background: rgba(22, 33, 46, 0.45); }
  .pdf-dialog form { padding: var(--space-6); }
  .pdf-dialog .eyebrow { display: block; margin-bottom: var(--space-3); }
  .pdf-dialog h2 { font-size: var(--size-6); margin: 0 0 var(--space-3); }
  .pdf-lead { margin: 0 0 var(--space-5); }
  .pdf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .pdf-dialog label { display: flex; flex-direction: column; gap: var(--space-1); font-family: var(--font-marginal); font-size: var(--size-1); color: var(--text-quiet); }
  .pdf-dialog input {
    font-family: var(--font-body);
    font-size: var(--size-3);
    color: var(--text-body);
    background: var(--surface-panel);
    border: var(--border-w-rule) solid var(--border-field);
    border-radius: var(--radius-field);
    padding: 0 var(--space-4);
    height: var(--control-h);
    width: 100%;
  }
  .pdf-dialog input:focus { outline: none; border-color: var(--text-body); }
  .pdf-dialog input:focus-visible { outline: var(--focus-w) solid var(--focus-ring); outline-offset: var(--focus-offset); }
  .pdf-dialog .hp { position: absolute !important; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .pdf-note { margin: var(--space-4) 0 0; font-size: var(--size-2); color: var(--text-quiet); }
  .pdf-status { margin: var(--space-3) 0 0; font-size: var(--size-2); min-height: 1.4em; }
  .pdf-status.err { color: var(--danger); }
  .pdf-status.ok { color: var(--text-loud); }
  .pdf-checks {
    list-style: none;
    padding: var(--space-3) var(--space-4);
    margin: var(--space-3) 0 0;
    background: var(--surface-sunken);
    border-radius: var(--radius-inner);
    font-size: var(--size-1);
    color: var(--text-quiet);
    display: flex;
    flex-direction: column;
    gap: 3px;
    max-height: 180px;
    overflow: auto;
  }
  .pdf-checks :global(li) { display: flex; gap: var(--space-2); }
  .pdf-checks :global(li b) { flex: 0 0 5ch; font-weight: var(--weight-strong); color: var(--text-body); }
  .pdf-checks :global(li.fail b) { color: var(--danger); }
  .pdf-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-4); }
  .pdf-dialog button[disabled] { opacity: 0.42; pointer-events: none; }

  @media (max-width: 960px) {
    .grid.arm .grow { grid-template-columns: minmax(0, 1.4fr) repeat(4, minmax(0, 1fr)); }
    .garm { padding-right: var(--space-2); }
  }
  @media (max-width: 860px) {
    .tool { border-radius: var(--radius-panel); }
    .inner { padding: 0 var(--space-4); }
    .about { grid-template-columns: 1fr; }
    .arms { grid-template-columns: 1fr 1fr; }
    /* Stacked: the score line is wide, and beside it the outcome text had an
       80px column and wrapped to eight lines. */
    .scorebar { grid-template-columns: 1fr; gap: var(--space-2); }
    .sb-secs { grid-template-columns: 1fr 1fr; }
    .sb-score { font-size: var(--size-5); white-space: normal; }
    .band { font-size: var(--size-3); }
    .p-label { display: none; }
    .p-step { padding-right: 4px; }
    .p-text { white-space: normal; }
    .shead { grid-template-columns: auto 1fr; }
    .ssub { grid-column: 2; justify-self: start; margin-top: 0; }
    .sblurb { margin-left: 0; }
    .grid.shared .grow, .grid.arm .grow { grid-template-columns: 1fr; }
    .grow.ghead { display: none; }
    .cellarm { display: block; flex: 0 0 72px; }
    .gcell { flex-direction: row; align-items: center; gap: var(--space-3); }
    .out { padding-top: 0; text-align: left; }
    .r-secs { grid-template-columns: 1fr 1fr; }
    .cutrow { grid-template-columns: 1fr; gap: var(--space-2); }
    .pdf-grid { grid-template-columns: 1fr; }
    .stepnav .btn-primary { margin-left: 0; }
    .rtable { display: block; overflow-x: auto; }
  }

  /* ── print: every step, in order, as a model people print ─────────────── */
  @media print {
    .tool.js .step { display: block; }
    .scorebar-wrap { position: static; }
    .tool { box-shadow: none; border: 1px solid var(--border-hair); }
    .resultcard, .about-col, .grid, .arm, .example-notice { border: 1px solid var(--border-hair); }
    .stepnav, .hero-cta, .r-actions, .pdf-dialog, .p-steps, .notice-actions { display: none !important; }
    .grid, .grow, .cutrow, .move, .resultcard { break-inside: avoid; }
    .cutrow { opacity: 1 !important; }
    .grid input { border: 1px solid var(--border-hair); }
    .grid input.set { outline: 2px solid var(--ink-1); }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>

<script>
  // The inputs are one object in this closure, and the step is a number
  // beside it. Never written to localStorage, never posted except inside the
  // PDF request, and gone when the tab closes.
  //
  // This is a module script, so it imports the same data module the page
  // rendered from. The bar, every computed line, the result and (on the
  // server) the PDF all read one set of formulas: `readModel()`.
  import {
    ARM_ROWS,
    EXAMPLE,
    EXAMPLE_NOTICE,
    INPUT_COUNT,
    OUTCOMES,
    SECTIONS,
    TOTALS,
    blankInputs,
    fmtComputed,
    fmtInput,
    fmtMoney,
    fmtMonths,
    readModel,
    unitOf,
    type ArmKey,
    type ArmRowKey,
    type Cell,
    type ModelInputs,
    type RowKind,
    type SharedKey,
  } from '../../data/run-cost-model';

  const $ = (id: string) => document.getElementById(id)!;
  const pad = (n: number) => String(n).padStart(2, '0');

  let state: ModelInputs = blankInputs();

  // ---- the steps ----------------------------------------------------------

  const tool = $('tool');
  const nav = document.querySelector<HTMLElement>('header.nav');
  const bar = document.querySelector<HTMLElement>('.scorebar-wrap');
  const stepEls = [...tool.querySelectorAll<HTMLElement>('.step')];
  const STEP_COUNT = stepEls.length;
  const LAST = STEP_COUNT - 1;
  let step = 0;
  tool.classList.add('js');

  const inputs = Array.from(document.querySelectorAll<HTMLInputElement>('.grid input[type="number"]'));
  const currencyInput = $('in-currency') as HTMLInputElement;

  // Which lines live in which step. Step 0 and the last have none.
  const stepInputs = stepEls.map((el) => [...el.querySelectorAll<HTMLInputElement>('input[type="number"]')]);

  function stepLabel(i: number) {
    if (i === 0) return 'Start';
    if (i === LAST) return 'Result';
    return `${SECTIONS[i - 1].num} ${SECTIONS[i - 1].name}`;
  }

  function goTo(i: number, move = true) {
    step = Math.max(0, Math.min(LAST, i));
    tool.dataset.step = String(step);
    stepEls.forEach((el, k) => el.classList.toggle('current', k === step));
    updateProgress();
    if (!move) return;
    // Scroll so the tool's top sits just under the nav. The score bar is the
    // tool's first child, so the step heading lands directly beneath it.
    const navH = nav?.getBoundingClientRect().height ?? 76;
    const top = tool.getBoundingClientRect().top + window.scrollY;
    window.scrollTo({ top: Math.max(0, top - navH - 8), behavior: 'smooth' });
    stepEls[step].querySelector<HTMLElement>('.step-title')?.focus({ preventScroll: true });
  }

  const valueOf = (el: HTMLInputElement): Cell =>
    el.dataset.scope === 'shared' ? state.shared[el.dataset.key as SharedKey] : state.arms[el.dataset.arm as ArmKey][el.dataset.key as ArmRowKey];

  function updateProgress() {
    const filled = inputs.filter((e) => valueOf(e) !== null).length;
    $('p-fill').style.width = `${(filled / INPUT_COUNT) * 100}%`;
    $('p-track').setAttribute('aria-valuenow', String(filled));
    $('p-text').textContent = `Step ${step + 1} of ${STEP_COUNT} · ${stepLabel(step)} · ${filled} of ${INPUT_COUNT} lines set`;
    document.querySelectorAll<HTMLButtonElement>('.p-step').forEach((b) => {
      const i = Number(b.dataset.go);
      if (i === step) b.setAttribute('aria-current', 'step');
      else b.removeAttribute('aria-current');
      // A section step is "done" once every line in it is set.
      const qs = stepInputs[i];
      b.classList.toggle('done', qs.length > 0 && qs.every((e) => valueOf(e) !== null));
    });
    stepInputs.forEach((qs, i) => {
      if (!qs.length) return;
      const note = document.getElementById(`stepnote-${SECTIONS[i - 1].num}`);
      if (note) note.textContent = `${qs.filter((e) => valueOf(e) !== null).length} of ${qs.length} lines set in this step`;
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) => {
    b.addEventListener('click', () => goTo(Number(b.dataset.go)));
  });

  // ---- inputs -------------------------------------------------------------

  function parseCell(raw: string): Cell {
    const t = raw.trim();
    if (t === '') return null;
    const n = Number(t);
    return Number.isFinite(n) && n >= 0 ? n : null;
  }

  /** The state from the fields, for the first paint and a back-navigation restore. */
  function readInputs() {
    state = blankInputs();
    for (const el of inputs) {
      const v = parseCell(el.value);
      if (el.dataset.scope === 'shared') state.shared[el.dataset.key as SharedKey] = v;
      else state.arms[el.dataset.arm as ArmKey][el.dataset.key as ArmRowKey] = v;
    }
    state.currency = currencyInput.value.slice(0, 12);
  }

  /** The fields from the state, for New model and the loaded example. */
  function writeInputs() {
    currencyInput.value = state.currency;
    for (const el of inputs) {
      const v = valueOf(el);
      el.value = v === null ? '' : String(v);
    }
  }

  const isExample = () => JSON.stringify(state) === JSON.stringify(EXAMPLE);

  // ---- render -------------------------------------------------------------

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  }

  function setOut(id: string, text: string) {
    const o = document.getElementById(id);
    if (!o) return;
    o.textContent = text;
    o.classList.toggle('has', text !== '—');
  }

  function update() {
    const r = readModel(state);
    const cur = state.currency;
    const example = isExample();

    // Fields: a filled one is sun. Units follow the currency label.
    for (const e of inputs) e.classList.toggle('set', e.value.trim() !== '');
    currencyInput.classList.toggle('set', currencyInput.value.trim() !== '');
    document.querySelectorAll<HTMLElement>('.gunit[data-kind]').forEach((u) => {
      u.textContent = unitOf(u.dataset.kind as RowKind, cur);
    });

    // Computed lines under each section.
    for (const s of SECTIONS) {
      for (const row of s.computed) {
        if (s.scope === 'shared') {
          setOut(`c-${row.key}`, fmtComputed(row, r.shared.values[row.key as keyof typeof r.shared.values], cur));
        } else {
          for (const a of r.arms) setOut(`c-${row.key}-${a.key}`, fmtComputed(row, a.values[row.key as keyof typeof a.values], cur, a.breakEvenState));
        }
      }
    }

    // The bar.
    const lead = r.leader ? r.arms.find((a) => a.key === r.leader)! : null;
    const left = r.totalInputs - r.filled;
    $('lead-cost').textContent = lead ? fmtMoney(lead.values.perOutcome, cur, true) : '—';
    $('lead-of').textContent = lead ? `per acceptable outcome, ${lead.short}` : 'per acceptable outcome';
    let bandKey = 'none';
    let bandText = 'Not started';
    let noteText = `${INPUT_COUNT} lines to fill. A blank is unknown, not zero.`;
    if (r.outcome) {
      bandKey = r.outcome.key;
      bandText = r.outcome.name;
      noteText = example
        ? `${EXAMPLE_NOTICE.lead} Change any figure to make the model yours.`
        : lead
          ? `Leading option: ${lead.name}. Net ${fmtMoney(lead.values.net, cur)} against doing it by hand over ${fmtInput(state.shared.months)} months.`
          : 'No option saves money against the manual baseline over the period.';
    } else if (r.filled > 0) {
      bandText = 'In progress';
      noteText = `${left} ${left === 1 ? 'line' : 'lines'} to fill. Each total appears once the lines that feed it are filled.`;
    }
    $('verdict').dataset.b = bandKey;
    $('band').textContent = bandText;
    $('note').textContent = noteText;
    for (const a of r.arms) {
      $(`pill-v-${a.key}`).textContent = fmtMoney(a.values.perOutcome, cur, true);
      $(`pill-${a.key}`).classList.toggle('is-lead', a.key === r.leader);
    }

    // The result step.
    const card = $('resultcard');
    card.dataset.b = bandKey;
    $('r-band').textContent = bandText;
    $('r-lead').textContent = lead ? `Leading option: ${lead.name} · ${fmtMoney(lead.values.perOutcome, cur, true)} per acceptable outcome` : '';
    $('r-example').hidden = !example;
    $('r-what').textContent = r.outcome
      ? r.outcome.what
      : `Fill every one of the ${INPUT_COUNT} lines to read the outcome. Until then this shows each total as soon as the lines that feed it are filled.`;
    $('r-flags').replaceChildren(...r.flags.map((f) => el('li', f.key, f.text)));

    $('r-secs').replaceChildren(
      ...r.arms.map((a) => {
        const box = el('div', `r-sec${a.key === r.leader ? ' is-lead' : ''}`);
        box.append(el('span', 'k', a.name));
        const v = el('span', 'v', fmtMoney(a.values.perOutcome, cur, true));
        v.append(el('small', undefined, 'per acceptable outcome'));
        box.append(v);
        let n = '';
        let bad = false;
        if (a.breakEvenState === 'never') { n = 'Never breaks even'; bad = true; }
        else if (a.breakEvenState === 'beyond') { n = `Breaks even in month ${fmtMonths(a.values.breakEven)}, after the period`; bad = true; }
        else if (a.breakEvenState === 'inside') n = `Breaks even in month ${fmtMonths(a.values.breakEven)}`;
        else n = `${a.filled}/${ARM_ROWS.length} lines set`;
        box.append(el('span', `n${bad ? ' bad' : ''}`, n));
        const top = a.blocks[0];
        if (top && top.share !== null && top.value !== null && r.complete) {
          box.append(el('span', 'n', `Largest run line: ${top.name.toLowerCase()}, ${Math.round(top.share * 100)}%`));
        }
        return box;
      }),
    );

    for (const row of TOTALS) {
      for (const a of r.arms) {
        const td = $(`t-${row.key}-${a.key}`);
        td.textContent = fmtComputed(row, a.values[row.key as keyof typeof a.values], cur, a.breakEvenState);
        td.classList.toggle('is-lead', row.key === 'perOutcome' && a.key === r.leader);
        td.classList.toggle('bad', (row.key === 'net' && (a.values.net ?? 0) < 0) || (row.key === 'breakEven' && a.breakEvenState === 'never'));
      }
    }

    $('r-fix').hidden = r.checks.length === 0;
    $('r-fixlist').replaceChildren(
      ...r.checks.map((c, i) => {
        const li = el('li');
        li.append(el('span', 'fn', pad(i + 1)));
        li.append(el('div', 'ft', c.text));
        return li;
      }),
    );

    for (const o of OUTCOMES) {
      document.getElementById(`cut-${o.key}`)?.classList.toggle('active', r.outcome?.key === o.key);
    }

    updateProgress();
  }

  // ---- controls -----------------------------------------------------------

  // Scroll a line to sit just under the sticky header and put focus in it.
  function revealInput(target: HTMLInputElement) {
    const navH = nav?.getBoundingClientRect().height ?? 76;
    const barH = bar?.getBoundingClientRect().height ?? 0;
    const row = target.closest<HTMLElement>('.grow') ?? target;
    const top = row.getBoundingClientRect().top + window.scrollY;
    window.scrollTo({ top: Math.max(0, top - navH - barH - 12), behavior: 'smooth' });
    target.focus({ preventScroll: true });
  }

  // After a blank line is filled, move on: to the next blank line in this
  // step, else to the next step. A changed or cleared line stays put, so
  // revising a figure does not throw the page around. The pause lets the sun
  // fill land before the move, so the entry is seen to have taken.
  function advanceFrom(target: HTMLInputElement) {
    const qs = stepInputs[step];
    const at = qs.indexOf(target);
    if (at < 0) return;
    const after = qs.slice(at + 1).concat(qs.slice(0, at));
    const next = after.find((e) => valueOf(e) === null);
    window.setTimeout(() => {
      if (next) revealInput(next);
      else if (step < LAST) goTo(step + 1);
    }, 350);
  }

  for (const target of inputs) {
    let blankOnFocus = false;
    target.addEventListener('focus', () => {
      blankOnFocus = valueOf(target) === null;
    });
    target.addEventListener('input', () => {
      const v = parseCell(target.value);
      if (target.dataset.scope === 'shared') state.shared[target.dataset.key as SharedKey] = v;
      else state.arms[target.dataset.arm as ArmKey][target.dataset.key as ArmRowKey] = v;
      update();
    });
    // `change` fires when the value is committed: on Enter or on leaving the field.
    target.addEventListener('change', () => {
      if (blankOnFocus && valueOf(target) !== null) {
        blankOnFocus = false;
        advanceFrom(target);
      }
    });
    target.addEventListener('keydown', (ev) => {
      if (ev.key !== 'Enter') return;
      ev.preventDefault();
      if (blankOnFocus && valueOf(target) !== null) {
        blankOnFocus = false;
        advanceFrom(target);
        return;
      }
      // A revised line: Enter just moves to the next line in the step.
      const qs = stepInputs[step];
      const at = qs.indexOf(target);
      const next = qs[at + 1];
      if (next) next.focus();
    });
  }
  currencyInput.addEventListener('input', () => {
    state.currency = currencyInput.value.slice(0, 12);
    update();
  });

  function startBlank() {
    state = blankInputs();
    writeInputs();
    update();
    goTo(1);
  }
  $('blank').addEventListener('click', startBlank);
  $('blank-start').addEventListener('click', startBlank);
  $('blank-start-2').addEventListener('click', startBlank);

  // The score bar sticks under the nav, and the nav is taller when its links
  // wrap on a narrow screen. Measure it rather than guess.
  function placeBar() {
    if (nav && bar) bar.style.setProperty('--nav-h', `${Math.round(nav.getBoundingClientRect().height)}px`);
  }
  placeBar();
  window.addEventListener('resize', placeBar);

  // ---- the PDF ------------------------------------------------------------

  const dialog = document.getElementById('pdf-dialog') as HTMLDialogElement;
  const form = document.getElementById('pdf-form') as HTMLFormElement;
  const pdfStatus = $('pdf-status');
  const pdfChecks = $('pdf-checks');
  const submit = document.getElementById('pdf-submit') as HTMLButtonElement;
  const cancel = $('pdf-cancel');

  function openPdf() {
    pdfStatus.textContent = '';
    pdfStatus.className = 'pdf-status';
    pdfChecks.hidden = true;
    pdfChecks.replaceChildren();
    submit.disabled = false;
    cancel.textContent = 'Cancel';
    if (typeof dialog.showModal === 'function') dialog.showModal();
    else dialog.setAttribute('open', '');
  }
  $('pdf').addEventListener('click', openPdf);
  cancel.addEventListener('click', () => dialog.close());

  function say(text: string, kind: 'ok' | 'err' | '') {
    pdfStatus.textContent = text;
    pdfStatus.className = `pdf-status${kind ? ` ${kind}` : ''}`;
  }

  function showChecks(checks: { name: string; ok: boolean }[]) {
    if (!Array.isArray(checks) || !checks.length) return;
    pdfChecks.replaceChildren(
      ...checks.map((c) => {
        const li = el('li', c.ok ? undefined : 'fail');
        li.append(el('b', undefined, c.ok ? 'ok' : 'failed'), document.createTextNode(c.name));
        return li;
      }),
    );
    pdfChecks.hidden = false;
  }

  function download(base64: string, filename: string) {
    const bin = atob(base64);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    const url = URL.createObjectURL(new Blob([bytes], { type: 'application/pdf' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 60_000);
  }

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    if (!name || !email) {
      say('Both fields are needed.', 'err');
      return;
    }

    submit.disabled = true;
    say('Checking and building the PDF.', '');

    // One key per attempt. A retry after a network error is a new attempt; a
    // repeat click while this one runs is stopped by the disabled button.
    const requestKey =
      typeof crypto.randomUUID === 'function'
        ? crypto.randomUUID()
        : `${Date.now()}-${Math.random().toString(16).slice(2)}`;

    try {
      const res = await fetch('/api/pipeline/resource-pdf', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          resource: 'run-cost-model',
          requestKey,
          answers: { name, email },
          botcheck: String(data.get('botcheck') ?? ''),
          inputs: state,
          isExample: isExample(),
          search: location.search,
          referrer: document.referrer,
          entryPath: location.pathname,
        }),
      });
      const body = await res.json().catch(() => ({}));

      if (!res.ok || !body.ok || typeof body.pdf !== 'string') {
        const errs = Array.isArray(body.errors) ? body.errors.map((e: { message: string }) => e.message).join(' ') : '';
        say(errs || body.error || 'We could not build the PDF just now. Try again in a moment.', 'err');
        showChecks(body.checks);
        submit.disabled = false;
        return;
      }

      download(body.pdf, body.filename || 'run-cost-model.pdf');
      cancel.textContent = 'Close';

      const checks = Array.isArray(body.checks) ? body.checks : [];
      const passed = checks.filter((c: { ok: boolean }) => c.ok).length;
      const checkLine = checks.length ? ` Checked before download: ${passed} of ${checks.length} checks passed.` : '';
      say(`Your PDF is downloading.${checkLine} ${body.saved ? (body.delivery ?? '') : (body.note ?? '')}`.trim(), 'ok');
      showChecks(checks);
    } catch {
      say('The request did not reach the server. Check the connection and try again.', 'err');
      submit.disabled = false;
    }
  });

  // The fields arrive filled with the reference example from the server, and
  // a back-navigation may restore typed values. Read them rather than assume.
  readInputs();
  update();
  goTo(0, false);
</script>
