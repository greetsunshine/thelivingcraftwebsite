  .legend { display: grid; gap: var(--space-2); max-width: 78ch; margin-bottom: var(--space-5); }
  .legend-row { display: grid; grid-template-columns: auto 1fr; gap: var(--space-4); align-items: baseline; }
  .legend dd { color: var(--text-quiet); font-size: var(--size-2); }
  .caction {
