  }
  .adc :global(.step[data-standing='not-yet-defined']) {
    background: var(--state-unwritten-bg);
  }
  .adc :global(.step-head) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .adc :global(.badge) {
    font-family: var(--font-mono);
    font-size: var(--size-1);
    font-weight: var(--weight-medium);
    border-radius: var(--radius-control);
    padding: 3px var(--space-3);
    background: var(--surface-panel);
    color: var(--text-quiet);
  }
  /* The danger family is split in two on purpose: --danger-mark is a 3:1 fill
     and cannot carry text, --danger is the 5.5:1 ink. So the badge is ink on
     the quiet tint, never white on berry. */
  .adc :global(.badge[data-standing='no']) {
    background: var(--surface-panel);
    color: var(--danger);
  }
  .adc :global(.badge[data-standing='not-yet-defined']) {
    background: var(--surface-panel);
    color: var(--text-quiet);
    outline: 1px dashed var(--border-field);
  }
  .adc :global(.step-area) {
    font-family: var(--font-mono);
    font-size: var(--size-1);
    color: var(--text-quiet);
  }
  .adc :global(.step-label) {
    font-size: var(--size-5);
    font-weight: var(--weight-strong);
    color: var(--text-loud);
    line-height: var(--lh-snug);
  }
  .adc :global(.step-ask) {
    margin-top: var(--space-2);
    font-size: var(--size-4);
    line-height: var(--lh-snug);
    color: var(--text-body);
    max-width: var(--measure-prose);
  }
  .adc :global(.step-why),
  .adc :global(.step-do) {
    margin-top: var(--space-4);
    font-size: var(--size-3);
    line-height: var(--lh-normal);
    color: var(--text-body);
    max-width: var(--measure-prose);
  }
  .adc :global(.step-do) {
    background: var(--surface-panel);
    border-radius: var(--radius-inner);
    padding: var(--space-4);
  }
  .adc :global(.step-guide) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--size-1);
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .adc :global(.step-guide:hover) {
    color: var(--accent-ink-strong);
  }

  .adc :global(.legend) {
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }
  .adc :global(.legend-row) {
    display: grid;
    grid-template-columns: 16ch 1fr;
    gap: var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius-inner);
    background: var(--surface-sunken);
  }
  .adc :global(.legend-row[data-standing='no']) {
    background: var(--agent-refused-bg);
  }
  .adc :global(.legend-row[data-standing='not-yet-defined']) {
    background: var(--state-unwritten-bg);
  }
  .adc :global(.legend-row dt) {
    font-family: var(--font-mono);
    font-size: var(--size-2);
    color: var(--text-loud);
  }
  .adc :global(.legend-row dd) {
    font-size: var(--size-3);
    line-height: var(--lh-normal);
    color: var(--text-body);
  }

  .adc :global(.result-rules) {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: var(--measure-prose);
    list-style: decimal;
    padding-left: var(--space-5);
  }
  .adc :global(.result-rules li) {
    list-style: decimal;
    font-size: var(--size-2);
    color: var(--text-quiet);
    line-height: var(--lh-normal);
  }

  .adc :global(.result-after) {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    font-size: var(--size-3);
    color: var(--text-quiet);
    max-width: var(--measure-prose);
    background: var(--state-unwritten-line) no-repeat top left / 100% 2px;
  }
  .adc :global(.result-after a) {
    color: var(--text-loud);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .copy-fallback {
    margin-top: var(--space-5);
  }
  .copy-fallback label {
    display: block;
    font-size: var(--size-3);
    color: var(--text-quiet);
    margin-bottom: var(--space-3);
  }
  .copy-fallback textarea {
    width: 100%;
    border: 0;
    border-radius: var(--radius-field);
    background: var(--surface-panel);
    box-shadow: var(--shadow-raise);
    padding: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--size-2);
    line-height: var(--lh-normal);
    resize: vertical;
  }

  /* ── narrow, and 200% zoom ───────────────────────────────────────────────
     Everything below is one-column-or-wrap. Nothing has a min-width wider than
     a 390px screen, and the three choices stack rather than becoming three
     two-word columns. */
  @media (max-width: 900px) {
    .meanings {
      grid-template-columns: 1fr;
    }
    .adc :global(.counts) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .adc :global(.legend-row) {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
  @media (max-width: 720px) {
    .choices {
      grid-template-columns: 1fr;
    }
    .adc-toolbar {
      grid-template-columns: 1fr;
    }
    .tool-actions .btn {
      width: 100%;
    }
    .example-card {
      padding: var(--space-5);
    }
    .q-set {
      padding: var(--space-4);
    }
    .adc :global(.export) .btn {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .q-set {
      transition: none;
    }
  }
</style>

<style is:global>
  /*
    PRINT — the roadmap's "downloadable text/print summary without login".
    Two shapes, and the rule between them is honest: with a result, print the
    result; without one, print the checklist, which is a usable blank form to
    take into a review.

    Scoped by hand to this page's own chrome plus the two layout landmarks,
    because a scoped block cannot reach a component it does not own. This CSS
    ships only in this page's bundle.
  */
  @media print {
    .sitenav,
    .sitefooter,
    .skip,
    .adc .crumbs,
    .adc .hero-cta,
    .adc .adc-contents,
    .adc .adc-toolbar,
    .adc .copy-fallback,
    .adc .export,
    .adc .export-note,
    .adc .clear-one {
      display: none !important;
    }

    /* The radios stay in the no-result printout. That version of this page is
       a blank checklist somebody carries into a review, and a checklist you
       cannot tick is a handout. */

    /* The noir shell is one black area on screen and a wasted cartridge on
       paper. Everything prints as ink on white. */
    .adc .hero > .wrap {
      background: #fff !important;
      color: #000 !important;
      padding: 0 !important;
      width: auto !important;
      max-width: none !important;
    }
    .adc .hero h1,
    .adc .hero .credential,
    .adc .hero .credential strong {
      color: #000 !important;
    }
    .adc .hero h1 em {
      color: #000 !important;
    }
    .adc .hero .eyebrow,
    .adc .hero-note {
      color: #444 !important;
    }
    .adc .example-card {
      background: #fff !important;
      outline: 1px solid #999;
    }

    .adc .panel,
    .adc .q-set,
    .adc .step,
    .adc .bring,
    .adc .count,
    .adc .meaning {
      box-shadow: none !important;
      outline: 1px solid #bbb;
      break-inside: avoid;
    }

    /* With a result, the result IS the printout. */
    .adc[data-state='result'] .adc-questions,
    .adc[data-state='result'] .example-card,
    .adc[data-state='result'] .meanings,
    .adc[data-state='result'] .rules,
