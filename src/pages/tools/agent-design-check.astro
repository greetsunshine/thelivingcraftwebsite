---
/**
 * /tools/agent-design-check — the ungated browser checklist.
 *
 * THE SPECIFICATION
 *
 * docs/Website Rebuild 10-09-2026/Website_Growth_Roadmap.html, "Agent Design
 * Check functional scope". Every requirement in it, and where it lives:
 *
 *   structured yes/no/not-yet-defined over seven areas ... the form below,
 *     built from AREAS and QUESTIONS in src/data/agent-design-check.ts
 *   a built-in illustrative example ....................... EXAMPLE, plus a
 *     per-question `example` continuing the same scenario — the returns
 *     assistant from the VSL script, never a new scenario per question
 *   which questions remain unanswered, why they matter, and a prioritised
 *     set of next steps with guide links ................. the result panel
 *   distinguish a reported gap from a missing answer ..... three standings,
 *     three destinations in the output — see the block comment below
 *   transparent rules, not a model-generated score ....... RULES, printed
 *     before the form and again inside the result
 *   all-unknown returns a starting checklist ............. verdict 'starting'
 *   every box addressed still requests evidence .......... verdict 'evidence'
 *   processed in the browser ............................. no fetch on this
 *     page at all; see THE PRIVACY PROPERTY below
 *   downloadable text / print summary without login ...... Blob download,
 *     window.print() with a print stylesheet, clipboard as a fallback
 *   optional email signup AFTER the result, separate ..... one secondary
 *     link at the foot of the result. No inline capture, no gate
 *   no lead record from anonymous use .................... nothing posts
 *   track starts/completions only with analytics permission ... NOTHING IS
 *     WIRED. There is no consent mechanism on this site, so the honest
 *     implementation of "only with permission" is to instrument none of it
 *
 * ═══════════════════════════════════════════════════════════════════════════
 * THE PRIVACY PROPERTY, AND THE TWO THINGS THAT WOULD BREAK IT
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Nothing typed here about an architecture may reach a server. Two structural
 * choices hold that up, and both look like details:
 *
 * 1. THE ANSWERS ARE NOT IN A <form>. They are radios in a plain <div>. A form
 *    element can be submitted — by a stray Enter keypress, by a button that
 *    forgot type="button" — and a GET submission puts nineteen answers in the
 *    query string, which then travels in a Referer header to the first guide
 *    the visitor clicks. No form element, no such path. Do not "tidy" this into
 *    a <form>.
 *
 * 2. NO STORAGE, AND THE STATE IS A CLOSURE. CLAUDE.md forbids localStorage and
 *    sessionStorage site-wide; here that prohibition and the roadmap's "retain
 *    no architecture answers" happen to be the same sentence. The `answers`
 *    object lives inside the module script and dies with the tab.
 *
 * The analytics beacon in the layout still records a pageview, exactly as it
 * does on every other page — a path and a referrer, nothing from this form. It
 * captures form starts only for `form.apply-form`, which this is not, and CTA
 * clicks only by href. Adding a start/completion event here needs a consent
 * mechanism the site does not have.
 *
 * ═══════════════════════════════════════════════════════════════════════════
 * THREE STANDINGS, THREE DESTINATIONS IN THE OUTPUT
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * The roadmap says to distinguish a reported gap from a missing answer, and
 * this page has three states rather than two because "not yet defined" is
 * neither:
 *
 *   no ............ a REPORTED GAP. Somebody looked and the answer was no.
 *                   Appears in "next steps" with the question's `onGap` — a
 *                   design change — and takes the danger colours.
 *   not-yet-defined  NOBODY HAS DECIDED. Appears in "next steps" too, but with
 *                   `onUnwritten` — a way to find out, not a way to build — and
 *                   takes the unwritten colours. Never ranked against a gap:
 *                   they are different kinds of work, not degrees of one.
 *   (left alone) .. NOT ANSWERED HERE. Never appears as a step, never counted
 *                   toward anything, and reported in its own section as still
 *                   open. Treating a skipped question as a gap would be the
 *                   tool inventing a finding about a design it was told nothing
 *                   about.
 *
 * NO SCORE. Not a percentage, not a count out of nineteen, not a band. The
 * counts are printed as four separate numbers precisely so that no one of them
 * reads as a result. If a number ever appears here that combines them, this has
 * become the thing the roadmap said not to build.
 *
 * ═══════════════════════════════════════════════════════════════════════════
 * USEFUL AT REST
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Everything above the toolbar is server-rendered and complete before anybody
 * answers anything: the worked example, all nineteen questions, why each one
 * matters, what it looks like in the example, its guide, and the rules the
 * checker uses. That is the content. The script adds the result; it is not what
 * makes the page worth opening, and the <noscript> note says so plainly rather
 * than apologising.
 */
import PracticeLayout from '../../layouts/PracticeLayout.astro';
import { SITE_ORIGIN } from '../../data/facts';
import {
  AREAS,
  QUESTIONS,
  EXAMPLE,
  RULES,
  STANDINGS,
  type Answer,
} from '../../data/agent-design-check';

export const prerender = true;

const path = '/tools/agent-design-check';
const url = `${SITE_ORIGIN}${path}`;

/** Radio order. Absence of an answer is not a fourth radio — see the rubric. */
const CHOICES: Answer[] = ['yes', 'no', 'not-yet-defined'];

const grouped = AREAS.map((area) => ({
  area,
  questions: QUESTIONS.filter((q) => q.area === area.id),
}));

const title = 'Agent design check — a browser checklist · Sunil Mathew';
const description = `${QUESTIONS.length} questions across ${AREAS.length} areas of an agentic design — purpose, evidence, tool permissions, external actions, evaluation, uncertainty and ownership. Answered in your browser, with no score and no sign-in.`;

const schema: unknown[] = [
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_ORIGIN}/` },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: `${SITE_ORIGIN}/tools` },
      { '@type': 'ListItem', position: 3, name: 'Agent design check' },
    ],
  },
];
---

<PracticeLayout title={title} description={description} canonical={path} schema={schema}>
  <div class="adc" id="adc" data-state="rest">
    <nav aria-label="Breadcrumb">
      <ol class="crumbs">
        <li><a href="/">Home</a></li>
        <li class="sep" aria-hidden="true">/</li>
        <li><a href="/tools/">Tools</a></li>
        <li class="sep" aria-hidden="true">/</li>
        <li aria-current="page">Agent design check</li>
      </ol>
    </nav>

    <section class="hero adc-hero">
      <div class="wrap">
        <p class="eyebrow">Tools · browser checklist</p>
        <h1>Agent <em>design check</em></h1>
        <p class="credential">
          {QUESTIONS.length} questions about a system that acts. Answer the ones you can,
          leave the rest, and get back <strong>what is still open and what to do about it</strong>
          — in the order the decisions are worth making.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#questions"
            >Go to the questions&nbsp;<span class="arrow" aria-hidden="true">→</span></a
          >
          <a class="btn btn-ghost" href="#example">Read the example first</a>
        </div>
        <p class="hero-note">
          Worked out in this page. No sign-in, no score, and nothing you type is sent
          anywhere.
        </p>
      </div>
    </section>

    {/* ── the rules, before the form ───────────────────────────────────────── */}
    <section class="wrap" aria-labelledby="rules-h">
      <div class="sec-head">
        <p class="eyebrow">Before you start</p>
        <h2 id="rules-h">What this does, <em>and what it will not do</em></h2>
      </div>
      <ol class="rules">
        {
          RULES.map((r, i) => (
            <li>
              <span class="rule-n">{String(i + 1).padStart(2, '0')}</span>
              <span class="rule-t">{r}</span>
            </li>
          ))
        }
      </ol>
      <p class="privacy-note">
        Your answers are held in this page and nowhere else. They are not saved to your
        browser, not sent to a server, and not recoverable by anybody — including us — once
        you close the tab. That is also why there is nothing to sign in to.
      </p>
    </section>

    {/* ── the worked example ───────────────────────────────────────────────── */}
    <section class="wrap" id="example" aria-labelledby="example-h">
      <div class="sec-head">
        <p class="eyebrow">The example throughout</p>
        <h2 id="example-h">{EXAMPLE.title}</h2>
      </div>
      <div class="example-card">
        {EXAMPLE.paragraphs.map((p) => <p>{p}</p>)}
        <p class="disclaimer">{EXAMPLE.disclaimer}</p>
      </div>
    </section>

    {/* ── what the three answers mean ──────────────────────────────────────── */}
    <section class="wrap" aria-labelledby="answers-h">
      <div class="sec-head">
        <p class="eyebrow">The three answers</p>
        <h2 id="answers-h">“No” and “not yet defined” are <em>different facts</em></h2>
      </div>
      <dl class="meanings">
        {
          (['yes', 'no', 'not-yet-defined'] as Answer[]).map((s) => (
            <div class="meaning" data-standing={s}>
              <dt>{STANDINGS[s].short}</dt>
              <dd>{STANDINGS[s].meaning}</dd>
            </div>
          ))
        }
        <div class="meaning" data-standing="unanswered">
          <dt>{STANDINGS.unanswered.short}</dt>
          <dd>{STANDINGS.unanswered.meaning}</dd>
        </div>
      </dl>
    </section>

    {/* ── contents ─────────────────────────────────────────────────────────── */}
    <section class="wrap adc-contents" aria-labelledby="contents-h">
      <h2 class="contents-h" id="contents-h">The {AREAS.length} areas</h2>
      <ol class="contents-list">
        {
          grouped.map(({ area, questions }, i) => (
            <li>
              <a href={`#${area.id}`}>
                <span class="c-n">{String(i + 1).padStart(2, '0')}</span>
                <span class="c-t">{area.title}</span>
                <span class="c-q">
                  {questions.length} {questions.length === 1 ? 'question' : 'questions'}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    {/*
      ── the questions ──────────────────────────────────────────────────────
      A <div>, not a <form>. See note 1 in the header comment: a form element
      can be submitted, and a submitted GET carries every answer in the URL.
    */}
    <div class="wrap adc-questions" id="questions">
      <div id="adc-form">
        {
          grouped.map(({ area, questions }, ai) => (
            <section class="area" id={area.id} aria-labelledby={`h-${area.id}`}>
              <div class="area-head">
                <p class="eyebrow">
                  <span class="num">{String(ai + 1).padStart(2, '0')}</span> Area
                </p>
                <h2 id={`h-${area.id}`}>{area.title}</h2>
                <p class="area-blurb">{area.blurb}</p>
              </div>

              {questions.map((q) => (
                <div class="q" data-question={q.id}>
                  <h3 class="q-label">{q.label}</h3>

                  <fieldset class="q-set">
                    <legend class="q-ask">{q.ask}</legend>

                    <div class="q-notes">
                      <p class="q-why">
                        <span class="k">Why it matters</span>
                        {q.why}
                      </p>
                      <p class="q-eg">
                        <span class="k">In the example</span>
                        {q.example}
                      </p>
                    </div>

                    <div class="choices">
                      {CHOICES.map((c) => (
                        <label class="choice" data-standing={c}>
                          <input type="radio" name={q.id} value={c} id={`${q.id}--${c}`} />
                          <span class="choice-t">{STANDINGS[c].choice}</span>
                        </label>
                      ))}
                    </div>

                    <div class="q-foot">
                      <a class="q-guide" href={q.guide.href}>
                        {q.guide.title}
                        <span class="arrow" aria-hidden="true">
                          →
                        </span>
                      </a>
                      <button
                        type="button"
                        class="clear-one"
                        data-clear={q.id}
                        disabled
                        aria-label={`Clear the answer to: ${q.label}`}
                      >
                        Clear
                      </button>
                    </div>
                  </fieldset>
                </div>
              ))}
            </section>
          ))
        }
      </div>
    </div>

    {/* ── the toolbar ──────────────────────────────────────────────────────── */}
    <div class="wrap">
      <div class="adc-toolbar panel">
        <div class="tool-copy">
          <h2>Work out what to do next</h2>
          <p>
            Leaving questions alone is fine. They come back as still open, never as a gap.
          </p>
        </div>
        <div class="tool-actions">
          <button type="button" class="btn btn-primary" id="adc-show">
            Show what to do next
          </button>
          <button type="button" class="btn btn-ghost" id="adc-clear">Clear all answers</button>
        </div>
        <p class="tool-count" id="adc-count">
          Answered 0 of {QUESTIONS.length} questions.
        </p>
      </div>

      <noscript>
        <p class="noscript-note">
          The result is worked out in your browser, so this last part needs JavaScript. The
          {' '}{QUESTIONS.length} questions above, why each one matters, and the guide behind
          each are the whole of what it would use — nothing is fetched, and there is nothing
          more to see.
        </p>
      </noscript>
    </div>

    {/*
      The result lands here. `role="status"` beside it announces that it has,
      and focus moves into the panel itself — a screen reader user should not
      have to go looking for output that appeared four screens down.
    */}
    <div class="wrap">
      <p class="sr-only" id="adc-live" role="status" aria-live="polite"></p>
      <div id="adc-result"></div>

      {/*
        Clipboard fallback. Revealed only when the clipboard API refuses or is
        unavailable (an insecure context, a permissions policy). It is a real
        fallback, not decoration: the text is there to be selected by hand.
      */}
      <div class="copy-fallback" id="adc-fallback" hidden>
        <label for="adc-fallback-text">
          Copying was not permitted by your browser. The summary is here — select it all and
          copy.
        </label>
        <textarea id="adc-fallback-text" rows="12" readonly></textarea>
      </div>
    </div>
  </div>

  {/*
    Where to go next, and it is a LIST OF LINKS rather than a form.

    The roadmap's row for this page reads "Wants value without a sales form",
    and then names the next step as "optional resources/cohort/advisory". Both
    halves matter. Omitting the onward routes entirely leaves somebody who has
    just worked through nineteen questions with nowhere to go; putting an email
    field here would be exactly the sales form the row rules out, and would sit
    on a page whose whole claim is that nothing you type is sent anywhere.

    So: three links, no field, no capture, and deliberately after everything
    else on the page. Using the tool creates no lead record, which is the
    roadmap's requirement and is true by construction — there is no endpoint to
    create one with.
  */}
  <section class="wrap adc-after" aria-labelledby="after-h">
    <h2 id="after-h">If a question here landed</h2>
    <p>
      Nothing you answered was sent anywhere, and no record of you exists. The page
      view itself is counted, as it is on every page here, and that count cannot be
      joined to a person or to anything above. If you want to take one of these
      questions further, these are the routes that exist.
    </p>
    <ul class="adc-routes">
      <li>
        <a href="/resources/guides/">The guides</a> — the reasoning behind these
        questions, in longer form. Free, and no sign-up.
      </li>
      <li>
        <a href="/">The open cohort</a> — building a working agentic system and
        practising the argument for its design, with feedback. Applying starts a
        conversation about fit.
      </li>
      <li>
        <a href="/advisory/">Advisory</a> — if the decision in front of your team is
        the immediate problem rather than the practice of making them.
      </li>
    </ul>
  </section>
</PracticeLayout>

<script>
  /**
   * The checker. Reads the rubric, holds the answers in a closure, renders the
   * result, and hands the visitor a file.
   *
   * A MODULE SCRIPT, NOT `is:inline`. An inline script cannot import — this
   * repo has been bitten by exactly that (see CLAUDE.md on pair.astro importing
   * buildAdr and never being able to call it). A module script is bundled by
   * Vite and type-checked by `astro check`, which is the point: the summary
   * format has ONE owner in the rubric module, and both the download and the
   * copy button call it rather than assembling their own.
   *
   * NOTHING HERE TOUCHES THE NETWORK OR ANY STORAGE. `answers` is the whole of
   * the state and it dies with the tab.
   */
  import {
    QUESTIONS,
    STANDINGS,
    RULES,
    VERDICT_COPY,
    areaOf,
    nextSteps,
    evidenceRequests,
    stillOpen,
    tally,
    verdict,
    summaryText,
    type Answer,
    type Answers,
    type Standing,
  } from '../../data/agent-design-check';

  const form = document.getElementById('adc-form');
  const root = document.getElementById('adc');
  const host = document.getElementById('adc-result');
  const live = document.getElementById('adc-live');
  const countLine = document.getElementById('adc-count');
  const showBtn = document.getElementById('adc-show');
  const clearBtn = document.getElementById('adc-clear');
  const fallback = document.getElementById('adc-fallback');
  const fallbackText = document.getElementById('adc-fallback-text');

  /**
   * The six elements are checked once and passed in, rather than asserted at
   * every use. Narrowing from an `if` does not survive into a hoisted function
   * declaration, and this body is almost nothing but function declarations —
   * so the alternative is a scattering of `!`, which is how a guarded DOM query
   * quietly becomes an unguarded one.
   */
  function boot(
    form: HTMLElement,
    root: HTMLElement,
    host: HTMLElement,
    live: HTMLElement,
    showBtn: HTMLElement,
    clearBtn: HTMLElement,
  ): void {
    /** The only state. No storage, no server, no history entry. */
    const answers: Answers = {};

    // ── small DOM helpers ───────────────────────────────────────────────────
    // Built with createElement and textContent rather than innerHTML. The
    // rubric strings are ours, but a page that assembles markup from strings
    // teaches the next person to do it with a string that is not.

    function el<K extends keyof HTMLElementTagNameMap>(
      tag: K,
      cls?: string,
      text?: string,
    ): HTMLElementTagNameMap[K] {
      const node = document.createElement(tag);
      if (cls) node.className = cls;
      if (text) node.textContent = text;
      return node;
    }

    function kicker(label: string, body: string, cls: string): HTMLParagraphElement {
      const p = el('p', cls);
      p.append(el('span', 'k', label));
      p.append(document.createTextNode(body));
      return p;
    }

    function say(message: string): void {
      // Cleared first so an identical message announces twice when it happens
      // twice — two downloads should not be silent the second time.
      live.textContent = '';
      window.setTimeout(() => {
        live.textContent = message;
      }, 60);
    }

    // ── answering ───────────────────────────────────────────────────────────

    function radiosFor(id: string): HTMLInputElement[] {
      return Array.from(
        form.querySelectorAll<HTMLInputElement>('input[type="radio"][name="' + id + '"]'),
      );
    }

    function syncQuestion(id: string): void {
      const box = form.querySelector<HTMLElement>('[data-question="' + id + '"]');
      if (!box) return;
      const standing = answers[id];
      if (standing) box.dataset.standing = standing;
      else box.removeAttribute('data-standing');

      const clear = box.querySelector<HTMLButtonElement>('[data-clear]');
      if (clear) clear.disabled = !standing;
    }

    function syncCount(): void {
      if (!countLine) return;
      const n = Object.keys(answers).length;
      // A count of how much of the form is filled in. NOT a score, not a
      // percentage, and deliberately not a bar — see the rubric's first rule.
      countLine.textContent =
        'Answered ' + n + ' of ' + QUESTIONS.length + ' question' + (n === 1 ? '' : 's') + '.';
    }

    form.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement) || target.type !== 'radio') return;
      answers[target.name] = target.value as Answer;
      syncQuestion(target.name);
      syncCount();
    });

    form.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const button = target.closest<HTMLButtonElement>('[data-clear]');
      if (!button) return;
      const id = button.getAttribute('data-clear');
      if (!id) return;
      delete answers[id];
      radiosFor(id).forEach((r) => {
        r.checked = false;
      });
      syncQuestion(id);
      syncCount();
      say('Answer cleared.');
    });

    // ── the result ──────────────────────────────────────────────────────────

    function standingBadge(standing: Standing): HTMLElement {
      const badge = el('span', 'badge', STANDINGS[standing].short);
      badge.dataset.standing = standing;
      return badge;
    }

    function guideLink(href: string, title: string): HTMLAnchorElement {
      const a = el('a', 'step-guide');
      a.href = href;
      a.textContent = title;
      const arrow = el('span', 'arrow', '→');
      arrow.setAttribute('aria-hidden', 'true');
      a.append(arrow);
      return a;
    }

    function buildResult(): HTMLElement {
      const v = verdict(answers);
      const counts = tally(answers);
      const steps = nextSteps(answers);
      const evidence = evidenceRequests(answers);
      const open = stillOpen(answers);
      const copy = VERDICT_COPY[v];

      const panel = el('section', 'result panel');
      panel.id = 'adc-result-panel';
      panel.tabIndex = -1;
      panel.setAttribute('aria-labelledby', 'adc-result-h');

      const heading = el('h2', 'result-h', copy.heading);
      heading.id = 'adc-result-h';
      panel.append(heading);
      panel.append(el('p', 'result-lede', copy.body));

      // Four separate numbers. Never combined — a single figure would be the
      // readiness score the roadmap rules out.
      const dl = el('dl', 'counts');
      const orderedCounts: Standing[] = ['yes', 'no', 'not-yet-defined', 'unanswered'];
      orderedCounts.forEach((s) => {
        const cell = el('div', 'count');
        cell.dataset.standing = s;
        cell.append(el('dt', 'count-k', STANDINGS[s].short));
        cell.append(el('dd', 'count-v', String(counts[s])));
        dl.append(cell);
      });
      panel.append(dl);
      panel.append(
        el(
          'p',
          'counts-note',
          'Four counts of ' +
            QUESTIONS.length +
            ' questions. They are not added together, and there is no score here to improve.',
        ),
      );

      // Export sits at the top of the result rather than the bottom: it is the
      // thing somebody wants once they have read a step and want to take the
      // rest to a colleague, not after scrolling past everything twice.
      const exportRow = el('div', 'export');
      const downloadBtn = el('button', 'btn btn-primary', 'Download as a text file');
      downloadBtn.type = 'button';
      downloadBtn.addEventListener('click', download);
      const copyBtn = el('button', 'btn btn-ghost', 'Copy the summary');
      copyBtn.type = 'button';
      copyBtn.addEventListener('click', () => {
        void copyToClipboard();
      });
      const printBtn = el('button', 'btn btn-ghost', 'Print or save as PDF');
      printBtn.type = 'button';
      printBtn.addEventListener('click', () => window.print());
      exportRow.append(downloadBtn, copyBtn, printBtn);
      panel.append(exportRow);
      panel.append(
        el(
          'p',
          'export-note',
          'The file is built here and handed straight to you. It is not uploaded, and no copy of it exists anywhere else.',
        ),
      );

      // The distinction the roadmap asks for, stated in the output itself and
      // only for the standings that actually occur.
      const present = orderedCounts.filter((s) => counts[s] > 0);
      if (present.length > 1) {
        panel.append(el('h3', 'result-sub', 'What these mean'));
        const legend = el('dl', 'legend');
        present.forEach((s) => {
          const cell = el('div', 'legend-row');
          cell.dataset.standing = s;
          cell.append(el('dt', '', STANDINGS[s].short));
          cell.append(el('dd', '', STANDINGS[s].meaning));
          legend.append(cell);
        });
        panel.append(legend);
      }

      if (steps.length) {
        panel.append(el('h3', 'result-sub', 'Next steps, in order'));
        panel.append(
          el(
            'p',
            'sub-note',
            'Ordered by whether the question is about an action that leaves the system, then by the order the decisions are worth making. A reported gap and a not-yet-defined answer are not ranked against each other.',
          ),
        );
        const list = el('ol', 'steps');
        steps.forEach((step) => {
          const q = step.question;
          const item = el('li', 'step');
          item.dataset.standing = step.standing;

          const head = el('div', 'step-head');
          head.append(standingBadge(step.standing));
          head.append(el('span', 'step-area', areaOf(q.area).title));
          item.append(head);

          item.append(el('h4', 'step-label', q.label));
          item.append(el('p', 'step-ask', q.ask));
          item.append(kicker('Why it matters', q.why, 'step-why'));
          item.append(
            kicker(
              step.kind === 'design' ? 'Design change' : 'Decision to make',
              step.action,
              'step-do',
            ),
          );
          item.append(guideLink(q.guide.href, q.guide.title));
          list.append(item);
        });
        panel.append(list);
      }

      if (evidence.length) {
        panel.append(el('h3', 'result-sub', 'Marked addressed — what to bring'));
        panel.append(
          el(
            'p',
            'sub-note',
            'Answering yes closes nothing. Each one below is the artefact that would show the claim, which is what a review will ask for.',
          ),
        );
        const list = el('ul', 'brings');
        evidence.forEach((q) => {
          const item = el('li', 'bring');
          item.dataset.standing = 'yes';
          const head = el('div', 'step-head');
          head.append(el('span', 'step-area', areaOf(q.area).title));
          item.append(head);
          item.append(el('h4', 'step-label', q.label));
          item.append(kicker('Bring', q.onYes, 'step-do'));
          list.append(item);
        });
        panel.append(list);
      }

      // Suppressed in the starting case, where every question is already a step
      // above. Same rule as `summaryText`, and it lives in the rubric.
      if (open.length && v !== 'starting') {
        panel.append(el('h3', 'result-sub', 'Not answered here — still open'));
        panel.append(
          el(
            'p',
            'sub-note',
            'You left these alone. Nothing has been assumed about them and none of them is reported as a gap — they are listed because they are still worth answering.',
          ),
        );
        const list = el('ul', 'brings');
        open.forEach((q) => {
          const item = el('li', 'bring');
          item.dataset.standing = 'unanswered';
          const head = el('div', 'step-head');
          head.append(el('span', 'step-area', areaOf(q.area).title));
          item.append(head);
          item.append(el('h4', 'step-label', q.label));
          item.append(el('p', 'step-ask', q.ask));
          item.append(kicker('Why it matters', q.why, 'step-why'));
          item.append(guideLink(q.guide.href, q.guide.title));
          list.append(item);
        });
        panel.append(list);
      }

      panel.append(el('h3', 'result-sub', 'The rules this used'));
      const rules = el('ol', 'result-rules');
      RULES.forEach((r) => rules.append(el('li', '', r)));
      panel.append(rules);

      // The optional signup the roadmap asks for: AFTER the result, separate
      // from using the tool, and a link rather than a field. An inline capture
      // form here would gate the output on an email address, which is the one
      // thing "ungated" rules out.
      const after = el('p', 'result-after');
      after.append(
        document.createTextNode(
          'Nothing above was recorded and no one has been notified. If you want these questions asked against your own system, ',
        ),
      );
      const ask = el('a', '', 'send a note about what you are building');
      ask.href = '/#ask';
      after.append(ask);
      after.append(document.createTextNode(' — that is a separate thing you choose to do.'));
      panel.append(after);

      return panel;
    }

    function render(): void {
      const panel = buildResult();
      host.replaceChildren(panel);
      root.dataset.state = 'result';
      if (fallback) fallback.hidden = true;

      const counts = tally(answers);
      say(
        'Result ready below. ' +
          counts.no +
          ' reported as a gap, ' +
          counts['not-yet-defined'] +
          ' not yet defined, ' +
          counts.yes +
          ' marked addressed, ' +
          counts.unanswered +
          ' not answered.',
      );
      panel.focus();
    }

    // ── export ──────────────────────────────────────────────────────────────
    // One owner for the format: `summaryText` in the rubric. The download and
    // the copy both call it, so the two can never disagree.

    function summary(): string {
      return summaryText(answers, { origin: window.location.origin, now: new Date() });
    }

    function download(): void {
      const blob = new Blob([summary()], { type: 'text/plain;charset=utf-8' });
      const objectUrl = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = objectUrl;
      link.download = 'agent-design-check.txt';
      document.body.append(link);
      link.click();
      link.remove();
      window.setTimeout(() => URL.revokeObjectURL(objectUrl), 1000);
      say('Summary downloaded as agent-design-check.txt');
    }

    async function copyToClipboard(): Promise<void> {
      const text = summary();
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          if (fallback) fallback.hidden = true;
          say('Summary copied to the clipboard.');
          return;
        }
      } catch {
        /* falls through to the visible fallback below */
      }
      if (fallback && fallbackText instanceof HTMLTextAreaElement) {
        fallbackText.value = text;
        fallback.hidden = false;
        fallbackText.focus();
        fallbackText.select();
        say('Copying was not permitted. The summary is in a box below, ready to select.');
      } else {
        say('Copying was not permitted. Use the download button instead.');
      }
    }

    // ── the toolbar ─────────────────────────────────────────────────────────

    showBtn.addEventListener('click', render);

    clearBtn.addEventListener('click', () => {
      Object.keys(answers).forEach((id) => {
        delete answers[id];
        radiosFor(id).forEach((r) => {
          r.checked = false;
        });
        syncQuestion(id);
      });
      host.replaceChildren();
      root.dataset.state = 'rest';
      if (fallback) fallback.hidden = true;
      syncCount();
      say('All answers cleared. The questions are as they were.');
    });

    syncCount();
  }

  if (form && root && host && live && showBtn && clearBtn) {
    boot(form, root, host, live, showBtn, clearBtn);
  }
</script>

